<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'nonce-<%= nonce %>' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - VisiSocial</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style nonce="<%= nonce %>">
        :root {
            --primary: #7c6cff;
            --primary-dark: #5b4fe0;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --gradient-primary: linear-gradient(118deg, #9d7bff 0%, #7c6cff 45%, #34e3ff 100%);
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-lg: 0 25px 80px -20px rgba(99, 102, 241, 0.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        /* Animated Background */
        .bg-animated {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
            background: var(--darker);
        }

        .bg-animated .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.15;
            animation: float 25s ease-in-out infinite;
        }

        .bg-animated .orb-1 {
            width: 700px;
            height: 700px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            top: -250px;
            right: -250px;
        }

        .bg-animated .orb-2 {
            width: 500px;
            height: 500px;
            background: linear-gradient(135deg, var(--secondary) 0%, var(--accent) 100%);
            bottom: -150px;
            left: -150px;
            animation-delay: -7s;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(60px, -60px) scale(1.1); }
            50% { transform: translate(-40px, 40px) scale(0.9); }
            75% { transform: translate(-60px, -40px) scale(1.05); }
        }

        /* Header */
        header {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
        }

        .header-content {
            max-width: 1600px;
            margin: 0 auto;
            padding: 20px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.3);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .logo {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-back {
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: var(--primary-light);
            padding: 10px 20px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back:hover {
            background: rgba(99, 102, 241, 0.2);
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        /* Container */
        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 40px 32px;
        }

        /* Glass Card */
        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            position: relative;
            overflow: hidden;
        }

        .glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        }

        /* Page Header */
        .page-header {
            margin-bottom: 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .page-title i {
            color: var(--accent);
        }

        .gradient-text {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .time-filter {
            display: flex;
            gap: 8px;
            background: rgba(255, 255, 255, 0.03);
            padding: 4px;
            border-radius: 12px;
        }

        .time-btn {
            padding: 8px 16px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: var(--muted);
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .time-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--light);
        }

        .time-btn.active {
            background: var(--primary);
            color: white;
        }

        /* Charts Grid */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin-bottom: 24px;
        }

        .chart-card {
            padding: 28px;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .chart-title {
            font-size: 1.25rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chart-title i {
            color: var(--accent);
            font-size: 1.5rem;
        }

        .chart-badge {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .badge-primary {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary-light);
        }

        .chart-container {
            position: relative;
            height: 300px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 32px;
        }

        .stat-card {
            padding: 24px;
            text-align: center;
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 16px;
        }

        .stat-icon-primary {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary);
        }

        .stat-icon-success {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .stat-icon-warning {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .stat-icon-accent {
            background: rgba(6, 182, 212, 0.1);
            color: var(--accent);
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--light);
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--muted);
        }

        /* Table */
        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th,
        .data-table td {
            padding: 16px;
            text-align: left;
        }

        .data-table th {
            background: rgba(255, 255, 255, 0.03);
            color: var(--muted);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .data-table tbody tr {
            border-bottom: 1px solid var(--glass-border);
            transition: background 0.2s ease;
        }

        .data-table tbody tr:hover {
            background: rgba(255, 255, 255, 0.03);
        }

        .data-table td {
            color: var(--light);
        }

        .trend-up {
            color: var(--success);
        }

        .trend-down {
            color: var(--danger);
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        .progress-primary {
            background: var(--primary);
        }

        .progress-success {
            background: var(--success);
        }

        .progress-warning {
            background: var(--warning);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .charts-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 16px;
            }

            .container {
                padding: 24px 16px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .page-title {
                font-size: 2rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .chart-card {
                padding: 20px;
            }

            .chart-container {
                height: 250px;
            }
        }
    </style>
</head>

<body>
    <!-- Animated Background -->
    <div class="bg-animated">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <!-- Header -->
    <header>
        <div class="header-content">
            <div class="header-left">
                <a href="/admin" class="logo">VisiSocial</a>
                <div class="admin-badge">
                    <i class="fas fa-chart-line"></i>
                    <span>Analytics</span>
                </div>
            </div>

            <div class="header-right">
                <a href="/admin" class="btn-back">
                    <i class="fas fa-arrow-left"></i>
                    <span>Dashboard</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <div class="container">
        
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-chart-bar"></i>
                Analytics <span class="gradient-text">Dashboard</span>
            </h1>

            <div class="time-filter">
                <button class="time-btn" onclick="setDays(7)">7 Days</button>
                <button class="time-btn active" onclick="setDays(30)">30 Days</button>
                <button class="time-btn" onclick="setDays(90)">90 Days</button>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="glass-card stat-card">
                <div class="stat-icon stat-icon-primary">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-value"><%= userGrowth.reduce((sum, day) => sum + day.count, 0) %></div>
                <div class="stat-label">New Users</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-icon stat-icon-success">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stat-value">
                    <%= Math.round((userGrowth[userGrowth.length - 1]?.count / Math.max(1, userGrowth[0]?.count) - 1) * 100) %>%
                </div>
                <div class="stat-label">Growth Rate</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-icon stat-icon-warning">
                    <i class="fas fa-fire"></i>
                </div>
                <div class="stat-value"><%= topInterests.length %></div>
                <div class="stat-label">Interest Categories</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-icon stat-icon-accent">
                    <i class="fas fa-heart"></i>
                </div>
                <div class="stat-value">
                    <%= Math.round(engagementDistribution.reduce((sum, bucket) => sum + bucket.count, 0) / 
                        Math.max(1, engagementDistribution.length)) %>
                </div>
                <div class="stat-label">Avg Engagement</div>
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="charts-grid">
            <!-- User Growth Chart -->
            <div class="glass-card chart-card">
                <div class="chart-header">
                    <h3 class="chart-title">
                        <i class="fas fa-chart-area"></i>
                        User Growth
                    </h3>
                    <span class="chart-badge badge-success">
                        <i class="fas fa-arrow-up"></i> Trending
                    </span>
                </div>
                <div class="chart-container">
                    <canvas id="userGrowthChart"></canvas>
                </div>
            </div>

            <!-- Engagement Distribution Chart -->
            <div class="glass-card chart-card">
                <div class="chart-header">
                    <h3 class="chart-title">
                        <i class="fas fa-chart-pie"></i>
                        Engagement Distribution
                    </h3>
                    <span class="chart-badge badge-primary">
                        <i class="fas fa-info-circle"></i> Overview
                    </span>
                </div>
                <div class="chart-container">
                    <canvas id="engagementChart"></canvas>
                </div>
            </div>

            <!-- Top Interests Chart -->
            <div class="glass-card chart-card">
                <div class="chart-header">
                    <h3 class="chart-title">
                        <i class="fas fa-heart"></i>
                        Top Interests
                    </h3>
                    <span class="chart-badge badge-warning">
                        <i class="fas fa-star"></i> Popular
                    </span>
                </div>
                <div class="chart-container">
                    <canvas id="interestsChart"></canvas>
                </div>
            </div>

            <!-- Activity by Day of Week -->
            <div class="glass-card chart-card">
                <div class="chart-header">
                    <h3 class="chart-title">
                        <i class="fas fa-calendar-alt"></i>
                        Activity by Day
                    </h3>
                    <span class="chart-badge badge-primary">
                        <i class="fas fa-clock"></i> Weekly
                    </span>
                </div>
                <div class="chart-container">
                    <canvas id="activityChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Gender Distribution Table -->
        <div class="glass-card" style="padding: 28px; margin-bottom: 24px;">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-venus-mars"></i>
                    Gender Distribution
                </h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Gender</th>
                        <th>Count</th>
                        <th>Percentage</th>
                        <th>Distribution</th>
                    </tr>
                </thead>
                <tbody>
                    <% 
                    const totalGender = genderDistribution.reduce((sum, g) => sum + g.count, 0);
                    genderDistribution.forEach(gender => { 
                        const percentage = Math.round((gender.count / totalGender) * 100);
                    %>
                    <tr>
                        <td style="text-transform: capitalize;"><%= gender._id || 'Not specified' %></td>
                        <td><%= gender.count %></td>
                        <td><%= percentage %>%</td>
                        <td>
                            <div class="progress-bar">
                                <div class="progress-fill progress-primary" style="width: <%= percentage %>%"></div>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

    </div>

    <script nonce="<%= nonce %>">
        // User Growth Chart
        const userGrowthCtx = document.getElementById('userGrowthChart').getContext('2d');
        new Chart(userGrowthCtx, {
            type: 'line',
            data: {
                labels: <%= JSON.stringify(userGrowth.map(d => d._id)) %>,
                datasets: [{
                    label: 'New Users',
                    data: <%= JSON.stringify(userGrowth.map(d => d.count)) %>,
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { color: '#94a3b8' },
                        grid: { color: 'rgba(255, 255, 255, 0.05)' }
                    },
                    x: {
                        ticks: { color: '#94a3b8' },
                        grid: { color: 'rgba(255, 255, 255, 0.05)' }
                    }
                }
            }
        });

        // Engagement Distribution Chart
        const engagementCtx = document.getElementById('engagementChart').getContext('2d');
        new Chart(engagementCtx, {
            type: 'doughnut',
            data: {
                labels: ['0-20', '20-40', '40-60', '60-80', '80-100'],
                datasets: [{
                    data: <%= JSON.stringify(engagementDistribution.map(d => d.count)) %>,
                    backgroundColor: [
                        '#ef4444',
                        '#f59e0b',
                        '#6366f1',
                        '#10b981',
                        '#06b6d4'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#94a3b8', padding: 15 }
                    }
                }
            }
        });

        // Top Interests Chart
        const interestsCtx = document.getElementById('interestsChart').getContext('2d');
        new Chart(interestsCtx, {
            type: 'bar',
            data: {
                labels: <%= JSON.stringify(topInterests.map(i => i._id)) %>,
                datasets: [{
                    label: 'Users',
                    data: <%= JSON.stringify(topInterests.map(i => i.count)) %>,
                    backgroundColor: '#8b5cf6',
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { color: '#94a3b8' },
                        grid: { color: 'rgba(255, 255, 255, 0.05)' }
                    },
                    x: {
                        ticks: { color: '#94a3b8' },
                        grid: { display: false }
                    }
                }
            }
        });

        // Activity by Day Chart
        const activityCtx = document.getElementById('activityChart').getContext('2d');
        const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        new Chart(activityCtx, {
            type: 'radar',
            data: {
                labels: dayNames,
                datasets: [{
                    label: 'Active Users',
                    data: <%= JSON.stringify(activeByDayOfWeek) %>,
                    borderColor: '#06b6d4',
                    backgroundColor: 'rgba(6, 182, 212, 0.1)',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    r: {
                        ticks: { color: '#94a3b8' },
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        pointLabels: { color: '#94a3b8' }
                    }
                }
            }
        });

        function setDays(days) {
            window.location.href = `/admin/analytics?days=${days}`;
        }
    </script>
</body>
</html>