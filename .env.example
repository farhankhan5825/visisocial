# Offline demo/tests/evaluation need no credentials and do not load .env.
# Enable live mode explicitly in the shell before npm start.
APP_MODE=live
NODE_ENV=production
PORT=3001
# Required: fresh TLS database, HTTPS origin, independent strong secrets.
PUBLIC_ORIGIN=
MONGODB_URI=
SESSION_SECRET=
# Exactly 32 random bytes as 64 hexadecimal characters.
TOKEN_ENCRYPTION_KEY=
# Meta Development Mode and allowlisted developer test accounts only.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_TEST_USER_IDS=
# Required vN.0; verify supported version and permissions with Meta.
API_VERSION=
# Optional providers; each additionally requires the user's consent.
# Model pinned in src/providers.js; no floating override.
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
HIBP_API_KEY=
# Local directory containing public eng.traineddata, never a remote URL.
TESSERACT_LANG_PATH=
