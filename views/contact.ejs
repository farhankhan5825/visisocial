<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | VisiSocial</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">

    <style>
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            line-height: 1.7;
            overflow-x: hidden;
        }

        .contact-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            background:
                radial-gradient(circle at 20% 20%, rgba(99, 102, 241, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.12) 0%, transparent 40%);
            animation: float 25s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(20px, -20px); }
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 4rem 2rem;
        }

        .header {
            text-align: center;
            margin-bottom: 4rem;
            animation: fadeInDown 0.8s ease;
        }

        .header-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            box-shadow: var(--shadow-glow);
        }

        h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 3.2rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--primary-light), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            font-size: 1.2rem;
            color: var(--muted);
        }

        .section {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 2rem;
            transition: all 0.4s ease;
        }

        .section:hover {
            background: var(--glass-hover);
            box-shadow: var(--shadow-glow);
        }

        h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--muted);
            font-weight: 500;
        }

        input, textarea, select {
            width: 100%;
            padding: 0.9rem 1rem;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
            background: rgba(2, 6, 23, 0.6);
            color: var(--light);
            font-size: 1rem;
            margin-bottom: 1.5rem;
        }

        textarea {
            resize: vertical;
            min-height: 140px;
        }

        button {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.9rem 2rem;
            border-radius: 999px;
            border: none;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: var(--shadow-glow);
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        button:hover {
            transform: translateY(-2px);
            opacity: 0.95;
        }

        .contact-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .card {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
        }

        .card i {
            font-size: 1.8rem;
            color: var(--primary-light);
            margin-bottom: 1rem;
        }

        .card p {
            color: var(--muted);
            font-size: 0.95rem;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 768px) {
            h1 { font-size: 2.4rem; }
            .container { padding: 2rem 1.5rem; }
        }
    </style>
</head>

<body>
    <%- include('./partials/navbar') %>

    <div class="contact-bg"></div>

    <div class="container">
        <header class="header">
            <div class="header-icon">
                <i class="fas fa-envelope"></i>
            </div>
            <h1>Contact Us</h1>
            <p class="subtitle">
                Have a question, feedback, or need help? We’d love to hear from you.
            </p>
        </header>

        <section class="section">
            <h2>Send Us a Message</h2>

            <form method="POST" action="/contact">
                <label for="name">Full Name</label>
                <input id="name" name="name" type="text" required>

                <label for="email">Email Address</label>
                <input id="email" name="email" type="email" required>

                <label for="subject">Subject</label>
                <select id="subject" name="subject" required>
                    <option value="">Select a topic</option>
                    <option value="support">Technical Support</option>
                    <option value="billing">Billing</option>
                    <option value="privacy">Privacy & Data</option>
                    <option value="feedback">Feedback</option>
                    <option value="other">Other</option>
                </select>

                <label for="message">Message</label>
                <textarea id="message" name="message" required></textarea>

                <button type="submit">
                    <i class="fas fa-paper-plane"></i>
                    Send Message
                </button>
            </form>
        </section>

        <section class="section">
            <h2>Other Ways to Reach Us</h2>

            <div class="contact-cards">
                <div class="card">
                    <i class="fas fa-headset"></i>
                    <p><strong>Support</strong><br>support@visisocial.com</p>
                </div>

                <div class="card">
                    <i class="fas fa-scale-balanced"></i>
                    <p><strong>Legal</strong><br>legal@visisocial.com</p>
                </div>

                <div class="card">
                    <i class="fas fa-clock"></i>
                    <p><strong>Response Time</strong><br>Within 24–48 hours</p>
                </div>
            </div>
        </section>
    </div>

    <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
        // Reserved for future enhancements (analytics / validation)
    </script>
    <%- include('partials/footer') %>
</body>
</html>
