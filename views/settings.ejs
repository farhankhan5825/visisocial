<!-- views/settings.ejs -->
<!DOCTYPE html>
<html lang="en" data-bs-theme="<%= user.settings?.display?.theme || 'dark' %>">
<head>
  <meta charset="utf-8">
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Manage your VisiSocial settings and preferences">
  
  <!-- Favicon -->
  <link href="/img/favicon.ico" rel="icon">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/stylesheets/visisocial.css" rel="stylesheet">
  
  <!-- Styles -->
  <link href="/stylesheets/bootstrap.min.css" rel="stylesheet">
  <link href="/stylesheets/styles.css" rel="stylesheet">
  
  <!-- Additional Styles for Settings -->
  <style>
    :root {
      --primary: #7c6cff;
      --primary-light: #9d7bff;
      --secondary: #9d7bff;
      --success: #2dd4a8;
      --warning: #f6b24a;
      --danger: #ff5d6c;
      --dark: #0a0a16;
      --darker: #06060e;
      --light: #ECECF6;
      --muted: #9a9ab6;
      --glass: rgba(255, 255, 255, 0.03);
      --glass-hover: rgba(255, 255, 255, 0.06);
      --glass-border: rgba(255,255,255,0.09);
    }
    
    body {
      font-family: 'Inter', sans-serif;
      background: var(--darker);
      color: var(--light);
      min-height: 100vh;
    }
    
    .settings-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    
    /* Settings Header */
    .settings-header {
      margin-bottom: 3rem;
      text-align: center;
    }
    
    .settings-header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .settings-header p {
      color: var(--muted);
      font-size: 1.1rem;
    }
    
    /* Settings Layout */
    .settings-layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 2rem;
      min-height: 600px;
    }
    
    /* Sidebar */
    .settings-sidebar {
      background: var(--glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 1.5rem;
      height: fit-content;
      position: sticky;
      top: 2rem;
    }
    
    .settings-nav {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    .settings-nav-item {
      margin-bottom: 0.5rem;
    }
    
    .settings-nav-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      color: var(--muted);
      text-decoration: none;
      border-radius: 12px;
      transition: all 0.3s ease;
    }
    
    .settings-nav-link:hover,
    .settings-nav-link.active {
      background: var(--glass-hover);
      color: var(--light);
    }
    
    .settings-nav-link.active {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
    }
    
    .settings-nav-link i {
      width: 20px;
      text-align: center;
    }
    
    /* Settings Content */
    .settings-content {
      background: var(--glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 2rem;
    }
    
    .settings-section {
      display: none;
    }
    
    .settings-section.active {
      display: block;
      animation: fadeIn 0.3s ease;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .section-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--glass-border);
    }
    
    .section-header h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    
    .section-header p {
      color: var(--muted);
      margin: 0;
    }
    
    /* Settings Cards */
    .settings-card {
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }
    
    .settings-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }
    
    .settings-card-header h3 {
      font-size: 1.2rem;
      font-weight: 600;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    
    .settings-card-header i {
      color: var(--primary-light);
    }
    
    /* Form Controls */
    .form-group {
      margin-bottom: 1.5rem;
    }
    
    .form-label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      color: var(--light);
    }
    
    .form-text {
      display: block;
      margin-top: 0.25rem;
      font-size: 0.875rem;
      color: var(--muted);
    }
    
    .form-control,
    .form-select {
      background: rgba(2, 6, 23, 0.5);
      border: 1px solid var(--glass-border);
      color: var(--light);
      border-radius: 12px;
      padding: 0.75rem 1rem;
      width: 100%;
      transition: all 0.3s ease;
    }
    
    .form-control:focus,
    .form-select:focus {
      background: rgba(2, 6, 23, 0.7);
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
      color: var(--light);
    }
    
    /* Switch */
    .form-check {
      display: flex;
      align-items: center;
      margin-bottom: 1rem;
      padding-left: 0;
    }
    
    .form-check-input {
      width: 3rem;
      height: 1.5rem;
      margin-right: 0.75rem;
      background-color: var(--glass);
      border: 1px solid var(--glass-border);
    }
    
    .form-check-input:checked {
      background-color: var(--primary);
      border-color: var(--primary);
    }
    
    .form-check-label {
      color: var(--light);
      font-weight: 500;
      flex: 1;
    }
    
    /* Radio & Checkbox Groups */
    .radio-group,
    .checkbox-group {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    
    .radio-option,
    .checkbox-option {
      flex: 1;
      min-width: 200px;
    }
    
    .option-card {
      background: rgba(2, 6, 23, 0.5);
      border: 2px solid var(--glass-border);
      border-radius: 12px;
      padding: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .option-card:hover {
      border-color: var(--primary-light);
      background: rgba(99, 102, 241, 0.1);
    }
    
    .option-card.selected {
      border-color: var(--primary);
      background: rgba(99, 102, 241, 0.15);
    }
    
    .option-card input {
      display: none;
    }
    
    .option-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }
    
    .option-card-header h4 {
      font-size: 1rem;
      font-weight: 600;
      margin: 0;
    }
    
    .option-card-body p {
      font-size: 0.875rem;
      color: var(--muted);
      margin: 0;
    }
    
    /* Action Buttons */
    .settings-actions {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--glass-border);
    }
    
    .btn-settings {
      padding: 0.75rem 1.5rem;
      border-radius: 12px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.3s ease;
      border: none;
    }
    
    .btn-settings-primary {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
    }
    
    .btn-settings-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
    }
    
    .btn-settings-secondary {
      background: var(--glass);
      border: 1px solid var(--glass-border);
      color: var(--light);
    }
    
    .btn-settings-secondary:hover {
      background: var(--glass-hover);
      transform: translateY(-2px);
    }
    
    /* Permission Badges */
    .permission-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(139, 92, 246, 0.1);
      border: 1px solid rgba(139, 92, 246, 0.3);
      border-radius: 20px;
      font-size: 0.875rem;
    }
    
    .permission-badge.granted {
      background: rgba(34, 197, 94, 0.1);
      border-color: rgba(34, 197, 94, 0.3);
    }
    
    .permission-badge.revoked {
      background: rgba(239, 68, 68, 0.1);
      border-color: rgba(239, 68, 68, 0.3);
    }
    
    /* Toast Messages */
    .toast-container {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 9999;
    }
    
    .toast {
      background: var(--dark);
      border: 1px solid var(--glass-border);
      border-radius: 12px;
      padding: 1rem;
      margin-bottom: 1rem;
      min-width: 300px;
      animation: slideIn 0.3s ease;
    }
    
    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    
    .toast.success {
      border-left: 4px solid var(--success);
    }
    
    .toast.error {
      border-left: 4px solid var(--danger);
    }
    
    .toast.warning {
      border-left: 4px solid var(--warning);
    }
    
    /* Responsive */
    @media (max-width: 992px) {
      .settings-layout {
        grid-template-columns: 1fr;
      }
      
      .settings-sidebar {
        position: static;
        margin-bottom: 1.5rem;
      }
    }
    
    @media (max-width: 768px) {
      .settings-container {
        padding: 1rem;
      }
      
      .settings-content {
        padding: 1.5rem;
      }
      
      .radio-group,
      .checkbox-group {
        flex-direction: column;
      }
      
      .option-card {
        min-width: 100%;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/navbar') %>
  <!-- Settings Container -->
  <div class="settings-container">
    <div class="settings-header">
      <h1>Settings</h1>
      <p>Customize your VisiSocial experience and manage your preferences</p>
    </div>

    <div class="settings-layout">
      <!-- Sidebar -->
      <div class="settings-sidebar">
        <ul class="settings-nav">
          <li class="settings-nav-item">
            <a href="#general" class="settings-nav-link <%= activeTab === 'general' ? 'active' : '' %>" data-tab="general">
              <i class="fas fa-sliders-h"></i>
              <span>General</span>
            </a>
          </li>
          <li class="settings-nav-item">
            <a href="#privacy" class="settings-nav-link <%= activeTab === 'privacy' ? 'active' : '' %>" data-tab="privacy">
              <i class="fas fa-shield-alt"></i>
              <span>Privacy & Security</span>
            </a>
          </li>
          <li class="settings-nav-item">
            <a href="#notifications" class="settings-nav-link <%= activeTab === 'notifications' ? 'active' : '' %>" data-tab="notifications">
              <i class="fas fa-bell"></i>
              <span>Notifications</span>
            </a>
          </li>
          <li class="settings-nav-item">
            <a href="#analysis" class="settings-nav-link <%= activeTab === 'analysis' ? 'active' : '' %>" data-tab="analysis">
              <i class="fas fa-chart-line"></i>
              <span>Analysis Settings</span>
            </a>
          </li>
          <li class="settings-nav-item">
            <a href="#display" class="settings-nav-link <%= activeTab === 'display' ? 'active' : '' %>" data-tab="display">
              <i class="fas fa-palette"></i>
              <span>Display</span>
            </a>
          </li>
          <li class="settings-nav-item">
            <a href="#facebook" class="settings-nav-link <%= activeTab === 'facebook' ? 'active' : '' %>" data-tab="facebook">
              <i class="fab fa-facebook"></i>
              <span>Facebook Integration</span>
            </a>
          </li>
          <li class="settings-nav-item">
            <a href="#export" class="settings-nav-link <%= activeTab === 'export' ? 'active' : '' %>" data-tab="export">
              <i class="fas fa-download"></i>
              <span>Data & Export</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Content -->
      <div class="settings-content">
        <!-- Toast Messages -->
        <% if (success) { %>
          <div class="toast success" id="successToast">
            <div class="d-flex align-items-center">
              <i class="fas fa-check-circle text-success me-2"></i>
              <div><%= success %></div>
              <button type="button" class="btn-close btn-close-white ms-auto" onclick="this.parentElement.parentElement.remove()"></button>
            </div>
          </div>
        <% } %>
        
        <% if (error) { %>
          <div class="toast error" id="errorToast">
            <div class="d-flex align-items-center">
              <i class="fas fa-exclamation-circle text-danger me-2"></i>
              <div><%= error %></div>
              <button type="button" class="btn-close btn-close-white ms-auto" onclick="this.parentElement.parentElement.remove()"></button>
            </div>
          </div>
        <% } %>

        <!-- General Settings -->
        <div class="settings-section <%= activeTab === 'general' ? 'active' : '' %>" id="generalSection">
          <div class="section-header">
            <h2><i class="fas fa-sliders-h"></i> General Settings</h2>
            <p>Manage your account and basic preferences</p>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-user-cog"></i> Account Preferences</h3>
            </div>
            
            <div class="form-group">
              <label class="form-label">Language</label>
              <select class="form-select" id="languagePreference">
                <option value="auto" <%= user.settings?.analysis?.languagePreference === 'auto' ? 'selected' : '' %>>Auto-detect</option>
                <% languages.forEach(lang => { %>
                  <option value="<%= lang.code %>" <%= user.settings?.analysis?.languagePreference === lang.code ? 'selected' : '' %>>
                    <%= lang.flag %> <%= lang.name %>
                  </option>
                <% }) %>
              </select>
              <div class="form-text">Language used for analysis and interface</div>
            </div>

            <div class="form-group">
              <label class="form-label">Timezone</label>
              <select class="form-select" id="timezone">
                <option value="auto" selected>Auto-detect</option>
                <option value="UTC">UTC</option>
                <option value="America/New_York">Eastern Time (ET)</option>
                <option value="America/Chicago">Central Time (CT)</option>
                <option value="America/Denver">Mountain Time (MT)</option>
                <option value="America/Los_Angeles">Pacific Time (PT)</option>
                <option value="Europe/London">London</option>
                <option value="Europe/Paris">Paris</option>
                <option value="Asia/Tokyo">Tokyo</option>
              </select>
            </div>
          </div>

          <div class="settings-actions">
            <button class="btn btn-settings btn-settings-primary" onclick="saveSettings('general')">
              <i class="fas fa-save"></i> Save Changes
            </button>
            <button class="btn btn-settings btn-settings-secondary" onclick="resetSettings('general')">
              <i class="fas fa-undo"></i> Reset Section
            </button>
          </div>
        </div>

        <!-- Privacy & Security -->
        <div class="settings-section <%= activeTab === 'privacy' ? 'active' : '' %>" id="privacySection">
          <div class="section-header">
            <h2><i class="fas fa-shield-alt"></i> Privacy & Security</h2>
            <p>Control your data privacy and security settings</p>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-lock"></i> Privacy Settings</h3>
            </div>
            
            <div class="form-group">
              <label class="form-label">Profile Visibility</label>
              <div class="radio-group">
                <div class="radio-option">
                  <label class="option-card <%= user.settings?.privacy?.profileVisibility === 'private' ? 'selected' : '' %>">
                    <input type="radio" name="profileVisibility" value="private" 
                           <%= user.settings?.privacy?.profileVisibility === 'private' ? 'checked' : '' %>>
                    <div class="option-card-header">
                      <h4><i class="fas fa-user-lock"></i> Private</h4>
                    </div>
                    <div class="option-card-body">
                      <p>Only you can see your profile and analysis</p>
                    </div>
                  </label>
                </div>
                
                <div class="radio-option">
                  <label class="option-card <%= user.settings?.privacy?.profileVisibility === 'friends' ? 'selected' : '' %>">
                    <input type="radio" name="profileVisibility" value="friends" 
                           <%= user.settings?.privacy?.profileVisibility === 'friends' ? 'checked' : '' %>>
                    <div class="option-card-header">
                      <h4><i class="fas fa-user-friends"></i> Friends Only</h4>
                    </div>
                    <div class="option-card-body">
                      <p>Share with friends you connect with</p>
                    </div>
                  </label>
                </div>
                
                <div class="radio-option">
                  <label class="option-card <%= user.settings?.privacy?.profileVisibility === 'public' ? 'selected' : '' %>">
                    <input type="radio" name="profileVisibility" value="public" 
                           <%= user.settings?.privacy?.profileVisibility === 'public' ? 'checked' : '' %>>
                    <div class="option-card-header">
                      <h4><i class="fas fa-globe"></i> Public</h4>
                    </div>
                    <div class="option-card-body">
                      <p>Anyone can see your profile (anonymized)</p>
                    </div>
                  </label>
                </div>
              </div>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="allowDataCollection" 
                     <%= user.settings?.privacy?.allowDataCollection ? 'checked' : '' %>>
              <label class="form-check-label" for="allowDataCollection">
                Allow data collection for analysis
                <div class="form-text">Enable to improve your analysis accuracy</div>
              </label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="anonymizeData" 
                     <%= user.settings?.privacy?.anonymizeData ? 'checked' : '' %>>
              <label class="form-check-label" for="anonymizeData">
                Anonymize personal data
                <div class="form-text">Remove personally identifiable information</div>
              </label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="shareInsights" 
                     <%= user.settings?.privacy?.shareInsights ? 'checked' : '' %>>
              <label class="form-check-label" for="shareInsights">
                Share anonymous insights
                <div class="form-text">Help improve the platform (anonymous)</div>
              </label>
            </div>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-key"></i> Security Settings</h3>
            </div>
            
            <div class="form-group">
              <label class="form-label">Session Timeout</label>
              <select class="form-select" id="sessionTimeout">
                <% sessionOptions.forEach(option => { %>
                  <option value="<%= option.value %>" 
                          <%= user.settings?.security?.sessionTimeout === option.value ? 'selected' : '' %>>
                    <%= option.label %>
                  </option>
                <% }) %>
              </select>
              <div class="form-text">Automatically log out after inactivity</div>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="loginAlerts" 
                     <%= user.settings?.security?.loginAlerts ? 'checked' : '' %>>
              <label class="form-check-label" for="loginAlerts">
                Login alerts
                <div class="form-text">Get notified of new login attempts</div>
              </label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="twoFactorAuth" 
                     <%= user.settings?.security?.twoFactorAuth ? 'checked' : '' %>>
              <label class="form-check-label" for="twoFactorAuth">
                Two-factor authentication
                <div class="form-text">Add an extra layer of security</div>
              </label>
            </div>

            <div class="form-group mt-4">
              <label class="form-label">Data Retention</label>
              <select class="form-select" id="dataRetention">
                <% retentionOptions.forEach(option => { %>
                  <option value="<%= option.value %>" 
                          <%= user.settings?.security?.dataRetention === option.value ? 'selected' : '' %>>
                    <%= option.label %>
                    <span class="text-muted"> - <%= option.description %></span>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="settings-actions">
            <button class="btn btn-settings btn-settings-primary" onclick="saveSettings('privacy')">
              <i class="fas fa-save"></i> Save Changes
            </button>
            <button class="btn btn-settings btn-settings-secondary" onclick="resetSettings('privacy')">
              <i class="fas fa-undo"></i> Reset Section
            </button>
          </div>
        </div>

        <!-- Notifications -->
        <div class="settings-section <%= activeTab === 'notifications' ? 'active' : '' %>" id="notificationsSection">
          <div class="section-header">
            <h2><i class="fas fa-bell"></i> Notifications</h2>
            <p>Configure how and when you receive notifications</p>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-envelope"></i> Email Notifications</h3>
            </div>
            
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="emailAlerts" 
                     <%= user.settings?.notifications?.emailAlerts ? 'checked' : '' %>>
              <label class="form-check-label" for="emailAlerts">
                Email alerts
                <div class="form-text">Important updates and security alerts</div>
              </label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="analysisUpdates" 
                     <%= user.settings?.notifications?.analysisUpdates ? 'checked' : '' %>>
              <label class="form-check-label" for="analysisUpdates">
                Analysis updates
                <div class="form-text">When your personality analysis is updated</div>
              </label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="weeklyDigest" 
                     <%= user.settings?.notifications?.weeklyDigest ? 'checked' : '' %>>
              <label class="form-check-label" for="weeklyDigest">
                Weekly digest
                <div class="form-text">Summary of your weekly insights</div>
              </label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="marketingEmails" 
                     <%= user.settings?.notifications?.marketingEmails ? 'checked' : '' %>>
              <label class="form-check-label" for="marketingEmails">
                Marketing emails
                <div class="form-text">Product updates and new features</div>
              </label>
            </div>
          </div>

          <div class="settings-actions">
            <button class="btn btn-settings btn-settings-primary" onclick="saveSettings('notifications')">
              <i class="fas fa-save"></i> Save Changes
            </button>
            <button class="btn btn-settings btn-settings-secondary" onclick="resetSettings('notifications')">
              <i class="fas fa-undo"></i> Reset Section
            </button>
          </div>
        </div>

        <!-- Analysis Settings -->
        <div class="settings-section <%= activeTab === 'analysis' ? 'active' : '' %>" id="analysisSection">
          <div class="section-header">
            <h2><i class="fas fa-chart-line"></i> Analysis Settings</h2>
            <p>Configure how your data is analyzed</p>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-sync-alt"></i> Analysis Frequency</h3>
            </div>
            
            <div class="form-group">
              <label class="form-label">Refresh Analysis</label>
              <div class="radio-group">
                <% refreshOptions.forEach(option => { %>
                  <div class="radio-option">
                    <label class="option-card <%= user.settings?.analysis?.refreshFrequency === option.value ? 'selected' : '' %>">
                      <input type="radio" name="refreshFrequency" value="<%= option.value %>" 
                             <%= user.settings?.analysis?.refreshFrequency === option.value ? 'checked' : '' %>>
                      <div class="option-card-header">
                        <h4><%= option.label %></h4>
                      </div>
                      <div class="option-card-body">
                        <p><%= option.description %></p>
                      </div>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-image"></i> Image Processing</h3>
            </div>
            
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="includeImages" 
                     <%= user.settings?.analysis?.includeImages ? 'checked' : '' %>>
              <label class="form-check-label" for="includeImages">
                Analyze images for text
                <div class="form-text">Extract and analyze text from your photos</div>
              </label>
            </div>

            <div class="form-group mt-3">
              <label class="form-label">Maximum Images to Process</label>
              <input type="range" class="form-range" id="maxImageProcessing" 
                     min="5" max="50" step="5" 
                     value="<%= user.settings?.analysis?.maxImageProcessing || 25 %>">
              <div class="d-flex justify-content-between">
                <small>5 images</small>
                <small id="imageCount"><%= user.settings?.analysis?.maxImageProcessing || 25 %> images</small>
                <small>50 images</small>
              </div>
            </div>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-cogs"></i> Advanced Settings</h3>
            </div>
            
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="detailedReports" 
                     <%= user.settings?.analysis?.detailedReports ? 'checked' : '' %>>
              <label class="form-check-label" for="detailedReports">
                Detailed analysis reports
                <div class="form-text">Include comprehensive insights in reports</div>
              </label>
            </div>
          </div>

          <div class="settings-actions">
            <button class="btn btn-settings btn-settings-primary" onclick="saveSettings('analysis')">
              <i class="fas fa-save"></i> Save Changes
            </button>
            <button class="btn btn-settings btn-settings-secondary" onclick="resetSettings('analysis')">
              <i class="fas fa-undo"></i> Reset Section
            </button>
          </div>
        </div>

        <!-- Display Settings -->
        <div class="settings-section <%= activeTab === 'display' ? 'active' : '' %>" id="displaySection">
          <div class="section-header">
            <h2><i class="fas fa-palette"></i> Display Settings</h2>
            <p>Customize the look and feel of the application</p>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-paint-brush"></i> Theme & Appearance</h3>
            </div>
            
            <div class="form-group">
              <label class="form-label">Theme</label>
              <div class="radio-group">
                <% themes.forEach(theme => { %>
                  <div class="radio-option">
                    <label class="option-card <%= user.settings?.display?.theme === theme.id ? 'selected' : '' %>">
                      <input type="radio" name="theme" value="<%= theme.id %>" 
                             <%= user.settings?.display?.theme === theme.id ? 'checked' : '' %>>
                      <div class="option-card-header">
                        <h4><i class="<%= theme.icon %>"></i> <%= theme.name %></h4>
                      </div>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Font Size</label>
              <select class="form-select" id="fontSize">
                <% fontSizeOptions.forEach(option => { %>
                  <option value="<%= option.value %>" 
                          <%= user.settings?.display?.fontSize === option.value ? 'selected' : '' %>>
                    <%= option.label %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="compactMode" 
                     <%= user.settings?.display?.compactMode ? 'checked' : '' %>>
              <label class="form-check-label" for="compactMode">
                Compact mode
                <div class="form-text">Reduce spacing for more content</div>
              </label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="animations" 
                     <%= user.settings?.display?.animations ? 'checked' : '' %>>
              <label class="form-check-label" for="animations">
                Animations
                <div class="form-text">Enable interface animations</div>
              </label>
            </div>
          </div>

          <div class="settings-actions">
            <button class="btn btn-settings btn-settings-primary" onclick="saveSettings('display')">
              <i class="fas fa-save"></i> Save Changes
            </button>
            <button class="btn btn-settings btn-settings-secondary" onclick="resetSettings('display')">
              <i class="fas fa-undo"></i> Reset Section
            </button>
          </div>
        </div>

        <!-- Facebook Integration -->
        <div class="settings-section <%= activeTab === 'facebook' ? 'active' : '' %>" id="facebookSection">
          <div class="section-header">
            <h2><i class="fab fa-facebook"></i> Facebook Integration</h2>
            <p>Manage your Facebook connection and permissions</p>
          </div>

          <% if (facebookTokenInfo.isValid) { %>
            <div class="settings-card">
              <div class="settings-card-header">
                <h3><i class="fas fa-link"></i> Connection Status</h3>
              </div>
              
              <div class="row mb-3">
                <div class="col-md-6">
                  <p><strong>Status:</strong> <span class="text-success">Connected</span></p>
                  <p><strong>App ID:</strong> <%= facebookTokenInfo.appId %></p>
                  <p><strong>User ID:</strong> <%= facebookTokenInfo.userId %></p>
                </div>
                <div class="col-md-6">
                  <p><strong>Token Issued:</strong> <%= facebookTokenInfo.issuedAt.toLocaleDateString() %></p>
                  <p><strong>Token Expires:</strong> <%= facebookTokenInfo.expiresAt === 'Never' ? 'Never' : facebookTokenInfo.expiresAt.toLocaleDateString() %></p>
                </div>
              </div>
            </div>

            <% if (facebookPermissions.length > 0) { %>
              <div class="settings-card">
                <div class="settings-card-header">
                  <h3><i class="fas fa-key"></i> Granted Permissions</h3>
                </div>
                
                <div class="permissions-list">
                  <% facebookPermissions.forEach(perm => { %>
                    <div class="permission-badge <%= perm.status === 'granted' ? 'granted' : 'revoked' %> mb-2 me-2">
                      <i class="fas fa-<%= perm.status === 'granted' ? 'check' : 'times' %>"></i>
                      <%= perm.permission %>
                      <% if (perm.status === 'granted') { %>
                        <button class="btn btn-sm btn-outline-danger ms-2" 
                                onclick="revokePermission('<%= perm.permission %>')">
                          Revoke
                        </button>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
                
                <div class="mt-3">
                  <a href="https://www.facebook.com/settings?tab=applications" 
                     target="_blank" 
                     class="btn btn-outline-primary">
                    <i class="fab fa-facebook me-2"></i> Manage on Facebook
                  </a>
                </div>
              </div>
            <% } %>
            
            <div class="alert alert-info mt-3">
              <i class="fas fa-info-circle me-2"></i>
              To disconnect completely, please visit Facebook's App Settings page.
            </div>
            
          <% } else { %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              Facebook connection is not active. Please reconnect to use Facebook features.
            </div>
            
            <div class="text-center mt-4">
              <a href="/auth/facebook" class="btn btn-primary btn-lg">
                <i class="fab fa-facebook me-2"></i> Connect Facebook Account
              </a>
            </div>
          <% } %>
        </div>

        <!-- Data & Export -->
        <div class="settings-section <%= activeTab === 'export' ? 'active' : '' %>" id="exportSection">
          <div class="section-header">
            <h2><i class="fas fa-download"></i> Data & Export</h2>
            <p>Manage your data export and backup settings</p>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-cloud-upload-alt"></i> Auto Backup</h3>
            </div>
            
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="autoBackup" 
                     <%= user.settings?.export?.autoBackup ? 'checked' : '' %>>
              <label class="form-check-label" for="autoBackup">
                Enable automatic backups
                <div class="form-text">Regularly backup your analysis data</div>
              </label>
            </div>

            <div class="form-group mt-3">
              <label class="form-label">Backup Frequency</label>
              <select class="form-select" id="backupFrequency" <%= !user.settings?.export?.autoBackup ? 'disabled' : '' %>>
                <option value="weekly" <%= user.settings?.export?.backupFrequency === 'weekly' ? 'selected' : '' %>>Weekly</option>
                <option value="monthly" <%= user.settings?.export?.backupFrequency === 'monthly' ? 'selected' : '' %>>Monthly</option>
                <option value="quarterly" <%= user.settings?.export?.backupFrequency === 'quarterly' ? 'selected' : '' %>>Quarterly</option>
              </select>
            </div>

            <div class="form-check mt-3">
              <input class="form-check-input" type="checkbox" id="includeRawData" 
                     <%= user.settings?.export?.includeRawData ? 'checked' : '' %>>
              <label class="form-check-label" for="includeRawData">
                Include raw data in backups
                <div class="form-text">Store original data along with analysis</div>
              </label>
            </div>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-file-export"></i> Export Settings</h3>
            </div>
            
            <div class="form-group">
              <label class="form-label">Default Export Format</label>
              <div class="radio-group">
                <% exportFormatOptions.forEach(option => { %>
                  <div class="radio-option">
                    <label class="option-card <%= user.settings?.export?.format === option.value ? 'selected' : '' %>">
                      <input type="radio" name="exportFormat" value="<%= option.value %>" 
                             <%= user.settings?.export?.format === option.value ? 'checked' : '' %>>
                      <div class="option-card-header">
                        <h4><i class="<%= option.icon %>"></i> <%= option.label %></h4>
                      </div>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="settings-card">
            <div class="settings-card-header">
              <h3><i class="fas fa-database"></i> Data Management</h3>
            </div>
            
            <div class="row">
              <div class="col-md-6 mb-3">
                <button class="btn btn-outline-primary w-100" onclick="exportSettings()">
                  <i class="fas fa-download me-2"></i> Export Settings
                </button>
              </div>
              <div class="col-md-6 mb-3">
                <button class="btn btn-outline-secondary w-100" onclick="importSettings()">
                  <i class="fas fa-upload me-2"></i> Import Settings
                </button>
              </div>
            </div>
            
            <div class="mt-3">
              <button class="btn btn-outline-danger w-100" onclick="clearAnalysisData()">
                <i class="fas fa-trash me-2"></i> Clear Analysis Data
              </button>
              <div class="form-text text-center mt-1">This will remove all your analysis data but keep your account</div>
            </div>
            
            <!-- Hidden file input for import -->
            <input type="file" id="settingsFileInput" accept=".json" style="display: none;">
          </div>

          <div class="settings-actions">
            <button class="btn btn-settings btn-settings-primary" onclick="saveSettings('export')">
              <i class="fas fa-save"></i> Save Changes
            </button>
            <button class="btn btn-settings btn-settings-secondary" onclick="resetSettings('export')">
              <i class="fas fa-undo"></i> Reset Section
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <script nonce="<%= nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      // Tab Navigation
      document.querySelectorAll('.settings-nav-link').forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          const tab = this.getAttribute('data-tab');
          
          // Update active tab in URL without reload
          history.replaceState(null, '', `/settings?tab=${tab}`);
          
          // Update active nav link
          document.querySelectorAll('.settings-nav-link').forEach(l => {
            l.classList.remove('active');
          });
          this.classList.add('active');
          
          // Show corresponding section
          document.querySelectorAll('.settings-section').forEach(section => {
            section.classList.remove('active');
          });
          document.getElementById(`${tab}Section`).classList.add('active');
        });
      });
      
      // Initialize from URL parameter
      const urlParams = new URLSearchParams(window.location.search);
      const activeTab = urlParams.get('tab') || 'general';
      const tabLink = document.querySelector(`.settings-nav-link[data-tab="${activeTab}"]`);
      if (tabLink) {
        tabLink.click();
      }
      
      // Image count display
      const imageRange = document.getElementById('maxImageProcessing');
      const imageCount = document.getElementById('imageCount');
      if (imageRange && imageCount) {
        imageRange.addEventListener('input', function() {
          imageCount.textContent = `${this.value} images`;
        });
      }
      
      // Auto backup toggle
      const autoBackup = document.getElementById('autoBackup');
      const backupFrequency = document.getElementById('backupFrequency');
      if (autoBackup && backupFrequency) {
        autoBackup.addEventListener('change', function() {
          backupFrequency.disabled = !this.checked;
        });
      }
      
      // Option card selection
      document.querySelectorAll('.option-card').forEach(card => {
        card.addEventListener('click', function() {
          const input = this.querySelector('input');
          if (input) {
            input.checked = true;
            
            // Update visual selection
            this.parentElement.parentElement.querySelectorAll('.option-card').forEach(c => {
              c.classList.remove('selected');
            });
            this.classList.add('selected');
          }
        });
      });
      
      // Remove toast messages after 5 seconds
      setTimeout(() => {
        document.querySelectorAll('.toast').forEach(toast => {
          toast.remove();
        });
      }, 5000);
    });
    
    // Save settings
    async function saveSettings(section) {
      try {
        let settings = {};
        
        switch(section) {
          case 'general':
            settings = {
              languagePreference: document.getElementById('languagePreference').value,
              timezone: document.getElementById('timezone').value
            };
            break;
            
          case 'privacy':
            settings = {
              profileVisibility: document.querySelector('input[name="profileVisibility"]:checked')?.value || 'private',
              allowDataCollection: document.getElementById('allowDataCollection').checked,
              anonymizeData: document.getElementById('anonymizeData').checked,
              shareInsights: document.getElementById('shareInsights').checked,
              sessionTimeout: parseInt(document.getElementById('sessionTimeout').value),
              loginAlerts: document.getElementById('loginAlerts').checked,
              twoFactorAuth: document.getElementById('twoFactorAuth').checked,
              dataRetention: document.getElementById('dataRetention').value
            };
            break;
            
          case 'notifications':
            settings = {
              emailAlerts: document.getElementById('emailAlerts').checked,
              analysisUpdates: document.getElementById('analysisUpdates').checked,
              weeklyDigest: document.getElementById('weeklyDigest').checked,
              marketingEmails: document.getElementById('marketingEmails').checked
            };
            break;
            
          case 'analysis':
            settings = {
              refreshFrequency: document.querySelector('input[name="refreshFrequency"]:checked')?.value || 'weekly',
              includeImages: document.getElementById('includeImages').checked,
              maxImageProcessing: parseInt(document.getElementById('maxImageProcessing').value),
              detailedReports: document.getElementById('detailedReports').checked
            };
            break;
            
          case 'display':
            const theme = document.querySelector('input[name="theme"]:checked')?.value || 'dark';
            settings = {
              theme: theme,
              fontSize: document.getElementById('fontSize').value,
              compactMode: document.getElementById('compactMode').checked,
              animations: document.getElementById('animations').checked
            };
            // Apply theme immediately
            document.documentElement.setAttribute('data-bs-theme', theme);
            break;
            
          case 'export':
            settings = {
              autoBackup: document.getElementById('autoBackup').checked,
              backupFrequency: document.getElementById('backupFrequency').value,
              includeRawData: document.getElementById('includeRawData').checked,
              format: document.querySelector('input[name="exportFormat"]:checked')?.value || 'both'
            };
            break;
        }
        
        const response = await fetch('/settings/update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ section, settings })
        });
        
        if (response.ok) {
          showToast('Settings saved successfully!', 'success');
        } else {
          throw new Error('Failed to save settings');
        }
      } catch (error) {
        console.error('Error saving settings:', error);
        showToast('Error saving settings. Please try again.', 'error');
      }
    }
    
    // Reset settings
    async function resetSettings(section) {
      if (!confirm(`Are you sure you want to reset ${section} settings to defaults?`)) {
        return;
      }
      
      try {
        const response = await fetch('/settings/reset', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ section })
        });
        
        if (response.ok) {
          showToast('Settings reset successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          throw new Error('Failed to reset settings');
        }
      } catch (error) {
        console.error('Error resetting settings:', error);
        showToast('Error resetting settings. Please try again.', 'error');
      }
    }
    
    // Export settings
    async function exportSettings() {
      try {
        const response = await fetch('/settings/export');
        if (response.ok) {
          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `visisocial-settings-${new Date().toISOString().split('T')[0]}.json`;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          window.URL.revokeObjectURL(url);
          
          showToast('Settings exported successfully!', 'success');
        } else {
          throw new Error('Export failed');
        }
      } catch (error) {
        console.error('Error exporting settings:', error);
        showToast('Error exporting settings. Please try again.', 'error');
      }
    }
    
    // Import settings
    function importSettings() {
      document.getElementById('settingsFileInput').click();
    }
    
    // Handle file selection for import
    document.getElementById('settingsFileInput')?.addEventListener('change', async function(e) {
      const file = e.target.files[0];
      if (!file) return;
      
      if (!file.name.endsWith('.json')) {
        showToast('Please select a JSON file', 'error');
        return;
      }
      
      if (!confirm('Importing settings will overwrite your current settings. Continue?')) {
        this.value = '';
        return;
      }
      
      const formData = new FormData();
      formData.append('settingsFile', file);
      
      try {
        const response = await fetch('/settings/import', {
          method: 'POST',
          body: formData
        });
        
        if (response.ok) {
          showToast('Settings imported successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          const error = await response.json();
          throw new Error(error.message || 'Import failed');
        }
      } catch (error) {
        console.error('Error importing settings:', error);
        showToast(`Error importing settings: ${error.message}`, 'error');
      } finally {
        this.value = '';
      }
    });
    
    // Revoke Facebook permission
    async function revokePermission(permission) {
      if (!confirm(`Revoke permission: ${permission}?`)) {
        return;
      }
      
      try {
        const response = await fetch('/settings/facebook/revoke', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ permission })
        });
        
        if (response.ok) {
          showToast('Permission revoked successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          throw new Error('Failed to revoke permission');
        }
      } catch (error) {
        console.error('Error revoking permission:', error);
        showToast('Error revoking permission. Please try again.', 'error');
      }
    }
    
    // Clear analysis data
    async function clearAnalysisData() {
      if (!confirm('This will delete all your analysis data. This action cannot be undone. Continue?')) {
        return;
      }
      
      try {
        const response = await fetch('/api/analysis/clear', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        if (response.ok) {
          showToast('Analysis data cleared successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          throw new Error('Failed to clear data');
        }
      } catch (error) {
        console.error('Error clearing data:', error);
        showToast('Error clearing data. Please try again.', 'error');
      }
    }
    
    // Show toast message
    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      toast.className = `toast ${type}`;
      toast.innerHTML = `
        <div class="d-flex align-items-center">
          <i class="fas fa-${type === 'success' ? 'check' : type === 'error' ? 'exclamation' : 'info'}-circle 
                   text-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'} me-2"></i>
          <div>${message}</div>
          <button type="button" class="btn-close btn-close-white ms-auto" onclick="this.parentElement.parentElement.remove()"></button>
        </div>
      `;
      
      const container = document.querySelector('.settings-content');
      container.insertBefore(toast, container.firstChild);
      
      setTimeout(() => toast.remove(), 5000);
    }
  </script>
    <%- include('partials/footer') %>
</body>
</html>