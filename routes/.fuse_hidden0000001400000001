/**
 * Optimize image buffer or file using Sharp
 */
async function optimizeImage(input) {
  try {
    const inputBuffer = Buffer.isBuffer(input) ? input : await fs.readFile(input);
    const metadata = await sharp(inputBuffer).metadata();
    
    const width = Math.min(metadata.width || 1920, 1920);
    const height = Math.min(metadata.height || 1080, 1080);
    
    const optimizedBuffer = await sharp(inputBuffer)
      .resize({ width, height, fit: 'inside', withoutEnlargement: true })
      .rotate()
      .toFormat('jpeg', { quality: 80, progressive: true, optimizeCoding: true, mozjpeg: true })
      .toBuffer();
    
    logger.debug(`Image optimized: ${inputBuffer.length} → ${optimizedBuffer.length} bytes`);
    return optimizedBuffer;
  } catch (error) {
    logger.error(`Image optimization error: ${error.message}`);
    return Buffer.isBuffer(input) ? input : await fs.readFile(input);
  }
}

/**
 * Process album data with enhanced OCR
 */
async function handleAlbumsData(userId, albums, taskId = null, forceReprocess = false) {
  const startTime = Date.now();
  metrics.increment('image_processing.started');
  
  if (!userId || !albums || !Array.isArray(albums)) {
    logger.error('Invalid parameters for handleAlbumsData');
    metrics.increment('image_processing.error.invalid_params');
    return;
  }

  let totalImages = 0;
  albums.forEach(album => totalImages += (album.photos?.data?.length || 0));

  if (totalImages === 0) {
    logger.info("No images found to process");
    metrics.increment('image_processing.no_images');
    return;
  }

  logger.info(`Starting OCR processing for ${Math.min(totalImages, MAX_TOTAL_IMAGES)} images`);

  try {
    const user = await User.findOne({ id: userId });
    if (!user) {
      logger.error(`User ${userId} not found`);
      metrics.increment('image_processing.error.user_not_found');
      return;
    }

    if (!user.feedData) user.feedData = [];
    if (!user.processedAlbums) user.processedAlbums = [];

    const processedAlbumIds = new Set(user.processedAlbums.map(album => album.id));
    const userLanguages = detectUserLanguages(user);
    logger.info(`Using language codes for OCR: ${userLanguages}`);

    let totalProcessedImages = 0;
    let totalSuccessfulImages = 0;

    for (const album of albums) {
      if (!forceReprocess && processedAlbumIds.has(album.id)) {
        logger.info(`Skipping already processed album: ${album.name || 'Unnamed'}`);
        continue;
      }
      
      const albumPhotos = album.photos?.data || [];
      const imageData = [];
      
      for (let i = 0; i < albumPhotos.length && totalProcessedImages < MAX_TOTAL_IMAGES; i++) {
        const photo = albumPhotos[i];
        const imageUrl = photo.images?.[0]?.source;
        
        if (imageUrl) {
          imageData.push({
            url: imageUrl,
            photoId: photo.id,
            albumId: album.id,
            albumName: album.name || 'Unnamed'
          });
          totalProcessedImages++;
        }
        
        if (totalProcessedImages >= MAX_TOTAL_IMAGES) {
          logger.info(`Reached limit of ${MAX_TOTAL_IMAGES} images`);
          break;
        }
      }

      if (imageData.length === 0) continue;

      logger.info(`Processing ${imageData.length} images from album: ${album.name || 'Unnamed'}`);

      const imageUrls = imageData.map(img => img.url);
      const ocrResults = await batchExtractText(imageUrls, userLanguages, MAX_CONCURRENT_OCR_TASKS);

      const processedResults = ocrResults
        .map((result, index) => {
          if (!result || !result.text || result.text.length < 3 || result.confidence < 60) {
            return null;
          }

          totalSuccessfulImages++;

          return {
            text: result.text,
            confidence: result.confidence,
            wordCount: result.wordCount,
            language: result.language,
            method: result.method,
            source: 'image',
            imageUrl: imageData[index].url,
            photoId: imageData[index].photoId,
            albumId: imageData[index].albumId,
            albumName: imageData[index].albumName,
            processedAt: new Date()
          };
        })
        .filter(result => result !== null);

      if (processedResults.length > 0) {
        user.feedData.push(...processedResults);
        
        user.processedAlbums.push({
          id: album.id,
          name: album.name,
          processedAt: new Date(),
          processedPhotos: processedResults.length,
          totalPhotos: imageData.length,
          averageConfidence: processedResults.reduce((sum, r) => sum + r.confidence, 0) / processedResults.length,
          methods: {
            google_vision: processedResults.filter(r => r.method === 'google_vision').length,
            tesseract: processedResults.filter(r => r.method === 'tesseract').length
          }
        });
        
        await user.save();
        logger.info(`Saved ${processedResults.length} text entries from album: ${album.name || 'Unnamed'}`);
      }

      if (totalProcessedImages >= MAX_TOTAL_IMAGES) break;
      await new Promise(resolve => setTimeout(resolve, 1000));
    }

    const processingTime = Date.now() - startTime;
    const successRate = totalProcessedImages > 0 ? (totalSuccessfulImages / totalProcessedImages) * 100 : 0;
    
    metrics.timing('image_processing.duration', processingTime);
    metrics.increment('image_processing.completed');
    metrics.gauge('image_processing.success_rate', successRate);
    
    logger.info(`OCR processing complete: ${totalSuccessfulImages}/${totalProcessedImages} successful (${successRate.toFixed(1)}%)`);
  } catch (error) {
    metrics.increment('image_processing.error');
    logger.error(`Error processing albums: ${error.message}`);
    throw error;
  }
}

/**
 * Detect user languages for OCR
 */
function detectUserLanguages(user) {
  const languages = new Set(['eng']);
  
  if (user.languages && Array.isArray(user.languages)) {
    const langMap = {
      'English': 'eng', 'Spanish': 'spa', 'French': 'fra', 'German': 'deu',
      'Italian': 'ita', 'Portuguese': 'por', 'Chinese': 'chi_sim', 'Japanese': 'jpn',
      'Korean': 'kor', 'Arabic': 'ara', 'Russian': 'rus', 'Hindi': 'hin'
    };
    
    user.languages.forEach(lang => {
      const code = langMap[lang.name || lang];
      if (code) languages.add(code);
    });
  }
  
  if (user.location?.name) {
    const location = user.location.name.toLowerCase();
    if (location.includes('spain') || location.includes('mexico')) languages.add('spa');
    else if (location.includes('france')) languages.add('fra');
    else if (location.includes('germany')) languages.add('deu');
    else if (location.includes('italy')) languages.add('ita');
    else if (location.includes('brazil')) languages.add('por');
    else if (location.includes('china')) languages.add('chi_sim');
    else if (location.includes('japan')) languages.add('jpn');
    else if (location.includes('korea')) languages.add('kor');
  }
  
  return Array.from(languages).slice(0, 3).join('+');
}

