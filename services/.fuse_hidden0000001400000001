// ==================== QUERY GENERATORS ====================

class QueryGenerator {
  static generateEmailQueries(email) {
    const [username, domain] = email.split('@');
    
    return [
      `"${email}"`,
      `"${email}" -site:${domain}`,
      `${email} filetype:pdf`,
      `${email} filetype:doc`,
      `site:pastebin.com "${email}"`,
      `site:github.com "${email}"`,
      `site:linkedin.com "${email}"`,
      `site:twitter.com "${email}"`,
      `"${email}" (password OR breach OR leak OR dump)`,
      `"${email}" (resume OR CV OR "curriculum vitae")`,
      `"${username}" @${domain}`,
      `site:gitlab.com "${email}"`,
      `site:reddit.com "${email}"`,
      `site:stackoverflow.com "${email}"`,
      `intitle:"index of" "${email}"`,
    ];
  }
  
  static generateNameQueries(name) {
    const nameParts = name.split(' ').filter(Boolean);
    const firstName = nameParts[0];
    const lastName = nameParts[nameParts.length - 1];
    
    return [
      `"${name}"`,
      `"${name}" (LinkedIn OR resume OR CV)`,
      `"${name}" (CEO OR founder OR director OR manager)`,
      `"${name}" (developer OR engineer OR designer)`,
      `site:linkedin.com/in "${name}"`,
      `site:twitter.com "${name}"`,
      `site:instagram.com "${name}"`,
      `"${name}" (published OR author OR researcher)`,
      `"${firstName} ${lastName}"`,
      `site:scholar.google.com "${name}"`,
      `"${name}" filetype:pdf`,
    ];
  }
  
  static generateUsernameQueries(username) {
    return [
      `"${username}"`,
      `site:twitter.com "${username}"`,
      `site:instagram.com "${username}"`,
      `site:reddit.com/user "${username}"`,
      `site:github.com "${username}"`,
      `"@${username}"`,
      `site:twitch.tv "${username}"`,
      `site:medium.com/@${username}`,
    ];
  }
  
  static generatePhoneQueries(phone) {
    const normalized = phone.replace(/\D/g, '');
    const formats = [
      phone,
      normalized,
      `+${normalized}`,
      `(${normalized.slice(0,3)}) ${normalized.slice(3,6)}-${normalized.slice(6)}`,
    ];
    
    const queries = [];
    formats.forEach(format => {
      queries.push(
        `"${format}"`,
        `"${format}" (contact OR "phone number")`,
      );
    });
    
    return queries;
  }
}

// ==================== SEARCH ENGINES ====================

class SearchEngineAPI {
  /**
   * Google Custom Search (Primary search engine)
   */
  static async googleSearch(query, options = {}) {
    if (!SEARCH_CONFIG.GOOGLE_CSE_API_KEY || !SEARCH_CONFIG.GOOGLE_CSE_ID) {
      logger.warn('Google CSE not configured');
      return [];
    }
    
    try {
      const response = await axios.get('https://www.googleapis.com/customsearch/v1', {
        params: {
          key: SEARCH_CONFIG.GOOGLE_CSE_API_KEY,
          cx: SEARCH_CONFIG.GOOGLE_CSE_ID,
          q: query,
          num: options.num || 10,
          start: options.start || 1,
          ...options
        },
        timeout: SEARCH_CONFIG.TIMEOUT
      });
      
      return (response.data.items || []).map(item => ({
        title: item.title,
        url: item.link,
        snippet: item.snippet,
        source: 'google',
        displayLink: item.displayLink,
        thumbnail: item.pagemap?.cse_thumbnail?.[0]?.src,
        timestamp: new Date()
      }));
    } catch (error) {
      logger.error(`Google search error: ${error.message}`);
      metrics.increment('search.google.errors');
      return [];
    }
  }
  
  /**
   * DuckDuckGo (Privacy-focused fallback)
   */
  static async duckDuckGoSearch(query) {
    try {
      const response = await axios.get('https://api.duckduckgo.com/', {
        params: {
          q: query,
          format: 'json',
          no_html: 1,
          skip_disambig: 1
        },
        timeout: SEARCH_CONFIG.TIMEOUT
      });
      
      const results = [];
      
      if (response.data.Abstract) {
        results.push({
          title: response.data.Heading || 'DuckDuckGo Result',
          url: response.data.AbstractURL,
          snippet: response.data.Abstract,
          source: 'duckduckgo',
          timestamp: new Date()
        });
      }
      
      (response.data.RelatedTopics || []).forEach(topic => {
        if (topic.FirstURL) {
          results.push({
            title: topic.Text?.split(' - ')[0] || 'Related Topic',
            url: topic.FirstURL,
            snippet: topic.Text,
            source: 'duckduckgo',
            timestamp: new Date()
          });
        }
      });
      
      return results;
    } catch (error) {
      logger.error(`DuckDuckGo search error: ${error.message}`);
      return [];
    }
  }
}

