/**
 * Advanced retry mechanism with exponential backoff
 */
async function retryableRequest(requestFn, maxRetries = MAX_RETRY_ATTEMPTS, context = {}) {
  let lastError;
  
  for (let attempt = 0; attempt < maxRetries; attempt++) {
    try {
      return await requestFn();
    } catch (error) {
      lastError = error;
      
      // Don't retry client errors (4xx)
      if (error.response?.status >= 400 && error.response?.status < 500) {
        throw error;
      }
      
      // Exponential backoff with jitter
      const delay = BACKOFF_DELAY * Math.pow(2, attempt) + Math.random() * 1000;
      logger.info(`Request failed, retrying in ${delay}ms (attempt ${attempt + 1}/${maxRetries})`, context);
      await new Promise(resolve => setTimeout(resolve, delay));
    }
  }
  
  throw lastError;
}

