{
  "name": "visisocial-backend",
  "version": "2.0.0",
  "description": "Advanced Social Media Analytics Platform - Personality insights powered by AI",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "nodemon --ignore data/ --ignore logs/ --ignore temp/ --ignore uploads/ index.js",
    "dev": "NODE_ENV=development nodemon --ignore data/ --ignore logs/ --ignore temp/ --ignore uploads/ index.js",
    "prod": "NODE_ENV=production node index.js",
    "serve": "node index.js",
    "debug": "NODE_ENV=development node --inspect index.js",
    "lint": "eslint .",
    "test": "jest --coverage",
    "clean": "rm -rf temp/* logs/* data/metrics.json",
    "clean:win": "if exist temp rd /s /q temp && if exist logs rd /s /q logs"
  },
  "keywords": [
    "social-media",
    "analytics",
    "personality",
    "facebook",
    "ai",
    "openai",
    "sentiment-analysis",
    "ocr"
  ],
  "author": "VisiSocial Team",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/vision": "^4.3.3",
    "archiver": "^7.0.1",
    "axios": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dompurify": "^3.2.5",
    "dotenv": "^16.4.5",
    "ejs-mate": "^4.0.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.1",
    "express-minify": "^1.0.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.17.3",
    "express-useragent": "^1.0.15",
    "helmet": "^8.0.0",
    "html-pdf-node": "^1.0.8",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.6.1",
    "jsdom": "^26.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
    "mongoose": "^7.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "natural": "^6.7.2",
    "node-cron": "^4.0.5",
    "openai": "^4.68.1",
    "passport": "^0.6.0",
    "passport-facebook": "^3.0.0",
    "puppeteer": "^24.34.0",
    "redis": "^5.0.1",
    "response-time": "^2.3.4",
    "sentiment": "^5.0.2",
    "serve-index": "^1.9.1",
    "sharp": "^0.34.1",
    "socket.io": "^4.8.1",
    "tesseract.js": "^4.1.4",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
