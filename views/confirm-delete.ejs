<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Account Deletion | VisiSocial</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    
    <style nonce="<%= nonce %>">
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
            --shadow-soft: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            line-height: 1.7;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .danger-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: 
                radial-gradient(circle at 20% 20%, rgba(239, 68, 68, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, rgba(220, 38, 38, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.1) 0%, transparent 60%);
            animation: dangerPulse 10s ease-in-out infinite;
        }

        @keyframes dangerPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 4rem 2rem;
            flex: 1;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--primary-light);
            text-decoration: none;
            font-weight: 500;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
        }

        .back-link:hover {
            gap: 0.75rem;
        }

        .delete-container {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(239, 68, 68, 0.3);
            border-radius: 32px;
            padding: 3rem;
            box-shadow: var(--shadow-glow);
            animation: slideUp 0.5s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .danger-icon {
            width: 100px;
            height: 100px;
            margin: 0 auto 2rem;
            background: linear-gradient(135deg, var(--danger) 0%, #dc2626 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
            animation: shake 2s ease-in-out infinite;
            box-shadow: 0 0 60px rgba(239, 68, 68, 0.5);
        }

        @keyframes shake {
            0%, 100% { transform: rotate(0deg); }
            10%, 30%, 50%, 70%, 90% { transform: rotate(-10deg); }
            20%, 40%, 60%, 80% { transform: rotate(10deg); }
        }

        .delete-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .delete-title {
            font-family: 'Poppins', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--danger);
            margin-bottom: 1rem;
        }

        .delete-subtitle {
            font-size: 1.2rem;
            color: var(--muted);
            max-width: 600px;
            margin: 0 auto;
        }

        .warning-banner {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.15) 100%);
            border: 2px solid rgba(239, 68, 68, 0.4);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            animation: glow 3s ease-in-out infinite;
        }

        @keyframes glow {
            0%, 100% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.3); }
            50% { box-shadow: 0 0 40px rgba(239, 68, 68, 0.6); }
        }

        .warning-banner h3 {
            color: #fca5a5;
            font-weight: 700;
            font-size: 1.3rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .warning-banner h3 i {
            font-size: 1.5rem;
        }

        .warning-banner p {
            color: var(--light);
            font-size: 1rem;
            line-height: 1.8;
        }

        .data-loss-section {
            margin-bottom: 2.5rem;
        }

        .data-loss-section h3 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--light);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .data-loss-section h3 i {
            color: var(--danger);
        }

        .data-items {
            display: grid;
            gap: 1rem;
        }

        .data-item {
            background: rgba(2, 6, 23, 0.5);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s ease;
        }

        .data-item:hover {
            background: rgba(2, 6, 23, 0.7);
            border-color: rgba(239, 68, 68, 0.4);
            transform: translateX(8px);
        }

        .data-item i {
            font-size: 1.5rem;
            color: var(--danger);
            width: 30px;
            text-align: center;
        }

        .data-item-content {
            flex: 1;
        }

        .data-item-title {
            font-weight: 600;
            color: var(--light);
            margin-bottom: 0.25rem;
        }

        .data-item-description {
            font-size: 0.9rem;
            color: var(--muted);
        }

        .confirmation-section {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .confirmation-section h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--light);
            margin-bottom: 1.5rem;
        }

        .confirmation-input-wrapper {
            margin-bottom: 1.5rem;
        }

        .confirmation-label {
            display: block;
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
            color: var(--muted);
        }

        .confirmation-label strong {
            color: var(--danger);
            font-weight: 700;
        }

        .confirmation-input {
            width: 100%;
            padding: 1rem 1.5rem;
            background: rgba(2, 6, 23, 0.6);
            border: 2px solid var(--glass-border);
            border-radius: 12px;
            color: var(--light);
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .confirmation-input:focus {
            outline: none;
            border-color: var(--danger);
            background: rgba(2, 6, 23, 0.8);
        }

        .confirmation-input::placeholder {
            color: var(--muted);
            font-weight: 400;
            letter-spacing: 0;
        }

        .confirmation-input.valid {
            border-color: var(--success);
        }

        .confirmation-input.invalid {
            border-color: var(--danger);
        }

        .countdown-notice {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .countdown-notice i {
            color: var(--warning);
            font-size: 1.5rem;
        }

        .countdown-notice p {
            color: var(--light);
            font-size: 0.95rem;
        }

        .action-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn {
            padding: 1.25rem 2rem;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

        .btn-cancel {
            background: var(--glass);
            border: 2px solid var(--glass-border);
            color: var(--light);
        }

        .btn-cancel:hover {
            background: var(--glass-hover);
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .btn-delete {
            background: linear-gradient(135deg, var(--danger) 0%, #dc2626 100%);
            color: white;
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-delete.enabled {
            opacity: 1;
            cursor: pointer;
        }

        .btn-delete.enabled:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 40px rgba(239, 68, 68, 0.4);
        }

        .btn-delete:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
            padding: 1.5rem;
            background: rgba(2, 6, 23, 0.3);
            border-radius: 12px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 900;
            color: var(--danger);
            margin-bottom: 0.25rem;
        }

        .stat-label {
            font-size: 0.85rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .safety-tip {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%);
            border: 1px solid rgba(34, 197, 94, 0.3);
            border-radius: 12px;
            padding: 1.5rem;
            margin-top: 2rem;
        }

        .safety-tip h4 {
            color: var(--success);
            font-weight: 700;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .safety-tip p {
            color: var(--muted);
            font-size: 0.95rem;
        }

        @media (max-width: 768px) {
            .container {
                padding: 2rem 1.5rem;
            }

            .delete-container {
                padding: 2rem;
            }

            .delete-title {
                font-size: 2rem;
            }

            .action-buttons {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 480px) {
            .danger-icon {
                width: 80px;
                height: 80px;
                font-size: 2.5rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="danger-bg"></div>
    <%- include('partials/navbar') %>

    <div class="container">
        <a href="/profile" class="back-link">
            <i class="fas fa-arrow-left"></i>
            Back to Profile
        </a>

        <div class="delete-container">
            <div class="delete-header">
                <div class="danger-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h1 class="delete-title">Are You Absolutely Sure?</h1>
                <p class="delete-subtitle">
                    This action cannot be undone. This will permanently delete your account and remove all your data from our servers.
                </p>
            </div>

            <div class="warning-banner">
                <h3>
                    <i class="fas fa-radiation"></i>
                    PERMANENT DATA LOSS WARNING
                </h3>
                <p>
                    Once you delete your account, there is <strong>no going back</strong>. 
                    All your data will be <strong>immediately and permanently deleted</strong> from our servers. 
                    We cannot recover your account or any associated data after deletion.
                </p>
            </div>

            <div class="data-loss-section">
                <h3>
                    <i class="fas fa-trash-alt"></i>
                    What Will Be Deleted Forever
                </h3>

                <div class="data-items">
                    <div class="data-item">
                        <i class="fas fa-user-circle"></i>
                        <div class="data-item-content">
                            <div class="data-item-title">Your Profile</div>
                            <div class="data-item-description">Account information, settings, and preferences</div>
                        </div>
                    </div>

                    <div class="data-item">
                        <i class="fas fa-search"></i>
                        <div class="data-item-content">
                            <div class="data-item-title">All OSINT Searches</div>
                            <div class="data-item-description">Internet searches, breach checks, and AI-generated profiles</div>
                        </div>
                    </div>

                    <div class="data-item">
                        <i class="fas fa-brain"></i>
                        <div class="data-item-content">
                            <div class="data-item-title">AI Analysis Results</div>
                            <div class="data-item-description">Generated profiles, image analysis, and intelligence reports</div>
                        </div>
                    </div>

                    <div class="data-item">
                        <i class="fas fa-database"></i>
                        <div class="data-item-content">
                            <div class="data-item-title">Search History</div>
                            <div class="data-item-description">All past searches and their results</div>
                        </div>
                    </div>

                    <div class="data-item">
                        <i class="fas fa-chart-line"></i>
                        <div class="data-item-content">
                            <div class="data-item-title">Statistics & Analytics</div>
                            <div class="data-item-description">Usage data, risk scores, and performance metrics</div>
                        </div>
                    </div>

                    <div class="data-item">
                        <i class="fas fa-key"></i>
                        <div class="data-item-content">
                            <div class="data-item-title">API Keys & Integrations</div>
                            <div class="data-item-description">All configured API keys and service connections</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-value"><%= stats?.totalSearches || 0 %></div>
                    <div class="stat-label">Searches to Delete</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value"><%= stats?.criticalFindings || 0 %></div>
                    <div class="stat-label">Critical Findings</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value"><%= stats?.totalResults || 0 %></div>
                    <div class="stat-label">Total Results</div>
                </div>
            </div>

            <form action="/profile/delete" method="POST" id="deleteForm">
                <div class="confirmation-section">
                    <h3>Type DELETE to confirm</h3>
                    
                    <div class="confirmation-input-wrapper">
                        <label class="confirmation-label">
                            Please type <strong>DELETE</strong> to confirm this action
                        </label>
                        <input 
                            type="text" 
                            id="confirmationInput" 
                            class="confirmation-input" 
                            placeholder="Type DELETE here"
                            autocomplete="off"
                            required
                        >
                    </div>

                    <div class="countdown-notice">
                        <i class="fas fa-clock"></i>
                        <p>
                            After clicking delete, your account will be <strong>immediately and permanently deleted</strong>. 
                            This process cannot be stopped once initiated.
                        </p>
                    </div>
                </div>

                <div class="action-buttons">
                    <a href="/profile" class="btn btn-cancel">
                        <i class="fas fa-shield-alt"></i>
                        <span>No, Keep My Account</span>
                    </a>
                    <button type="submit" class="btn btn-delete" id="deleteButton" disabled>
                        <i class="fas fa-trash-alt"></i>
                        <span>Yes, Delete Everything</span>
                    </button>
                </div>
            </form>

            <div class="safety-tip">
                <h4>
                    <i class="fas fa-lightbulb"></i>
                    Need a break instead?
                </h4>
                <p>
                    If you're concerned about privacy or security, you can export your data 
                    or temporarily deactivate features instead of permanently deleting your account. 
                    Contact support for assistance.
                </p>
            </div>
        </div>
    </div>

    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', function() {
            const confirmationInput = document.getElementById('confirmationInput');
            const deleteButton = document.getElementById('deleteButton');
            const deleteForm = document.getElementById('deleteForm');
            
            // Enable delete button only when "DELETE" is typed
            confirmationInput.addEventListener('input', function() {
                const value = this.value.trim();
                
                if (value === 'DELETE') {
                    this.classList.remove('invalid');
                    this.classList.add('valid');
                    deleteButton.disabled = false;
                    deleteButton.classList.add('enabled');
                } else {
                    this.classList.remove('valid');
                    if (value.length > 0) {
                        this.classList.add('invalid');
                    } else {
                        this.classList.remove('invalid');
                    }
                    deleteButton.disabled = true;
                    deleteButton.classList.remove('enabled');
                }
            });

            // Final confirmation before submission
            deleteForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                if (confirmationInput.value.trim() !== 'DELETE') {
                    alert('Please type DELETE to confirm account deletion');
                    return;
                }
                
                const finalConfirm = confirm(
                    '🚨 FINAL WARNING 🚨\n\n' +
                    'This will PERMANENTLY DELETE your account and ALL data.\n\n' +
                    'This action CANNOT be undone.\n\n' +
                    'Are you 100% sure you want to proceed?'
                );
                
                if (finalConfirm) {
                    // Disable button to prevent double submission
                    deleteButton.disabled = true;
                    deleteButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Deleting...</span>';
                    
                    // Submit the form
                    this.submit();
                }
            });

            // Prevent accidental page close
            window.addEventListener('beforeunload', function(e) {
                if (confirmationInput.value.length > 0) {
                    e.preventDefault();
                    e.returnValue = '';
                    return '';
                }
            });
        });
    </script>
    <%- include('partials/footer') %>
</body>
</html>