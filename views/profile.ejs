<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.name %> | Profile | VisiSocial</title>
  <meta name="description" content="View and manage your VisiSocial profile and personality insights">
  <meta name="author" content="VisiSocial Team">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/stylesheets/visisocial.css" rel="stylesheet">
  
  <!-- Styles -->
  <link href="/stylesheets/bootstrap.min.css" rel="stylesheet">
  <link href="/stylesheets/styles.css" rel="stylesheet">
  
  <style>
    :root {
      --primary: #7c6cff;
      --primary-dark: #5b4fe0;
      --primary-light: #9d7bff;
      --secondary: #9d7bff;
      --accent: #34e3ff;
      --accent-2: #10b981;
      --warning: #f6b24a;
      --danger: #ff5d6c;
      --dark: #0a0a16;
      --darker: #06060e;
      --light: #ECECF6;
      --muted: #9a9ab6;
      --gradient: linear-gradient(118deg, #9d7bff, #7c6cff 45%, #34e3ff);
      --gradient-2: linear-gradient(135deg, #06b6d4 0%, #10b981 100%);
      --gradient-danger: linear-gradient(135deg, #ff5d6c, #ff8a5d);
      --glass: rgba(255, 255, 255, 0.03);
      --glass-hover: rgba(255, 255, 255, 0.08);
      --glass-border: rgba(255,255,255,0.09);
      --shadow-lg: 0 25px 80px -20px rgba(99, 102, 241, 0.25);
      --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--darker);
      color: var(--light);
      line-height: 1.7;
      min-height: 100vh;
    }
    
    h1, h2, h3, h4, h5, h6 {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    
    /* Animated Background */
    .bg-animated {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      overflow: hidden;
    }
    
    .bg-animated .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.4;
      animation: float 20s ease-in-out infinite;
    }
    
    .bg-animated .orb-1 {
      width: 600px;
      height: 600px;
      background: var(--primary);
      top: -200px;
      right: -200px;
      animation-delay: 0s;
    }
    
    .bg-animated .orb-2 {
      width: 400px;
      height: 400px;
      background: var(--secondary);
      bottom: -100px;
      left: -100px;
      animation-delay: -5s;
    }
    
    .bg-animated .orb-3 {
      width: 300px;
      height: 300px;
      background: var(--accent);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      animation-delay: -10s;
    }
    
    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      25% { transform: translate(50px, -50px) scale(1.1); }
      50% { transform: translate(-30px, 30px) scale(0.9); }
      75% { transform: translate(-50px, -30px) scale(1.05); }
    }
    
    /* Glass Effect */
    .glass-card {
      background: var(--glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .glass-card:hover {
      background: var(--glass-hover);
      transform: translateY(-8px);
      box-shadow: var(--shadow-lg);
      border-color: rgba(255, 255, 255, 0.15);
    }
    
    /* Gradient Text */
    .gradient-text {
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    /* Buttons */
    .btn-gradient {
      background: var(--gradient);
      border: none;
      color: white;
      padding: 14px 36px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      z-index: 1;
    }
    
    .btn-gradient::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #0891b2 100%);
      z-index: -1;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .btn-gradient:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 40px rgba(99, 102, 241, 0.35);
      color: white;
    }
    
    .btn-gradient:hover::before {
      opacity: 1;
    }
    
    .btn-gradient-danger {
      background: var(--gradient-danger);
      border: none;
      color: white;
      padding: 14px 36px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      z-index: 1;
    }
    
    .btn-gradient-danger:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 40px rgba(239, 68, 68, 0.35);
      color: white;
    }
    
    .btn-outline-glow {
      background: transparent;
      border: 2px solid var(--glass-border);
      color: var(--light);
      padding: 12px 32px;
      border-radius: 50px;
      font-weight: 600;
      transition: all 0.3s ease;
    }
    
    .btn-outline-glow:hover {
      border-color: var(--primary);
      color: var(--primary);
      box-shadow: 0 0 30px rgba(99, 102, 241, 0.2);
    }
    
    /* Navbar */
    .navbar-custom {
      background: rgba(2, 6, 23, 0.8);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--glass-border);
      padding: 15px 0;
      transition: all 0.3s ease;
    }
    
    .navbar-custom.scrolled {
      background: rgba(2, 6, 23, 0.95);
      padding: 10px 0;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }
    
    .navbar-brand {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: 1.6rem;
    }
    
    .nav-link {
      color: var(--muted) !important;
      font-weight: 500;
      padding: 8px 20px !important;
      border-radius: 8px;
      transition: all 0.3s ease;
    }
    
    .nav-link:hover, .nav-link.active {
      color: var(--light) !important;
      background: var(--glass);
    }
    
    /* Profile Container */
    .profile-container {
      max-width: 1200px;
      margin: 40px auto;
      padding: 30px;
    }
    
    /* Profile Header */
    .profile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 40px;
      margin-bottom: 40px;
      position: relative;
      overflow: hidden;
    }
    
    .profile-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--gradient);
      opacity: 0.05;
      z-index: -1;
    }
    
    .profile-header-content h1 {
      font-size: 2.5rem;
      margin-bottom: 8px;
    }
    
    .profile-header-content .email {
      color: var(--muted);
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .profile-avatar {
      position: relative;
      width: 160px;
      height: 160px;
    }
    
    .profile-avatar img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--glass-border);
      transition: all 0.3s ease;
    }
    
    .profile-avatar:hover img {
      border-color: var(--primary);
      transform: scale(1.05);
    }
    
    .profile-avatar::before {
      content: '';
      position: absolute;
      inset: -8px;
      border-radius: 50%;
      background: var(--gradient);
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: -1;
    }
    
    .profile-avatar:hover::before {
      opacity: 0.3;
    }
    
    /* Profile Grid */
    .profile-grid {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 30px;
      margin-bottom: 40px;
    }
    
    @media (max-width: 992px) {
      .profile-grid {
        grid-template-columns: 1fr;
      }
    }
    
    /* Profile Sidebar */
    .profile-sidebar {
      position: sticky;
      top: 100px;
      height: fit-content;
    }
    
    .profile-stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    
    .profile-stat {
      text-align: center;
      padding: 20px;
    }
    
    .stat-value {
      font-size: 2rem;
      font-weight: 800;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
      margin-bottom: 8px;
    }
    
    .stat-label {
      font-size: 0.9rem;
      color: var(--muted);
      font-weight: 500;
    }
    
    /* Profile Details */
    .profile-details-section {
      padding: 40px;
    }
    
    .section-title {
      font-size: 1.4rem;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .section-title i {
      color: var(--primary);
    }
    
    .details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }
    
    .detail-item {
      padding: 20px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--glass-border);
      transition: all 0.3s ease;
    }
    
    .detail-item:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(99, 102, 241, 0.3);
    }
    
    .detail-label {
      font-size: 0.85rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .detail-label i {
      color: var(--accent);
      font-size: 0.9rem;
    }
    
    .detail-value {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--light);
    }
    
    .detail-value.none {
      color: var(--muted);
      font-style: italic;
    }
    
    /* Account Actions */
    .account-actions {
      padding: 40px;
      margin-top: 40px;
      position: relative;
      overflow: hidden;
    }
    
    .account-actions::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--gradient-danger);
      opacity: 0.03;
      z-index: -1;
    }
    
    .danger-zone {
      padding: 30px;
      border-radius: 20px;
      background: rgba(239, 68, 68, 0.05);
      border: 1px solid rgba(239, 68, 68, 0.2);
    }
    
    .danger-zone h3 {
      color: #ef4444;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .danger-zone p {
      color: var(--muted);
      margin-bottom: 24px;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    
    /* Back to Top */
    .back-to-top {
      position: fixed;
      bottom: 30px;
      right: 30px;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: var(--gradient);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 1000;
      box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
    }
    
    .back-to-top.visible {
      opacity: 1;
      visibility: visible;
    }
    
    .back-to-top:hover {
      transform: translateY(-5px);
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .profile-header {
        flex-direction: column;
        text-align: center;
        gap: 30px;
      }
      
      .profile-avatar {
        width: 140px;
        height: 140px;
      }
      
      .profile-header-content h1 {
        font-size: 2rem;
      }
      
      .details-grid {
        grid-template-columns: 1fr;
      }
      
      .profile-container {
        padding: 15px;
      }
    }
  </style>
</head>

<body>
  <!-- Animated Background -->
  <div class="bg-animated">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <!-- Navigation -->
  <%- include('partials/navbar') %>

  <div class="profile-container">
    <!-- Profile Header -->
    <div class="glass-card profile-header">
      <div class="profile-header-content">
        <h1><span class="gradient-text"><%= user.name || 'User' %></span></h1>
        <p class="email">
          <i class="fas fa-envelope"></i>
          <%= user.email || 'No email available' %>
        </p>
        <div class="mt-4 d-flex gap-3">
          <a href="/" class="btn-gradient">
            <i class="fas fa-chart-bar me-2"></i>View Dashboard
          </a>
          <a href="/analysis" class="btn-outline-glow">
            <i class="fas fa-sync me-2"></i>Refresh Analysis
          </a>
        </div>
      </div>
      <div class="profile-avatar">
        <img src="<%= user.picture?.data?.url || '/img/default-user.png' %>" alt="<%= user.name %>">
      </div>
    </div>

    <div class="profile-grid">
      <!-- Profile Sidebar -->
      <div class="profile-sidebar">
        <div class="glass-card profile-stats">
          <div class="profile-stat">
            <div class="stat-value"><%= analysisCount || '0' %></div>
            <div class="stat-label">Analyses</div>
          </div>
          <div class="profile-stat">
            <div class="stat-value"><%= daysActive || '1' %></div>
            <div class="stat-label">Days Active</div>
          </div>
          <div class="profile-stat">
            <div class="stat-value"><%= connectedAccounts || '1' %></div>
            <div class="stat-label">Connected Accounts</div>
          </div>
          <div class="profile-stat">
            <div class="stat-value"><%= insightsCount || '0' %></div>
            <div class="stat-label">Insights</div>
          </div>
        </div>

        <div class="glass-card p-4 mb-4">
          <h4 class="mb-3">Account Status</h4>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="badge bg-success rounded-pill">Active</div>
            <span class="text-success">Verified</span>
          </div>
          <p class="text-muted small mb-0">
            Member since <%= joinDate || 'Recently' %>
          </p>
        </div>

        <div class="glass-card p-4">
          <h4 class="mb-3">Quick Actions</h4>
          <div class="d-flex flex-column gap-2">
            <a href="/settings" class="btn btn-outline-glow btn-sm">
              <i class="fas fa-cog me-2"></i>Settings
            </a>
            <a href="/export" class="btn btn-outline-glow btn-sm">
              <i class="fas fa-download me-2"></i>Export Data
            </a>
            <a href="/privacy" class="btn btn-outline-glow btn-sm">
              <i class="fas fa-shield-alt me-2"></i>Privacy
            </a>
          </div>
        </div>
      </div>

      <!-- Profile Details -->
      <div class="glass-card profile-details-section">
        <h2 class="section-title">
          <i class="fas fa-id-card"></i>
          Profile Information
        </h2>

        <div class="details-grid">
          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-user"></i>
              Full Name
            </div>
            <div class="detail-value"><%= user.name || 'N/A' %></div>
          </div>

          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-envelope"></i>
              Email Address
            </div>
            <div class="detail-value"><%= user.email || 'N/A' %></div>
          </div>

          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-birthday-cake"></i>
              Birthday
            </div>
            <div class="detail-value"><%= user.birthday || 'Not provided' %></div>
          </div>

          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-venus-mars"></i>
              Gender
            </div>
            <div class="detail-value"><%= user.gender || 'Not specified' %></div>
          </div>

          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-map-marker-alt"></i>
              Current Location
            </div>
            <div class="detail-value">
              <%= user.location?.name || 'Not specified' %>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-home"></i>
              Hometown
            </div>
            <div class="detail-value">
              <%= user.hometown?.name || 'Not specified' %>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-calendar-alt"></i>
              Age Range
            </div>
            <div class="detail-value">
              <% if (user.age_range?.min) { %>
                <%= user.age_range.min %>+ years
              <% } else { %>
                Not specified
              <% } %>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-label">
              <i class="fas fa-clock"></i>
              Member Since
            </div>
            <div class="detail-value">
              <%= new Date(user.created_at || Date.now()).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Account Actions -->
    <div class="glass-card account-actions">
      <div class="danger-zone">
        <h3><i class="fas fa-exclamation-triangle"></i> Danger Zone</h3>
        <p>
          Deleting your account will permanently remove all your data, including personality analyses,
          connected accounts, and preferences. This action cannot be undone.
        </p>
        <form id="deleteAccountForm" action="/profile/delete" method="POST" onsubmit="return confirmDelete()">
          <button type="submit" class="btn-gradient-danger">
            <i class="fas fa-trash-alt me-2"></i> Delete Account Permanently
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Back to Top -->
  <div class="back-to-top" id="backToTop">
    <i class="fas fa-arrow-up"></i>
  </div>

  <script nonce="<%= nonce %>">
    // Navbar scroll effect
    const navbar = document.querySelector('.navbar-custom');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    });
    
    // Back to top
    const backToTop = document.getElementById('backToTop');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 500) {
        backToTop.classList.add('visible');
      } else {
        backToTop.classList.remove('visible');
      }
    });
    
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    
    // Confirm account deletion
    function confirmDelete() {
      return confirm("⚠️ **Warning: This action is irreversible!**\n\nAre you sure you want to delete your account? All your data will be permanently removed, including:\n• Personality analyses\n• Connected social media accounts\n• All insights and preferences\n\nType 'DELETE' to confirm:");
    }
    
    // Smooth scrolling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
    
    // Add animation to detail items
    document.querySelectorAll('.detail-item').forEach((item, index) => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(20px)';
      
      setTimeout(() => {
        item.style.transition = 'all 0.5s ease';
        item.style.opacity = '1';
        item.style.transform = 'translateY(0)';
      }, index * 100);
    });
  </script>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/footer') %>
</body>
</html>