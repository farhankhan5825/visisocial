<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | VisiSocial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <link href="/stylesheets/visisocial.css" rel="stylesheet">
    <style>
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --facebook: #1877f2;
            --advertiser: #f59e0b;
            --broker: #8b5cf6;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            min-height: 100vh;
        }

        .comparison-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: 
                radial-gradient(circle at 20% 20%, rgba(24, 119, 242, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--facebook) 0%, var(--advertiser) 50%, var(--broker) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            color: var(--muted);
            font-size: 1.2rem;
            margin-bottom: 2rem;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.6;
        }

        .entity-selector {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 3rem;
        }

        .entity-tab {
            padding: 1rem 2rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--muted);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 600;
        }

        .entity-tab:hover {
            background: var(--glass-hover);
            color: var(--light);
        }

        .entity-tab.active {
            background: var(--glass-hover);
            border-color: var(--primary);
            color: var(--light);
        }

        .entity-tab.platform.active {
            border-color: var(--facebook);
        }

        .entity-tab.advertiser.active {
            border-color: var(--advertiser);
        }

        .entity-tab.broker.active {
            border-color: var(--broker);
        }

        .comparison-view {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-bottom: 3rem;
        }

        @media (max-width: 1200px) {
            .comparison-view {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
        }

        .entity-view {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 2.5rem;
            transition: all 0.4s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .entity-view:hover {
            background: var(--glass-hover);
            box-shadow: var(--shadow-glow);
            transform: translateY(-5px);
        }

        .entity-view.platform {
            border-top: 4px solid var(--facebook);
        }

        .entity-view.advertiser {
            border-top: 4px solid var(--advertiser);
        }

        .entity-view.broker {
            border-top: 4px solid var(--broker);
        }

        .entity-header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--glass-border);
        }

        .entity-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
        }

        .entity-icon.platform {
            background: linear-gradient(135deg, var(--facebook) 0%, #42b72a 100%);
        }

        .entity-icon.advertiser {
            background: linear-gradient(135deg, var(--advertiser) 0%, #f97316 100%);
        }

        .entity-icon.broker {
            background: linear-gradient(135deg, var(--broker) 0%, #a855f7 100%);
        }

        .entity-title {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .entity-title.platform { color: #60a5fa; }
        .entity-title.advertiser { color: #fcd34d; }
        .entity-title.broker { color: #a855f7; }

        .entity-subtitle {
            color: var(--muted);
            font-size: 1rem;
        }

        .entity-data {
            flex: 1;
        }

        .data-section {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--light);
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .section-title.platform { color: #60a5fa; }
        .section-title.advertiser { color: #fcd34d; }
        .section-title.broker { color: #a855f7; }

        .data-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .data-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 1rem;
            background: rgba(2, 6, 23, 0.4);
            border-radius: 8px;
        }

        .data-label {
            font-size: 0.9rem;
            color: var(--muted);
        }

        .data-value {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--light);
        }

        .data-value.platform { color: #93c5fd; }
        .data-value.advertiser { color: #fde68a; }
        .data-value.broker { color: #c4b5fd; }

        .nested-list {
            margin-left: 1rem;
            margin-top: 0.5rem;
        }

        .nested-item {
            font-size: 0.85rem;
            color: var(--muted);
            margin-bottom: 0.25rem;
            padding: 0.25rem 0.5rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        .insight-box {
            background: rgba(2, 6, 23, 0.6);
            border-left: 4px solid;
            border-radius: 8px;
            padding: 1.5rem;
            margin-top: 2rem;
        }

        .insight-box.platform {
            border-left-color: var(--facebook);
        }

        .insight-box.advertiser {
            border-left-color: var(--advertiser);
        }

        .insight-box.broker {
            border-left-color: var(--broker);
        }

        .insight-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .insight-title.platform { color: #60a5fa; }
        .insight-title.advertiser { color: #fcd34d; }
        .insight-title.broker { color: #a855f7; }

        .insight-content {
            font-size: 0.9rem;
            color: var(--muted);
            line-height: 1.6;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            padding: 1rem 1.5rem;
            background: var(--glass);
            border-radius: 12px;
        }

        .breadcrumb a {
            color: var(--muted);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .breadcrumb a:hover {
            color: var(--primary-light);
        }

        .breadcrumb .separator {
            color: var(--muted);
        }

        .breadcrumb .current {
            color: var(--primary-light);
            font-weight: 600;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--light);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: var(--glass-hover);
            border-color: var(--primary-light);
        }

        .info-banner {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(6, 182, 212, 0.05) 100%);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 3rem;
            text-align: center;
        }

        .info-banner h3 {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--light);
        }

        .info-banner p {
            color: var(--muted);
            max-width: 800px;
            margin: 0 auto;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .container { padding: 1rem; }
            h1 { font-size: 2rem; }
            .entity-selector { flex-direction: column; }
            .comparison-view { gap: 2rem; }
            .entity-view { padding: 1.5rem; }
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="comparison-bg"></div>

    <div class="container">
        <div class="breadcrumb">
            <a href="/surveillance/dashboard">Surveillance</a>
            <span class="separator">/</span>
            <span class="current">Multi-Entity Views</span>
        </div>

        <div class="page-header">
            <h1>Multi-Entity Intelligence Views</h1>
            <p class="subtitle">
                Different entities see different versions of you. Compare how platforms, advertisers, 
                and data brokers build and use your profile for their specific purposes.
            </p>
        </div>

        <div class="info-banner">
            <h3><i class="fas fa-eye"></i> The Many Faces of Your Data</h3>
            <p>
                Each entity processes your data differently based on their business objectives. 
                While platforms focus on engagement, advertisers seek targeting opportunities, 
                and data brokers build comprehensive shadow profiles for resale.
            </p>
        </div>

        <div class="comparison-view">
            <!-- Platform View -->
            <div class="entity-view platform">
                <div class="entity-header">
                    <div class="entity-icon platform">
                        <i class="fab fa-facebook"></i>
                    </div>
                    <h2 class="entity-title platform">Platform View</h2>
                    <p class="entity-subtitle">What Facebook Sees</p>
                </div>

                <div class="entity-data">
                    <% if (views.platform.data.explicit) { %>
                    <div class="data-section">
                        <h3 class="section-title platform">
                            <i class="fas fa-user-circle"></i>
                            Explicit Data
                        </h3>
                        <div class="data-list">
                            <% for (const [key, value] of Object.entries(views.platform.data.explicit)) { %>
                            <div class="data-item">
                                <span class="data-label"><%= key.replace(/^./, str => str.toUpperCase()) %></span>
                                <span class="data-value platform"><%= value || 'Not provided' %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <% if (views.platform.data.inferred) { %>
                    <div class="data-section">
                        <h3 class="section-title platform">
                            <i class="fas fa-brain"></i>
                            Inferred Traits
                        </h3>
                        <div class="data-list">
                            <% for (const [key, value] of Object.entries(views.platform.data.inferred)) { 
                                if (typeof value === 'object') continue; %>
                            <div class="data-item">
                                <span class="data-label"><%= key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %></span>
                                <span class="data-value platform"><%= value %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <% if (views.platform.data.behavioral) { %>
                    <div class="data-section">
                        <h3 class="section-title platform">
                            <i class="fas fa-chart-line"></i>
                            Behavioral Patterns
                        </h3>
                        <div class="data-list">
                            <% for (const [key, value] of Object.entries(views.platform.data.behavioral)) { 
                                if (typeof value === 'object') continue; %>
                            <div class="data-item">
                                <span class="data-label"><%= key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %></span>
                                <span class="data-value platform"><%= value %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <div class="insight-box platform">
                        <h4 class="insight-title platform">
                            <i class="fas fa-bullseye"></i>
                            Platform Objective
                        </h4>
                        <p class="insight-content">
                            Facebook focuses on maximizing engagement and time spent on platform. 
                            Your data is used to optimize feed ranking, suggest connections, 
                            and keep you returning frequently through personalized content.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Advertiser View -->
            <div class="entity-view advertiser">
                <div class="entity-header">
                    <div class="entity-icon advertiser">
                        <i class="fas fa-ad"></i>
                    </div>
                    <h2 class="entity-title advertiser">Advertiser View</h2>
                    <p class="entity-subtitle">What Advertisers Get</p>
                </div>

                <div class="entity-data">
                    <% if (views.advertiser.data.demographics) { %>
                    <div class="data-section">
                        <h3 class="section-title advertiser">
                            <i class="fas fa-users"></i>
                            Demographics
                        </h3>
                        <div class="data-list">
                            <% for (const [key, value] of Object.entries(views.advertiser.data.demographics)) { %>
                            <div class="data-item">
                                <span class="data-label"><%= key.replace(/^./, str => str.toUpperCase()) %></span>
                                <span class="data-value advertiser"><%= value || 'Unknown' %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <% if (views.advertiser.data.interests) { %>
                    <div class="data-section">
                        <h3 class="section-title advertiser">
                            <i class="fas fa-heart"></i>
                            Interests & Likes
                        </h3>
                        <div class="data-list">
                            <div class="data-item">
                                <span class="data-label">Total Interests</span>
                                <span class="data-value advertiser"><%= views.advertiser.data.interests.length || 0 %></span>
                            </div>
                            <% if (views.advertiser.data.interests.length > 0) { %>
                            <div class="nested-list">
                                <% views.advertiser.data.interests.slice(0, 5).forEach(interest => { %>
                                <div class="nested-item"><%= interest %></div>
                                <% }); %>
                                <% if (views.advertiser.data.interests.length > 5) { %>
                                <div class="nested-item">+ <%= views.advertiser.data.interests.length - 5 %> more</div>
                                <% } %>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <% if (views.advertiser.data.targeting) { %>
                    <div class="data-section">
                        <h3 class="section-title advertiser">
                            <i class="fas fa-crosshairs"></i>
                            Targeting Signals
                        </h3>
                        <div class="data-list">
                            <% for (const [key, value] of Object.entries(views.advertiser.data.targeting)) { 
                                if (typeof value === 'object') continue; %>
                            <div class="data-item">
                                <span class="data-label"><%= key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %></span>
                                <span class="data-value advertiser"><%= typeof value === 'number' ? value + '%' : value %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <div class="insight-box advertiser">
                        <h4 class="insight-title advertiser">
                            <i class="fas fa-shopping-cart"></i>
                            Advertiser Objective
                        </h4>
                        <p class="insight-content">
                            Advertisers see you as a potential customer. They analyze your 
                            interests, demographics, and behaviors to predict purchase intent 
                            and show you relevant ads at optimal times for conversion.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Broker View -->
            <div class="entity-view broker">
                <div class="entity-header">
                    <div class="entity-icon broker">
                        <i class="fas fa-database"></i>
                    </div>
                    <h2 class="entity-title broker">Broker View</h2>
                    <p class="entity-subtitle">What Data Brokers Build</p>
                </div>

                <div class="entity-data">
                    <% if (views.broker.data.crossPlatformId) { %>
                    <div class="data-section">
                        <h3 class="section-title broker">
                            <i class="fas fa-fingerprint"></i>
                            Cross-Platform ID
                        </h3>
                        <div class="data-list">
                            <div class="data-item">
                                <span class="data-label">Aggregated ID</span>
                                <span class="data-value broker"><%= views.broker.data.crossPlatformId %></span>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <% if (views.broker.data.offlineData) { %>
                    <div class="data-section">
                        <h3 class="section-title broker">
                            <i class="fas fa-store"></i>
                            Offline Data Sources
                        </h3>
                        <div class="data-list">
                            <div class="data-item">
                                <span class="data-label">Integrated Sources</span>
                                <span class="data-value broker">Multiple</span>
                            </div>
                            <div class="nested-list">
                                <%= views.broker.data.offlineData.split(', ').map(item => `<div class="nested-item">${item}</div>`).join('') %>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <% if (views.broker.data.predictive) { %>
                    <div class="data-section">
                        <h3 class="section-title broker">
                            <i class="fas fa-crystal-ball"></i>
                            Predictive Analytics
                        </h3>
                        <div class="data-list">
                            <% for (const [key, value] of Object.entries(views.broker.data.predictive)) { 
                                if (typeof value === 'object') continue; %>
                            <div class="data-item">
                                <span class="data-label"><%= key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %></span>
                                <span class="data-value broker"><%= typeof value === 'number' && key.includes('Value') ? value : typeof value === 'number' ? value + '%' : value %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <div class="insight-box broker">
                        <h4 class="insight-title broker">
                            <i class="fas fa-chart-network"></i>
                            Broker Objective
                        </h4>
                        <p class="insight-content">
                            Data brokers create comprehensive shadow profiles by combining 
                            online and offline data. They sell these profiles to various 
                            entities for risk assessment, marketing, and analytics purposes.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <a href="/surveillance/dashboard" class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

    <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
        document.addEventListener('DOMContentLoaded', function() {
            // Entity tab switching
            const tabs = document.querySelectorAll('.entity-tab');
            const views = document.querySelectorAll('.entity-view');
            
            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    const entityType = this.dataset.entity;
                    
                    // Update active tab
                    tabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Scroll to corresponding view
                    const targetView = document.querySelector(`.entity-view.${entityType}`);
                    if (targetView) {
                        targetView.scrollIntoView({ 
                            behavior: 'smooth', 
                            block: 'start' 
                        });
                    }
                });
            });
        });
    </script>
    <%- include('../partials/footer') %>
</body>
</html>