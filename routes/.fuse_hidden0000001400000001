/**
 * Language detection with fallback
 */
function detectLanguage(text) {
  try {
    if (natural.LanguageDetect) {
      const detector = new natural.LanguageDetect();
      const detections = detector.detect(text, 2);
      if (detections.length && detections[0][1] > 0.3) {
        return detections[0][0];
      }
    }
    
    const englishRatio = text.split(/\s+/).filter(word => /^[a-zA-Z]+$/.test(word)).length / text.split(/\s+/).length;
    return englishRatio > 0.5 ? 'english' : 'unknown';
  } catch (error) {
    logger.error(`Language detection error: ${error.message}`);
    return 'unknown';
  }
}

/**
 * Enhanced text preprocessing with multilingual support
 */
function preprocessText(text, language = 'english') {
  if (!text || typeof text !== 'string') return [];
  
  if (language === 'auto') {
    language = detectLanguage(text);
  }
  
  const normalizedText = text
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^\w\s]/g, ' ')
    .toLowerCase();
  
  const tokenizer = new natural.WordTokenizer();
  let tokens = tokenizer.tokenize(normalizedText);
  
  if (language === 'english' && natural.PorterStemmer) {
    tokens = tokens.map(token => natural.PorterStemmer.stem(token));
  } else if (language === 'spanish' && natural.PorterStemmerEs) {
    tokens = tokens.map(token => natural.PorterStemmerEs.stem(token));
  }
  
  return tokens.filter(token => 
    !comprehensiveStopwords.includes(token) && 
    token.length > 2 &&
    !/^\d+$/.test(token)
  );
}

/**
 * Calculate text similarity using cosine similarity
 */
function calculateTextSimilarity(text1, text2) {
  try {
    const tokens1 = preprocessText(text1);
    const tokens2 = preprocessText(text2);
    
    const freqMap1 = tokens1.reduce((map, token) => {
      map[token] = (map[token] || 0) + 1;
      return map;
    }, {});
    
    const freqMap2 = tokens2.reduce((map, token) => {
      map[token] = (map[token] || 0) + 1;
      return map;
    }, {});
    
    const uniqueWords = [...new Set([...tokens1, ...tokens2])];
    const vector1 = uniqueWords.map(word => freqMap1[word] || 0);
    const vector2 = uniqueWords.map(word => freqMap2[word] || 0);
    
    const dotProduct = vector1.reduce((sum, val, i) => sum + val * vector2[i], 0);
    const magnitude1 = Math.sqrt(vector1.reduce((sum, val) => sum + val * val, 0));
    const magnitude2 = Math.sqrt(vector2.reduce((sum, val) => sum + val * val, 0));
    
    if (magnitude1 === 0 || magnitude2 === 0) return 0;
    return dotProduct / (magnitude1 * magnitude2);
  } catch (error) {
    logger.error(`Text similarity calculation error: ${error.message}`);
    return 0;
  }
}

/**
 * Analyze text frequency with improved filtering
 */
function analyzeTextFrequency(textData, minOccurrences = DEFAULT_MIN_WORD_OCCURRENCES) {
  if (!Array.isArray(textData)) {
    return { mostCommonWords: [], wordFrequency: {}, totalWords: 0, uniqueWords: 0, vocabularyDiversity: 0 };
  }
  
  const wordFrequency = {};

  textData.forEach(word => {
    if (word && typeof word === 'string') {
      const cleanWord = word.trim().toLowerCase();
      if (cleanWord.length > 2 && !comprehensiveStopwords.includes(cleanWord)) {
        wordFrequency[cleanWord] = (wordFrequency[cleanWord] || 0) + 1;
      }
    }
  });

  const mostCommonWords = Object.entries(wordFrequency)
    .filter(([_, count]) => count >= minOccurrences)
    .sort((a, b) => b[1] - a[1])
    .map(([word, count]) => ({ word, count }))
    .slice(0, 15);

  const totalWords = Object.values(wordFrequency).reduce((sum, count) => sum + count, 0);
  const uniqueWords = Object.keys(wordFrequency).length;

  return {
    mostCommonWords,
    wordFrequency,
    totalWords,
    uniqueWords,
    vocabularyDiversity: uniqueWords ? (uniqueWords / totalWords) : 0
  };
}

/**
 * Advanced text analysis with comprehensive metrics
 */
function analyzeText(text) {
  try {
    if (!text || typeof text !== 'string') {
      return {
        sentiment: { score: 50, comparative: 0 },
        wordFrequency: {},
        mostCommonWords: [],
        readability: { fleschKincaid: 50, syllablesPerWord: 0, wordsPerSentence: 0 },
        statistics: { totalWords: 0, uniqueWords: 0, vocabularyDiversity: 0, sentences: 0, characters: 0 }
      };
    }
    
    const sentiment = new Sentiment();
    const sentimentResult = sentiment.analyze(text);
    
    const tokens = preprocessText(text);
    const { mostCommonWords, wordFrequency, totalWords, uniqueWords, vocabularyDiversity } = analyzeTextFrequency(tokens);
    
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
    const characters = text.replace(/\s/g, '').length;
    
    const calculateSyllables = word => {
      word = word.toLowerCase();
      if (word.length <= 3) return 1;
      return word.replace(/(?:[^laeiouy]|ed|[^laeiouy]e)$/, '')
                .replace(/^y/, '')
                .match(/[aeiouy]{1,2}/g)?.length || 1;
    };
    
    const totalSyllables = tokens.reduce((sum, word) => sum + calculateSyllables(word), 0);
    const syllablesPerWord = tokens.length ? totalSyllables / tokens.length : 0;
    
    const fleschKincaid = tokens.length && sentences 
      ? 206.835 - 1.015 * (tokens.length / sentences) - 84.6 * (totalSyllables / tokens.length)
      : 50;
    
    return {
      sentiment: {
        score: Math.round((sentimentResult.comparative + 5) * 10),
        comparative: sentimentResult.comparative,
        positive: sentimentResult.positive,
        negative: sentimentResult.negative
      },
      wordFrequency,
      mostCommonWords,
      readability: {
        fleschKincaid: Math.max(0, Math.min(100, fleschKincaid)),
        syllablesPerWord,
        wordsPerSentence: sentences ? tokens.length / sentences : 0
      },
      statistics: {
        totalWords,
        uniqueWords,
        vocabularyDiversity,
        sentences,
        characters
      }
    };
  } catch (error) {
    logger.error(`Text analysis error: ${error.message}`);
    return {
      sentiment: { score: 50, comparative: 0 },
      wordFrequency: {},
      mostCommonWords: [],
      readability: { fleschKincaid: 50, syllablesPerWord: 0, wordsPerSentence: 0 },
      statistics: { totalWords: 0, uniqueWords: 0, vocabularyDiversity: 0, sentences: 0, characters: 0 }
    };
  }
}

