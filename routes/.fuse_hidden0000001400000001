      }
      
      // Initialize settings object if it doesn't exist
      if (!user.settings) {
        user.settings = {};
      }
      
      // Update specific section
      user.settings[section] = { ...user.settings[section], ...settings };
      user.lastUpdated = new Date();
      
      await user.save();
      
      // Log the update
      logger.info(`Settings updated for user ${userId}: ${section}`);
      metrics.increment('settings.updated');
      
      // If theme was changed, set a cookie for immediate effect
      if (section === 'display' && settings.theme) {
        res.cookie('theme', settings.theme, { 
          maxAge: 30 * 24 * 60 * 60 * 1000, // 30 days
          httpOnly: false
        });
