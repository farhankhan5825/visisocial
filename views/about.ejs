<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <title><%= title || 'About VisiSocial' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'About VisiSocial: social intelligence that hands the dossier back to the watched.' %>">
  <% if (typeof keywords !== 'undefined' && keywords) { %><meta name="keywords" content="<%= keywords %>"><% } %>
  <link href="/img/favicon.ico" rel="icon">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
  <link href="/stylesheets/bootstrap.min.css" rel="stylesheet">
  <link href="/stylesheets/visisocial.css" rel="stylesheet">
  <link href="/stylesheets/styles.css" rel="stylesheet">
  <style>
    .ab { padding: 10px 0 30px; }

    /* Hero */
    .ab-hero { padding: clamp(40px, 7vw, 84px) 0 clamp(30px, 5vw, 56px); display: grid; grid-template-columns: 7fr 5fr; gap: 40px; align-items: center; }
    @media (max-width: 920px) { .ab-hero { grid-template-columns: 1fr; } }
    .ab-h1 { font-size: clamp(2rem, 5.4vw, 3.4rem); font-weight: 700; line-height: 1.04; letter-spacing: -.03em; margin: 14px 0 16px; }
    .ab-lead { color: var(--vs-ink-2); font-size: 1.05rem; line-height: 1.7; max-width: 52ch; }
    .ab-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
    .ab-visual { position: relative; aspect-ratio: 1; border-radius: var(--vs-r-lg); border: 1px solid var(--vs-line); background: radial-gradient(circle at 50% 40%, rgba(124,108,255,.18), transparent 62%), linear-gradient(180deg, var(--vs-surface-2), var(--vs-surface)); display: grid; place-items: center; overflow: hidden; }
    .ab-visual::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 40px 40px; -webkit-mask-image: radial-gradient(circle at 50% 50%, #000, transparent 72%); mask-image: radial-gradient(circle at 50% 50%, #000, transparent 72%); }
    .ab-eye-core { position: relative; width: 120px; height: 120px; border-radius: 50%; display: grid; place-items: center; font-size: 2.6rem; color: var(--vs-cyan); background: rgba(52,227,255,.07); border: 1px solid rgba(52,227,255,.3); box-shadow: 0 0 50px rgba(52,227,255,.25); }
    .ab-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(124,108,255,.22); }
    .ab-ring.r1 { width: 56%; height: 56%; } .ab-ring.r2 { width: 74%; height: 74%; } .ab-ring.r3 { width: 92%; height: 92%; }

    /* Stats strip */
    .ab-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 1px solid var(--vs-line); border-radius: var(--vs-r); overflow: hidden; background: linear-gradient(180deg, var(--vs-surface-2), var(--vs-surface)); }
    @media (max-width: 720px) { .ab-stats { grid-template-columns: repeat(2, 1fr); } }
    .ab-stat { padding: 26px 22px; border-right: 1px solid var(--vs-line); }
    .ab-stat:last-child { border-right: 0; }
    @media (max-width: 720px) { .ab-stat:nth-child(2) { border-right: 0; } .ab-stat:nth-child(1), .ab-stat:nth-child(2) { border-bottom: 1px solid var(--vs-line); } }
    .ab-stat .v { font-family: var(--vs-display); font-size: clamp(1.6rem, 3.4vw, 2.3rem); font-weight: 700; letter-spacing: -.03em; }
    .ab-stat .l { font-family: var(--vs-mono); font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--vs-muted); margin-top: 6px; }
    .ab-stat .i { color: var(--vs-violet-soft); font-size: .9rem; margin-bottom: 12px; }

    /* Features — asymmetric 2-col, first is wide */
    .feat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 760px) { .feat-grid { grid-template-columns: 1fr; } }
    .feat { padding: 26px; }
    .feat .fic { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; font-size: 1.1rem; margin-bottom: 16px; }
    .feat h3 { font-size: 1.15rem; margin: 0 0 8px; }
    .feat p { color: var(--vs-muted); font-size: .92rem; line-height: 1.65; margin: 0; }

    /* Mission */
    .mission { text-align: center; max-width: 760px; margin: 0 auto; }
    .mission h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.12; letter-spacing: -.03em; }
    .mission p { color: var(--vs-ink-2); font-size: 1.05rem; line-height: 1.7; margin-top: 18px; }

    /* Timeline */
    .tl { position: relative; display: grid; gap: 6px; padding-left: 28px; }
    .tl::before { content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px; background: linear-gradient(180deg, var(--vs-violet), rgba(52,227,255,.2)); }
    .tl-item { position: relative; padding: 14px 0 22px 18px; }
    .tl-item::before { content: ""; position: absolute; left: -28px; top: 18px; width: 16px; height: 16px; border-radius: 50%; background: var(--vs-bg); border: 2px solid var(--vs-violet); box-shadow: 0 0 12px rgba(124,108,255,.5); }
    .tl-year { font-family: var(--vs-mono); font-size: .74rem; font-weight: 600; letter-spacing: .1em; color: var(--vs-cyan); }
    .tl-item h4 { font-size: 1.05rem; margin: 4px 0 5px; }
    .tl-item p { color: var(--vs-muted); font-size: .9rem; margin: 0; }

    /* Tech */
    .tech-wrap { display: flex; flex-wrap: wrap; gap: 12px; }
    .tech { display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; border: 1px solid var(--vs-line); border-radius: var(--vs-r-pill); background: rgba(255,255,255,.02); font-weight: 500; font-size: .92rem; transition: border-color .3s var(--vs-ease), transform .3s var(--vs-ease); }
    .tech:hover { border-color: var(--vs-line-2); transform: translateY(-2px); }
    .tech i { font-size: 1.1rem; }

    /* Team */
    .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .member { padding: 28px; display: flex; gap: 18px; align-items: flex-start; }
    .member img { width: 84px; height: 84px; border-radius: 18px; object-fit: cover; border: 1px solid var(--vs-line-2); }
    .member h4 { font-size: 1.15rem; margin: 0 0 2px; }
    .member .role { font-family: var(--vs-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--vs-cyan); margin: 0 0 10px; }
    .member p.bio { color: var(--vs-muted); font-size: .9rem; line-height: 1.6; margin: 0 0 12px; }
    .member .chips { display: flex; flex-wrap: wrap; gap: 7px; }

    /* CTA */
    .ab-final { text-align: center; padding: clamp(40px, 7vw, 72px); border-radius: var(--vs-r-lg); border: 1px solid var(--vs-line); background: radial-gradient(circle at 50% 0%, rgba(124,108,255,.14), transparent 60%), linear-gradient(180deg, var(--vs-surface-2), var(--vs-surface)); }
    .ab-final h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.12; letter-spacing: -.03em; }
    .ab-final p { color: var(--vs-muted); margin: 14px auto 26px; max-width: 50ch; }
  </style>
</head>
<body>
  <div class="vs-field"></div>
  <div class="vs-grid-overlay"></div>

  <%- include('partials/navbar') %>

  <main class="ab">
    <div class="vs-shell">

      <!-- HERO -->
      <section class="ab-hero vs-reveal">
        <div>
          <span class="vs-eyebrow">About VisiSocial</span>
          <h1 class="ab-h1">The surveillance economy keeps a file on you.<br><span class="vs-grad-text">We hand it back.</span></h1>
          <p class="ab-lead">VisiSocial reconstructs the profile that platforms, advertisers, and data brokers infer from your social footprint, then shows it to the one person who never gets to see it: you.</p>
          <div class="ab-cta">
            <a href="/auth/facebook" class="vs-btn vs-btn--solid"><i class="fab fa-facebook-f"></i>Reveal my profile</a>
            <a href="/docs" class="vs-btn vs-btn--ghost"><i class="fas fa-book"></i>How it works</a>
          </div>
        </div>
        <div class="ab-visual">
          <span class="ab-ring r1"></span><span class="ab-ring r2"></span><span class="ab-ring r3"></span>
          <div class="ab-eye-core"><i class="fas fa-eye"></i></div>
        </div>
      </section>

      <!-- STATS -->
      <% if (typeof stats !== 'undefined' && stats && stats.length) { %>
      <section class="vs-section vs-reveal" style="padding-top: 6px;">
        <div class="ab-stats">
          <% stats.forEach(function(stat){ %>
          <div class="ab-stat">
            <div class="i"><i class="<%= stat.icon %>"></i></div>
            <div class="v vs-grad-text"><%= stat.value %></div>
            <div class="l"><%= stat.label %></div>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- FEATURES -->
      <% if (typeof features !== 'undefined' && features && features.length) { %>
      <section class="vs-section vs-reveal">
        <div class="vs-section-head"><h2 class="vs-section-title"><span class="vs-tick"></span>What it does</h2></div>
        <div class="feat-grid">
          <% features.forEach(function(feature, i){ %>
          <div class="vs-card vs-card--interactive feat">
            <div class="fic" style="background: <%= feature.color %>22; color: <%= feature.color %>;"><i class="<%= feature.icon %>"></i></div>
            <h3><%= feature.title %></h3>
            <p><%= feature.description %></p>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- MISSION -->
      <section class="vs-section vs-reveal">
        <div class="vs-card vs-card--pad mission" style="padding: clamp(36px, 6vw, 64px);">
          <h2>The profile exists either way. Only one of you gets to <span class="vs-grad-text">read it</span>.</h2>
          <p>We believe the people being modeled deserve the same view as the people doing the modeling. VisiSocial turns opaque inference into something you can inspect, question, and act on. No dark patterns, no resale, no pretending the dossier was never built.</p>
        </div>
      </section>

      <!-- TIMELINE -->
      <% if (typeof timeline !== 'undefined' && timeline && timeline.length) { %>
      <section class="vs-section vs-reveal">
        <div class="vs-section-head"><h2 class="vs-section-title"><span class="vs-tick"></span>How we got here</h2></div>
        <div class="tl">
          <% timeline.forEach(function(item){ %>
          <div class="tl-item">
            <span class="tl-year"><%= item.year %></span>
            <h4><i class="<%= item.icon %>" style="color: var(--vs-violet-soft); margin-right: 8px;"></i><%= item.title %></h4>
            <p><%= item.description %></p>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- TECH -->
      <% if (typeof techStack !== 'undefined' && techStack && techStack.length) { %>
      <section class="vs-section vs-reveal">
        <div class="vs-section-head"><h2 class="vs-section-title"><span class="vs-tick"></span>Built with</h2></div>
        <div class="tech-wrap">
          <% techStack.forEach(function(tech){ %>
          <span class="tech"><i class="<%= tech.icon %>" style="color: <%= tech.color %>;"></i><%= tech.name %></span>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- TEAM -->
      <% if (typeof team !== 'undefined' && team && team.length) { %>
      <section class="vs-section vs-reveal">
        <div class="vs-section-head"><h2 class="vs-section-title"><span class="vs-tick"></span>Who's behind it</h2></div>
        <div class="team-grid">
          <% team.forEach(function(member){ %>
          <div class="vs-card member">
            <img src="<%= member.image || '/img/user.png' %>" alt="<%= member.name %>" onerror="this.src='/img/user.png'">
            <div>
              <h4><%= member.name %></h4>
              <p class="role"><%= member.role %></p>
              <p class="bio"><%= member.bio %></p>
              <% if (member.expertise && member.expertise.length) { %>
              <div class="chips">
                <% member.expertise.forEach(function(skill){ %><span class="vs-pill"><%= skill %></span><% }); %>
              </div>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- FINAL CTA -->
      <section class="vs-section vs-reveal">
        <div class="ab-final">
          <h2>See what they see.</h2>
          <p>Connect once and read the dossier the data economy keeps on you. Then decide what to do with it.</p>
          <a href="/auth/facebook" class="vs-btn vs-btn--solid"><i class="fab fa-facebook-f"></i>Reveal my profile</a>
        </div>
      </section>

    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
