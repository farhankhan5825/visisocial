// Import settings route
router.post('/settings/import',
  authenticateToken,
  upload.single('settingsFile'),
  wrapAsync(async (req, res) => {
    try {
      if (!req.file) {
        return res.status(400).json({ success: false, message: "No file uploaded" });
      }
      
      const userId = req.user.id;
      const user = await User.findOne({ id: userId });
      
      if (!user) {
        return res.status(404).json({ success: false, message: "User not found" });
      }
      
      // Read and parse the uploaded file
      const fileContent = fs.readFileSync(req.file.path, 'utf8');
      const importedSettings = JSON.parse(fileContent);
      
      // Validate the imported settings structure
      if (!importedSettings.settings || typeof importedSettings.settings !== 'object') {
        throw new Error('Invalid settings file format');
      }
      
      // Update user settings
      user.settings = importedSettings.settings;
      await user.save();
      
      // Clean up uploaded file
      fs.unlinkSync(req.file.path);
      
      logger.info(`Settings imported for user: ${userId}`);
      metrics.increment('settings.imported');
      
      res.json({ success: true, message: "Settings imported successfully" });
      
    } catch (error) {
      logger.error(`Settings import error: ${error.message}`);
      metrics.increment('settings.import_errors');
      
      // Clean up file if it exists
      if (req.file && fs.existsSync(req.file.path)) {
        fs.unlinkSync(req.file.path);
      }
      
      res.status(500).json({ 
        success: false, 
        message: "Error importing settings: " + error.message 
      });
    }
  })
);

// Revoke Facebook permissions
router.post('/settings/facebook/revoke',
  authenticateToken,
  wrapAsync(async (req, res) => {
    try {
      const { permission } = req.body;
      
      if (!permission) {
        return res.status(400).json({ success: false, message: "Permission not specified" });
      }
      
      // Call Facebook API to revoke permission
      try {
        await axios.delete(`https://graph.facebook.com/${API_VERSION}/me/permissions`, {
          params: {
            permission: permission,
            access_token: req.user.accessToken
          },
          timeout: FETCH_TIMEOUT
        });
        
        logger.info(`Facebook permission revoked: ${permission} for user ${req.user.id}`);
        metrics.increment('settings.facebook_permission_revoked');
        
        res.json({ success: true, message: `Permission '${permission}' revoked successfully` });
        
      } catch (fbError) {
        logger.error(`Facebook API error: ${fbError.message}`);
        res.status(500).json({ 
          success: false, 
          message: "Error revoking Facebook permission" 
        });
      }
      
    } catch (error) {
      logger.error(`Revoke permission error: ${error.message}`);
      res.status(500).json({ 
        success: false, 
        message: "Error processing request" 
      });
    }
  })
);




