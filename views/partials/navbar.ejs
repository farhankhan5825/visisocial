<!-- VisiSocial navbar — design system v2 (self-contained) -->
<style>
    .vs-nav{position:fixed; top:0; left:0; right:0; z-index:1000; height:70px;
        background:rgba(8,8,18,.72); -webkit-backdrop-filter:blur(18px) saturate(150%); backdrop-filter:blur(18px) saturate(150%);
        border-bottom:1px solid transparent; transition:background .35s cubic-bezier(.2,.7,.2,1),border-color .35s}
    .vs-nav.scrolled{background:rgba(7,7,15,.94); border-bottom-color:rgba(255,255,255,.08); box-shadow:0 10px 40px -22px rgba(0,0,0,.9)}
    .vs-nav__c{max-width:1320px; height:100%; margin:0 auto; padding:0 26px; display:flex; align-items:center; gap:18px}

    .vs-brand{display:flex; align-items:center; gap:11px; font-family:'Poppins',sans-serif; font-weight:800; font-size:1.24rem; letter-spacing:-.01em; color:#fff}
    .vs-brand__icon{width:36px; height:36px; border-radius:10px; display:grid; place-items:center; color:#0a0a16; font-size:.95rem;
        background:linear-gradient(118deg,#9d7bff,#7c6cff 45%,#34e3ff); box-shadow:0 8px 22px -8px rgba(124,108,255,.8); transition:transform .4s cubic-bezier(.2,.7,.2,1)}
    .vs-brand:hover .vs-brand__icon{transform:rotate(-8deg) scale(1.06)}
    .vs-brand__text{background:linear-gradient(120deg,#cfc7ff,#7c6cff 55%,#34e3ff); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent}

    .vs-menu{display:flex; align-items:center; gap:2px; margin-left:auto; list-style:none; padding:0; margin:0 0 0 auto}
    /* harden against page-level ul/li styles bleeding into the nav */
    .vs-nav ul,.vs-nav li{margin:0; padding:0; list-style:none; background:none; border:0; border-radius:0}
    .vs-nav li::before,.vs-nav li::after,.vs-nav .vs-link::before,.vs-nav .vs-link::after{content:none !important}
    .vs-item{position:relative; margin:0; padding:0; background:none; border:0; border-radius:0; list-style:none}
    .vs-link{display:flex; align-items:center; gap:8px; padding:9px 13px; border-radius:11px; color:#9a9ab6;
        font-family:'Inter',sans-serif; font-size:.9rem; font-weight:500; cursor:pointer; white-space:nowrap;
        background:transparent; border:0; transition:color .25s,background .25s}
    .vs-link i.fa-chevron-down{font-size:.66rem; opacity:.7; transition:transform .3s}
    .vs-link:hover,.vs-link.active{color:#fff; background:rgba(255,255,255,.05)}
    .vs-live{font-family:'Space Grotesk',monospace; font-size:.6rem; letter-spacing:.14em; color:#34e3ff;
        padding:3px 8px; border-radius:30px; border:1px solid rgba(52,227,255,.3); background:rgba(52,227,255,.06); display:inline-flex; align-items:center; gap:6px}
    .vs-live::before{content:""; width:5px;height:5px;border-radius:50%;background:#34e3ff;box-shadow:0 0 8px #34e3ff;animation:vsp 2s infinite}
    @keyframes vsp{50%{opacity:.3}}

    /* dropdowns — display:none when closed so they can never ghost */
    .vs-dd__menu{display:none; position:absolute; top:calc(100% + 10px); right:0; min-width:220px; padding:8px; flex-direction:column; gap:2px;
        background:#0c0c1a; border:1px solid rgba(255,255,255,.14); border-radius:15px;
        box-shadow:0 26px 60px -26px rgba(0,0,0,.95); animation:vsdd .26s cubic-bezier(.2,.7,.2,1)}
    /* invisible bridge so the cursor keeps :hover while crossing the gap into the menu */
    .vs-dd__menu::before{content:""; position:absolute; top:-14px; left:0; right:0; height:14px}
    @keyframes vsdd{from{opacity:0; transform:translateY(8px)}to{opacity:1; transform:none}}
    .vs-item.is-dd:hover .vs-dd__menu,.vs-item.is-dd.open .vs-dd__menu{display:flex}
    .vs-item.is-dd:hover .fa-chevron-down,.vs-item.is-dd.open .fa-chevron-down{transform:rotate(180deg)}
    .vs-dd__menu .vs-link{padding:10px 12px; color:#9a9ab6}
    .vs-dd__menu .vs-link:hover{color:#fff; background:rgba(124,108,255,.16)}
    .vs-divider{height:1px; background:rgba(255,255,255,.08); margin:6px 4px; border:0}
    .vs-avatar{width:26px;height:26px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,.18)}

    .vs-cta{display:flex; align-items:center; gap:10px; margin-left:6px}
    .vs-btn{display:inline-flex; align-items:center; gap:8px; font-family:'Inter',sans-serif; font-size:.88rem; font-weight:600;
        padding:9px 16px; border-radius:11px; cursor:pointer; white-space:nowrap; transition:transform .3s,box-shadow .3s,background .3s,border-color .3s}
    .vs-btn--ghost{color:#ECECF6; border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.03)}
    .vs-btn--ghost:hover{border-color:#7c6cff; background:rgba(124,108,255,.12); transform:translateY(-2px)}
    .vs-btn--solid{color:#0a0a16; border:1px solid transparent; background:linear-gradient(118deg,#9d7bff,#7c6cff 45%,#34e3ff); box-shadow:0 10px 28px -12px rgba(124,108,255,.75)}
    .vs-btn--solid:hover{transform:translateY(-2px); box-shadow:0 16px 40px -12px rgba(124,108,255,.9)}

    .vs-toggle{display:none; flex-direction:column; gap:5px; width:42px; height:42px; margin-left:auto;
        align-items:center; justify-content:center; border:1px solid rgba(255,255,255,.16); border-radius:11px; background:rgba(255,255,255,.03); cursor:pointer}
    .vs-toggle span{width:18px; height:2px; background:#ECECF6; border-radius:2px; transition:.3s cubic-bezier(.2,.7,.2,1)}
    .vs-toggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
    .vs-toggle.open span:nth-child(2){opacity:0}
    .vs-toggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

    body{padding-top:70px}

    @media (max-width:1024px){
        .vs-toggle{display:flex}
        .vs-menu{position:fixed; top:70px; left:0; right:0; flex-direction:column; align-items:stretch; gap:3px; margin:0;
            padding:16px 22px 24px; background:#07070f; border-bottom:1px solid rgba(255,255,255,.08);
            transform:translateY(-130%); opacity:0; visibility:hidden; transition:.4s cubic-bezier(.2,.7,.2,1); max-height:calc(100vh - 70px); overflow-y:auto}
        .vs-menu.open{transform:none; opacity:1; visibility:visible}
        .vs-link{padding:13px}
        .vs-dd__menu{position:static; display:none; box-shadow:none; border:0; background:rgba(255,255,255,.03); margin:2px 0 4px 14px; animation:none}
        .vs-item.is-dd.open .vs-dd__menu{display:flex}
        .vs-item.is-dd:hover .vs-dd__menu{display:none}
        .vs-item.is-dd.open:hover .vs-dd__menu{display:flex}
        .vs-cta{flex-direction:column; align-items:stretch; width:100%; margin:8px 0 0}
        .vs-btn{justify-content:center; width:100%}
    }
</style>

<nav class="vs-nav" id="vsNav">
    <div class="vs-nav__c">
        <a href="/" class="vs-brand">
            <span class="vs-brand__icon"><i class="fas fa-brain"></i></span>
            <span class="vs-brand__text">VisiSocial</span>
        </a>

        <button class="vs-toggle" id="vsToggle" aria-label="Toggle menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>

        <ul class="vs-menu" id="vsMenu">
            <li class="vs-item"><a href="/" class="vs-link"><i class="fas fa-house"></i><span>Home</span></a></li>
            <li class="vs-item"><a href="/metrics" class="vs-link"><i class="fas fa-chart-line"></i><span>Metrics</span><span class="vs-live">LIVE</span></a></li>
            <li class="vs-item"><a href="/internet-search" class="vs-link"><i class="fas fa-globe"></i><span>Internet Presence</span></a></li>

            <% if (typeof user !== 'undefined' && user) { %>
            <li class="vs-item"><a href="/surveillance/dashboard" class="vs-link"><i class="fas fa-eye"></i><span>Surveillance</span></a></li>
            <% } %>

            <li class="vs-item is-dd">
                <a href="#" class="vs-link" data-dd><i class="fas fa-book"></i><span>Resources</span><i class="fas fa-chevron-down"></i></a>
                <div class="vs-dd__menu">
                    <a href="/docs" class="vs-link"><i class="fas fa-code"></i><span>API Docs</span></a>
                    <a href="/support" class="vs-link"><i class="fas fa-headset"></i><span>Support</span></a>
                    <a href="/status" class="vs-link"><i class="fas fa-server"></i><span>System Status</span></a>
                </div>
            </li>

            <li class="vs-item is-dd">
                <a href="#" class="vs-link" data-dd><i class="fas fa-shield-halved"></i><span>Legal</span><i class="fas fa-chevron-down"></i></a>
                <div class="vs-dd__menu">
                    <a href="/privacy" class="vs-link"><i class="fas fa-user-shield"></i><span>Privacy Policy</span></a>
                    <a href="/terms" class="vs-link"><i class="fas fa-file-contract"></i><span>Terms of Service</span></a>
                    <a href="/cookies" class="vs-link"><i class="fas fa-cookie-bite"></i><span>Cookie Policy</span></a>
                </div>
            </li>

            <% if (typeof user !== 'undefined' && user) { %>
            <li class="vs-item is-dd">
                <a href="#" class="vs-link" data-dd>
                    <% if (typeof userData !== 'undefined' && userData && (userData.picture?.data?.url || userData.picture)) { %>
                        <img src="<%= userData.picture?.data?.url || userData.picture %>" alt="" class="vs-avatar">
                    <% } else { %>
                        <i class="fas fa-user-circle"></i>
                    <% } %>
                    <span><%= (typeof userData !== 'undefined' && userData ? userData.name : user.name) || 'Account' %></span>
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div class="vs-dd__menu">
                    <a href="/profile" class="vs-link"><i class="fas fa-user"></i><span>My Profile</span></a>
                    <a href="/settings" class="vs-link"><i class="fas fa-cog"></i><span>Settings</span></a>
                    <hr class="vs-divider">
                    <a href="/export-data/csv" class="vs-link"><i class="fas fa-download"></i><span>Export Data</span></a>
                    <hr class="vs-divider">
                    <a href="/auth/logout" class="vs-link"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a>
                </div>
            </li>
            <% } else { %>
            <li class="vs-item vs-cta">
                <a href="/login" class="vs-btn vs-btn--solid"><i class="fas fa-sign-in-alt"></i><span>Login</span></a>
            </li>
            <% } %>
        </ul>
    </div>
</nav>

<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
(function(){
    var nav=document.getElementById('vsNav'), toggle=document.getElementById('vsToggle'), menu=document.getElementById('vsMenu');
    function onScroll(){ if(nav) nav.classList.toggle('scrolled', window.scrollY>20); }
    window.addEventListener('scroll', onScroll); onScroll();

    if(toggle && menu){
        toggle.addEventListener('click', function(){
            var open=menu.classList.toggle('open'); toggle.classList.toggle('open', open);
            toggle.setAttribute('aria-expanded', open?'true':'false');
            document.body.style.overflow = open ? 'hidden' : '';
        });
    }
    // dropdown toggles (click — works on mobile; harmless on desktop where hover also opens)
    document.querySelectorAll('.vs-item.is-dd > [data-dd]').forEach(function(t){
        t.addEventListener('click', function(e){
            e.preventDefault();
            var item=t.parentElement, wasOpen=item.classList.contains('open');
            document.querySelectorAll('.vs-item.is-dd.open').forEach(function(o){ if(o!==item) o.classList.remove('open'); });
            item.classList.toggle('open', !wasOpen);
        });
    });
    // close menus on outside click
    document.addEventListener('click', function(e){
        if(nav && !nav.contains(e.target)){
            document.querySelectorAll('.vs-item.is-dd.open').forEach(function(o){ o.classList.remove('open'); });
            if(menu && menu.classList.contains('open')){ menu.classList.remove('open'); toggle.classList.remove('open'); document.body.style.overflow=''; }
        }
    });
    // close mobile menu when a real link is clicked
    menu && menu.querySelectorAll('a:not([data-dd])').forEach(function(a){
        a.addEventListener('click', function(){ menu.classList.remove('open'); toggle && toggle.classList.remove('open'); document.body.style.overflow=''; });
    });
})();
</script>
