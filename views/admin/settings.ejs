<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'nonce-<%= nonce %>' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - VisiSocial</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <style nonce="<%= nonce %>">
        :root {
            --primary: #7c6cff;
            --primary-dark: #5b4fe0;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --gradient-primary: linear-gradient(118deg, #9d7bff 0%, #7c6cff 45%, #34e3ff 100%);
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-lg: 0 25px 80px -20px rgba(99, 102, 241, 0.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        /* Animated Background */
        .bg-animated {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
            background: var(--darker);
        }

        .bg-animated .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.15;
            animation: float 25s ease-in-out infinite;
        }

        .bg-animated .orb-1 {
            width: 700px;
            height: 700px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            top: -250px;
            right: -250px;
        }

        .bg-animated .orb-2 {
            width: 500px;
            height: 500px;
            background: linear-gradient(135deg, var(--secondary) 0%, var(--accent) 100%);
            bottom: -150px;
            left: -150px;
            animation-delay: -7s;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(60px, -60px) scale(1.1); }
            50% { transform: translate(-40px, 40px) scale(0.9); }
            75% { transform: translate(-60px, -40px) scale(1.05); }
        }

        /* Header */
        header {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.3);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .logo {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-back {
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: var(--primary-light);
            padding: 10px 20px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back:hover {
            background: rgba(99, 102, 241, 0.2);
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .btn-logout {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
            padding: 10px 24px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-logout:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--danger);
            transform: translateY(-2px);
        }

        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 32px;
        }

        /* Glass Card */
        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            position: relative;
            overflow: hidden;
        }

        .glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        }

        /* Page Header */
        .page-header {
            margin-bottom: 32px;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .page-title i {
            color: var(--accent);
        }

        .gradient-text {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-subtitle {
            color: var(--muted);
            font-size: 1.1rem;
        }

        /* Sidebar Navigation */
        .settings-layout {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 24px;
            align-items: start;
        }

        .settings-nav {
            position: sticky;
            top: 100px;
        }

        .nav-section {
            margin-bottom: 24px;
        }

        .nav-section-title {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 0 16px;
            margin-bottom: 8px;
        }

        .nav-item {
            padding: 12px 16px;
            border-radius: 12px;
            color: var(--muted);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 4px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--light);
        }

        .nav-item.active {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary-light);
            border-left: 3px solid var(--primary);
        }

        .nav-item i {
            width: 20px;
            text-align: center;
        }

        /* Settings Content */
        .settings-content {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .settings-section {
            display: none;
        }

        .settings-section.active {
            display: block;
        }

        .section-card {
            padding: 32px;
            margin-bottom: 24px;
        }

        .section-header {
            margin-bottom: 28px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--glass-border);
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            color: var(--accent);
        }

        .section-description {
            color: var(--muted);
            font-size: 0.95rem;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--light);
        }

        .form-description {
            display: block;
            margin-bottom: 12px;
            font-size: 0.85rem;
            color: var(--muted);
            line-height: 1.6;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.03);
            color: var(--light);
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
        }

        .form-input:focus {
            border-color: var(--primary);
            background: rgba(255, 255, 255, 0.05);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .form-input[type="number"] {
            max-width: 200px;
        }

        textarea.form-input {
            min-height: 120px;
            resize: vertical;
        }

        select.form-input {
            cursor: pointer;
        }

        /* Toggle Switch */
        .toggle-group {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .toggle-group:last-child {
            border-bottom: none;
        }

        .toggle-info {
            flex: 1;
        }

        .toggle-label {
            font-weight: 600;
            color: var(--light);
            margin-bottom: 4px;
        }

        .toggle-description {
            font-size: 0.85rem;
            color: var(--muted);
        }

        .toggle-switch {
            position: relative;
            width: 56px;
            height: 32px;
        }

        .toggle-input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 34px;
            transition: 0.3s;
            border: 1px solid var(--glass-border);
        }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 24px;
            width: 24px;
            left: 3px;
            bottom: 3px;
            background: var(--muted);
            border-radius: 50%;
            transition: 0.3s;
        }

        .toggle-input:checked + .toggle-slider {
            background: var(--primary);
            border-color: var(--primary);
        }

        .toggle-input:checked + .toggle-slider:before {
            transform: translateX(24px);
            background: white;
        }

        /* Alert Boxes */
        .alert {
            padding: 16px 20px;
            border-radius: 12px;
            margin-bottom: 24px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .alert i {
            font-size: 1.2rem;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .alert-info {
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: var(--primary-light);
        }

        .alert-warning {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: var(--warning);
        }

        .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: var(--success);
        }

        /* Buttons */
        .btn {
            padding: 12px 32px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border: none;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--gradient-primary);
            color: white;
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--light);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--primary);
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
        }

        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--danger);
        }

        .form-actions {
            display: flex;
            gap: 12px;
            padding-top: 24px;
            border-top: 1px solid var(--glass-border);
            margin-top: 32px;
        }

        /* Grid Layouts */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .form-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        /* Toast */
        .toast-container {
            position: fixed;
            top: 100px;
            right: 20px;
            z-index: 10000;
            max-width: 420px;
        }

        .toast {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: flex-start;
            gap: 16px;
            opacity: 0;
            transform: translateX(100px);
            animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        @keyframes slideIn {
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Responsive */
        @media (max-width: 992px) {
            .settings-layout {
                grid-template-columns: 1fr;
            }

            .settings-nav {
                position: static;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 16px;
            }

            .nav-section {
                margin-bottom: 0;
            }
        }

        @media (max-width: 768px) {
            .header-content {
                padding: 16px 20px;
                flex-direction: column;
                gap: 16px;
            }

            .container {
                padding: 24px 16px;
            }

            .page-title {
                font-size: 2rem;
            }

            .section-card {
                padding: 24px 20px;
            }

            .form-grid,
            .form-grid-3 {
                grid-template-columns: 1fr;
            }

            .form-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .page-title {
                font-size: 1.75rem;
            }

            .section-title {
                font-size: 1.25rem;
            }
        }
    </style>
</head>

<body>
    <!-- Animated Background -->
    <div class="bg-animated">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Header -->
    <header>
        <div class="header-content">
            <div class="header-left">
                <a href="/admin" class="logo">VisiSocial</a>
                <div class="admin-badge">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </div>
            </div>

            <div class="header-right">
                <a href="/admin" class="btn-back">
                    <i class="fas fa-arrow-left"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/logout" class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <div class="container">
        
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-cog"></i>
                System <span class="gradient-text">Settings</span>
            </h1>
            <p class="page-subtitle">Configure and manage your VisiSocial platform</p>
        </div>

        <!-- Settings Layout -->
        <div class="settings-layout">
            
            <!-- Sidebar Navigation -->
            <div class="glass-card settings-nav">
                <div style="padding: 24px;">
                    <div class="nav-section">
                        <div class="nav-section-title">Configuration</div>
                        <a class="nav-item active" data-section="general">
                            <i class="fas fa-sliders-h"></i>
                            <span>General</span>
                        </a>
                        <a class="nav-item" data-section="security">
                            <i class="fas fa-shield-alt"></i>
                            <span>Security</span>
                        </a>
                        <a class="nav-item" data-section="api">
                            <i class="fas fa-code"></i>
                            <span>API Settings</span>
                        </a>
                        <a class="nav-item" data-section="email">
                            <i class="fas fa-envelope"></i>
                            <span>Email</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">System</div>
                        <a class="nav-item" data-section="cache">
                            <i class="fas fa-database"></i>
                            <span>Cache</span>
                        </a>
                        <a class="nav-item" data-section="maintenance">
                            <i class="fas fa-tools"></i>
                            <span>Maintenance</span>
                        </a>
                        <a class="nav-item" data-section="logs">
                            <i class="fas fa-file-alt"></i>
                            <span>Logs</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Advanced</div>
                        <a class="nav-item" data-section="backup">
                            <i class="fas fa-cloud-download-alt"></i>
                            <span>Backup</span>
                        </a>
                        <a class="nav-item" data-section="danger">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>Danger Zone</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Settings Content -->
            <div class="settings-content">
                
                <!-- General Settings -->
                <div class="settings-section active" id="general">
                    <form id="generalForm">
                        <div class="glass-card section-card">
                            <div class="section-header">
                                <h2 class="section-title">
                                    <i class="fas fa-sliders-h"></i>
                                    General Settings
                                </h2>
                                <p class="section-description">Configure basic platform settings and preferences</p>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Site Name</label>
                                <span class="form-description">The name of your platform displayed across the application</span>
                                <input type="text" class="form-input" name="siteName" value="<%= settings.general.siteName || 'VisiSocial' %>">
                            </div>

                            <div class="form-group">
                                <label class="form-label">Site Description</label>
                                <span class="form-description">A brief description of your platform</span>
                                <textarea class="form-input" name="siteDescription"><%= settings.general.siteDescription || '' %></textarea>
                            </div>

                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">Support Email</label>
                                    <input type="email" class="form-input" name="supportEmail" value="<%= settings.general.supportEmail || '' %>">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Admin Email</label>
                                    <input type="email" class="form-input" name="adminEmail" value="<%= settings.general.adminEmail || '' %>">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Features</label>
                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">User Registration</div>
                                        <div class="toggle-description">Allow new users to register accounts</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="allowRegistration" <%= settings.general.allowRegistration ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>

                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">Email Verification</div>
                                        <div class="toggle-description">Require email verification for new accounts</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="requireEmailVerification" <%= settings.general.requireEmailVerification ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>

                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">Analytics Tracking</div>
                                        <div class="toggle-description">Enable analytics and user tracking</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="enableAnalytics" <%= settings.general.enableAnalytics ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i>
                                    Save Changes
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetForm('generalForm')">
                                    <i class="fas fa-undo"></i>
                                    Reset
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Security Settings -->
                <div class="settings-section" id="security">
                    <form id="securityForm">
                        <div class="glass-card section-card">
                            <div class="section-header">
                                <h2 class="section-title">
                                    <i class="fas fa-shield-alt"></i>
                                    Security Settings
                                </h2>
                                <p class="section-description">Configure security policies and authentication settings</p>
                            </div>

                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                <div>
                                    <strong>Security Notice:</strong> Changes to these settings will affect all users. Use caution when modifying security configurations.
                                </div>
                            </div>

                            <div class="form-grid-3">
                                <div class="form-group">
                                    <label class="form-label">Session Duration (hours)</label>
                                    <input type="number" class="form-input" name="sessionDuration" value="<%= settings.security.sessionDuration || 24 %>" min="1" max="720">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Max Login Attempts</label>
                                    <input type="number" class="form-input" name="maxLoginAttempts" value="<%= settings.security.maxLoginAttempts || 5 %>" min="1" max="20">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Lockout Duration (min)</label>
                                    <input type="number" class="form-input" name="lockoutDuration" value="<%= settings.security.lockoutDuration || 15 %>" min="1" max="1440">
                                </div>
                            </div>

                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">Password Min Length</label>
                                    <input type="number" class="form-input" name="passwordMinLength" value="<%= settings.security.passwordMinLength || 8 %>" min="6" max="32">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Token Expiry (days)</label>
                                    <input type="number" class="form-input" name="tokenExpiry" value="<%= settings.security.tokenExpiry || 7 %>" min="1" max="365">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Security Features</label>
                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">Two-Factor Authentication</div>
                                        <div class="toggle-description">Enable 2FA for enhanced security</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="enable2FA" <%= settings.security.enable2FA ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>

                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">IP Whitelisting</div>
                                        <div class="toggle-description">Restrict admin access to specific IP addresses</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="ipWhitelisting" <%= settings.security.ipWhitelisting ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>

                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">CSRF Protection</div>
                                        <div class="toggle-description">Enable Cross-Site Request Forgery protection</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="csrfProtection" <%= settings.security.csrfProtection ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i>
                                    Save Changes
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetForm('securityForm')">
                                    <i class="fas fa-undo"></i>
                                    Reset
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- API Settings -->
                <div class="settings-section" id="api">
                    <form id="apiForm">
                        <div class="glass-card section-card">
                            <div class="section-header">
                                <h2 class="section-title">
                                    <i class="fas fa-code"></i>
                                    API Settings
                                </h2>
                                <p class="section-description">Configure API rate limits and access controls</p>
                            </div>

                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">Rate Limit (requests/hour)</label>
                                    <input type="number" class="form-input" name="rateLimit" value="<%= settings.api.rateLimit || 1000 %>" min="10" max="10000">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Burst Limit</label>
                                    <input type="number" class="form-input" name="burstLimit" value="<%= settings.api.burstLimit || 50 %>" min="5" max="500">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">OpenAI API Key</label>
                                <span class="form-description">API key for GPT-4 personality analysis</span>
                                <input type="password" class="form-input" name="openaiKey" value="<%= settings.api.openaiKey || '' %>" placeholder="sk-...">
                            </div>

                            <div class="form-group">
                                <label class="form-label">Facebook App Secret</label>
                                <span class="form-description">Facebook OAuth application secret</span>
                                <input type="password" class="form-input" name="facebookSecret" value="<%= settings.api.facebookSecret || '' %>">
                            </div>

                            <div class="form-group">
                                <label class="form-label">API Features</label>
                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">Public API Access</div>
                                        <div class="toggle-description">Allow external applications to access the API</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="publicApiAccess" <%= settings.api.publicApiAccess ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>

                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">API Key Required</div>
                                        <div class="toggle-description">Require API keys for all requests</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="requireApiKey" <%= settings.api.requireApiKey ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i>
                                    Save Changes
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetForm('apiForm')">
                                    <i class="fas fa-undo"></i>
                                    Reset
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Email Settings -->
                <div class="settings-section" id="email">
                    <form id="emailForm">
                        <div class="glass-card section-card">
                            <div class="section-header">
                                <h2 class="section-title">
                                    <i class="fas fa-envelope"></i>
                                    Email Settings
                                </h2>
                                <p class="section-description">Configure SMTP and email notification settings</p>
                            </div>

                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">SMTP Host</label>
                                    <input type="text" class="form-input" name="smtpHost" value="<%= settings.email.smtpHost || '' %>" placeholder="smtp.gmail.com">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">SMTP Port</label>
                                    <input type="number" class="form-input" name="smtpPort" value="<%= settings.email.smtpPort || 587 %>" placeholder="587">
                                </div>
                            </div>

                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">SMTP Username</label>
                                    <input type="text" class="form-input" name="smtpUsername" value="<%= settings.email.smtpUsername || '' %>">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">SMTP Password</label>
                                    <input type="password" class="form-input" name="smtpPassword" value="<%= settings.email.smtpPassword || '' %>">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">From Email</label>
                                <input type="email" class="form-input" name="fromEmail" value="<%= settings.email.fromEmail || '' %>" placeholder="noreply@visisocial.com">
                            </div>

                            <div class="form-group">
                                <label class="form-label">Email Notifications</label>
                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">Welcome Emails</div>
                                        <div class="toggle-description">Send welcome email to new users</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="sendWelcomeEmail" <%= settings.email.sendWelcomeEmail ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>

                                <div class="toggle-group">
                                    <div class="toggle-info">
                                        <div class="toggle-label">Analysis Complete</div>
                                        <div class="toggle-description">Notify users when analysis is complete</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-input" name="sendAnalysisEmail" <%= settings.email.sendAnalysisEmail ? 'checked' : '' %>>
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i>
                                    Save Changes
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="testEmail()">
                                    <i class="fas fa-paper-plane"></i>
                                    Send Test Email
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Cache Settings -->
                <div class="settings-section" id="cache">
                    <div class="glass-card section-card">
                        <div class="section-header">
                            <h2 class="section-title">
                                <i class="fas fa-database"></i>
                                Cache Management
                            </h2>
                            <p class="section-description">Manage system cache and temporary data</p>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <div>
                                <strong>Cache Info:</strong> Current cache size: <%= settings.cache.currentSize || '0' %> KB with <%= settings.cache.itemCount || 0 %> items stored
                            </div>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Cache TTL (seconds)</label>
                                <input type="number" class="form-input" value="<%= settings.cache.ttl || 3600 %>" min="60" max="86400">
                            </div>

                            <div class="form-group">
                                <label class="form-label">Max Cache Size (MB)</label>
                                <input type="number" class="form-input" value="<%= settings.cache.maxSize || 100 %>" min="10" max="1000">
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn btn-danger" onclick="clearCache('all')">
                                <i class="fas fa-trash"></i>
                                Clear All Cache
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="clearCache('user')">
                                <i class="fas fa-users"></i>
                                Clear User Cache
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="clearCache('api')">
                                <i class="fas fa-code"></i>
                                Clear API Cache
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Maintenance -->
                <div class="settings-section" id="maintenance">
                    <form id="maintenanceForm">
                        <div class="glass-card section-card">
                            <div class="section-header">
                                <h2 class="section-title">
                                    <i class="fas fa-tools"></i>
                                    Maintenance Mode
                                </h2>
                                <p class="section-description">Enable maintenance mode for system updates</p>
                            </div>

                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <div>
                                    <strong>Warning:</strong> Enabling maintenance mode will prevent all users from accessing the platform
                                </div>
                            </div>

                            <div class="toggle-group">
                                <div class="toggle-info">
                                    <div class="toggle-label">Maintenance Mode</div>
                                    <div class="toggle-description">Enable maintenance mode and display a maintenance page</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" class="toggle-input" name="maintenanceMode" <%= settings.maintenance.enabled ? 'checked' : '' %>>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Maintenance Message</label>
                                <textarea class="form-input" name="maintenanceMessage" placeholder="We're performing scheduled maintenance. We'll be back soon!"><%= settings.maintenance.message || '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Estimated Time (hours)</label>
                                <input type="number" class="form-input" name="estimatedTime" value="<%= settings.maintenance.estimatedTime || 2 %>" min="1" max="72">
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i>
                                    Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Logs -->
                <div class="settings-section" id="logs">
                    <div class="glass-card section-card">
                        <div class="section-header">
                            <h2 class="section-title">
                                <i class="fas fa-file-alt"></i>
                                System Logs
                            </h2>
                            <p class="section-description">View and manage system logs</p>
                        </div>

                        <div class="form-grid-3">
                            <div class="form-group">
                                <label class="form-label">Log Level</label>
                                <select class="form-input">
                                    <option value="error">Error</option>
                                    <option value="warn">Warning</option>
                                    <option value="info" selected>Info</option>
                                    <option value="debug">Debug</option>
                                    <option value="verbose">Verbose</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Max Log Size (MB)</label>
                                <input type="number" class="form-input" value="50" min="10" max="500">
                            </div>

                            <div class="form-group">
                                <label class="form-label">Retention (days)</label>
                                <input type="number" class="form-input" value="30" min="1" max="365">
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn btn-primary" onclick="downloadLogs()">
                                <i class="fas fa-download"></i>
                                Download Logs
                            </button>
                            <button type="button" class="btn btn-danger" onclick="clearLogs()">
                                <i class="fas fa-trash"></i>
                                Clear Logs
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Backup -->
                <div class="settings-section" id="backup">
                    <div class="glass-card section-card">
                        <div class="section-header">
                            <h2 class="section-title">
                                <i class="fas fa-cloud-download-alt"></i>
                                Backup & Restore
                            </h2>
                            <p class="section-description">Manage database backups and restoration</p>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <div>
                                <strong>Last Backup:</strong> <%= settings.backup.lastBackup || 'Never' %>
                            </div>
                        </div>

                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-label">Automatic Backups</div>
                                <div class="toggle-description">Enable daily automated backups</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" class="toggle-input" <%= settings.backup.autoBackup ? 'checked' : '' %>>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Backup Frequency</label>
                            <select class="form-input">
                                <option value="daily">Daily</option>
                                <option value="weekly">Weekly</option>
                                <option value="monthly">Monthly</option>
                            </select>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn btn-primary" onclick="createBackup()">
                                <i class="fas fa-cloud-upload-alt"></i>
                                Create Backup Now
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="restoreBackup()">
                                <i class="fas fa-undo"></i>
                                Restore from Backup
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="settings-section" id="danger">
                    <div class="glass-card section-card">
                        <div class="section-header">
                            <h2 class="section-title">
                                <i class="fas fa-exclamation-triangle"></i>
                                Danger Zone
                            </h2>
                            <p class="section-description">Irreversible actions that affect the entire system</p>
                        </div>

                        <div class="alert alert-danger">
                            <i class="fas fa-skull-crossbones"></i>
                            <div>
                                <strong>Warning:</strong> Actions in this section are permanent and cannot be undone. Proceed with extreme caution.
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div style="padding: 20px; border: 2px solid var(--danger); border-radius: 12px;">
                                <h4 style="margin-bottom: 8px; color: var(--danger);">Reset All User Data</h4>
                                <p style="color: var(--muted); margin-bottom: 16px; font-size: 0.9rem;">
                                    Delete all user accounts, profiles, and associated data. This action cannot be undone.
                                </p>
                                <button type="button" class="btn btn-danger" onclick="confirmDangerAction('resetUsers')">
                                    <i class="fas fa-users-slash"></i>
                                    Reset All Users
                                </button>
                            </div>

                            <div style="padding: 20px; border: 2px solid var(--danger); border-radius: 12px;">
                                <h4 style="margin-bottom: 8px; color: var(--danger);">Clear All Analytics</h4>
                                <p style="color: var(--muted); margin-bottom: 16px; font-size: 0.9rem;">
                                    Permanently delete all analytics data and metrics. This action cannot be undone.
                                </p>
                                <button type="button" class="btn btn-danger" onclick="confirmDangerAction('clearAnalytics')">
                                    <i class="fas fa-chart-line"></i>
                                    Clear Analytics
                                </button>
                            </div>

                            <div style="padding: 20px; border: 2px solid var(--danger); border-radius: 12px;">
                                <h4 style="margin-bottom: 8px; color: var(--danger);">Factory Reset</h4>
                                <p style="color: var(--muted); margin-bottom: 16px; font-size: 0.9rem;">
                                    Reset the entire system to factory defaults. All data will be permanently deleted.
                                </p>
                                <button type="button" class="btn btn-danger" onclick="confirmDangerAction('factoryReset')">
                                    <i class="fas fa-bomb"></i>
                                    Factory Reset System
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script nonce="<%= nonce %>">
        // Toast Notification
        function showToast(message, type = 'info', title = '', duration = 5000) {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast';
            
            const icons = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-circle',
                warning: 'fa-exclamation-triangle',
                info: 'fa-info-circle'
            };

            const colors = {
                success: '#10b981',
                error: '#ef4444',
                warning: '#f59e0b',
                info: '#6366f1'
            };

            toast.innerHTML = `
                <div style="width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: ${colors[type]}; background: linear-gradient(135deg, rgba(${type === 'success' ? '16, 185, 129' : type === 'error' ? '239, 68, 68' : type === 'warning' ? '245, 158, 11' : '99, 102, 241'}, 0.2) 0%, rgba(${type === 'success' ? '16, 185, 129' : type === 'error' ? '239, 68, 68' : type === 'warning' ? '245, 158, 11' : '99, 102, 241'}, 0.05) 100%);">
                    <i class="fas ${icons[type]}"></i>
                </div>
                <div style="flex: 1;">
                    <div style="font-weight: 600; margin-bottom: 4px;">${title || type.charAt(0).toUpperCase() + type.slice(1)}</div>
                    <div style="font-size: 0.9rem; color: var(--muted);">${message}</div>
                </div>
                <button onclick="this.parentElement.remove()" style="background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 1.2rem; padding: 0; width: 24px; height: 24px; border-radius: 6px;">
                    <i class="fas fa-times"></i>
                </button>
            `;

            toastContainer.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'slideOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards';
                setTimeout(() => toast.remove(), 400);
            }, duration);
        }

        // Navigation
        document.querySelectorAll('.nav-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const section = this.dataset.section;
                
                // Update active nav item
                document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                
                // Show corresponding section
                document.querySelectorAll('.settings-section').forEach(s => s.classList.remove('active'));
                document.getElementById(section).classList.add('active');
                
                // Scroll to top
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });

        // Form Submissions
        ['generalForm', 'securityForm', 'apiForm', 'emailForm', 'maintenanceForm'].forEach(formId => {
            const form = document.getElementById(formId);
            if (form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const formData = new FormData(this);
                    const data = Object.fromEntries(formData);
                    
                    try {
                        const response = await fetch('/admin/settings', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ section: formId.replace('Form', ''), data })
                        });
                        
                        const result = await response.json();
                        
                        if (result.success) {
                            showToast('Settings saved successfully', 'success', 'Success!');
                        } else {
                            showToast(result.error || 'Failed to save settings', 'error', 'Error');
                        }
                    } catch (error) {
                        showToast('Network error occurred', 'error', 'Error');
                    }
                });
            }
        });

        // Reset Form
        function resetForm(formId) {
            document.getElementById(formId).reset();
            showToast('Form reset to original values', 'info', 'Reset');
        }

        // Test Email
        async function testEmail() {
            showToast('Sending test email...', 'info', 'Testing');
            // Implement test email logic
            setTimeout(() => {
                showToast('Test email sent successfully', 'success', 'Success!');
            }, 2000);
        }

        // Clear Cache
        async function clearCache(type) {
            if (!confirm(`Are you sure you want to clear ${type} cache?`)) return;
            
            showToast(`Clearing ${type} cache...`, 'info', 'Processing');
            // Implement cache clearing logic
            setTimeout(() => {
                showToast(`${type} cache cleared successfully`, 'success', 'Success!');
            }, 1500);
        }

        // Download Logs
        function downloadLogs() {
            showToast('Preparing log download...', 'info', 'Downloading');
            // Implement log download
        }

        // Clear Logs
        function clearLogs() {
            if (!confirm('Are you sure you want to clear all logs? This cannot be undone.')) return;
            showToast('Logs cleared successfully', 'success', 'Success!');
        }

        // Backup Functions
        function createBackup() {
            showToast('Creating system backup...', 'info', 'Backup Started');
            // Implement backup logic
        }

        function restoreBackup() {
            if (!confirm('Restore from backup? This will overwrite current data.')) return;
            showToast('Restoring from backup...', 'info', 'Restore Started');
        }

        // Danger Actions
        function confirmDangerAction(action) {
            const confirmText = prompt('Type "CONFIRM" to proceed with this dangerous action:');
            if (confirmText !== 'CONFIRM') {
                showToast('Action cancelled', 'info', 'Cancelled');
                return;
            }
            
            showToast(`Executing ${action}...`, 'warning', 'Processing');
            // Implement danger actions
        }

        console.log('Settings page loaded successfully');
    </script>
</body>
</html>