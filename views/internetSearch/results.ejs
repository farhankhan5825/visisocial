<!-- views/internetSearch/results.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <link href="/stylesheets/visisocial.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/marked/lib/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <style nonce="<%= nonce %>">
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --primary-dark: #5b4fe0;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
            --shadow-soft: 0 8px 32px rgba(0, 0, 0, 0.2);
            --shadow-hard: 0 20px 60px rgba(0, 0, 0, 0.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            line-height: 1.7;
            overflow-x: hidden;
        }

        .search-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: 
                radial-gradient(circle at 20% 20%, rgba(124, 108, 255, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(52, 227, 255, 0.08) 0%, transparent 50%);
            animation: float 25s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            33% { transform: translate(30px, -20px) rotate(120deg); }
            66% { transform: translate(-20px, 30px) rotate(240deg); }
        }

        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 2rem 2rem 4rem;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--primary-light);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            padding: 0.75rem 1.5rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
        }

        .back-link:hover {
            gap: 0.75rem;
            background: var(--glass-hover);
            border-color: var(--primary);
        }

        .action-buttons {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .action-btn {
            padding: 0.75rem 1.5rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
            color: var(--light);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .action-btn:hover {
            background: var(--glass-hover);
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .action-btn.primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-color: transparent;
        }

        .action-btn.primary:hover {
            box-shadow: 0 8px 24px rgba(124, 108, 255, 0.4);
        }

        .search-info {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 2.5rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .search-info::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
        }

        .search-info-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 2rem;
            margin-bottom: 1.5rem;
        }

        .search-query {
            flex: 1;
            min-width: 250px;
        }

        .search-query-label {
            color: var(--muted);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .search-query-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--light);
            word-break: break-word;
        }

        .search-query-image {
            max-width: 250px;
            max-height: 120px;
            border-radius: 12px;
            margin-top: 0.75rem;
            box-shadow: var(--shadow-soft);
        }

        .search-meta {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(2, 6, 23, 0.4);
            border-radius: 50px;
            font-size: 0.85rem;
            color: var(--muted);
        }

        .meta-item i {
            color: var(--primary-light);
        }

        .search-status {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 2rem;
            border-radius: 50px;
            font-weight: 600;
        }

        .search-status.queued {
            background: linear-gradient(135deg, rgba(52, 227, 255, 0.2) 0%, rgba(8, 145, 178, 0.15) 100%);
            border: 1px solid rgba(52, 227, 255, 0.4);
            color: #67e8f9;
        }

        .search-status.running {
            background: linear-gradient(135deg, rgba(246, 178, 74, 0.2) 0%, rgba(255, 93, 108, 0.15) 100%);
            border: 1px solid rgba(246, 178, 74, 0.4);
            color: #fcd34d;
        }

        .search-status.complete {
            background: linear-gradient(135deg, rgba(45, 212, 168, 0.2) 0%, rgba(16, 185, 129, 0.15) 100%);
            border: 1px solid rgba(45, 212, 168, 0.4);
            color: #86efac;
        }

        .search-status.error {
            background: linear-gradient(135deg, rgba(255, 93, 108, 0.2) 0%, rgba(220, 38, 38, 0.15) 100%);
            border: 1px solid rgba(255, 93, 108, 0.4);
            color: #fca5a5;
        }

        .progress-container {
            margin-top: 1.5rem;
        }

        .progress-bar-wrapper {
            width: 100%;
            height: 10px;
            background: rgba(2, 6, 23, 0.5);
            border-radius: 50px;
            overflow: hidden;
            position: relative;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
            border-radius: 50px;
            transition: width 0.3s ease;
            position: relative;
        }

        .progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 0.75rem;
            font-size: 0.9rem;
            color: var(--muted);
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top-color: currentColor;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Analytics Cards */
        .analytics-section {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 3rem;
        }

        .analytics-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2.5rem;
        }

        .analytics-header i {
            font-size: 2rem;
            color: var(--primary-light);
        }

        .analytics-header h2 {
            font-size: 2rem;
            font-weight: 700;
        }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .analytics-card {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .analytics-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
        }

        .analytics-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
        }

        .analytics-value {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--primary-light) 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .analytics-label {
            color: var(--muted);
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        .analytics-sublabel {
            color: var(--muted);
            font-size: 0.75rem;
        }

        .comparison-bar {
            width: 100%;
            height: 6px;
            background: rgba(2, 6, 23, 0.5);
            border-radius: 50px;
            margin-top: 1rem;
            overflow: hidden;
        }

        .comparison-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--success) 0%, var(--primary) 50%, var(--danger) 100%);
            border-radius: 50px;
            transition: width 0.5s ease;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .summary-card {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2rem;
            text-align: center;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .summary-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
        }

        .summary-card.critical::before {
            background: var(--danger);
        }

        .summary-card.moderate::before {
            background: var(--warning);
        }

        .summary-card.low::before {
            background: var(--success);
        }

        .summary-card.info::before {
            background: var(--primary);
        }

        .summary-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-soft);
        }

        .summary-value {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 3rem;
            font-weight: 700;
            letter-spacing: -0.03em;
            margin-bottom: 0.5rem;
        }

        .summary-card.critical .summary-value {
            color: var(--danger);
        }

        .summary-card.moderate .summary-value {
            color: var(--warning);
        }

        .summary-card.low .summary-value {
            color: var(--success);
        }

        .summary-card.info .summary-value {
            background: linear-gradient(135deg, var(--primary-light) 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .summary-label {
            color: var(--muted);
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .risk-score-card {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 3rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .risk-score-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            opacity: 0.05;
            background-size: 30px 30px;
            background-image: 
                linear-gradient(to right, var(--glass-border) 1px, transparent 1px),
                linear-gradient(to bottom, var(--glass-border) 1px, transparent 1px);
        }

        .risk-score-value {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 5rem;
            font-weight: 700;
            letter-spacing: -0.03em;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }

        .risk-critical .risk-score-value {
            color: var(--danger);
            text-shadow: 0 0 30px rgba(255, 93, 108, 0.5);
        }

        .risk-high .risk-score-value {
            color: var(--warning);
            text-shadow: 0 0 30px rgba(246, 178, 74, 0.5);
        }

        .risk-medium .risk-score-value {
            color: var(--accent);
            text-shadow: 0 0 30px rgba(52, 227, 255, 0.5);
        }

        .risk-low .risk-score-value {
            color: var(--success);
            text-shadow: 0 0 30px rgba(45, 212, 168, 0.5);
        }

        .risk-label {
            font-size: 1.5rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            z-index: 1;
        }

        /* AI Insights */
        .insights-section {
            background: linear-gradient(135deg, rgba(124, 108, 255, 0.1) 0%, rgba(139, 92, 246, 0.05) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(124, 108, 255, 0.3);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 3rem;
        }

        .insights-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .insights-header i {
            font-size: 2rem;
            color: var(--primary-light);
        }

        .insights-header h2 {
            font-size: 2rem;
            font-weight: 700;
        }

        .insight-card {
            background: rgba(2, 6, 23, 0.4);
            border-left: 4px solid;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

        .insight-card:hover {
            transform: translateX(4px);
            background: rgba(2, 6, 23, 0.6);
        }

        .insight-card.critical {
            border-color: var(--danger);
        }

        .insight-card.warning {
            border-color: var(--warning);
        }

        .insight-card.info {
            border-color: var(--accent);
        }

        .insight-card.success {
            border-color: var(--success);
        }

        .insight-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }

        .insight-icon {
            font-size: 1.5rem;
        }

        .insight-card.critical .insight-icon {
            color: var(--danger);
        }

        .insight-card.warning .insight-icon {
            color: var(--warning);
        }

        .insight-card.info .insight-icon {
            color: var(--accent);
        }

        .insight-card.success .insight-icon {
            color: var(--success);
        }

        .insight-title {
            font-weight: 600;
            font-size: 1.1rem;
        }

        .insight-message {
            color: var(--muted);
            margin-bottom: 1rem;
        }

        .insight-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .insight-action {
            padding: 0.5rem 1rem;
            background: rgba(2, 6, 23, 0.5);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
            font-size: 0.85rem;
            color: var(--light);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .insight-action:hover {
            background: var(--glass-hover);
            border-color: var(--primary);
        }

        /* AI Profile Section */
        .ai-profile-section {
            background: linear-gradient(135deg, rgba(124, 108, 255, 0.1) 0%, rgba(139, 92, 246, 0.05) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(124, 108, 255, 0.3);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 3rem;
        }

        .ai-profile-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .ai-profile-title {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .ai-profile-title i {
            font-size: 2rem;
            color: var(--primary-light);
        }

        .ai-profile-title h2 {
            font-size: 2rem;
            font-weight: 700;
        }

        .ai-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(124, 108, 255, 0.2);
            border: 1px solid rgba(124, 108, 255, 0.4);
            border-radius: 50px;
            font-size: 0.85rem;
            color: var(--primary-light);
        }

        .ai-profile-content {
            background: rgba(2, 6, 23, 0.3);
            border-radius: 16px;
            padding: 2.5rem;
            line-height: 1.9;
            max-height: none;
        }

        /* Proper markdown styling */
        .ai-profile-content h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--light);
            margin: 2.5rem 0 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--primary);
        }

        .ai-profile-content h1:first-child {
            margin-top: 0;
        }

        .ai-profile-content h2 {
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--primary-light);
            margin: 2rem 0 1rem;
        }

        .ai-profile-content h3 {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--accent);
            margin: 1.5rem 0 1rem;
        }

        .ai-profile-content h4 {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--light);
            margin: 1.25rem 0 0.75rem;
        }

        .ai-profile-content p {
            color: var(--light);
            margin-bottom: 1.25rem;
            font-size: 1rem;
        }

        .ai-profile-content ul,
        .ai-profile-content ol {
            margin-left: 2rem;
            margin-bottom: 1.5rem;
            color: var(--light);
        }

        .ai-profile-content li {
            margin-bottom: 0.75rem;
            line-height: 1.8;
        }

        .ai-profile-content strong {
            color: var(--primary-light);
            font-weight: 600;
        }

        .ai-profile-content em {
            color: var(--accent);
            font-style: italic;
        }

        .ai-profile-content code {
            background: rgba(2, 6, 23, 0.6);
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
            color: var(--accent);
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
        }

        .ai-profile-content pre {
            background: rgba(2, 6, 23, 0.8);
            border: 1px solid var(--glass-border);
            border-radius: 8px;
            padding: 1.5rem;
            overflow-x: auto;
            margin-bottom: 1.5rem;
        }

        .ai-profile-content pre code {
            background: none;
            padding: 0;
            border-radius: 0;
        }

        .ai-profile-content blockquote {
            border-left: 4px solid var(--primary);
            padding-left: 1.5rem;
            margin: 1.5rem 0;
            color: var(--muted);
            font-style: italic;
        }

        .ai-profile-content hr {
            border: none;
            height: 1px;
            background: var(--glass-border);
            margin: 2rem 0;
        }

        .ai-profile-content a {
            color: var(--primary-light);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: all 0.3s ease;
        }

        .ai-profile-content a:hover {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        /* Image Analysis */
        .image-analysis-section {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 3rem;
        }

        .image-analysis-grid {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 2.5rem;
        }

        .image-container {
            position: relative;
        }

        .analyzed-image {
            width: 100%;
            border-radius: 16px;
            box-shadow: var(--shadow-hard);
        }

        .image-metadata {
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(2, 6, 23, 0.4);
            border-radius: 12px;
            font-size: 0.85rem;
        }

        .image-metadata-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--glass-border);
        }

        .image-metadata-item:last-child {
            border-bottom: none;
        }

        .image-analysis-content {
            background: rgba(2, 6, 23, 0.3);
            border-radius: 16px;
            padding: 2rem;
            line-height: 1.8;
        }

        .reverse-image-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-top: 2rem;
        }

        .reverse-link-card {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            text-decoration: none;
            color: var(--light);
        }

        .reverse-link-card:hover {
            background: rgba(2, 6, 23, 0.6);
            border-color: var(--primary);
            transform: translateY(-4px);
            box-shadow: var(--shadow-soft);
        }

        .reverse-link-card i {
            font-size: 2.5rem;
            color: var(--primary-light);
            margin-bottom: 1rem;
            display: block;
        }

        .reverse-link-card h4 {
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .reverse-link-card p {
            font-size: 0.85rem;
            color: var(--muted);
            margin-bottom: 0.75rem;
        }

        .priority-badge {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .priority-high {
            background: rgba(255, 93, 108, 0.2);
            color: #fca5a5;
            border: 1px solid rgba(255, 93, 108, 0.4);
        }

        .priority-medium {
            background: rgba(246, 178, 74, 0.2);
            color: #fcd34d;
            border: 1px solid rgba(246, 178, 74, 0.4);
        }

        .priority-low {
            background: rgba(45, 212, 168, 0.2);
            color: #86efac;
            border: 1px solid rgba(45, 212, 168, 0.4);
        }

        .results-section {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 2rem;
        }

        .results-section h2 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .results-section h2 i {
            color: var(--primary-light);
        }

        .section-count {
            background: rgba(124, 108, 255, 0.2);
            padding: 0.3rem 0.9rem;
            border-radius: 50px;
            font-size: 0.9rem;
            color: var(--primary-light);
            border: 1px solid rgba(124, 108, 255, 0.4);
        }

        .result-item {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

        .result-item:hover {
            background: rgba(2, 6, 23, 0.6);
            border-color: var(--primary);
            transform: translateX(4px);
        }

        .result-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .result-title {
            flex: 1;
            font-weight: 600;
            color: var(--light);
            font-size: 1.1rem;
        }

        .result-url {
            color: var(--primary-light);
            font-size: 0.9rem;
            margin-bottom: 0.75rem;
            word-break: break-all;
            text-decoration: none;
            display: block;
            transition: all 0.3s ease;
        }

        .result-url:hover {
            color: var(--accent);
            text-decoration: underline;
        }

        .result-snippet {
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .result-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .result-badge {
            padding: 0.4rem 0.875rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .badge-source {
            background: rgba(124, 108, 255, 0.2);
            border: 1px solid rgba(124, 108, 255, 0.4);
            color: var(--primary-light);
        }

        .badge-verified {
            background: rgba(45, 212, 168, 0.2);
            border: 1px solid rgba(45, 212, 168, 0.4);
            color: #86efac;
        }

        .badge-unverified {
            background: rgba(148, 163, 184, 0.2);
            border: 1px solid rgba(148, 163, 184, 0.4);
            color: var(--muted);
        }

        .badge-critical {
            background: rgba(255, 93, 108, 0.2);
            border: 1px solid rgba(255, 93, 108, 0.4);
            color: #fca5a5;
        }

        .badge-moderate {
            background: rgba(246, 178, 74, 0.2);
            border: 1px solid rgba(246, 178, 74, 0.4);
            color: #fcd34d;
        }

        .badge-low {
            background: rgba(45, 212, 168, 0.2);
            border: 1px solid rgba(45, 212, 168, 0.4);
            color: #86efac;
        }

        /* Social Media Grid */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .social-card {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            text-decoration: none;
            color: var(--light);
            position: relative;
            overflow: hidden;
        }

        .social-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
        }

        .social-card.verified::before {
            background: var(--success);
        }

        .social-card.search-only::before {
            background: var(--muted);
        }

        .social-card:hover {
            background: rgba(2, 6, 23, 0.6);
            transform: translateY(-4px);
            border-color: var(--primary);
            box-shadow: var(--shadow-soft);
        }

        .social-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 1rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        .social-card.verified .social-icon {
            background: linear-gradient(135deg, var(--success) 0%, #16a34a 100%);
        }

        .social-card.search-only .social-icon {
            background: linear-gradient(135deg, var(--muted) 0%, #64748b 100%);
        }

        .social-name {
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
        }

        .social-username {
            color: var(--primary-light);
            font-size: 0.9rem;
            margin-bottom: 0.75rem;
        }

        .social-description {
            font-size: 0.85rem;
            color: var(--muted);
            margin-bottom: 1rem;
        }

        .social-verified {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.8rem;
            background: rgba(45, 212, 168, 0.2);
            border: 1px solid rgba(45, 212, 168, 0.4);
            border-radius: 50px;
            font-size: 0.75rem;
            color: #86efac;
            margin-top: 0.5rem;
        }

        .section-divider {
            margin: 2rem 0 1.5rem;
            padding: 1rem;
            background: rgba(2, 6, 23, 0.5);
            border-radius: 8px;
            border-left: 4px solid var(--primary);
        }

        .section-divider h3 {
            font-size: 1.2rem;
            color: var(--primary-light);
            margin-bottom: 0.5rem;
        }

        .section-divider p {
            font-size: 0.9rem;
            color: var(--muted);
        }

        .tags-container {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .tag {
            padding: 0.4rem 0.9rem;
            background: rgba(2, 6, 23, 0.5);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
            font-size: 0.8rem;
            color: var(--muted);
        }

        .export-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .export-modal.active {
            display: flex;
        }

        .export-content {
            background: var(--dark);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            max-width: 500px;
            width: 90%;
        }

        .export-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-top: 2rem;
        }

        .export-option {
            padding: 1.5rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            color: var(--light);
        }

        .export-option:hover {
            background: var(--glass-hover);
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .export-option i {
            font-size: 2rem;
            color: var(--primary-light);
            margin-bottom: 0.5rem;
        }

        .empty-results {
            text-align: center;
            padding: 5rem 2rem;
            color: var(--muted);
        }

        .empty-results i {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            opacity: 0.5;
        }

        .empty-results h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--light);
        }

        @media (max-width: 1024px) {
            .analytics-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .image-analysis-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 1.5rem 1rem 3rem;
            }

            .summary-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .analytics-grid {
                grid-template-columns: 1fr;
            }

            .social-grid {
                grid-template-columns: 1fr;
            }

            .risk-score-value {
                font-size: 3.5rem;
            }

            .top-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .action-buttons {
                width: 100%;
            }

            .action-btn {
                flex: 1;
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .summary-grid {
                grid-template-columns: 1fr;
            }

            .reverse-image-links {
                grid-template-columns: 1fr;
            }

            .export-options {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="search-bg"></div>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="top-bar">
            <a href="/internet-search" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Back to Dashboard
            </a>

            <% if (searchResult.status === 'complete') { %>
            <div class="action-buttons">
                <button class="action-btn" onclick="openExportModal()">
                    <i class="fas fa-download"></i>
                    Export Results
                </button>
                <button class="action-btn" onclick="shareResults()">
                    <i class="fas fa-share-alt"></i>
                    Share
                </button>
                <a href="/internet-search" class="action-btn primary">
                    <i class="fas fa-search"></i>
                    New Search
                </a>
            </div>
            <% } %>
        </div>

        <div class="search-info">
            <div class="search-info-row">
                <div class="search-query">
                    <div class="search-query-label">
                        <i class="fas fa-<%= searchResult.searchType === 'email' ? 'envelope' : searchResult.searchType === 'phone' ? 'phone' : searchResult.searchType === 'image' ? 'image' : searchResult.searchType === 'username' ? 'user' : 'id-card' %>"></i>
                        <%= searchResult.searchType.charAt(0).toUpperCase() + searchResult.searchType.slice(1) %> Search
                    </div>
                    <div class="search-query-value">
                        <% if (searchResult.searchType === 'image' && searchResult.searchValue.includes('/uploads/images/')) { %>
                            <img src="<%= searchResult.searchValue %>" class="search-query-image" alt="Search Image">
                        <% } else { %>
                            <%= searchResult.searchValue %>
                        <% } %>
                    </div>

                    <div class="search-meta">
                        <div class="meta-item">
                            <i class="fas fa-clock"></i>
                            <span><%= new Date(searchResult.createdAt).toLocaleString() %></span>
                        </div>
                        <% if (searchResult.duration) { %>
                        <div class="meta-item">
                            <i class="fas fa-hourglass-half"></i>
                            <span><%= (searchResult.duration / 1000).toFixed(1) %>s duration</span>
                        </div>
                        <% } %>
                        <div class="meta-item">
                            <i class="fas fa-fingerprint"></i>
                            <span><%= searchResult.searchId.split('-')[0] %></span>
                        </div>
                    </div>

                    <% if (searchResult.tags && searchResult.tags.length > 0) { %>
                    <div class="tags-container">
                        <% searchResult.tags.forEach(tag => { %>
                        <span class="tag"><%= tag %></span>
                        <% }) %>
                    </div>
                    <% } %>
                </div>

                <div class="search-status <%= searchResult.status %>">
                    <% if (searchResult.status === 'queued') { %>
                    <div class="spinner"></div>
                    <span id="statusText">Queued...</span>
                    <% } else if (searchResult.status === 'running') { %>
                    <div class="spinner"></div>
                    <span id="statusText">Searching...</span>
                    <% } else if (searchResult.status === 'complete') { %>
                    <i class="fas fa-check-circle"></i>
                    <span>Complete</span>
                    <% } else if (searchResult.status === 'error') { %>
                    <i class="fas fa-exclamation-circle"></i>
                    <span>Error</span>
                    <% } %>
                </div>
            </div>

            <% if (searchResult.status === 'running' || searchResult.status === 'queued') { %>
            <div class="progress-container">
                <div class="progress-bar-wrapper">
                    <div class="progress-bar" id="progressBar" style="width: <%= searchResult.metadata?.lastProgress || 0 %>%"></div>
                </div>
                <div class="progress-info">
                    <span id="progressPhase"><%= searchResult.metadata?.lastMessage || 'Initializing...' %></span>
                    <span id="progressPercent"><%= searchResult.metadata?.lastProgress || 0 %>%</span>
                </div>
            </div>
            <% } %>
        </div>

        <% if (searchResult.status === 'complete') { %>
        
        <!-- Summary Cards -->
        <div class="summary-grid">
            <div class="summary-card info">
                <div class="summary-value"><%= searchResult.summary.totalResults %></div>
                <div class="summary-label">Total Results</div>
            </div>

            <div class="summary-card critical">
                <div class="summary-value"><%= searchResult.summary.criticalFindings %></div>
                <div class="summary-label">Critical Findings</div>
            </div>

            <div class="summary-card moderate">
                <div class="summary-value"><%= searchResult.summary.moderateFindings %></div>
                <div class="summary-label">Moderate Risk</div>
            </div>

            <div class="summary-card low">
                <div class="summary-value"><%= searchResult.summary.lowRiskFindings %></div>
                <div class="summary-label">Low Risk</div>
            </div>
        </div>

        <!-- Risk Score -->
        <div class="risk-score-card risk-<%= searchResult.summary.overallRisk.toLowerCase() %>">
            <div class="risk-score-value"><%= searchResult.summary.riskScore %>/100</div>
            <div class="risk-label"><%= searchResult.summary.overallRisk %> RISK</div>
        </div>

        <!-- Analytics Section -->
        <% if (analytics) { %>
        <section class="analytics-section">
            <div class="analytics-header">
                <i class="fas fa-chart-line"></i>
                <h2>Advanced Analytics</h2>
            </div>

            <div class="analytics-grid">
                <div class="analytics-card">
                    <div class="analytics-value"><%= analytics.uniqueness %>%</div>
                    <div class="analytics-label">Uniqueness</div>
                    <div class="analytics-sublabel">Data distinctiveness score</div>
                    <div class="comparison-bar">
                        <div class="comparison-fill" style="width: <%= analytics.uniqueness %>%"></div>
                    </div>
                </div>

                <div class="analytics-card">
                    <div class="analytics-value"><%= analytics.completeness %>%</div>
                    <div class="analytics-label">Completeness</div>
                    <div class="analytics-sublabel">Source coverage</div>
                    <div class="comparison-bar">
                        <div class="comparison-fill" style="width: <%= analytics.completeness %>%"></div>
                    </div>
                </div>

                <div class="analytics-card">
                    <div class="analytics-value"><%= analytics.confidence %>%</div>
                    <div class="analytics-label">Confidence</div>
                    <div class="analytics-sublabel">Result reliability</div>
                    <div class="comparison-bar">
                        <div class="comparison-fill" style="width: <%= analytics.confidence %>%"></div>
                    </div>
                </div>

                <div class="analytics-card">
                    <div class="analytics-value"><%= analytics.dataFreshness %>%</div>
                    <div class="analytics-label">Data Freshness</div>
                    <div class="analytics-sublabel">Recency score</div>
                    <div class="comparison-bar">
                        <div class="comparison-fill" style="width: <%= analytics.dataFreshness %>%"></div>
                    </div>
                </div>

                <% if (comparisonStats && comparisonStats.avgRisk) { %>
                <div class="analytics-card">
                    <div class="analytics-value"><%= Math.round(comparisonStats.avgRisk) %></div>
                    <div class="analytics-label">Type Average</div>
                    <div class="analytics-sublabel">vs. <%= searchResult.summary.riskScore %> yours</div>
                </div>
                <% } %>

                <div class="analytics-card">
                    <div class="analytics-value"><%= analytics.impactScore %>%</div>
                    <div class="analytics-label">Impact Score</div>
                    <div class="analytics-sublabel">Overall exposure</div>
                    <div class="comparison-bar">
                        <div class="comparison-fill" style="width: <%= analytics.impactScore %>%"></div>
                    </div>
                </div>
            </div>
        </section>
        <% } %>

        <!-- AI Insights -->
        <% if (aiInsights && aiInsights.length > 0) { %>
        <section class="insights-section">
            <div class="insights-header">
                <i class="fas fa-lightbulb"></i>
                <h2>AI-Powered Insights</h2>
            </div>

            <% aiInsights.forEach(insight => { %>
            <div class="insight-card <%= insight.type %>">
                <div class="insight-header">
                    <i class="<%= insight.icon %> insight-icon"></i>
                    <div class="insight-title"><%= insight.title %></div>
                </div>
                <div class="insight-message"><%= insight.message %></div>
                <% if (insight.actionable && insight.actions) { %>
                <div class="insight-actions">
                    <% insight.actions.forEach(action => { %>
                    <button class="insight-action"><%= action %></button>
                    <% }) %>
                </div>
                <% } %>
            </div>
            <% }) %>
        </section>
        <% } %>

        <!-- AI Profile Section -->
        <% if (searchResult.aiProfile && searchResult.aiProfile.fullProfile) { %>
        <section class="ai-profile-section">
            <div class="ai-profile-header">
                <div class="ai-profile-title">
                    <i class="fas fa-brain"></i>
                    <h2>AI-Generated Intelligence Profile</h2>
                </div>
                <span class="ai-badge">
                    <i class="fas fa-robot"></i>
                    Powered by <%= searchResult.aiProfile.model || 'GPT-4o-mini' %>
                </span>
            </div>
            <div class="ai-profile-content" id="aiProfileContent"></div>
        </section>
        <% } %>

        <!-- Image Analysis Section -->
        <% if (searchResult.searchType === 'image' && searchResult.sources.imageAnalysis) { %>
        <section class="image-analysis-section">
            <h2>
                <i class="fas fa-image"></i>
                AI Image Analysis
            </h2>

            <div class="image-analysis-grid">
                <div class="image-container">
                    <img src="<%= searchResult.searchValue %>" alt="Analyzed Image" class="analyzed-image">
                    
                    <% if (searchResult.sources.imageMetadata) { %>
                    <div class="image-metadata">
                        <div class="image-metadata-item">
                            <span>Status:</span>
                            <span><%= searchResult.sources.imageMetadata.accessible ? '✓ Accessible' : '✗ Not Accessible' %></span>
                        </div>
                        <% if (searchResult.sources.imageMetadata.contentType) { %>
                        <div class="image-metadata-item">
                            <span>Type:</span>
                            <span><%= searchResult.sources.imageMetadata.contentType %></span>
                        </div>
                        <% } %>
                        <% if (searchResult.sources.imageMetadata.contentLength) { %>
                        <div class="image-metadata-item">
                            <span>Size:</span>
                            <span><%= (searchResult.sources.imageMetadata.contentLength / 1024).toFixed(1) %> KB</span>
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                </div>
                
                <div class="image-analysis-content" id="imageAnalysisContent">
                    <% if (searchResult.sources.imageAnalysis.fullAnalysis) { %>
                        <%= searchResult.sources.imageAnalysis.fullAnalysis %>
                    <% } else { %>
                        <p style="color: var(--muted);">Image analysis not available</p>
                    <% } %>
                </div>
            </div>

            <% if (searchResult.sources.reverseImageLinks && searchResult.sources.reverseImageLinks.length > 0) { %>
            <h3 style="margin: 3rem 0 1.5rem; font-size: 1.5rem;">
                <i class="fas fa-search"></i>
                Reverse Image Search Engines
            </h3>
            <div class="reverse-image-links">
                <% searchResult.sources.reverseImageLinks.forEach(link => { %>
                <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="reverse-link-card">
                    <i class="fas fa-search"></i>
                    <h4><%= link.engine %></h4>
                    <p><%= link.description %></p>
                    <% if (link.priority) { %>
                    <span class="priority-badge priority-<%= link.priority.toLowerCase() %>">
                        <%= link.priority %>
                    </span>
                    <% } %>
                </a>
                <% }) %>
            </div>
            <% } %>
        </section>
        <% } %>

        <!-- Infrastructure Exposure (Shodan) -->
        <% if (searchResult.sources.infrastructure) { var infra = searchResult.sources.infrastructure; %>
        <style nonce="<%= nonce %>">
          .infra-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 1.25rem; }
          .infra-chip { display: inline-flex; align-items: center; gap: 7px; font-family: 'JetBrains Mono', monospace; font-size: .75rem; color: var(--muted); background: rgba(255,255,255,.03); border: 1px solid var(--glass-border); border-radius: 999px; padding: 6px 12px; }
          .infra-chip i { color: var(--accent); }
          .port-grid, .vuln-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1.25rem; }
          .port-chip { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: .8rem; color: var(--primary-light); background: rgba(124,108,255,.1); border: 1px solid rgba(124,108,255,.3); border-radius: 8px; padding: 6px 11px; }
          .vuln-chip { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: .78rem; color: var(--danger); background: rgba(255,93,108,.1); border: 1px solid rgba(255,93,108,.35); border-radius: 8px; padding: 6px 11px; }
          .svc-list { display: grid; gap: 10px; }
          .svc-row { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 14px 16px; border: 1px solid var(--glass-border); border-radius: 14px; background: rgba(255,255,255,.015); }
          .svc-port { font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--accent); font-size: .95rem; min-width: 64px; }
          .svc-name { color: var(--light); font-size: .9rem; }
          .svc-name small { color: var(--muted); display: block; font-size: .78rem; margin-top: 2px; }
          .svc-tag { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
          .infra-note { color: var(--muted); font-size: .82rem; margin-top: 1rem; }
          @media (max-width: 560px) { .svc-row { grid-template-columns: auto 1fr; } .svc-row .svc-tag { display: none; } }
        </style>
        <section class="results-section">
            <h2>
                <i class="fas fa-server"></i>
                Infrastructure Exposure
                <span class="section-count"><%= (infra.services && infra.services.length) || (infra.ports && infra.ports.length) || 0 %></span>
            </h2>

            <div class="infra-meta">
                <span class="infra-chip"><i class="fas fa-crosshairs"></i><%= infra.target %><% if (infra.resolvedIp && infra.resolvedIp !== infra.target) { %> · <%= infra.resolvedIp %><% } %></span>
                <% if (infra.org) { %><span class="infra-chip"><i class="fas fa-building"></i><%= infra.org %></span><% } %>
                <% if (infra.location) { %><span class="infra-chip"><i class="fas fa-location-dot"></i><%= infra.location %></span><% } %>
                <% if (infra.os) { %><span class="infra-chip"><i class="fas fa-microchip"></i><%= infra.os %></span><% } %>
            </div>

            <% if (infra.ports && infra.ports.length) { %>
            <div class="svc-tag" style="margin-bottom: .6rem;">Open ports</div>
            <div class="port-grid">
                <% infra.ports.forEach(function(p){ %><span class="port-chip"><%= p %></span><% }); %>
            </div>
            <% } %>

            <% if (infra.software && infra.software.length) { %>
            <div class="svc-tag" style="margin-bottom: .6rem;">Software detected</div>
            <div class="port-grid">
                <% infra.software.slice(0, 24).forEach(function(cpe){ var parts = String(cpe).replace('cpe:2.3:', '').replace('cpe:/', '').replace(/^[apoh]:/, '').split(':').filter(function(x){ return x && x !== '*'; }); var label = parts.slice(0, 3).join(' '); %><span class="port-chip" style="color: var(--accent); background: rgba(52,227,255,.08); border-color: rgba(52,227,255,.3);"><%= label || cpe %></span><% }); %>
            </div>
            <% } %>

            <% if (infra.vulns && infra.vulns.length) { %>
            <div class="svc-tag" style="margin-bottom: .6rem; color: var(--danger);">Known vulnerabilities (<%= infra.vulns.length %>)</div>
            <div class="vuln-grid">
                <% infra.vulns.slice(0, 40).forEach(function(v){ %><a class="vuln-chip" href="https://nvd.nist.gov/vuln/detail/<%= v %>" target="_blank" rel="noopener noreferrer"><%= v %></a><% }); %>
            </div>
            <% } %>

            <% if (infra.services && infra.services.length) { %>
            <div class="svc-tag" style="margin-bottom: .6rem;">Exposed services</div>
            <div class="svc-list">
                <% infra.services.forEach(function(s){ %>
                <div class="svc-row">
                    <span class="svc-port"><%= s.port %><% if (s.transport) { %>/<%= s.transport %><% } %></span>
                    <span class="svc-name"><%= s.product || 'Unknown service' %><% if (s.version) { %> <%= s.version %><% } %><% if (s.hostnames && s.hostnames.length) { %><small><%= s.hostnames.slice(0, 2).join(', ') %></small><% } %></span>
                    <span class="svc-tag"><%= s.ip %></span>
                </div>
                <% }); %>
            </div>
            <% } %>

            <p class="infra-note"><i class="fas fa-circle-info"></i> Public-internet exposure reported by Shodan for the host behind this <%= infra.targetType %>. Open ports and services are what any outside scanner can already see.</p>
        </section>
        <% } %>

        <!-- Data Breaches -->
        <% if (searchResult.sources.breaches && searchResult.sources.breaches.length > 0) { %>
        <section class="results-section">
            <h2>
                <i class="fas fa-exclamation-triangle"></i>
                Data Breaches
                <span class="section-count"><%= searchResult.sources.breaches.length %></span>
            </h2>

            <% searchResult.sources.breaches.forEach(breach => { %>
            <div class="result-item">
                <div class="result-header">
                    <div class="result-title">
                        <%= breach.name || breach.title %>
                        <% if (breach.isVerified) { %>
                        <i class="fas fa-check-circle" style="color: var(--success); margin-left: 0.5rem;" title="Verified breach"></i>
                        <% } %>
                    </div>
                    <span class="result-badge badge-critical">CRITICAL</span>
                </div>
                <div class="result-snippet"><%= breach.description %></div>
                <div class="result-meta">
                    <% if (breach.domain) { %>
                    <span class="result-badge badge-source"><%= breach.domain %></span>
                    <% } %>
                    <span style="color: var(--muted); font-size: 0.9rem;">
                        <i class="fas fa-calendar"></i> <%= breach.breachDate %>
                    </span>
                    <% if (breach.pwnCount) { %>
                    <span style="color: var(--muted); font-size: 0.9rem;">
                        <i class="fas fa-users"></i> <%= breach.pwnCount.toLocaleString() %> accounts
                    </span>
                    <% } %>
                    <% if (breach.dataClasses && breach.dataClasses.length > 0) { %>
                    <span style="color: var(--warning); font-size: 0.9rem;">
                        <i class="fas fa-database"></i> <%= breach.dataClasses.join(', ') %>
                    </span>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </section>
        <% } %>

        <!-- Paste Site Leaks -->
        <% if (searchResult.sources.pastes && searchResult.sources.pastes.length > 0) { %>
        <section class="results-section">
            <h2>
                <i class="fas fa-file-alt"></i>
                Paste Site Leaks
                <span class="section-count"><%= searchResult.sources.pastes.length %></span>
            </h2>

            <% searchResult.sources.pastes.forEach(paste => { %>
            <div class="result-item">
                <div class="result-header">
                    <div class="result-title"><%= paste.title || 'Untitled Paste' %></div>
                    <span class="result-badge badge-critical">CRITICAL</span>
                </div>
                <div class="result-meta">
                    <span class="result-badge badge-source"><%= paste.source %></span>
                    <% if (paste.date) { %>
                    <span style="color: var(--muted); font-size: 0.9rem;">
                        <i class="fas fa-calendar"></i> <%= paste.date %>
                    </span>
                    <% } %>
                    <% if (paste.emailCount) { %>
                    <span style="color: var(--muted); font-size: 0.9rem;">
                        <i class="fas fa-envelope"></i> <%= paste.emailCount %> emails
                    </span>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </section>
        <% } %>

        <!-- Search Engine Results -->
        <% if (searchResult.sources.searchEngines && searchResult.sources.searchEngines.length > 0) { %>
        <section class="results-section">
            <h2>
                <i class="fas fa-search"></i>
                Search Engine Results
                <span class="section-count"><%= searchResult.sources.searchEngines.length %></span>
            </h2>

            <% searchResult.sources.searchEngines.slice(0, 30).forEach(result => { %>
            <div class="result-item">
                <div class="result-header">
                    <div class="result-title"><%= result.title %></div>
                    <% if (result.riskLevel) { %>
                    <span class="result-badge badge-<%= result.riskLevel.toLowerCase() %>">
                        <%= result.riskLevel %>
                    </span>
                    <% } %>
                </div>
                <a href="<%= result.url %>" target="_blank" rel="noopener noreferrer" class="result-url">
                    <i class="fas fa-external-link-alt" style="font-size: 0.75rem; margin-right: 0.25rem;"></i>
                    <%= result.url %>
                </a>
                <div class="result-snippet"><%= result.snippet %></div>
                <div class="result-meta">
                    <span class="result-badge badge-source"><%= result.source %></span>
                    <% if (result.riskReason) { %>
                    <span style="color: var(--muted); font-size: 0.85rem;">
                        <i class="fas fa-info-circle"></i> <%= result.riskReason %>
                    </span>
                    <% } %>
                    <% if (result.displayLink) { %>
                    <span style="color: var(--muted); font-size: 0.85rem;">
                        <i class="fas fa-link"></i> <%= result.displayLink %>
                    </span>
                    <% } %>
                </div>
            </div>
            <% }) %>

            <% if (searchResult.sources.searchEngines.length > 30) { %>
            <div style="text-align: center; margin-top: 2rem; color: var(--muted);">
                <p>Showing 30 of <%= searchResult.sources.searchEngines.length %> results</p>
            </div>
            <% } %>
        </section>
        <% } %>

        <!-- Social Media -->
        <% if (searchResult.sources.socialMedia && searchResult.sources.socialMedia.length > 0) { %>
        <%
            const verifiedAccounts = searchResult.sources.socialMedia.filter(p => p.verified);
            const unverifiedAccounts = searchResult.sources.socialMedia.filter(p => p.status === 'unknown' && !p.verified);
            const searchOnlyAccounts = searchResult.sources.socialMedia.filter(p => p.status === 'search' || (!p.verified && p.status !== 'unknown'));
        %>
        <section class="results-section">
            <h2>
                <i class="fas fa-share-alt"></i>
                Social Media Platforms
                <span class="section-count"><%= searchResult.sources.socialMedia.length %></span>
            </h2>

            <% if (searchResult.summary.socialMediaStats) { %>
            <div style="margin-bottom: 2rem; padding: 1.5rem; background: rgba(2, 6, 23, 0.4); border-radius: 12px; border-left: 4px solid var(--primary);">
                <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
                    <div>
                        <span style="color: var(--success); font-weight: 600; font-size: 1.5rem;"><%= verifiedAccounts.length %></span>
                        <span style="color: var(--muted); margin-left: 0.5rem;">Verified Accounts</span>
                    </div>
                    <div>
                        <span style="color: var(--muted); font-weight: 600; font-size: 1.5rem;"><%= unverifiedAccounts.length %></span>
                        <span style="color: var(--muted); margin-left: 0.5rem;">Unverified</span>
                    </div>
                    <div>
                        <span style="color: var(--accent); font-weight: 600; font-size: 1.5rem;"><%= searchOnlyAccounts.length %></span>
                        <span style="color: var(--muted); margin-left: 0.5rem;">Search Links</span>
                    </div>
                </div>
            </div>
            <% } %>

            <% if (verifiedAccounts.length > 0) { %>
            <div class="section-divider">
                <h3><i class="fas fa-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Verified Accounts</h3>
                <p>Confirmed and verified social media profiles</p>
            </div>
            <div class="social-grid">
                <% verifiedAccounts.forEach(platform => { %>
                <a href="<%= platform.profileUrl || platform.searchUrl %>" target="_blank" rel="noopener noreferrer" class="social-card verified">
                    <div class="social-icon">
                        <i class="<%= platform.icon || 'fas fa-globe' %>"></i>
                    </div>
                    <div class="social-name"><%= platform.platform %></div>
                    <% if (platform.username) { %>
                    <div class="social-username">@<%= platform.username %></div>
                    <% } %>
                    <div class="social-description"><%= platform.description %></div>
                    
                    <span class="social-verified">
                        <i class="fas fa-check-circle"></i>
                        Verified Account
                    </span>
                    
                    <% if (platform.additionalData) { %>
                    <div style="margin-top: 1rem; font-size: 0.8rem; color: var(--muted);">
                        <% if (platform.additionalData.followers) { %>
                        <div><i class="fas fa-users"></i> <%= platform.additionalData.followers.toLocaleString() %> followers</div>
                        <% } %>
                        <% if (platform.additionalData.repos) { %>
                        <div><i class="fas fa-code"></i> <%= platform.additionalData.repos %> repos</div>
                        <% } %>
                        <% if (platform.additionalData.karma) { %>
                        <div><i class="fas fa-star"></i> <%= platform.additionalData.karma.toLocaleString() %> karma</div>
                        <% } %>
                    </div>
                    <% } %>
                </a>
                <% }) %>
            </div>
            <% } %>

            <% if (searchOnlyAccounts.length > 0) { %>
            <div class="section-divider" style="margin-top: 2.5rem;">
                <h3><i class="fas fa-search" style="color: var(--muted); margin-right: 0.5rem;"></i>Search Links</h3>
                <p>Direct search links to find potential profiles on these platforms</p>
            </div>
            <div class="social-grid">
                <% searchOnlyAccounts.forEach(platform => { %>
                <a href="<%= platform.searchUrl || platform.profileUrl %>" target="_blank" rel="noopener noreferrer" class="social-card search-only">
                    <div class="social-icon">
                        <i class="<%= platform.icon || 'fas fa-globe' %>"></i>
                    </div>
                    <div class="social-name"><%= platform.platform %></div>
                    <div class="social-description"><%= platform.description %></div>
                    <span class="result-badge badge-unverified">Search Only</span>
                </a>
                <% }) %>
            </div>
            <% } %>
        </section>
        <% } %>

        <!-- Code Repositories -->
        <% if (searchResult.sources.codeRepositories && searchResult.sources.codeRepositories.length > 0) { %>
        <section class="results-section">
            <h2>
                <i class="fas fa-code"></i>
                Code Repositories
                <span class="section-count"><%= searchResult.sources.codeRepositories.length %></span>
            </h2>

            <% searchResult.sources.codeRepositories.forEach(repo => { %>
            <div class="result-item">
                <div class="result-title">
                    <i class="<%= repo.icon || 'fab fa-github' %>" style="margin-right: 0.5rem;"></i>
                    <%= repo.platform %>
                </div>
                <a href="<%= repo.url %>" target="_blank" rel="noopener noreferrer" class="result-url">
                    <i class="fas fa-external-link-alt" style="font-size: 0.75rem; margin-right: 0.25rem;"></i>
                    <%= repo.url %>
                </a>
                <div class="result-snippet"><%= repo.description %></div>
            </div>
            <% }) %>
        </section>
        <% } %>

        <!-- Professional Networks -->
        <% if (searchResult.sources.professionalNetworks && searchResult.sources.professionalNetworks.length > 0) { %>
        <section class="results-section">
            <h2>
                <i class="fas fa-briefcase"></i>
                Professional Networks
                <span class="section-count"><%= searchResult.sources.professionalNetworks.length %></span>
            </h2>

            <% searchResult.sources.professionalNetworks.forEach(network => { %>
            <div class="result-item">
                <div class="result-title">
                    <i class="<%= network.icon || 'fas fa-building' %>" style="margin-right: 0.5rem;"></i>
                    <%= network.network %>
                </div>
                <a href="<%= network.url %>" target="_blank" rel="noopener noreferrer" class="result-url">
                    <i class="fas fa-external-link-alt" style="font-size: 0.75rem; margin-right: 0.25rem;"></i>
                    <%= network.url %>
                </a>
            </div>
            <% }) %>
        </section>
        <% } %>

        <!-- Related Searches -->
        <% if (relatedSearches && relatedSearches.length > 0) { %>
        <section class="results-section">
            <h2>
                <i class="fas fa-link"></i>
                Related Searches
                <span class="section-count"><%= relatedSearches.length %></span>
            </h2>

            <div class="social-grid">
                <% relatedSearches.forEach(related => { %>
                <a href="/internet-search/results/<%= related.searchId %>" class="social-card">
                    <div class="social-icon">
                        <i class="fas fa-search"></i>
                    </div>
                    <div class="social-name"><%= related.searchType.charAt(0).toUpperCase() + related.searchType.slice(1) %></div>
                    <div class="social-username"><%= related.searchValue.substring(0, 30) %><%= related.searchValue.length > 30 ? '...' : '' %></div>
                    <% if (related.summary && related.summary.riskScore) { %>
                    <div style="margin-top: 1rem;">
                        <span class="result-badge badge-<%= related.summary.riskScore > 70 ? 'critical' : related.summary.riskScore > 40 ? 'moderate' : 'low' %>">
                            Risk: <%= related.summary.riskScore %>
                        </span>
                    </div>
                    <% } %>
                </a>
                <% }) %>
            </div>
        </section>
        <% } %>

        <% } else if (searchResult.status === 'running' || searchResult.status === 'queued') { %>
        
        <div class="empty-results">
            <div class="spinner" style="width: 60px; height: 60px; border-width: 6px; margin: 0 auto 2rem;"></div>
            <h3>Comprehensive OSINT Search in Progress</h3>
            <p>Scanning search engines, data breaches, social media platforms, code repositories, and generating AI-powered intelligence profile...</p>
            <% if (searchResult.metadata && searchResult.metadata.lastMessage) { %>
            <p style="margin-top: 1rem; color: var(--primary-light); font-weight: 600;">
                Current: <%= searchResult.metadata.lastMessage %>
            </p>
            <% } %>
        </div>

        <% } else if (searchResult.status === 'error') { %>
        
        <div class="empty-results">
            <i class="fas fa-exclamation-circle"></i>
            <h3>Search Failed</h3>
            <p><%= searchResult.error?.message || searchResult.error || 'An error occurred during the search' %></p>
            <a href="/internet-search" class="action-btn primary" style="margin-top: 2rem; display: inline-flex;">
                <i class="fas fa-search"></i>
                Try New Search
            </a>
        </div>

        <% } %>
    </div>

    <!-- Export Modal -->
    <div class="export-modal" id="exportModal">
        <div class="export-content">
            <h2 style="margin-bottom: 1rem;">
                <i class="fas fa-download"></i>
                Export Results
            </h2>
            <p style="color: var(--muted); margin-bottom: 2rem;">Choose your preferred export format</p>
            
            <div class="export-options">
                <a href="/internet-search/export/<%= searchResult.searchId %>/json" class="export-option">
                    <i class="fas fa-file-code"></i>
                    <div>JSON</div>
                </a>
                <a href="/internet-search/export/<%= searchResult.searchId %>/txt" class="export-option">
                    <i class="fas fa-file-alt"></i>
                    <div>Text</div>
                </a>
                <a href="/internet-search/export/<%= searchResult.searchId %>/csv" class="export-option">
                    <i class="fas fa-file-csv"></i>
                    <div>CSV</div>
                </a>
                <a href="/internet-search/export/<%= searchResult.searchId %>/html" class="export-option">
                    <i class="fas fa-file-code"></i>
                    <div>HTML</div>
                </a>
            </div>
            
            <button class="action-btn" onclick="closeExportModal()" style="width: 100%; margin-top: 2rem; justify-content: center;">
                Close
            </button>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script nonce="<%= nonce %>">
        <% if (searchResult.status === 'running' || searchResult.status === 'queued') { %>
        // Real-time progress tracking. Polling is PRIMARY (works with or without
        // sockets); sockets are an optional live-update enhancement on top.
        const SEARCH_ID = '<%= searchResult.searchId %>';
        const progressBar = document.getElementById('progressBar');
        const progressPhase = document.getElementById('progressPhase');
        const progressPercent = document.getElementById('progressPercent');
        const statusText = document.getElementById('statusText');

        const PHASE_LABELS = {
            'query_generation': 'Generating queries',
            'search_engines': 'Searching internet',
            'breach_check': 'Checking breaches',
            'infrastructure': 'Mapping infrastructure',
            'image_analysis': 'Analyzing image',
            'social_media': 'Verifying social accounts',
            'code_repos': 'Searching repositories',
            'paste_sites': 'Checking paste sites',
            'professional': 'Professional networks',
            'analysis': 'Analyzing results',
            'ai_profile': 'Generating AI profile',
            'complete': 'Complete'
        };

        function applyProgress(progress, message, phase) {
            if (progressBar && progress != null) progressBar.style.width = progress + '%';
            if (progressPercent && progress != null) progressPercent.textContent = progress + '%';
            if (progressPhase && message) progressPhase.textContent = message;
            if (statusText && phase) statusText.textContent = PHASE_LABELS[phase] || 'Processing...';
        }

        let reloading = false;
        function finish() {
            if (reloading) return;
            reloading = true;
            clearInterval(progressCheckInterval);
            setTimeout(() => window.location.reload(), 600);
        }

        // PRIMARY: poll the status API every 4s.
        const progressCheckInterval = setInterval(async () => {
            try {
                const r = await fetch('/internet-search/api/status/' + SEARCH_ID, { cache: 'no-store' });
                const data = await r.json();
                if (data && data.success && data.search) {
                    const s = data.search;
                    applyProgress(s.progress, s.message, s.phase);
                    if (s.status === 'complete' || s.status === 'error') finish();
                }
            } catch (e) { /* transient network error; keep polling */ }
        }, 4000);

        // Hard safety net: reload after 5 minutes no matter what.
        setTimeout(() => { if (!reloading) window.location.reload(); }, 300000);

        // ENHANCEMENT: live socket updates. A socket failure must NOT break polling.
        try {
            const socket = io();
            socket.on('search_progress', function(data) {
                if (data.searchId === SEARCH_ID) applyProgress(data.progress, data.message, data.phase);
            });
            socket.on('search_complete', function(data) {
                if (data.searchId === SEARCH_ID) finish();
            });
            socket.on('search_error', function(data) {
                if (data.searchId === SEARCH_ID) finish();
            });
        } catch (e) {
            console.warn('Live socket unavailable, using polling only:', e);
        }
        
        // Manual refresh button
        const refreshBtn = document.createElement('button');
        refreshBtn.className = 'action-btn';
        refreshBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh Status';
        refreshBtn.onclick = () => window.location.reload();
        refreshBtn.style.cssText = 'position: fixed; bottom: 2rem; right: 2rem; z-index: 100;';
        document.body.appendChild(refreshBtn);
        
        <% } %>

        // Format AI profile with proper markdown
        window.addEventListener('DOMContentLoaded', function() {
            const aiProfileContent = document.getElementById('aiProfileContent');
            if (aiProfileContent && typeof marked !== 'undefined') {
                const rawContent = <%- JSON.stringify((searchResult.aiProfile && searchResult.aiProfile.fullProfile) || '') %>;
                
                // Configure marked for better rendering
                marked.setOptions({
                    breaks: true,
                    gfm: true,
                    headerIds: false
                });
                
                try {
                    aiProfileContent.innerHTML = marked.parse(rawContent);
                } catch (e) {
                    console.error('Markdown parsing error:', e);
                    aiProfileContent.textContent = rawContent;
                }
            }
            
            // Format image analysis
            const imageAnalysisContent = document.getElementById('imageAnalysisContent');
            if (imageAnalysisContent && typeof marked !== 'undefined') {
                const rawContent = imageAnalysisContent.textContent;
                try {
                    imageAnalysisContent.innerHTML = marked.parse(rawContent);
                } catch (e) {
                    console.error('Markdown parsing error:', e);
                }
            }
        });

        function openExportModal() {
            document.getElementById('exportModal').classList.add('active');
        }

        function closeExportModal() {
            document.getElementById('exportModal').classList.remove('active');
        }

        function shareResults() {
            const url = window.location.href;
            if (navigator.share) {
                navigator.share({
                    title: '<%= title %>',
                    text: 'Check out these OSINT search results',
                    url: url
                });
            } else {
                navigator.clipboard.writeText(url);
                alert('Link copied to clipboard!');
            }
        }

        // Close modal on outside click
        document.getElementById('exportModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeExportModal();
            }
        });
    </script>
</body>
</html>