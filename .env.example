# VisiSocial configuration. Copy this file to .env and fill in the blanks.
# Never commit .env: it holds your keys and is ignored by Git.
# Tests and the evaluation (npm test, npm run eval) need none of this.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# development = local live mode: http://localhost origin, local MongoDB, binds to 127.0.0.1.
# production  = deployed live mode: HTTPS origin and a mongodb+srv:// (TLS) database.
NODE_ENV=development
PORT=3001
# Bare origin only (no path). Register <PUBLIC_ORIGIN>/auth/facebook/callback in your Facebook app.
PUBLIC_ORIGIN=http://localhost:3001
# Local example. In production use mongodb+srv://USER:PASSWORD@CLUSTER/visisocial
MONGODB_URI=mongodb://127.0.0.1:27017/visisocial

# ---------------------------------------------------------------------------
# Secrets (required). Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
# At least 32 characters.
SESSION_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes).
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Facebook (required). From developers.facebook.com > your app > Settings > Basic.
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Comma-separated Facebook user IDs allowed to sign in, e.g. 1234567890,2345678901
# Any other account is refused after login.
FACEBOOK_TEST_USER_IDS=
# Graph API version in the form vN.0. Check the current version in Meta's changelog.
API_VERSION=v24.0

# ---------------------------------------------------------------------------
# Optional providers. Each one also needs the user's consent on the consent screen.
# Leave a value empty to switch that provider off.
# ---------------------------------------------------------------------------
# OpenAI: attribute guesses, profile summary and explanations.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini when empty.
OPENAI_MODEL=
# Google Cloud Vision: path to a service-account JSON file, e.g. ./cloudvision/service-account.json
# (cloudvision/*.json is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=
# Have I Been Pwned breach lookup for the signed-in user's own email.
HIBP_API_KEY=
# Local OCR fallback: a local folder containing eng.traineddata (never a URL).
TESSERACT_LANG_PATH=
