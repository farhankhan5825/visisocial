<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Page</title>
</head>
<body>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
      
    <h1>Test Page</h1>
    
    <!-- Static Output -->
    <p>This is a static message printed from the EJS file.</p>
    
    <!-- Dynamic Output -->
    <p>Dynamic message from the server: <%= message %></p>
    <p><%= message %></p>
    
    <!-- Token Info (if any) -->
    <p>Access Token: <%= accessToken ? accessToken : 'No token found' %></p>

    <!-- You can even add some basic JavaScript if needed -->
    <script>
        console.log("Test page loaded successfully.");
    </script>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
          const cookie = document.cookie.split('; ').find(row => row.startsWith('access_token='));
          if (!cookie) {
            console.error('Access token not found in cookies');
            alert('You are not logged in. Please log in to access this page.');
            return;
          }
          const accessToken = cookie.split('=')[1];
          console.log('Access Token found:', accessToken);
      
          // Optional: Use the token to make an API request to a protected route
          fetch('/another-protected-route', {
            method: 'GET',
            headers: {
              'Authorization': 'Bearer ' + accessToken,
            }
          })
          .then(response => response.json())
          .then(data => {
            console.log('Protected route data:', data);
          })
          .catch(error => console.error('Error accessing protected route:', error));
        });
    </script>
</body>
</html>
