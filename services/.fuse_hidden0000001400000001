class AIProfileGenerator {
  /**
   * Generate comprehensive AI-powered profile from collected data
   */
  static async generatePersonProfile(searchData) {
    if (!SEARCH_CONFIG.OPENAI_API_KEY) {
      logger.warn('OpenAI API not configured - skipping profile generation');
      return null;
    }
    
    try {
      logger.info('Generating AI profile from collected data...');
      
      // Prepare data summary for AI
      const dataSummary = this.prepareDataSummary(searchData);
      
      const response = await axios.post(
        'https://api.openai.com/v1/chat/completions',
        {
          model: SEARCH_CONFIG.OPENAI_MODEL,
          messages: [
            {
              role: 'system',
              content: `You are an expert OSINT analyst. Analyze the collected internet data and create a comprehensive, professional profile report. Be thorough, objective, and highlight both positive and concerning findings. Structure your response in clear sections.`
            },
            {
              role: 'user',
              content: `Based on the following internet search results, create a detailed profile analysis:

${dataSummary}

Please provide a comprehensive report with the following sections:

1. **EXECUTIVE SUMMARY** (2-3 paragraphs)
   - Overall digital footprint assessment
   - Key findings and notable discoveries
   - Primary online identity and presence

2. **DIGITAL PRESENCE ANALYSIS**
   - Social media activity and platforms (VERIFIED vs UNVERIFIED)
   - Professional presence (LinkedIn, GitHub, etc.)
   - Content creation and publications
   - Online behavior patterns

3. **PRIVACY & SECURITY ASSESSMENT**
   - Data breach exposures found
   - Sensitive information exposure
   - Privacy risk level (LOW/MEDIUM/HIGH/CRITICAL)
   - Specific vulnerabilities identified

4. **PROFESSIONAL PROFILE**
   - Career and job history (if found)
   - Skills and expertise areas
   - Professional networks and connections
   - Academic/research contributions

5. **ONLINE REPUTATION**
   - Public sentiment analysis
   - Notable mentions or features
   - Content quality and themes
   - Consistency across platforms

6. **RISK ANALYSIS**
   - Identity theft risk
   - Potential for social engineering attacks
   - Information that could be weaponized
   - Paste site/leak exposure

7. **RECOMMENDATIONS**
   - Privacy improvements needed
   - Accounts that should be secured
   - Content that should be removed
   - Security best practices

8. **DATA SOURCES SUMMARY**
   - Reliability of sources (verified vs unverified)
   - Data completeness
   - Missing information gaps

Format the report professionally with clear headers, bullet points where appropriate, and actionable insights.`
            }
          ],
          max_tokens: 3000,
          temperature: 0.7
        },
        {
          headers: {
            'Authorization': `Bearer ${SEARCH_CONFIG.OPENAI_API_KEY}`,
            'Content-Type': 'application/json'
          },
          timeout: 60000
        }
      );
      
      const profile = response.data.choices[0].message.content;
      
      logger.info('AI profile generation complete');
      metrics.increment('ai.profile.generated');
      
      return {
        fullProfile: profile,
        generatedAt: new Date(),
        model: SEARCH_CONFIG.OPENAI_MODEL,
        tokensUsed: response.data.usage.total_tokens,
        confidence: 'high'
      };
      
    } catch (error) {
      logger.error(`AI profile generation error: ${error.message}`);
      metrics.increment('ai.profile.errors');
      return {
        error: error.message,
        fullProfile: 'Profile generation failed. Please review the raw data manually.',
        confidence: 'none'
      };
    }
  }
  
  /**
   * Prepare data summary for AI analysis
   */
  static prepareDataSummary(searchData) {
    const { sources, summary, searchValue, searchType } = searchData;
    
    let dataSummary = `SEARCH TARGET: ${searchType.toUpperCase()} = "${searchValue}"\n\n`;
    
    // Summary stats
    dataSummary += `SEARCH SUMMARY:\n`;
    dataSummary += `- Total Results Found: ${summary.totalResults}\n`;
    dataSummary += `- Critical Findings: ${summary.criticalFindings}\n`;
    dataSummary += `- Risk Score: ${summary.riskScore}/100\n`;
    dataSummary += `- Overall Risk: ${summary.overallRisk}\n\n`;
    
    // Breaches
    if (sources.breaches && sources.breaches.length > 0) {
      dataSummary += `DATA BREACHES FOUND (${sources.breaches.length}):\n`;
      sources.breaches.slice(0, 10).forEach(breach => {
        dataSummary += `- ${breach.name} (${breach.breachDate}): ${breach.pwnCount?.toLocaleString()} accounts affected\n`;
        dataSummary += `  Data exposed: ${breach.dataClasses?.join(', ')}\n`;
      });
      dataSummary += '\n';
    }
    
    // Pastes
    if (sources.pastes && sources.pastes.length > 0) {
      dataSummary += `PASTE SITE LEAKS (${sources.pastes.length}):\n`;
      sources.pastes.slice(0, 5).forEach(paste => {
        dataSummary += `- ${paste.source}: "${paste.title}" (${paste.date})\n`;
      });
      dataSummary += '\n';
    }
    
    // Search engine results
    if (sources.searchEngines && sources.searchEngines.length > 0) {
      dataSummary += `WEB SEARCH RESULTS (${sources.searchEngines.length} total, showing top 20):\n`;
      sources.searchEngines.slice(0, 20).forEach(result => {
        dataSummary += `- [${result.source.toUpperCase()}] ${result.title}\n`;
        dataSummary += `  URL: ${result.url}\n`;
        dataSummary += `  Snippet: ${result.snippet}\n`;
        if (result.riskLevel) dataSummary += `  Risk: ${result.riskLevel}\n`;
        dataSummary += '\n';
      });
    }
    
    // Social media with verification status
    if (sources.socialMedia && sources.socialMedia.length > 0) {
      const verified = sources.socialMedia.filter(s => s.verified);
      const unknown = sources.socialMedia.filter(s => s.status === 'unknown');
      const searchOnly = sources.socialMedia.filter(s => s.status === 'search_only');
      
      dataSummary += `SOCIAL MEDIA PLATFORMS:\n`;
      
      if (verified.length > 0) {
        dataSummary += `\nVERIFIED ACCOUNTS (${verified.length}):\n`;
        verified.forEach(platform => {
          dataSummary += `- ${platform.platform}: @${platform.username} [CONFIRMED]\n`;
          dataSummary += `  Profile: ${platform.profileUrl}\n`;
          if (platform.additionalData) {
            dataSummary += `  Data: ${JSON.stringify(platform.additionalData)}\n`;
          }
        });
      }
      
      if (unknown.length > 0) {
        dataSummary += `\nUNVERIFIED (${unknown.length}):\n`;
        unknown.forEach(platform => {
          dataSummary += `- ${platform.platform}: @${platform.username} [UNVERIFIED - manual check needed]\n`;
        });
      }
      
      if (searchOnly.length > 0) {
        dataSummary += `\nSEARCH ONLY (${searchOnly.length}):\n`;
        searchOnly.forEach(platform => {
          dataSummary += `- ${platform.platform}: ${platform.searchUrl}\n`;
        });
      }
      
      dataSummary += '\n';
    }
    
    // Code repositories
    if (sources.codeRepositories && sources.codeRepositories.length > 0) {
      dataSummary += `CODE REPOSITORIES:\n`;
      sources.codeRepositories.forEach(repo => {
        dataSummary += `- ${repo.platform}: ${repo.url}\n`;
      });
      dataSummary += '\n';
    }
    
    // Professional networks
    if (sources.professionalNetworks && sources.professionalNetworks.length > 0) {
      dataSummary += `PROFESSIONAL NETWORKS:\n`;
      sources.professionalNetworks.forEach(network => {
        dataSummary += `- ${network.network}: ${network.url}\n`;
      });
      dataSummary += '\n';
    }
    
    // Image analysis
    if (sources.imageAnalysis) {
      dataSummary += `IMAGE ANALYSIS:\n${sources.imageAnalysis.fullAnalysis}\n\n`;
    }
    
    return dataSummary;
  }
}

// ==================== MAIN ORCHESTRATOR ====================

class InternetSearchOrchestrator {
  static async executeComprehensiveSearch(searchParams, progressCallback) {
    const { type, value, userId } = searchParams;
    
    logger.info(`Starting comprehensive search: ${type} = ${value}`);
    metrics.increment('search.comprehensive.started');
    
    const results = {
      searchId: crypto.randomBytes(16).toString('hex'),
      userId,
      searchType: type,
      searchValue: value,
      startTime: new Date(),
      sources: {},
      summary: {
        totalResults: 0,
        criticalFindings: 0,
        moderateFindings: 0,
        lowRiskFindings: 0
      },
      status: 'running'
    };
    
    try {
      // Phase 1: Query generation
      progressCallback?.({ phase: 'query_generation', progress: 5, message: 'Generating search queries...' });
      
      let queries = [];
      if (type !== 'image') {
        switch(type) {
          case 'email': queries = QueryGenerator.generateEmailQueries(value); break;
          case 'name': queries = QueryGenerator.generateNameQueries(value); break;
          case 'username': queries = QueryGenerator.generateUsernameQueries(value); break;
          case 'phone': queries = QueryGenerator.generatePhoneQueries(value); break;
        }
      }
      
      // Phase 2: Search engines
      progressCallback?.({ phase: 'search_engines', progress: 15, message: 'Searching Google & DuckDuckGo...' });
      
      const searchEnginePromises = [];
      
      // Google search
      for (const query of queries.slice(0, 8)) {
        searchEnginePromises.push(
          SearchEngineAPI.googleSearch(query).catch(err => [])
        );
        await new Promise(resolve => setTimeout(resolve, 250));
      }
      
      // DuckDuckGo
      searchEnginePromises.push(
        SearchEngineAPI.duckDuckGoSearch(value).catch(err => [])
      );
      
      const searchEngineResults = await Promise.all(searchEnginePromises);
      results.sources.searchEngines = searchEngineResults.flat();
      
      // Phase 3: Breach check
      if (type === 'email') {
        progressCallback?.({ phase: 'breach_check', progress: 30, message: 'Checking data breaches...' });
        const breachData = await BreachDatabases.checkHIBP(value);
        results.sources.breaches = breachData.breaches;
        results.sources.pastes = breachData.pastes;
        
        if (breachData.breaches.length > 0) {
          results.summary.criticalFindings += breachData.breaches.length;
        }
      }

      // Phase 3b: Infrastructure exposure (Shodan) - runs when a host/domain can be derived
      if (InfrastructureSearch.deriveTarget(type, value)) {
        progressCallback?.({ phase: 'infrastructure', progress: 35, message: 'Mapping exposed infrastructure (Shodan)...' });
        const infra = await InfrastructureSearch.checkShodan(type, value);
        if (infra) {
          results.sources.infrastructure = infra;
        }
      }

      // Phase 4: Image analysis
      if (type === 'image') {
        progressCallback?.({ phase: 'image_analysis', progress: 40, message: 'Analyzing image with AI...' });
        results.sources.reverseImageLinks = ReverseImageSearch.generateReverseSearchLinks(value);
        results.sources.imageAnalysis = await ReverseImageSearch.analyzeImageWithAI(value);
        results.sources.imageMetadata = await ReverseImageSearch.extractImageMetadata(value);
      }
      
      // Phase 5: Social media WITH VERIFICATION
      progressCallback?.({ phase: 'social_media', progress: 50, message: 'Verifying social media accounts...' });
      results.sources.socialMedia = await SocialMediaSearch.searchSocialPlatforms(value, type);
      
      // Phase 6: Code repos
      if (type === 'email' || type === 'username') {
        progressCallback?.({ phase: 'code_repos', progress: 60, message: 'Checking code repositories...' });
        results.sources.codeRepositories = await SpecializedSearches.searchCodeRepositories(value);
      }
      
      // Phase 7: Paste sites
      progressCallback?.({ phase: 'paste_sites', progress: 70, message: 'Scanning paste sites...' });
      results.sources.pasteSites = await SpecializedSearches.searchPasteSites(value);
      
      // Phase 8: Professional networks
      if (type === 'name') {
        progressCallback?.({ phase: 'professional', progress: 80, message: 'Searching professional networks...' });
        results.sources.professionalNetworks = await SpecializedSearches.searchProfessionalNetworks(value);
      }
      
      // Phase 9: Analyze results
      progressCallback?.({ phase: 'analysis', progress: 85, message: 'Analyzing results...' });
      this.analyzeResults(results);
      
      // Phase 10: Generate AI profile
      progressCallback?.({ phase: 'ai_profile', progress: 92, message: 'Generating AI-powered profile...' });
      results.aiProfile = await AIProfileGenerator.generatePersonProfile(results);
      
      // Complete
      results.endTime = new Date();
      results.duration = results.endTime - results.startTime;
      results.status = 'complete';
      
      progressCallback?.({ phase: 'complete', progress: 100, message: 'Search complete!' });
      
      logger.info(`Search complete: ${results.summary.totalResults} results, profile generated`);
      metrics.increment('search.comprehensive.completed');
      
      return results;
      
    } catch (error) {
      logger.error(`Comprehensive search error: ${error.message}`);
      metrics.increment('search.comprehensive.errors');
      
      results.status = 'error';
      results.error = error.message;
      results.endTime = new Date();
      
      return results;
    }
  }
  
  static analyzeResults(results) {
    let totalResults = 0;
    let criticalFindings = 0;
    let moderateFindings = 0;
    let lowRiskFindings = 0;
    
    if (results.sources.searchEngines) {
      totalResults += results.sources.searchEngines.length;
      
      results.sources.searchEngines.forEach(result => {
        const url = result.url.toLowerCase();
        
        if (url.includes('pastebin') || url.includes('ghostbin') || 
            url.includes('leak') || url.includes('dump') || url.includes('breach')) {
          criticalFindings++;
          result.riskLevel = 'CRITICAL';
          result.riskReason = 'Data leak/paste site exposure';
        } else if (url.includes('github') || url.includes('gitlab') || 
                   url.includes('stackoverflow') || url.includes('reddit')) {
          moderateFindings++;
          result.riskLevel = 'MODERATE';
          result.riskReason = 'Public code or forum exposure';
        } else {
          lowRiskFindings++;
          result.riskLevel = 'LOW';
          result.riskReason = 'General web presence';
        }
      });
    }
    
    if (results.sources.breaches) {
      totalResults += results.sources.breaches.length;
      criticalFindings += results.sources.breaches.length;
    }
    
    if (results.sources.pastes) {
      totalResults += results.sources.pastes.length;
      criticalFindings += results.sources.pastes.length;
    }
    
    if (results.sources.socialMedia) {
      // Only count verified or unknown accounts, not search_only
      const countable = results.sources.socialMedia.filter(s =>
        s.status === 'verified' || s.status === 'unknown'
      );
      totalResults += countable.length;
      lowRiskFindings += countable.length;
    }

    if (results.sources.infrastructure) {
      const infra = results.sources.infrastructure;
      const exposedCount = (infra.services && infra.services.length) || (infra.ports && infra.ports.length) || 0;
      // Each exposed service/port is a moderate exposure; each known vuln is critical.
      totalResults += exposedCount;
      moderateFindings += exposedCount;
      if (infra.vulns && infra.vulns.length) {
        totalResults += infra.vulns.length;
        criticalFindings += infra.vulns.length;
      }
    }
    
    results.summary.totalResults = totalResults;
    results.summary.criticalFindings = criticalFindings;
    results.summary.moderateFindings = moderateFindings;
    results.summary.lowRiskFindings = lowRiskFindings;
    
    // Add verification stats for social media
    if (results.sources.socialMedia) {
      results.summary.socialMediaStats = {
        verified: results.sources.socialMedia.filter(s => s.verified).length,
        unknown: results.sources.socialMedia.filter(s => s.status === 'unknown').length,
        searchOnly: results.sources.socialMedia.filter(s => s.status === 'search_only').length
      };
    }
    
    results.summary.riskScore = Math.min(100, 
      (criticalFindings * 10) + 
      (moderateFindings * 3) + 
      (lowRiskFindings * 1)
    );
    
    if (results.summary.riskScore >= 70) results.summary.overallRisk = 'CRITICAL';
    else if (results.summary.riskScore >= 40) results.summary.overallRisk = 'HIGH';
    else if (results.summary.riskScore >= 20) results.summary.overallRisk = 'MEDIUM';
    else results.summary.overallRisk = 'LOW';
  }
}

