/**
 * Load and preprocess CSV data with caching
 */
async function loadAndPreprocessCSVData() {
  const cacheKey = 'csv_data';
  
  try {
    const cachedData = await cache.get(cacheKey);
    if (cachedData) {
      logger.debug('Using cached CSV data');
      return cachedData;
    }

    logger.info(`Loading CSV data from: ${CSV_FILE_PATH}`);
    
    if (!fsSync.existsSync(CSV_FILE_PATH)) {
      logger.error(`CSV file not found at: ${CSV_FILE_PATH}`);
      throw new Error('CSV file not found');
    }
    
    const csvData = [];
    
    await new Promise((resolve, reject) => {
      fsSync.createReadStream(CSV_FILE_PATH)
        .pipe(csv())
        .on("data", (row) => csvData.push(row))
        .on("end", () => {
          logger.info(`CSV loaded: ${csvData.length} rows`);
          resolve();
        })
        .on("error", reject);
    });
    
    await cache.set(cacheKey, csvData, CACHE_EXPIRY);
    return csvData;
  } catch (error) {
    logger.error(`CSV processing error: ${error.message}`);
    throw error;
  }
}

/**
 * Calculate personality scores from CSV data
 */
async function calculatePersonalityScoresFromCSV(feedText) {
  try {
    const personalityScores = {
      extroversion: 50,
      neuroticism: 50,
      agreeableness: 50,
      conscientiousness: 50,
      openness: 50
    };
    
    if (!feedText || typeof feedText !== 'string' || feedText.length < 10) {
      logger.warn('Insufficient feed text for personality analysis');
      return personalityScores;
    }
    
    const csvData = await loadAndPreprocessCSVData();
    if (!csvData || csvData.length === 0) {
      logger.error('CSV data unavailable');
      return personalityScores;
    }
    
    // Preprocess the user's feed ONCE and build a frequency vector.
    // (Previously the whole feed was re-tokenized for every CSV row, which
    // caused a ~300MB memory/CPU spike on each analysis.)
    const feedTokens = preprocessText(feedText);
    if (feedTokens.length === 0) {
      logger.warn('No usable tokens in feed text for personality analysis');
      return personalityScores;
    }

    const feedFreq = new Map();
    for (const t of feedTokens) feedFreq.set(t, (feedFreq.get(t) || 0) + 1);
    let feedMagSq = 0;
    for (const c of feedFreq.values()) feedMagSq += c * c;
    const feedMag = Math.sqrt(feedMagSq);

    // Cosine similarity of a single status row against the precomputed feed
    // vector, iterating only over the (small) row's tokens.
    const similarityToFeed = (statusText) => {
      const tokens = preprocessText(statusText);
      if (tokens.length === 0) return 0;
      const rowFreq = new Map();
      for (const t of tokens) rowFreq.set(t, (rowFreq.get(t) || 0) + 1);
      let dot = 0;
      let rowMagSq = 0;
      for (const [t, c] of rowFreq) {
        rowMagSq += c * c;
        const fc = feedFreq.get(t);
        if (fc) dot += fc * c;
      }
      if (dot === 0) return 0;
      return dot / (feedMag * Math.sqrt(rowMagSq));
    };

    // Score every labelled row, keeping the matches above threshold.
    const matches = [];
    for (const row of csvData) {
      if (!row.STATUS || !row.sEXT || !row.sNEU || !row.sAGR || !row.sCON || !row.sOPN) continue;
      const similarity = similarityToFeed(row.STATUS);
      if (similarity > SIMILARITY_THRESHOLD) {
        matches.push({
          similarity,
          scores: {
            extroversion: parseFloat(row.sEXT) || 0,
            neuroticism: parseFloat(row.sNEU) || 0,
            agreeableness: parseFloat(row.sAGR) || 0,
            conscientiousness: parseFloat(row.sCON) || 0,
            openness: parseFloat(row.sOPN) || 0
          }
        });
      }
    }

    // Use only the strongest matches. Averaging hundreds/thousands of weak
    // matches regresses every trait to the dataset mean (the old behaviour),
    // which is why results looked generic.
    const TOP_MATCHES = 50;
    matches.sort((a, b) => b.similarity - a.similarity);
    const topMatches = matches.slice(0, TOP_MATCHES);

    if (topMatches.length > 0) {
      let weightSum = 0;
      const totals = { extroversion: 0, neuroticism: 0, agreeableness: 0, conscientiousness: 0, openness: 0 };
      for (const m of topMatches) {
        const weight = m.similarity * m.similarity;
        weightSum += weight;
        for (const trait of Object.keys(totals)) {
          totals[trait] += m.scores[trait] * weight;
        }
      }
      // CSV scores are on the Big Five 1-5 scale -> map to 0-100.
      const toScale = (v) => Math.round(Math.max(0, Math.min(100, (((v / weightSum) - 1) / 4) * 100)));
      personalityScores.extroversion = toScale(totals.extroversion);
      personalityScores.neuroticism = toScale(totals.neuroticism);
      personalityScores.agreeableness = toScale(totals.agreeableness);
      personalityScores.conscientiousness = toScale(totals.conscientiousness);
      personalityScores.openness = toScale(totals.openness);

      // Confidence reflects how many strong matches we found and how strong
      // they were, instead of always being 100.
      const avgSimilarity = topMatches.reduce((s, m) => s + m.similarity, 0) / topMatches.length;
      const coverage = Math.min(1, topMatches.length / TOP_MATCHES);
      personalityScores.confidence = Math.round(Math.min(100, coverage * avgSimilarity * 200));
    } else {
      personalityScores.confidence = 0;
    }

    logger.info(`Personality analysis complete: ${matches.length} candidate matches, using top ${topMatches.length}, confidence ${personalityScores.confidence}`);

    return personalityScores;
  } catch (error) {
    logger.error(`Personality score calculation error: ${error.message}`);
    return {
      extroversion: 50,
      neuroticism: 50,
      agreeableness: 50,
      conscientiousness: 50,
      openness: 50,
      confidence: 0
    };
  }
}

