<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'nonce-<%= nonce %>' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - VisiSocial</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <style nonce="<%= nonce %>">
        :root {
            --primary: #7c6cff;
            --primary-dark: #5b4fe0;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --gradient-primary: linear-gradient(118deg, #9d7bff 0%, #7c6cff 45%, #34e3ff 100%);
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-lg: 0 25px 80px -20px rgba(99, 102, 241, 0.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        /* Animated Background */
        .bg-animated {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
            background: var(--darker);
        }

        .bg-animated .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.15;
            animation: float 25s ease-in-out infinite;
        }

        .bg-animated .orb-1 {
            width: 700px;
            height: 700px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            top: -250px;
            right: -250px;
        }

        .bg-animated .orb-2 {
            width: 500px;
            height: 500px;
            background: linear-gradient(135deg, var(--secondary) 0%, var(--accent) 100%);
            bottom: -150px;
            left: -150px;
            animation-delay: -7s;
        }

        .bg-animated .orb-3 {
            width: 400px;
            height: 400px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 100%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: -14s;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(60px, -60px) scale(1.1); }
            50% { transform: translate(-40px, 40px) scale(0.9); }
            75% { transform: translate(-60px, -40px) scale(1.05); }
        }

        /* Header */
        header {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
        }

        .header-content {
            max-width: 1600px;
            margin: 0 auto;
            padding: 20px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--danger);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .logo {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-stats {
            display: flex;
            gap: 20px;
            padding-right: 20px;
            border-right: 1px solid var(--glass-border);
        }

        .header-stat {
            text-align: center;
        }

        .header-stat-value {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary-light);
        }

        .header-stat-label {
            font-size: 0.75rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-logout {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
            padding: 10px 24px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-logout:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--danger);
            transform: translateY(-2px);
        }

        /* Container */
        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 40px 32px;
        }

        /* Section Headers */
        .section-header {
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-title {
            font-size: 1.75rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            color: var(--accent);
            font-size: 1.5rem;
        }

        .gradient-text {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Glass Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 48px;
        }

        .stat-card {
            padding: 28px 24px;
            position: relative;
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .stat-icon.primary {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(99, 102, 241, 0.05) 100%);
            color: var(--primary);
        }

        .stat-icon.success {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(16, 185, 129, 0.05) 100%);
            color: var(--success);
        }

        .stat-icon.warning {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(245, 158, 11, 0.05) 100%);
            color: var(--warning);
        }

        .stat-icon.accent {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.2) 0%, rgba(6, 182, 212, 0.05) 100%);
            color: var(--accent);
        }

        .stat-icon.danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(239, 68, 68, 0.05) 100%);
            color: var(--danger);
        }

        .stat-trend {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
        }

        .stat-trend.up {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .stat-trend.down {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .stat-label {
            font-size: 0.85rem;
            color: var(--muted);
            font-weight: 500;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1;
            color: var(--light);
            margin-bottom: 4px;
        }

        .stat-description {
            font-size: 0.8rem;
            color: var(--muted);
        }

        /* Table Styles */
        .table-container {
            margin-top: 28px;
        }

        .table-wrapper {
            padding: 24px;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        thead {
            background: rgba(255, 255, 255, 0.03);
        }

        th {
            padding: 16px 20px;
            text-align: left;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--glass-border);
        }

        td {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            vertical-align: middle;
        }

        tbody tr {
            transition: all 0.2s ease;
        }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.03);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--glass-border);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-details {
            display: flex;
            flex-direction: column;
        }

        .user-name {
            font-weight: 600;
            color: var(--light);
        }

        .user-email {
            font-size: 0.85rem;
            color: var(--muted);
        }

        .user-id {
            font-family: 'Courier New', monospace;
            font-size: 0.85rem;
            color: var(--muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 4px 8px;
            border-radius: 6px;
            display: inline-block;
        }

        .date-display {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .date-time {
            font-size: 0.9rem;
            color: var(--light);
        }

        .date-relative {
            font-size: 0.75rem;
            color: var(--muted);
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
        }

        .empty-icon {
            font-size: 4rem;
            color: var(--muted);
            opacity: 0.3;
            margin-bottom: 16px;
        }

        .empty-text {
            font-size: 1.1rem;
            color: var(--muted);
        }

        /* Quick Actions */
        .quick-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 32px;
        }

        .action-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--light);
            padding: 12px 24px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

        .action-btn:hover {
            background: rgba(99, 102, 241, 0.1);
            border-color: var(--primary);
            color: var(--primary);
            transform: translateY(-2px);
        }

        .action-btn i {
            font-size: 1rem;
        }

        /* Personality Pills */
        .personality-pills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .personality-pill {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .personality-pill.dominant {
            background: rgba(99, 102, 241, 0.15);
            color: var(--primary-light);
            border: 1px solid rgba(99, 102, 241, 0.3);
        }

        /* Badge */
        .badge {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-primary {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary-light);
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .badge-danger {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 100px;
            right: 20px;
            z-index: 10000;
            max-width: 420px;
        }

        .toast {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: flex-start;
            gap: 16px;
            opacity: 0;
            transform: translateX(100px);
            animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        @keyframes slideIn {
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }
            to {
                opacity: 0;
                transform: translateX(100px);
            }
        }

        /* Progress Ring */
        .progress-ring {
            width: 60px;
            height: 60px;
            position: relative;
        }

        .progress-ring svg {
            transform: rotate(-90deg);
        }

        .progress-ring-circle {
            transition: stroke-dashoffset 0.5s ease;
            fill: none;
            stroke-width: 4;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .container {
                padding: 32px 24px;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .header-content {
                padding: 16px 20px;
                flex-direction: column;
                gap: 16px;
            }

            .header-stats {
                display: none;
            }

            .container {
                padding: 24px 16px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .quick-actions {
                width: 100%;
            }

            .action-btn {
                flex: 1;
                justify-content: center;
            }

            table {
                font-size: 0.85rem;
            }

            th, td {
                padding: 12px 16px;
            }

            .stat-value {
                font-size: 2rem;
            }
        }

        @media (max-width: 480px) {
            .logo {
                font-size: 1.25rem;
            }

            .section-title {
                font-size: 1.5rem;
            }

            .stat-value {
                font-size: 1.75rem;
            }

            .user-info {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>
    <!-- Animated Background -->
    <div class="bg-animated">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Header -->
    <header>
        <div class="header-content">
            <div class="header-left">
                <a href="/admin" class="logo">VisiSocial</a>
                <div class="admin-badge">
                    <i class="fas fa-shield-halved"></i>
                    <span>Admin Dashboard</span>
                </div>
            </div>

            <div class="header-right">
                <div class="header-stats">
                    <div class="header-stat">
                        <div class="header-stat-value"><%= stats.users.total %></div>
                        <div class="header-stat-label">Total Users</div>
                    </div>
                    <div class="header-stat">
                        <div class="header-stat-value"><%= stats.users.activeWeek %></div>
                        <div class="header-stat-label">Active</div>
                    </div>
                    <% if (stats.tokens) { %>
                    <div class="header-stat">
                        <div class="header-stat-value"><%= stats.tokens.active %></div>
                        <div class="header-stat-label">Sessions</div>
                    </div>
                    <% } %>
                </div>
                <a href="/logout" class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <div class="container">
        
        <!-- Quick Actions -->
        <div class="quick-actions">
            <a href="/login" class="action-btn">
                <i class="fas fa-users"></i>
                <span>User Dashboard</span>
            </a>
            <a href="/admin/users" class="action-btn">
                <i class="fas fa-users"></i>
                <span>Manage Users</span>
            </a>
            <a href="/admin/analytics" class="action-btn">
                <i class="fas fa-chart-line"></i>
                <span>Analytics</span>
            </a>
            <a href="/admin/logs" class="action-btn">
                <i class="fas fa-file-alt"></i>
                <span>Activity Logs</span>
            </a>
            <button class="action-btn" onclick="window.location.reload()">
                <i class="fas fa-sync-alt"></i>
                <span>Refresh Data</span>
            </button>
            <a href="/admin/settings" class="action-btn">
                <i class="fas fa-cog"></i>
                <span>Settings</span>
            </a>
        </div>

        <!-- User Overview -->
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-users"></i>
                User <span class="gradient-text">Overview</span>
            </h2>
        </div>

        <div class="stats-grid">
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon primary">
                        <i class="fas fa-users"></i>
                    </div>
                    <% if (stats.users.weeklyGrowth !== undefined) { %>
                    <div class="stat-trend <%= stats.users.weeklyGrowth >= 0 ? 'up' : 'down' %>">
                        <i class="fas fa-arrow-<%= stats.users.weeklyGrowth >= 0 ? 'up' : 'down' %>"></i>
                        <span><%= Math.abs(stats.users.weeklyGrowth) %>%</span>
                    </div>
                    <% } %>
                </div>
                <div class="stat-label">Total Users</div>
                <div class="stat-value"><%= stats.users.total %></div>
                <div class="stat-description">All registered accounts</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon success">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-arrow-up"></i>
                        <span>New</span>
                    </div>
                </div>
                <div class="stat-label">New Today</div>
                <div class="stat-value"><%= stats.users.newToday %></div>
                <div class="stat-description">Registered in last 24h</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon warning">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-calendar-week"></i>
                        <span>7d</span>
                    </div>
                </div>
                <div class="stat-label">New This Week</div>
                <div class="stat-value"><%= stats.users.newWeek %></div>
                <div class="stat-description">Last 7 days signups</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon accent">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-check"></i>
                        <span>Active</span>
                    </div>
                </div>
                <div class="stat-label">Active This Week</div>
                <div class="stat-value"><%= stats.users.activeWeek %></div>
                <div class="stat-description">Users with activity</div>
            </div>

            <% if (stats.users.newMonth !== undefined) { %>
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon primary">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <% if (stats.users.monthlyGrowth !== undefined) { %>
                    <div class="stat-trend <%= stats.users.monthlyGrowth >= 0 ? 'up' : 'down' %>">
                        <i class="fas fa-arrow-<%= stats.users.monthlyGrowth >= 0 ? 'up' : 'down' %>"></i>
                        <span><%= Math.abs(stats.users.monthlyGrowth) %>%</span>
                    </div>
                    <% } %>
                </div>
                <div class="stat-label">New This Month</div>
                <div class="stat-value"><%= stats.users.newMonth %></div>
                <div class="stat-description">Last 30 days signups</div>
            </div>
            <% } %>

            <% if (stats.users.activeMonth !== undefined) { %>
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon success">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-calendar"></i>
                        <span>30d</span>
                    </div>
                </div>
                <div class="stat-label">Active This Month</div>
                <div class="stat-value"><%= stats.users.activeMonth %></div>
                <div class="stat-description">Monthly active users</div>
            </div>
            <% } %>

            <% if (stats.users.avgEngagement !== undefined) { %>
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon warning">
                        <i class="fas fa-heart"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                </div>
                <div class="stat-label">Avg Engagement</div>
                <div class="stat-value"><%= Math.round(stats.users.avgEngagement) %></div>
                <div class="stat-description">User engagement score</div>
            </div>
            <% } %>

            <% if (stats.tokens) { %>
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon accent">
                        <i class="fas fa-key"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-check-circle"></i>
                        <span><%= Math.round((stats.tokens.active / (stats.tokens.total || 1)) * 100) %>%</span>
                    </div>
                </div>
                <div class="stat-label">Active Tokens</div>
                <div class="stat-value"><%= stats.tokens.active %></div>
                <div class="stat-description">Valid sessions</div>
            </div>
            <% } %>
        </div>

        <!-- System Metrics -->
        <div class="section-header" style="margin-top: 48px;">
            <h2 class="section-title">
                <i class="fas fa-server"></i>
                System <span class="gradient-text">Metrics</span>
            </h2>
        </div>

        <div class="stats-grid">
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon primary">
                        <i class="fas fa-microchip"></i>
                    </div>
                    <div class="stat-trend <%= stats.system.cpuLoad > 80 ? 'down' : 'up' %>">
                        <i class="fas fa-<%= stats.system.cpuLoad > 80 ? 'exclamation-triangle' : 'check' %>"></i>
                        <span><%= stats.system.cpuLoad > 80 ? 'High' : 'OK' %></span>
                    </div>
                </div>
                <div class="stat-label">CPU Load</div>
                <div class="stat-value"><%= stats.system.cpuLoad %>%</div>
                <div class="stat-description">Current processor usage</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon success">
                        <i class="fas fa-memory"></i>
                    </div>
                    <% if (stats.system.memoryPercent !== undefined) { %>
                    <div class="stat-trend <%= stats.system.memoryPercent > 80 ? 'down' : 'up' %>">
                        <i class="fas fa-<%= stats.system.memoryPercent > 80 ? 'exclamation-triangle' : 'check' %>"></i>
                        <span><%= stats.system.memoryPercent %>%</span>
                    </div>
                    <% } %>
                </div>
                <div class="stat-label">Memory Usage</div>
                <div class="stat-value"><%= stats.system.memoryUsed %> <small style="font-size: 1rem;">MB</small></div>
                <div class="stat-description">
                    <% if (stats.system.memoryTotal) { %>
                    <%= stats.system.memoryTotal %> MB total
                    <% } else { %>
                    Heap memory allocated
                    <% } %>
                </div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon warning">
                        <i class="fas fa-exchange-alt"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                </div>
                <div class="stat-label">Total Requests</div>
                <div class="stat-value"><%= stats.system.requests %></div>
                <div class="stat-description">API calls processed</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon <%= stats.system.errors > 50 ? 'danger' : 'accent' %>">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="stat-trend <%= stats.system.errors > 50 ? 'down' : 'up' %>">
                        <i class="fas fa-<%= stats.system.errors > 50 ? 'arrow-up' : 'check' %>"></i>
                        <span><%= stats.system.errors > 50 ? 'High' : 'Low' %></span>
                    </div>
                </div>
                <div class="stat-label">Errors Logged</div>
                <div class="stat-value"><%= stats.system.errors %></div>
                <div class="stat-description">System error count</div>
            </div>

            <% if (stats.system.uptime !== undefined) { %>
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon success">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-check-circle"></i>
                        <span>Online</span>
                    </div>
                </div>
                <div class="stat-label">System Uptime</div>
                <div class="stat-value"><%= Math.floor(stats.system.uptime / 3600) %><small style="font-size: 1rem;">h</small></div>
                <div class="stat-description"><%= Math.floor((stats.system.uptime % 3600) / 60) %> minutes</div>
            </div>
            <% } %>

            <% if (stats.system.platform) { %>
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon primary">
                        <i class="fab fa-<%= stats.system.platform === 'linux' ? 'linux' : stats.system.platform === 'win32' ? 'windows' : 'apple' %>"></i>
                    </div>
                    <span class="badge badge-primary"><%= stats.system.nodeVersion %></span>
                </div>
                <div class="stat-label">Platform</div>
                <div class="stat-value" style="font-size: 1.5rem; text-transform: capitalize;"><%= stats.system.platform %></div>
                <div class="stat-description"><%= stats.system.arch %> architecture</div>
            </div>
            <% } %>
        </div>

        <!-- Database Stats -->
        <% if (stats.database) { %>
        <div class="section-header" style="margin-top: 48px;">
            <h2 class="section-title">
                <i class="fas fa-database"></i>
                Database <span class="gradient-text">Statistics</span>
            </h2>
        </div>

        <div class="stats-grid">
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon primary">
                        <i class="fas fa-hdd"></i>
                    </div>
                </div>
                <div class="stat-label">Database Size</div>
                <div class="stat-value"><%= stats.database.size %> <small style="font-size: 1rem;">MB</small></div>
                <div class="stat-description">Total data storage</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon success">
                        <i class="fas fa-table"></i>
                    </div>
                </div>
                <div class="stat-label">Collections</div>
                <div class="stat-value"><%= stats.database.collections %></div>
                <div class="stat-description">Database collections</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon warning">
                        <i class="fas fa-list"></i>
                    </div>
                </div>
                <div class="stat-label">Indexes</div>
                <div class="stat-value"><%= stats.database.indexes %></div>
                <div class="stat-description">Total indexed fields</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon accent">
                        <i class="fas fa-cube"></i>
                    </div>
                </div>
                <div class="stat-label">Avg Object Size</div>
                <div class="stat-value"><%= stats.database.avgObjSize %> <small style="font-size: 1rem;">B</small></div>
                <div class="stat-description">Average document size</div>
            </div>
        </div>
        <% } %>

        <!-- Cache & Maintenance -->
        <div class="section-header" style="margin-top: 48px;">
            <h2 class="section-title">
                <i class="fas fa-tools"></i>
                Cache & <span class="gradient-text">Maintenance</span>
            </h2>
        </div>

        <div class="stats-grid">
            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon primary">
                        <i class="fas fa-tasks"></i>
                    </div>
                </div>
                <div class="stat-label">Tasks in Queue</div>
                <div class="stat-value"><%= stats.tasks.count %></div>
                <div class="stat-description">Pending background jobs</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon success">
                        <i class="fas fa-spinner"></i>
                    </div>
                </div>
                <div class="stat-label">Running Tasks</div>
                <div class="stat-value"><%= stats.tasks.running %></div>
                <div class="stat-description">Currently processing</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon warning">
                        <i class="fas fa-database"></i>
                    </div>
                    <% if (stats.cache.hitRate !== undefined) { %>
                    <div class="stat-trend up">
                        <i class="fas fa-bullseye"></i>
                        <span><%= Math.round(stats.cache.hitRate) %>%</span>
                    </div>
                    <% } %>
                </div>
                <div class="stat-label">Cache Items</div>
                <div class="stat-value"><%= stats.cache.items %></div>
                <div class="stat-description">Cached data entries</div>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-header">
                    <div class="stat-icon accent">
                        <i class="fas fa-hdd"></i>
                    </div>
                </div>
                <div class="stat-label">Cache Size</div>
                <div class="stat-value"><%= stats.cache.size %> <small style="font-size: 1rem;">KB</small></div>
                <div class="stat-description">Total cache storage</div>
            </div>
        </div>

        <!-- Personality Distribution -->
        <% if (stats.personality && stats.personality.length > 0) { %>
        <div class="section-header" style="margin-top: 48px;">
            <h2 class="section-title">
                <i class="fas fa-brain"></i>
                Personality <span class="gradient-text">Distribution</span>
            </h2>
        </div>

        <div class="glass-card" style="padding: 32px; margin-bottom: 48px;">
            <div class="personality-pills">
                <% stats.personality.forEach(trait => { %>
                <div class="personality-pill dominant">
                    <i class="fas fa-user"></i>
                    <span><%= trait._id %>: <%= trait.count %></span>
                </div>
                <% }); %>
            </div>
        </div>
        <% } %>

        <!-- Recent Users -->
        <div class="section-header" style="margin-top: 48px;">
            <h2 class="section-title">
                <i class="fas fa-user-clock"></i>
                Recent <span class="gradient-text">Users</span>
            </h2>
            <a href="/admin/users" class="action-btn">
                <span>View All</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="glass-card table-container">
            <% if (recentUsers && recentUsers.length > 0) { %>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>ID</th>
                                <th>Email</th>
                                <th>Engagement</th>
                                <th>Joined</th>
                                <th>Last Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentUsers.forEach(u => { %>
                                <tr onclick="window.location='/admin/users/<%= u.id %>'" style="cursor: pointer;">
                                    <td>
                                        <div class="user-info">
                                            <img src="<%= u.picture || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(u.name) %>" 
                                                 class="user-avatar" 
                                                 alt="<%= u.name %>">
                                            <div class="user-details">
                                                <span class="user-name"><%= u.name %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="user-id"><%= u.id.substring(0, 12) %>...</span>
                                    </td>
                                    <td>
                                        <span class="user-email"><%= u.email %></span>
                                    </td>
                                    <td>
                                        <% if (u.engagementScore !== undefined) { %>
                                        <span class="badge <%= u.engagementScore > 70 ? 'badge-success' : u.engagementScore > 40 ? 'badge-warning' : 'badge-danger' %>">
                                            <%= u.engagementScore %>
                                        </span>
                                        <% } else { %>
                                        <span class="badge badge-primary">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="date-display">
                                            <span class="date-time"><%= new Date(u.createdAt).toLocaleDateString() %></span>
                                            <span class="date-relative"><%= new Date(u.createdAt).toLocaleTimeString() %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="date-display">
                                            <span class="date-time"><%= new Date(u.lastUpdated).toLocaleDateString() %></span>
                                            <span class="date-relative"><%= new Date(u.lastUpdated).toLocaleTimeString() %></span>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-users empty-icon"></i>
                    <p class="empty-text">No recent users found</p>
                </div>
            <% } %>
        </div>

    </div>

    <script nonce="<%= nonce %>">
        // Toast Notification System
        function showToast(message, type = 'info', title = '', duration = 5000) {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast';
            
            const icons = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-circle',
                warning: 'fa-exclamation-triangle',
                info: 'fa-info-circle'
            };

            const colors = {
                success: '#10b981',
                error: '#ef4444',
                warning: '#f59e0b',
                info: '#6366f1'
            };

            toast.innerHTML = `
                <div style="width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: ${colors[type]}; background: linear-gradient(135deg, rgba(${type === 'success' ? '16, 185, 129' : type === 'error' ? '239, 68, 68' : type === 'warning' ? '245, 158, 11' : '99, 102, 241'}, 0.2) 0%, rgba(${type === 'success' ? '16, 185, 129' : type === 'error' ? '239, 68, 68' : type === 'warning' ? '245, 158, 11' : '99, 102, 241'}, 0.05) 100%);">
                    <i class="fas ${icons[type]}"></i>
                </div>
                <div style="flex: 1;">
                    <div style="font-weight: 600; margin-bottom: 4px;">${title || type.charAt(0).toUpperCase() + type.slice(1)}</div>
                    <div style="font-size: 0.9rem; color: var(--muted);">${message}</div>
                </div>
                <button onclick="this.parentElement.remove()" style="background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 1.2rem; padding: 0; width: 24px; height: 24px; border-radius: 6px; transition: all 0.2s;">
                    <i class="fas fa-times"></i>
                </button>
            `;

            toastContainer.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'slideOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards';
                setTimeout(() => toast.remove(), 400);
            }, duration);
        }

        // Auto-refresh dashboard every 30 seconds
        let autoRefresh = setInterval(() => {
            console.log('Auto-refreshing dashboard data...');
            // You can implement AJAX refresh here
        }, 30000);

        // Check for success/error messages in URL
        const urlParams = new URLSearchParams(window.location.search);
        const welcomeParam = urlParams.get('welcome');
        const successParam = urlParams.get('success');
        const errorParam = urlParams.get('error');

        if (welcomeParam === 'admin') {
            setTimeout(() => {
                showToast('Admin Dashboard loaded successfully. All systems operational.', 'success', 'Welcome Back!');
            }, 500);
        }

        if (successParam) {
            setTimeout(() => {
                showToast(decodeURIComponent(successParam), 'success', 'Success!');
            }, 500);
        }

        if (errorParam) {
            setTimeout(() => {
                showToast(decodeURIComponent(errorParam), 'error', 'Error');
            }, 500);
        }

        console.log('Admin dashboard loaded successfully');
    </script>
</body>
</html>