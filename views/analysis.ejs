<!-- analysis.ejs - Advanced Personality Analysis Dashboard -->
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <title>Analysis Dashboard | VisiSocial</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Advanced personality and social media analysis dashboard">
  
  <!-- Favicon -->
  <link href="/img/favicon.ico" rel="icon">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  
  <!-- Styles -->
  <link href="/stylesheets/bootstrap.min.css" rel="stylesheet">
  <link href="/stylesheets/visisocial.css" rel="stylesheet">
  <link href="/stylesheets/styles.css" rel="stylesheet">
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  
  <!-- Additional Charts -->
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
  <script src="https://unpkg.com/chartjs-plugin-gradient"></script>
  
  <style>
    :root {
      --primary: #7c6cff;
      --primary-light: #9d7bff;
      --secondary: #9d7bff;
      --accent: #34e3ff;
      --warning: #f6b24a;
      --danger: #ff5d6c;
      --success: #2dd4a8;
      --info: #34e3ff;
      --dark: #0a0a16;
      --darker: #06060e;
      --light: #ECECF6;
      --muted: #9a9ab6;
      --glass: rgba(255, 255, 255, 0.03);
      --glass-hover: rgba(255, 255, 255, 0.06);
      --glass-border: rgba(255,255,255,0.09);
      --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
      --shadow-soft: 0 8px 32px rgba(0, 0, 0, 0.2);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--darker);
      color: var(--light);
      min-height: 100vh;
      line-height: 1.6;
      overflow-x: hidden;
    }
    
    h1, h2, h3, h4, h5, h6 {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
    }
    
    .bg-mesh {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      background: 
        radial-gradient(ellipse at 10% 20%, rgba(99, 102, 241, 0.15) 0%, transparent 40%),
        radial-gradient(ellipse at 90% 80%, rgba(139, 92, 246, 0.1) 0%, transparent 40%),
        radial-gradient(ellipse at 50% 50%, rgba(6, 182, 212, 0.05) 0%, transparent 60%);
      opacity: 0.8;
    }
    
    .gradient-text {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 50%, var(--accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    /* Navbar */
    .navbar-custom {
      background: rgba(2, 6, 23, 0.9);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--glass-border);
      padding: 12px 0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    
    .navbar-brand {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: 1.5rem;
    }
    
    .nav-link {
      color: var(--muted) !important;
      font-weight: 500;
      padding: 10px 18px !important;
      border-radius: 10px;
      transition: all 0.3s ease;
    }
    
    .nav-link:hover, .nav-link.active {
      color: var(--light) !important;
      background: var(--glass);
    }
    
    .user-dropdown {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 16px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .user-dropdown:hover {
      background: var(--glass-hover);
      border-color: var(--primary);
    }
    
    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--primary);
    }
    
    .user-name {
      font-weight: 600;
      font-size: 0.95rem;
    }
    
    .dropdown-menu {
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 12px;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    }
    
    .dropdown-item {
      color: var(--muted);
      padding: 12px 16px;
      border-radius: 10px;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .dropdown-item:hover {
      color: var(--light);
      background: var(--glass);
    }
    
    .dropdown-item.logout:hover {
      color: var(--danger);
      background: rgba(239, 68, 68, 0.1);
    }
    
    /* Main Content */
    .analysis-container {
      padding: 2rem;
      max-width: 1800px;
      margin: 0 auto;
    }
    
    /* Breadcrumb */
    .breadcrumb-custom {
      background: transparent;
      padding: 0;
      margin-bottom: 2rem;
    }
    
    .breadcrumb-item a {
      color: var(--muted);
      text-decoration: none;
      transition: color 0.3s ease;
    }
    
    .breadcrumb-item a:hover {
      color: var(--primary-light);
    }
    
    .breadcrumb-item.active {
      color: var(--light);
    }
    
    /* Page Header */
    .page-header {
      margin-bottom: 3rem;
      padding: 2rem;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
    }
    
    .page-title {
      font-size: 2.2rem;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--light) 0%, var(--primary-light) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .page-subtitle {
      color: var(--muted);
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
    }
    
    .analysis-metadata {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
    }
    
    .metadata-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--muted);
    }
    
    .metadata-item i {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(99, 102, 241, 0.1);
      color: var(--primary-light);
    }
    
    /* Glass Cards */
    .glass-card {
      background: var(--glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    
    .glass-card:hover {
      background: var(--glass-hover);
      transform: translateY(-4px);
      box-shadow: var(--shadow-glow);
    }
    
    .card-header-custom {
      padding: 1.5rem 1.5rem 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .card-title {
      font-size: 1.2rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0;
    }
    
    .card-title i {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .card-body-custom {
      padding: 1.5rem;
    }
    
    .card-footer-custom {
      padding: 1rem 1.5rem;
      border-top: 1px solid var(--glass-border);
      color: var(--muted);
      font-size: 0.875rem;
    }
    
    /* Grid System */
    .analysis-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    /* Personality Overview */
    .personality-overview {
      grid-column: span 8;
      height: 100%;
    }
    
    /* Traits Grid */
    .traits-grid {
      grid-column: span 4;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    
    .trait-card {
      padding: 1.25rem;
      background: rgba(99, 102, 241, 0.05);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      transition: all 0.3s ease;
    }
    
    .trait-card:hover {
      transform: translateY(-2px);
      background: rgba(99, 102, 241, 0.1);
    }
    
    .trait-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }
    
    .trait-name {
      font-size: 0.875rem;
      color: var(--muted);
      margin-bottom: 0.5rem;
    }
    
    .trait-value {
      font-size: 1.5rem;
      font-weight: 700;
    }
    
    /* Chart Containers */
    .chart-container {
      position: relative;
      width: 100%;
    }
    
    .chart-container-lg {
      height: 320px;
    }
    
    .chart-container-md {
      height: 280px;
    }
    
    .chart-container-sm {
      height: 240px;
    }
    
    /* Personality Description */
    .personality-description {
      grid-column: span 6;
    }
    
    .description-content {
      padding: 1.5rem;
      background: rgba(99, 102, 241, 0.05);
      border-radius: 16px;
      line-height: 1.8;
      color: var(--muted);
    }
    
    /* Detailed Analysis */
    .detailed-analysis {
      grid-column: span 6;
    }
    
    .analysis-tabs {
      border-bottom: 1px solid var(--glass-border);
      margin-bottom: 1.5rem;
    }
    
    .analysis-tabs .nav-link {
      border: none;
      border-radius: 10px 10px 0 0;
      color: var(--muted);
      font-weight: 500;
      padding: 0.75rem 1.5rem;
    }
    
    .analysis-tabs .nav-link.active {
      color: var(--primary-light);
      background: transparent;
      border-bottom: 2px solid var(--primary-light);
    }
    
    /* Insights Grid */
    .insights-grid {
      grid-column: span 6;
      display: grid;
      gap: 1rem;
    }
    
    .insight-card {
      padding: 1.5rem;
      background: rgba(6, 182, 212, 0.05);
      border: 1px solid rgba(6, 182, 212, 0.2);
      border-radius: 16px;
    }
    
    .insight-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-bottom: 1rem;
      background: rgba(6, 182, 212, 0.15);
      color: var(--accent);
    }
    
    /* Recommendations */
    .recommendations-grid {
      grid-column: span 6;
      display: grid;
      gap: 1rem;
    }
    
    .recommendation-card {
      padding: 1.5rem;
      background: rgba(34, 197, 94, 0.05);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: 16px;
    }
    
    .recommendation-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-bottom: 1rem;
      background: rgba(34, 197, 94, 0.15);
      color: var(--success);
    }
    
    /* Data Quality */
    .data-quality {
      grid-column: span 4;
    }
    
    .quality-metric {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--glass-border);
    }
    
    .quality-label {
      color: var(--muted);
      font-size: 0.875rem;
    }
    
    .quality-value {
      font-weight: 600;
    }
    
    .quality-badge {
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    
    .quality-badge.excellent {
      background: rgba(34, 197, 94, 0.2);
      color: var(--success);
    }
    
    .quality-badge.good {
      background: rgba(59, 130, 246, 0.2);
      color: var(--info);
    }
    
    .quality-badge.fair {
      background: rgba(245, 158, 11, 0.2);
      color: var(--warning);
    }
    
    .quality-badge.poor {
      background: rgba(239, 68, 68, 0.2);
      color: var(--danger);
    }
    
    /* Word Cloud */
    .word-cloud-container {
      grid-column: span 8;
      min-height: 300px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .word-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      align-items: center;
      padding: 2rem;
    }
    
    .word-item {
      padding: 0.5rem 1rem;
      border-radius: 50px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
      border: 1px solid var(--glass-border);
      transition: all 0.3s ease;
    }
    
    .word-item:hover {
      transform: scale(1.05);
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);
    }
    
    .word-text {
      font-weight: 600;
    }
    
    .word-count {
      font-size: 0.75rem;
      opacity: 0.7;
    }
    
    /* Sentiment Timeline */
    .sentiment-timeline {
      grid-column: span 12;
    }
    
    /* Action Buttons */
    .action-buttons {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }
    
    .btn-analysis {
      padding: 1rem 2rem;
      border-radius: 12px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      transition: all 0.3s ease;
      border: none;
    }
    
    .btn-analysis-primary {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
    }
    
    .btn-analysis-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
    }
    
    .btn-analysis-secondary {
      background: var(--glass);
      border: 1px solid var(--glass-border);
      color: var(--light);
    }
    
    .btn-analysis-secondary:hover {
      background: var(--glass-hover);
      transform: translateY(-2px);
    }
    
    /* Loading Spinner */
    .analysis-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem;
      text-align: center;
    }
    
    .spinner-analysis {
      width: 60px;
      height: 60px;
      border: 4px solid var(--glass);
      border-top: 4px solid var(--primary);
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin-bottom: 1.5rem;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    /* Responsive */
    @media (max-width: 1400px) {
      .analysis-grid {
        grid-template-columns: repeat(6, 1fr);
      }
      .personality-overview,
      .word-cloud-container {
        grid-column: span 6;
      }
      .personality-description,
      .detailed-analysis,
      .insights-grid,
      .recommendations-grid {
        grid-column: span 3;
      }
    }
    
    @media (max-width: 992px) {
      .analysis-container {
        padding: 1rem;
      }
      .analysis-grid {
        grid-template-columns: repeat(1, 1fr);
      }
      .personality-overview,
      .traits-grid,
      .personality-description,
      .detailed-analysis,
      .insights-grid,
      .recommendations-grid,
      .data-quality,
      .word-cloud-container,
      .sentiment-timeline {
        grid-column: span 1;
      }
      .traits-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    
    @media (max-width: 768px) {
      .traits-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .action-buttons {
        flex-direction: column;
      }
      .page-title {
        font-size: 1.8rem;
      }
    }
    
    @media (max-width: 576px) {
      .analysis-metadata {
        flex-direction: column;
        gap: 1rem;
      }
      .traits-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="bg-mesh"></div>

  <!-- Navbar -->
  <%- include('partials/navbar') %>

  <!-- Main Content -->
  <div class="analysis-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-custom">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Analysis Dashboard</li>
      </ol>
    </nav>

    <!-- Page Header -->
    <div class="page-header">
      <h1 class="page-title">Personality Analysis Dashboard</h1>
      <p class="page-subtitle">Advanced insights from your social media patterns and interactions</p>
      
      <div class="analysis-metadata">
        <div class="metadata-item">
          <i class="fas fa-user-circle"></i>
          <div>
            <div class="metadata-label">Analyzed Profile</div>
            <div class="metadata-value"><%= userData.name || 'User' %></div>
          </div>
        </div>
        
        <div class="metadata-item">
          <i class="fas fa-calendar-alt"></i>
          <div>
            <div class="metadata-label">Last Analysis</div>
            <div class="metadata-value" id="lastUpdated"><%= userData.lastUpdated || new Date().toLocaleDateString() %></div>
          </div>
        </div>
        
        <div class="metadata-item">
          <i class="fas fa-database"></i>
          <div>
            <div class="metadata-label">Data Points</div>
            <div class="metadata-value"><%= (feedData?.data?.length || 0) + (albumsData?.length || 0) %> processed</div>
          </div>
        </div>
        
        <div class="metadata-item">
          <i class="fas fa-shield-alt"></i>
          <div>
            <div class="metadata-label">Confidence</div>
            <div class="metadata-value"><%= personalityScores?.confidence || 'N/A' %>%</div>
          </div>
        </div>
      </div>
    </div>

    <% if (!personalityScores) { %>
      <!-- Loading State -->
      <div class="glass-card">
        <div class="analysis-loading">
          <div class="spinner-analysis"></div>
          <h3>Analyzing Your Personality</h3>
          <p class="text-muted mt-2">We're processing your social media data to generate insights...</p>
        </div>
      </div>
    <% } else { %>
      <!-- Analysis Grid -->
      <div class="analysis-grid">
        <!-- Personality Overview Chart -->
        <div class="glass-card personality-overview">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-chart-radar" style="background: rgba(99, 102, 241, 0.15); color: var(--primary-light);"></i>
              Big Five Personality Profile
            </h3>
          </div>
          <div class="card-body-custom">
            <div class="chart-container chart-container-lg">
              <canvas id="personalityRadarChart"></canvas>
            </div>
          </div>
          <div class="card-footer-custom">
            Based on <strong><%= textStatistics?.totalWords || 0 %> words</strong> from your social media activity
          </div>
        </div>

        <!-- Traits Grid -->
        <div class="traits-grid">
          <!-- Openness -->
          <div class="glass-card trait-card">
            <div class="trait-icon" style="background: rgba(99, 102, 241, 0.15); color: var(--primary);">
              <i class="fas fa-lightbulb"></i>
            </div>
            <div class="trait-name">Openness</div>
            <div class="trait-value"><%= personalityScores.openness %>%</div>
          </div>
          
          <!-- Conscientiousness -->
          <div class="glass-card trait-card">
            <div class="trait-icon" style="background: rgba(34, 197, 94, 0.15); color: var(--success);">
              <i class="fas fa-tasks"></i>
            </div>
            <div class="trait-name">Conscientiousness</div>
            <div class="trait-value"><%= personalityScores.conscientiousness %>%</div>
          </div>
          
          <!-- Extroversion -->
          <div class="glass-card trait-card">
            <div class="trait-icon" style="background: rgba(245, 158, 11, 0.15); color: var(--warning);">
              <i class="fas fa-users"></i>
            </div>
            <div class="trait-name">Extroversion</div>
            <div class="trait-value"><%= personalityScores.extroversion %>%</div>
          </div>
          
          <!-- Agreeableness -->
          <div class="glass-card trait-card">
            <div class="trait-icon" style="background: rgba(239, 68, 68, 0.15); color: var(--danger);">
              <i class="fas fa-handshake"></i>
            </div>
            <div class="trait-name">Agreeableness</div>
            <div class="trait-value"><%= personalityScores.agreeableness %>%</div>
          </div>
        </div>

        <!-- Personality Description -->
        <div class="glass-card personality-description">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-comment-alt" style="background: rgba(6, 182, 212, 0.15); color: var(--accent);"></i>
              Your Personality Description
            </h3>
          </div>
          <div class="card-body-custom">
            <div class="description-content">
              <%= pD || 'Personality description will appear here after analysis.' %>
            </div>
          </div>
        </div>

        <!-- Detailed Analysis -->
        <div class="glass-card detailed-analysis">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-chart-line" style="background: rgba(139, 92, 246, 0.15); color: var(--secondary);"></i>
              Detailed Analysis
            </h3>
          </div>
          <div class="card-body-custom">
            <ul class="nav nav-tabs analysis-tabs" id="analysisTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="sentiment-tab" data-bs-toggle="tab" data-bs-target="#sentiment" type="button" role="tab">
                  <i class="fas fa-smile me-2"></i>Sentiment
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="interests-tab" data-bs-toggle="tab" data-bs-target="#interests" type="button" role="tab">
                  <i class="fas fa-heart me-2"></i>Interests
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="linguistic-tab" data-bs-toggle="tab" data-bs-target="#linguistic" type="button" role="tab">
                  <i class="fas fa-language me-2"></i>Linguistic
                </button>
              </li>
            </ul>
            
            <div class="tab-content mt-3" id="analysisTabContent">
              <!-- Sentiment Tab -->
              <div class="tab-pane fade show active" id="sentiment" role="tabpanel">
                <div class="chart-container chart-container-sm">
                  <canvas id="sentimentGauge"></canvas>
                </div>
                <p class="mt-3 text-muted">
                  Overall sentiment score based on your posts and interactions.
                  <%= sentiment?.score >= 50 ? 'You tend to express positive emotions.' : 'Your content shows more neutral or analytical tendencies.' %>
                </p>
              </div>
              
              <!-- Interests Tab -->
              <div class="tab-pane fade" id="interests" role="tabpanel">
                <div class="mb-3">
                  <h5 class="mb-2">Primary Interest Area</h5>
                  <span class="badge bg-primary bg-opacity-25 text-primary-emphasis fs-6 p-2"><%= areaOfInterest %></span>
                </div>
                <div>
                  <h5 class="mb-2">Top Categories</h5>
                  <div class="d-flex flex-wrap gap-2">
                    <% if (mostCommonLikes && typeof mostCommonLikes === 'object') { %>
                      <% Object.entries(mostCommonLikes).slice(0, 5).forEach(([category, count]) => { %>
                        <span class="badge bg-secondary bg-opacity-25 text-secondary-emphasis p-2"><%= category %> (<%= count %>)</span>
                      <% }) %>
                    <% } %>
                  </div>
                </div>
              </div>
              
              <!-- Linguistic Tab -->
              <div class="tab-pane fade" id="linguistic" role="tabpanel">
                <div class="row">
                  <div class="col-6">
                    <div class="text-center p-3">
                      <h3 class="display-6"><%= textStatistics?.vocabularyDiversity ? (textStatistics.vocabularyDiversity * 100).toFixed(1) : 0 %>%</h3>
                      <p class="text-muted mb-0">Vocabulary Diversity</p>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="text-center p-3">
                      <h3 class="display-6"><%= readability?.fleschKincaid ? readability.fleschKincaid.toFixed(0) : 0 %></h3>
                      <p class="text-muted mb-0">Readability Score</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Insights -->
        <div class="glass-card insights-grid">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-bullseye" style="background: rgba(6, 182, 212, 0.15); color: var(--accent);"></i>
              Key Insights
            </h3>
          </div>
          <div class="card-body-custom">
            <% if (insights && insights.length > 0) { %>
              <% insights.forEach((insight, index) => { %>
                <div class="insight-card mb-3">
                  <div class="insight-icon">
                    <i class="fas fa-chart-pie"></i>
                  </div>
                  <h5><%= insight.title %></h5>
                  <p class="mb-0"><%= insight.description %></p>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-muted">Insights will appear here after detailed analysis.</p>
            <% } %>
          </div>
        </div>

        <!-- Recommendations -->
        <div class="glass-card recommendations-grid">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-star" style="background: rgba(34, 197, 94, 0.15); color: var(--success);"></i>
              Recommendations
            </h3>
          </div>
          <div class="card-body-custom">
            <% if (recommendations && recommendations.length > 0) { %>
              <% recommendations.forEach((rec, index) => { %>
                <div class="recommendation-card mb-3">
                  <div class="recommendation-icon">
                    <i class="fas fa-check-circle"></i>
                  </div>
                  <h5><%= rec.title %></h5>
                  <p class="mb-0"><%= rec.description %></p>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-muted">Personalized recommendations will appear here.</p>
            <% } %>
          </div>
        </div>

        <!-- Data Quality -->
        <div class="glass-card data-quality">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-clipboard-check" style="background: rgba(59, 130, 246, 0.15); color: var(--info);"></i>
              Data Quality
            </h3>
          </div>
          <div class="card-body-custom">
            <div class="quality-metric">
              <span class="quality-label">Profile Completeness</span>
              <span class="quality-value">85%</span>
              <span class="quality-badge excellent">Excellent</span>
            </div>
            
            <div class="quality-metric">
              <span class="quality-label">Data Points</span>
              <span class="quality-value"><%= feedData?.data?.length || 0 %></span>
              <span class="quality-badge <%= (feedData?.data?.length || 0) > 50 ? 'excellent' : 'good' %>">
                <%= (feedData?.data?.length || 0) > 50 ? 'Excellent' : 'Good' %>
              </span>
            </div>
            
            <div class="quality-metric">
              <span class="quality-label">Analysis Confidence</span>
              <span class="quality-value"><%= personalityScores.confidence %>%</span>
              <span class="quality-badge <%= personalityScores.confidence > 80 ? 'excellent' : personalityScores.confidence > 60 ? 'good' : 'fair' %>">
                <%= personalityScores.confidence > 80 ? 'Excellent' : personalityScores.confidence > 60 ? 'Good' : 'Fair' %>
              </span>
            </div>
            
            <div class="quality-metric">
              <span class="quality-label">Update Frequency</span>
              <span class="quality-value">Daily</span>
              <span class="quality-badge excellent">Excellent</span>
            </div>
          </div>
        </div>

        <!-- Word Cloud -->
        <div class="glass-card word-cloud-container">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-cloud" style="background: rgba(245, 158, 11, 0.15); color: var(--warning);"></i>
              Frequently Used Words
            </h3>
          </div>
          <div class="card-body-custom">
            <div class="word-cloud">
              <% if (mostCommonWords && mostCommonWords.length > 0) { %>
                <% mostCommonWords.slice(0, 20).forEach((word, index) => { 
                  const size = Math.min(24, 14 + (word.count || 1));
                %>
                  <div class="word-item" style="font-size: <%= size %>px;">
                    <span class="word-text"><%= word.word %></span>
                    <span class="word-count">(<%= word.count %>)</span>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="text-muted">Word frequency data will appear here after text analysis.</p>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Sentiment Timeline -->
        <div class="glass-card sentiment-timeline">
          <div class="card-header-custom">
            <h3 class="card-title">
              <i class="fas fa-history" style="background: rgba(239, 68, 68, 0.15); color: var(--danger);"></i>
              Sentiment Over Time
            </h3>
          </div>
          <div class="card-body-custom">
            <div class="chart-container chart-container-md">
              <canvas id="sentimentTimeline"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <button class="btn btn-analysis btn-analysis-primary" id="refreshAnalysis">
          <i class="fas fa-sync-alt"></i>
          Refresh Analysis
        </button>
        
        <button class="btn btn-analysis btn-analysis-secondary" id="exportReport">
          <i class="fas fa-download"></i>
          Export Full Report
        </button>
        
        <button class="btn btn-analysis btn-analysis-secondary" id="shareInsights">
          <i class="fas fa-share-alt"></i>
          Share Insights
        </button>
        
        <a href="/profile" class="btn btn-analysis btn-analysis-secondary">
          <i class="fas fa-user-edit"></i>
          Complete Profile
        </a>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <script nonce="<%= nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      // Chart.js Defaults
      Chart.defaults.font.family = "'Inter', sans-serif";
      Chart.defaults.color = 'rgba(148, 163, 184, 0.8)';
      
      // Personality Radar Chart
      <% if (personalityScores) { %>
        const personalityRadarCtx = document.getElementById('personalityRadarChart');
        if (personalityRadarCtx) {
          const personalityData = {
            labels: [
              'Openness', 
              'Conscientiousness', 
              'Extroversion', 
              'Agreeableness', 
              'Neuroticism'
            ],
            datasets: [{
              label: 'Your Scores',
              data: [
                <%= personalityScores.openness || 0 %>,
                <%= personalityScores.conscientiousness || 0 %>,
                <%= personalityScores.extroversion || 0 %>,
                <%= personalityScores.agreeableness || 0 %>,
                <%= personalityScores.neuroticism || 0 %>
              ],
              backgroundColor: 'rgba(99, 102, 241, 0.2)',
              borderColor: 'rgba(99, 102, 241, 1)',
              borderWidth: 2,
              pointBackgroundColor: 'rgba(99, 102, 241, 1)',
              pointBorderColor: '#fff',
              pointRadius: 6,
              pointHoverRadius: 8
            }]
          };
          
          new Chart(personalityRadarCtx, {
          type: 'radar',
          data: personalityData,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              r: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  stepSize: 20,
                  backdropColor: 'transparent'
                },
                grid: {
                  color: 'rgba(255, 255, 255, 0.05)'
                },
                angleLines: {
                  color: 'rgba(255, 255, 255, 0.05)'
                },
                pointLabels: {
                  color: 'rgba(248, 250, 252, 0.9)',
                  font: {
                    size: 14,
                    weight: '600'
                  }
                }
              }
            },
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                padding: 12,
                cornerRadius: 8,
                callbacks: {
                  label: function(context) {
                    return `${context.label}: ${context.raw}%`;
                  }
                }
              }
            }
          }
        });
        
        // Sentiment Gauge Chart
        const sentimentGaugeCtx = document.getElementById('sentimentGauge');
        if (sentimentGaugeCtx) {
          const sentimentScore = <%= sentiment?.score || 50 %>;
          const isPositive = sentimentScore >= 50;
          
          new Chart(sentimentGaugeCtx, {
            type: 'doughnut',
            data: {
              labels: ['Positive', 'Negative'],
              datasets: [{
                data: [sentimentScore, 100 - sentimentScore],
                backgroundColor: [
                  isPositive ? 'rgba(34, 197, 94, 0.8)' : 'rgba(239, 68, 68, 0.8)',
                  'rgba(148, 163, 184, 0.2)'
                ],
                borderWidth: 0,
                circumference: 180,
                rotation: 270
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '75%',
              plugins: {
                legend: {
                  display: false
                }
              }
            },
            plugins: [{
              id: 'gaugeCenter',
              afterDraw: (chart) => {
                const { ctx, width, height } = chart;
                ctx.save();
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.font = 'bold 2rem Poppins';
                ctx.fillStyle = isPositive ? '#22c55e' : '#ef4444';
                ctx.fillText(`${sentimentScore}%`, width / 2, height / 2 + 20);
                ctx.font = '1rem Inter';
                ctx.fillStyle = 'rgba(148, 163, 184, 0.8)';
                ctx.fillText('Sentiment Score', width / 2, height / 2 - 20);
                ctx.restore();
              }
            }]
          });
        }
        
        // Sentiment Timeline Chart (Sample Data)
        const sentimentTimelineCtx = document.getElementById('sentimentTimeline');
        if (sentimentTimelineCtx) {
          const timelineData = {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
            datasets: [{
              label: 'Sentiment Score',
              data: [65, 59, 80, 81, 56, 55, <%= sentiment?.score || 50 %>],
              borderColor: 'rgba(99, 102, 241, 1)',
              backgroundColor: 'rgba(99, 102, 241, 0.1)',
              tension: 0.4,
              fill: true
            }]
          };
          
          new Chart(sentimentTimelineCtx, {
            type: 'line',
            data: timelineData,
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: false,
                  min: 0,
                  max: 100,
                  grid: {
                    color: 'rgba(255, 255, 255, 0.05)'
                  }
                },
                x: {
                  grid: {
                    color: 'rgba(255, 255, 255, 0.05)'
                  }
                }
              },
              plugins: {
                legend: {
                  display: false
                },
                tooltip: {
                  backgroundColor: 'rgba(15, 23, 42, 0.95)',
                  padding: 12,
                  cornerRadius: 8
                }
              }
            }
          });
        }
      <% } %>
      
      // Button Event Listeners
      const refreshBtn = document.getElementById('refreshAnalysis');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', async function() {
          this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Refreshing...';
          this.disabled = true;
          
          try {
            const response = await fetch('/api/analysis/refresh', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              }
            });
            
            if (response.ok) {
              setTimeout(() => {
                location.reload();
              }, 2000);
            } else {
              alert('Failed to refresh analysis. Please try again.');
              this.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh Analysis';
              this.disabled = false;
            }
          } catch (error) {
            console.error('Error:', error);
            alert('An error occurred. Please try again.');
            this.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh Analysis';
            this.disabled = false;
          }
        });
      }
      
      const exportBtn = document.getElementById('exportReport');
        if (exportBtn) {
        exportBtn.addEventListener('click', async function() {
            const originalHTML = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Preparing...';
            this.disabled = true;
            
            try {
            // Use the PDF export endpoint
            const response = await fetch('/api/export/pdf');
            
            if (response.ok && response.headers.get('content-type') === 'application/pdf') {
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `visisocial-report-${Date.now()}.pdf`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                window.URL.revokeObjectURL(url);
                
                // Show success message
                const toast = document.createElement('div');
                toast.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
                toast.style.zIndex = '9999';
                toast.innerHTML = `
                <strong>Success!</strong> PDF report downloaded successfully.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 5000);
            } else {
                // If not PDF, try to read as JSON for error
                const errorData = await response.json();
                throw new Error(errorData.message || 'Export failed');
            }
            } catch (error) {
            console.error('Export error:', error);
            alert('Failed to export PDF report: ' + error.message);
            } finally {
            this.innerHTML = originalHTML;
            this.disabled = false;
            }
        });
        }
      
      const shareBtn = document.getElementById('shareInsights');
      if (shareBtn) {
        shareBtn.addEventListener('click', function() {
          if (navigator.share) {
            navigator.share({
              title: 'My VisiSocial Personality Insights',
              text: 'Check out my personality analysis from VisiSocial!',
              url: window.location.href
            });
          } else {
            // Fallback: Copy to clipboard
            navigator.clipboard.writeText(window.location.href)
              .then(() => {
                alert('Link copied to clipboard!');
              })
              .catch(() => {
                prompt('Copy this link to share:', window.location.href);
              });
          }
        });
      }
      
      // Update last updated time
      const lastUpdatedEl = document.getElementById('lastUpdated');
      if (lastUpdatedEl && lastUpdatedEl.textContent.includes('T')) {
        const date = new Date(lastUpdatedEl.textContent);
        lastUpdatedEl.textContent = date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      }
    });
  </script>
    <%- include('partials/footer') %>
</body>
</html>