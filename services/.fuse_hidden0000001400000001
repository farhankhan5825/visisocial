        verify: async (username) => {
          // Facebook blocks automated access
          return { exists: null, data: null };
        }
      }
    ];
  }
  
  /**
   * Verify if account exists on a specific platform
   */
  static async verifyPlatform(platform, username) {
    const cacheKey = `platform_${platform.name}_${username}`;
    
    // Check cache first
    const cached = await cache.get(cacheKey);
    if (cached !== null && cached !== undefined) {
      logger.debug(`Cache hit for ${platform.name}/${username}`);
      metrics.increment('platform.cache.hit');
      return cached;
    }
    
    try {
      // Run verification
      const verification = await platform.verify(username);
      
      // Determine status
      let status, verified;
      if (verification.exists === true) {
        status = 'verified';
        verified = true;
      } else if (verification.exists === false) {
        status = 'not_found';
        verified = false;
      } else {
        status = 'unknown';
        verified = false;
      }
      
      // Only return if verified or unknown (skip not_found)
      if (status === 'not_found') {
        await cache.set(cacheKey, null, 3600000); // Cache 1 hour
        return null;
      }
      
      const result = {
        platform: platform.name,
        username: username,
        profileUrl: platform.profileUrl(username),
        verified: verified,
        status: status,
        icon: platform.icon,
        color: platform.color,
        checkedAt: new Date(),
        source: 'social_media',
        ...(verification.data && { additionalData: verification.data })
      };
      
      // Cache for 6 hours
      await cache.set(cacheKey, result, 6 * 3600000);
      
      metrics.increment(`platform.verify.${status}`);
      logger.debug(`${platform.name}/${username}: ${status}`);
      
      return result;
      
    } catch (error) {
      logger.debug(`Verification error for ${platform.name}/${username}: ${error.message}`);
      metrics.increment('platform.verify.error');
      
      // Return as unknown on error
      const result = {
        platform: platform.name,
        username: username,
        profileUrl: platform.profileUrl(username),
        verified: false,
        status: 'unknown',
        icon: platform.icon,
        color: platform.color,
        error: error.message,
        checkedAt: new Date(),
        source: 'social_media'
      };
      
      // Cache unknown for 1 hour
      await cache.set(cacheKey, result, 3600000);
      
      return result;
    }
  }
  
  /**
   * Validate username format
   */
  static isValidUsername(username) {
    if (!username || typeof username !== 'string') return false;
    if (username.length < 1 || username.length > 40) return false;
    // Allow letters, numbers, dots, hyphens, underscores
    return /^[a-zA-Z0-9._-]+$/.test(username);
  }
  
  /**
   * Get search URL for a platform
   */
  static getSearchUrl(platform, query) {
    return platform.searchUrl ? platform.searchUrl(query) : null;
  }
}

