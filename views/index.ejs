<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <title>Dashboard | VisiSocial</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Your personalized social intelligence console: personality inference, language signals, and surveillance risk in one view.">

  <link href="/img/favicon.ico" rel="icon">

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">

  <!-- Styles -->
  <link href="/stylesheets/bootstrap.min.css" rel="stylesheet">
  <link href="/stylesheets/visisocial.css" rel="stylesheet">
  <link href="/stylesheets/styles.css" rel="stylesheet">

  <style>
    /* ---- Dashboard page layout (components live in visisocial.css) ---- */
    .dash { padding: 30px 0 40px; }

    /* Identity header */
    .id-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 22px; flex-wrap: wrap; margin-bottom: 34px; }
    .id-greet { font-size: clamp(1.7rem, 4vw, 2.6rem); font-weight: 700; line-height: 1.05; letter-spacing: -.03em; margin: 8px 0 10px; }
    .id-sub { color: var(--vs-muted); max-width: 56ch; font-size: .98rem; }
    .id-pills { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 16px; }
    .id-side { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
    .id-date { font-family: var(--vs-mono); font-size: .8rem; color: var(--vs-muted); display: flex; align-items: center; gap: 8px; }
    .id-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }

    /* Bento signal grid */
    .signal-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 18px; }
    .signal-grid.surv { margin-top: 16px; }
    @media (max-width: 900px) { .signal-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 540px) { .signal-grid { grid-template-columns: 1fr; } }

    /* Two-up + asymmetric rows */
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .row-57 { display: grid; grid-template-columns: 5fr 7fr; gap: 18px; }
    .row-73 { display: grid; grid-template-columns: 1.35fr 1fr; gap: 18px; }
    @media (max-width: 980px) { .row-2, .row-57, .row-73 { grid-template-columns: 1fr; } }

    .chart-box { height: 280px; }
    .chart-box.sm { height: 240px; }

    /* Trait bars */
    .trait-item { margin-bottom: 16px; }
    .trait-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 7px; }
    .trait-name { font-size: .9rem; font-weight: 500; color: var(--vs-ink-2); }
    .trait-value { font-family: var(--vs-mono); font-size: .82rem; font-weight: 600; color: var(--vs-ink); }
    .trait-bar { height: 6px; border-radius: 999px; background: rgba(255,255,255,.06); overflow: hidden; }
    .trait-fill { height: 100%; border-radius: inherit; width: 0; transition: width 1.1s var(--vs-ease); }

    /* Vulnerability breakdown */
    .vuln-list { display: grid; gap: 14px; }
    .vuln-row { display: grid; grid-template-columns: 1fr auto; gap: 8px 14px; align-items: center; }
    .vuln-row .vuln-name { font-size: .86rem; color: var(--vs-ink-2); }
    .vuln-row .vuln-num { font-family: var(--vs-mono); font-size: .82rem; font-weight: 600; }
    .vuln-row .vs-bar { grid-column: 1 / -1; }

    /* Correlations */
    .corr-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    @media (max-width: 720px) { .corr-grid { grid-template-columns: 1fr; } }
    .corr { padding: 18px; border: 1px solid var(--vs-line); border-radius: var(--vs-r-sm); background: rgba(255,255,255,.015); transition: border-color .3s var(--vs-ease); }
    .corr:hover { border-color: var(--vs-line-2); }
    .corr-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .corr-type { font-family: var(--vs-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--vs-cyan); }
    .corr-conf { font-family: var(--vs-mono); font-size: .74rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
    .corr-conf.high { color: var(--vs-ok); background: rgba(45,212,168,.1); }
    .corr-conf.medium { color: var(--vs-warn); background: rgba(246,178,74,.1); }
    .corr-conf.low { color: var(--vs-muted); background: rgba(255,255,255,.05); }
    .corr-pattern { font-size: .92rem; color: var(--vs-ink); margin-bottom: 9px; line-height: 1.5; }
    .corr-insight { font-size: .82rem; color: var(--vs-muted); display: flex; gap: 8px; }
    .corr-insight i { color: var(--vs-warn); margin-top: 3px; }

    /* About / identity card */
    .about { display: flex; gap: 18px; align-items: center; }
    .about-av { width: 76px; height: 76px; border-radius: 18px; object-fit: cover; border: 1px solid var(--vs-line-2); }
    .about-name { font-size: 1.2rem; font-weight: 700; margin: 0 0 2px; }
    .about-role { font-family: var(--vs-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--vs-cyan); margin: 0 0 10px; }
    .about-bio { color: var(--vs-muted); font-size: .9rem; line-height: 1.6; margin: 0; }
    .about-actions { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 20px; }

    /* Photo gallery */
    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 9px; }
    .ph { position: relative; aspect-ratio: 1; border-radius: var(--vs-r-xs); overflow: hidden; cursor: pointer; border: 1px solid var(--vs-line); }
    .ph img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--vs-ease); }
    .ph:hover img { transform: scale(1.07); }
    .ph-ov { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 8px; background: rgba(7,7,14,.6); opacity: 0; transition: opacity .3s; }
    .ph:hover .ph-ov { opacity: 1; }
    .ph-btn { width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; color: #fff; background: rgba(255,255,255,.12); font-size: .72rem; }

    /* Personality narrative split */
    .pers-split { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; align-items: start; }
    @media (max-width: 860px) { .pers-split { grid-template-columns: 1fr; } }
    .pers-text { color: var(--vs-ink-2); line-height: 1.7; font-size: .96rem; }

    /* Toast + overlay */
    .vs-overlay { position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center; flex-direction: column; gap: 18px; background: rgba(7,7,14,.82); backdrop-filter: blur(8px); }
    .vs-spin { width: 46px; height: 46px; border: 3px solid rgba(124,108,255,.2); border-top-color: var(--vs-violet); border-radius: 50%; animation: vs-rot .8s linear infinite; }
    @keyframes vs-rot { to { transform: rotate(360deg); } }
    .vs-overlay .t { color: var(--vs-ink-2); font-family: var(--vs-mono); font-size: .86rem; }
    .vs-toast { position: fixed; top: 86px; right: 22px; z-index: 9998; max-width: 340px; padding: 16px 18px; border-radius: var(--vs-r-sm); background: var(--vs-raised); border: 1px solid var(--vs-line-2); box-shadow: var(--vs-shadow-lg); transform: translateX(140%); transition: transform .45s var(--vs-ease); }
    .vs-toast.show { transform: none; }
    .vs-toast .tt { display: flex; align-items: center; gap: 9px; font-weight: 600; font-size: .92rem; margin-bottom: 5px; }
    .vs-toast .tm { color: var(--vs-muted); font-size: .85rem; }

    .back-to-top.visible { display: inline-flex; }
  </style>
</head>

<body>
  <div class="vs-field"></div>
  <div class="vs-grid-overlay"></div>

  <!-- Loading overlay -->
  <div class="vs-overlay" id="loadingOverlay">
    <div class="vs-spin"></div>
    <div class="t" id="loadingText">Refreshing your analysis...</div>
  </div>

  <!-- Toast -->
  <div class="vs-toast" id="alertNotification">
    <div class="tt" id="alertTitle"><i class="fas fa-check-circle text-success"></i><span id="alertTitleText">Success</span></div>
    <div class="tm" id="alertMessage">Operation completed successfully.</div>
  </div>

  <%- include('partials/navbar') %>

  <main class="dash">
    <div class="vs-shell">

      <!-- ============ IDENTITY HEADER ============ -->
      <header class="id-head vs-reveal">
        <div>
          <span class="vs-eyebrow">Intelligence Console</span>
          <h1 class="id-greet">Welcome back,
            <span class="vs-grad-text"><% if (userData.name) { %><%= userData.name.split(' ')[0] %><% } else { %>there<% } %></span>
          </h1>
          <p class="id-sub">A live read of what your social footprint reveals: personality inference, language signals, and the risks a watcher could exploit.</p>
          <div class="id-pills">
            <span class="vs-pill vs-pill--ok vs-pill--live">Analysis complete</span>
            <% if (hasSurveillance) { %><span class="vs-pill vs-pill--warn">Surveillance active</span><% } %>
            <span class="vs-pill vs-pill--cyan"><%= (mostCommonWords && mostCommonWords.length) || 0 %> data points</span>
          </div>
        </div>
        <div class="id-side">
          <div class="id-date"><i class="far fa-calendar"></i><span id="currentDate"></span></div>
          <div class="id-actions">
            <button class="vs-btn vs-btn--ghost" id="refreshBtn"><i class="fas fa-sync-alt"></i>Refresh analysis</button>
            <% if (hasSurveillance) { %>
            <a href="/surveillance/exploitation-risk" class="vs-btn vs-btn--alert"><i class="fas fa-triangle-exclamation"></i>Risk report</a>
            <% } %>
          </div>
        </div>
      </header>

      <!-- ============ SIGNAL METRICS (BENTO) ============ -->
      <div class="signal-grid vs-reveal">
        <div class="vs-metric vs-edge-violet">
          <div class="vs-metric__top">
            <div class="vs-metric__ic vs-tint-violet"><i class="fas fa-heart"></i></div>
            <span class="vs-metric__label">Top interest</span>
          </div>
          <div class="vs-metric__value"><%= mostCommonLikes || 'Exploring' %></div>
          <div class="vs-metric__sub up"><i class="fas fa-arrow-trend-up"></i>Active signal</div>
        </div>

        <div class="vs-metric vs-edge-cyan">
          <div class="vs-metric__top">
            <div class="vs-metric__ic vs-tint-cyan"><i class="fas fa-compass"></i></div>
            <span class="vs-metric__label">Focus area</span>
          </div>
          <div class="vs-metric__value"><%= areaOfInterest || 'General' %></div>
          <div class="vs-metric__sub up"><i class="fas fa-chart-line"></i>Growing</div>
        </div>

        <div class="vs-metric vs-edge-ok">
          <div class="vs-metric__top">
            <div class="vs-metric__ic vs-tint-ok"><i class="fas fa-database"></i></div>
            <span class="vs-metric__label">Vocabulary</span>
          </div>
          <div class="vs-metric__value vs-data"><%= (mostCommonWords && mostCommonWords.length) || 0 %></div>
          <div class="vs-metric__sub up"><i class="fas fa-check"></i>Words analyzed</div>
        </div>

        <% var sScore = (sentiment && sentiment.score) || 50; %>
        <div class="vs-metric <%= sScore >= 50 ? 'vs-edge-ok' : 'vs-edge-alert' %>">
          <div class="vs-metric__top">
            <div class="vs-metric__ic <%= sScore >= 50 ? 'vs-tint-ok' : 'vs-tint-alert' %>"><i class="fas fa-face-smile"></i></div>
            <span class="vs-metric__label">Sentiment</span>
          </div>
          <div class="vs-metric__value vs-data"><%= sScore %>%</div>
          <div class="vs-metric__sub <%= sScore >= 50 ? 'up' : 'down' %>">
            <i class="fas fa-arrow-<%= sScore >= 50 ? 'up' : 'down' %>"></i><%= sScore >= 50 ? 'Positive tone' : 'Negative tone' %>
          </div>
        </div>
      </div>

      <% if (hasSurveillance) { %>
      <%
        var avgVuln = null;
        if (surveillance.vulnerabilityProfile) {
          var vp = surveillance.vulnerabilityProfile;
          avgVuln = Math.round((vp.manipulationSusceptibility + vp.privacyRisk + vp.socialEngineeringRisk + vp.emotionalExploitability + vp.dataLeakageRisk + vp.targetingPotential) / 6);
        }
      %>
      <div class="signal-grid surv vs-reveal">
        <div class="vs-metric vs-edge-warn">
          <div class="vs-metric__top">
            <div class="vs-metric__ic vs-tint-warn"><i class="fas fa-brain"></i></div>
            <span class="vs-metric__label">Behavioral</span>
          </div>
          <div class="vs-metric__value"><%= surveillance.behavioralPatterns ? 'Detected' : 'None' %></div>
          <div class="vs-metric__sub"><i class="fas fa-clock"></i><% if (surveillance.behavioralPatterns && surveillance.behavioralPatterns.postingCycle) { %><%= surveillance.behavioralPatterns.postingCycle.mostActiveTime || 'Various times' %><% } else { %>No pattern<% } %></div>
        </div>

        <div class="vs-metric <%= (avgVuln !== null && avgVuln > 50) ? 'vs-edge-alert' : 'vs-edge-ok' %>">
          <div class="vs-metric__top">
            <div class="vs-metric__ic <%= (avgVuln !== null && avgVuln > 50) ? 'vs-tint-alert' : 'vs-tint-ok' %>"><i class="fas fa-shield-halved"></i></div>
            <span class="vs-metric__label">Vulnerability</span>
          </div>
          <div class="vs-metric__value vs-data"><%= avgVuln !== null ? avgVuln + '%' : 'N/A' %></div>
          <div class="vs-metric__sub <%= (avgVuln !== null && avgVuln > 50) ? 'down' : 'up' %>"><i class="fas fa-shield"></i><%= (avgVuln !== null && avgVuln > 50) ? 'High risk' : 'Low risk' %></div>
        </div>

        <div class="vs-metric vs-edge-cyan">
          <div class="vs-metric__top">
            <div class="vs-metric__ic vs-tint-cyan"><i class="fas fa-diagram-project"></i></div>
            <span class="vs-metric__label">Cross-modal</span>
          </div>
          <div class="vs-metric__value vs-data"><%= (surveillance.correlations && surveillance.correlations.length) || 0 %></div>
          <div class="vs-metric__sub"><i class="fas fa-link"></i>Correlations</div>
        </div>

        <div class="vs-metric vs-edge-violet">
          <div class="vs-metric__top">
            <div class="vs-metric__ic vs-tint-violet"><i class="fas fa-microchip"></i></div>
            <span class="vs-metric__label">Data points</span>
          </div>
          <div class="vs-metric__value vs-data"><%= (surveillance.surveillanceMetadata && surveillance.surveillanceMetadata.totalDataPoints) || 0 %></div>
          <div class="vs-metric__sub up"><i class="fas fa-check"></i><%= (surveillance.surveillanceMetadata && surveillance.surveillanceMetadata.inferenceConfidence) || 0 %>% confidence</div>
        </div>
      </div>
      <% } %>

      <!-- ============ PERSONALITY PROFILE ============ -->
      <section class="vs-section vs-reveal">
        <div class="vs-section-head">
          <h2 class="vs-section-title"><span class="vs-tick"></span>Personality profile</h2>
          <span class="vs-pill vs-pill--cyan">Big Five inference</span>
        </div>
        <div class="vs-card vs-card--pad">
          <div class="pers-split">
            <div>
              <p class="pers-text"><%= pD || 'Your personality analysis will appear here once we have enough language data to model the five traits.' %></p>
              <div class="trait-bars" id="traitBars" style="margin-top: 22px;"></div>
            </div>
            <div class="chart-box"><canvas id="personalityChart"></canvas></div>
          </div>
        </div>
      </section>

      <!-- ============ LANGUAGE & SENTIMENT ============ -->
      <section class="vs-section vs-reveal" style="padding-top: 6px;">
        <div class="vs-section-head">
          <h2 class="vs-section-title"><span class="vs-tick"></span>Language signals</h2>
          <span class="vs-pill">Top 8 words</span>
        </div>
        <div class="row-73">
          <div class="vs-card">
            <div class="vs-card-head">
              <h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-comment-dots"></i></span>Frequently used words</h3>
            </div>
            <div class="vs-card-body">
              <div class="chart-box">
                <% if (mostCommonWords && mostCommonWords.length > 0) { %>
                  <canvas id="wordCountChart"></canvas>
                <% } else { %>
                  <div class="vs-empty"><i class="fas fa-comment-slash"></i><p>No word frequency data available yet</p></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="vs-card">
            <div class="vs-card-head">
              <h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-masks-theater"></i></span>Emotional tone</h3>
            </div>
            <div class="vs-card-body">
              <div class="chart-box sm"><canvas id="sentimentChart"></canvas></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ SURVEILLANCE INTELLIGENCE ============ -->
      <% if (hasSurveillance) { %>
      <section class="vs-section vs-reveal" style="padding-top: 6px;">
        <div class="vs-section-head">
          <h2 class="vs-section-title"><span class="vs-tick" style="background: linear-gradient(180deg,#f6b24a,#ff5d6c);"></span>Surveillance intelligence</h2>
          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button class="vs-btn vs-btn--warn" id="refreshSurveillanceBtn"><i class="fas fa-sync-alt"></i>Refresh</button>
            <a href="/surveillance/dashboard" class="vs-btn vs-btn--ghost"><i class="fas fa-eye"></i>Full report</a>
          </div>
        </div>

        <div class="row-57">
          <!-- Vulnerability breakdown -->
          <div class="vs-card">
            <div class="vs-card-head">
              <h3 class="vs-card-title"><span class="vs-ic" style="background: rgba(255,93,108,.12); color: var(--vs-alert);"><i class="fas fa-shield-halved"></i></span>Vulnerability breakdown</h3>
              <% if (avgVuln !== null) { %><span class="vs-pill <%= avgVuln > 50 ? 'vs-pill--alert' : 'vs-pill--ok' %>"><%= avgVuln %>% avg</span><% } %>
            </div>
            <div class="vs-card-body">
              <% if (surveillance.vulnerabilityProfile) { var vp = surveillance.vulnerabilityProfile;
                 var vdims = [
                   { n: 'Manipulation susceptibility', v: vp.manipulationSusceptibility },
                   { n: 'Privacy risk', v: vp.privacyRisk },
                   { n: 'Social engineering', v: vp.socialEngineeringRisk },
                   { n: 'Emotional exploitability', v: vp.emotionalExploitability },
                   { n: 'Data leakage', v: vp.dataLeakageRisk },
                   { n: 'Targeting potential', v: vp.targetingPotential }
                 ]; %>
              <div class="vuln-list">
                <% vdims.forEach(function(d){ var val = Math.round(d.v || 0); var col = val > 66 ? 'var(--vs-alert)' : val > 40 ? 'var(--vs-warn)' : 'var(--vs-ok)'; %>
                <div class="vuln-row">
                  <span class="vuln-name"><%= d.n %></span>
                  <span class="vuln-num" style="color: <%= col %>;"><%= val %>%</span>
                  <div class="vs-bar"><div class="vs-bar__fill vuln-fill" data-w="<%= val %>" style="background: <%= col %>;"></div></div>
                </div>
                <% }); %>
              </div>
              <% } else { %>
              <div class="vs-empty"><i class="fas fa-shield"></i><p>No vulnerability profile generated yet</p></div>
              <% } %>
            </div>
          </div>

          <!-- Correlations -->
          <div class="vs-card">
            <div class="vs-card-head">
              <h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-diagram-project"></i></span>Cross-modal correlations</h3>
              <% if (surveillance.correlations && surveillance.correlations.length) { %><span class="vs-pill vs-pill--cyan"><%= surveillance.correlations.length %> found</span><% } %>
            </div>
            <div class="vs-card-body">
              <% if (surveillance.correlations && surveillance.correlations.length > 0) { %>
              <div class="corr-grid">
                <% surveillance.correlations.slice(0, 4).forEach(function(correlation){ %>
                <div class="corr">
                  <div class="corr-top">
                    <span class="corr-type"><%= correlation.type || 'Pattern' %></span>
                    <span class="corr-conf <%= (correlation.confidence > 0.7) ? 'high' : (correlation.confidence > 0.4) ? 'medium' : 'low' %>"><%= Math.round(correlation.confidence * 100) %>%</span>
                  </div>
                  <div class="corr-pattern"><%= correlation.pattern || 'Behavioral pattern detected' %></div>
                  <div class="corr-insight"><i class="fas fa-lightbulb"></i><span><%= correlation.insight || 'Further analysis recommended' %></span></div>
                </div>
                <% }); %>
              </div>
              <% if (surveillance.correlations.length > 4) { %>
              <div style="text-align:center; margin-top: 18px;">
                <a href="/surveillance/cross-modal" class="vs-btn vs-btn--ghost"><i class="fas fa-arrow-right"></i>View all <%= surveillance.correlations.length %> correlations</a>
              </div>
              <% } %>
              <% } else { %>
              <div class="vs-empty"><i class="fas fa-diagram-project"></i><p>No correlations detected yet</p></div>
              <% } %>
            </div>
          </div>
        </div>
      </section>
      <% } else { %>
      <section class="vs-section vs-reveal" style="padding-top: 6px;">
        <div class="vs-card vs-card--pad" style="border-left: 3px solid var(--vs-warn);">
          <div class="vs-empty">
            <i class="fas fa-shield-halved" style="color: var(--vs-warn);"></i>
            <h3>Surveillance intelligence available</h3>
            <p>Run a deep pass to see the behavioral patterns and vulnerabilities a watcher could infer from your data.</p>
            <button class="vs-btn vs-btn--warn" id="triggerSurveillanceBtn" style="margin-top: 14px;"><i class="fas fa-play"></i>Run surveillance analysis</button>
          </div>
        </div>
      </section>
      <% } %>

      <!-- ============ IDENTITY & MEDIA ============ -->
      <section class="vs-section vs-reveal" style="padding-top: 6px;">
        <div class="vs-section-head">
          <h2 class="vs-section-title"><span class="vs-tick"></span>Identity &amp; media</h2>
        </div>
        <div class="row-2">
          <div class="vs-card vs-card--pad">
            <div class="about">
              <img src="<%= userData.picture?.data?.url || userData.picture || '/img/user.png' %>" alt="Profile" class="about-av" onerror="this.src='/img/user.png'">
              <div>
                <h4 class="about-name"><%= userData.name || 'User' %></h4>
                <p class="about-role">VisiSocial member</p>
                <p class="about-bio"><%= uD || 'Connect your social media to generate your personalized bio.' %></p>
              </div>
            </div>
            <div class="about-actions">
              <a href="/profile" class="vs-btn vs-btn--ghost"><i class="fas fa-user-pen"></i>Edit profile</a>
              <a href="/settings" class="vs-btn vs-btn--ghost"><i class="fas fa-sliders"></i>Privacy settings</a>
            </div>
          </div>

          <div class="vs-card">
            <div class="vs-card-head">
              <h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-images"></i></span>Photo gallery</h3>
              <span class="vs-pill"><%= albumsData ? albumsData.reduce((sum, album) => sum + (album.photos?.data?.length || 0), 0) : 0 %> photos</span>
            </div>
            <div class="vs-card-body">
              <% if (albumsData && albumsData.length > 0) { %>
              <div class="gallery">
                <% albumsData.forEach(function(album){ %>
                  <% if (album.photos && album.photos.data && album.photos.data.length > 0) { %>
                    <% album.photos.data.slice(0, 8).forEach(function(photo){ %>
                      <% if (photo.images && photo.images[0] && photo.images[0].source) { %>
                      <div class="ph">
                        <img src="<%= photo.images[0].source %>" alt="Photo" loading="lazy" onerror="this.src='/img/no-image.jpg'">
                        <div class="ph-ov">
                          <a href="<%= photo.images[0].source %>" target="_blank" class="ph-btn"><i class="fas fa-expand"></i></a>
                          <a href="<%= photo.images[0].source %>" download class="ph-btn"><i class="fas fa-download"></i></a>
                        </div>
                      </div>
                      <% } %>
                    <% }); %>
                  <% } %>
                <% }); %>
              </div>
              <% } else { %>
              <div class="vs-empty"><i class="far fa-images"></i><p>No photos found in your albums</p></div>
              <% } %>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <button class="back-to-top vs-btn vs-btn--solid btn-lg-square" id="backToTop"><i class="fas fa-arrow-up"></i></button>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <script nonce="<%= nonce %>">
    function showAlert(type, title, message, duration = 5000) {
      const alert = document.getElementById('alertNotification');
      const alertTitle = document.getElementById('alertTitle');
      const alertMessage = document.getElementById('alertMessage');
      let icon = 'fa-info-circle', iconColor = 'text-info';
      if (type === 'success') { icon = 'fa-check-circle'; iconColor = 'text-success'; }
      else if (type === 'error') { icon = 'fa-exclamation-circle'; iconColor = 'text-danger'; }
      else if (type === 'warning') { icon = 'fa-exclamation-triangle'; iconColor = 'text-warning'; }
      alertTitle.innerHTML = `<i class="fas ${icon} ${iconColor}"></i><span id="alertTitleText">${title}</span>`;
      alertMessage.textContent = message;
      alert.classList.add('show');
      setTimeout(() => alert.classList.remove('show'), duration);
    }

    function showLoading(message = 'Loading...') {
      const overlay = document.getElementById('loadingOverlay');
      document.getElementById('loadingText').textContent = message;
      overlay.style.display = 'flex';
    }
    function hideLoading() { document.getElementById('loadingOverlay').style.display = 'none'; }

    async function refreshAnalysis() {
      showLoading('Refreshing your analysis...');
      try {
        const response = await fetch('/refresh-analysis', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const data = await response.json();
        if (data.success) {
          showAlert('success', 'Analysis started', 'Your analysis refresh has been queued.', 8000);
          let checks = 0; const maxChecks = 30;
          const checkInterval = setInterval(async () => {
            checks++;
            if (checks >= maxChecks) { clearInterval(checkInterval); hideLoading(); showAlert('info', 'Processing complete', 'Analysis refresh complete.'); setTimeout(() => window.location.reload(), 2000); return; }
            try {
              const statusResponse = await fetch('/task-status');
              const status = await statusResponse.json();
              if (status.completed) { clearInterval(checkInterval); hideLoading(); showAlert('success', 'Analysis complete', 'Your analysis has been updated.'); setTimeout(() => window.location.reload(), 1500); }
            } catch (e) { console.error('Status check error:', e); }
          }, 3000);
        } else { hideLoading(); showAlert('error', 'Refresh failed', data.message || 'Failed to start refresh.'); }
      } catch (error) { hideLoading(); showAlert('error', 'Network error', 'Failed to connect. Please try again.'); console.error('Refresh error:', error); }
    }

    async function triggerSurveillance() {
      if (!confirm('Run surveillance analysis? This will analyze your behavioral patterns and vulnerabilities.')) return;
      showLoading('Running surveillance analysis...');
      try {
        const response = await fetch('/trigger-surveillance', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const data = await response.json();
        hideLoading();
        if (data.success) { showAlert('success', 'Analysis complete', 'Surveillance analysis completed successfully.'); setTimeout(() => { if (data.redirect) { window.location.href = data.redirect; } else { window.location.reload(); } }, 2000); }
        else { showAlert('error', 'Analysis failed', data.message || 'Failed to run surveillance analysis.'); }
      } catch (error) { hideLoading(); showAlert('error', 'Network error', 'Failed to connect. Please try again.'); console.error('Surveillance error:', error); }
    }

    async function refreshSurveillance() {
      showLoading('Refreshing surveillance data...');
      try {
        const response = await fetch('/refresh-surveillance', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const data = await response.json();
        hideLoading();
        if (data.success) { showAlert('success', 'Refresh started', 'Surveillance data is being refreshed.'); setTimeout(() => window.location.reload(), 3000); }
        else { showAlert('error', 'Refresh failed', data.message || 'Failed to refresh surveillance.'); }
      } catch (error) { hideLoading(); showAlert('error', 'Network error', 'Failed to connect. Please try again.'); console.error('Refresh error:', error); }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Date
      const dateEl = document.getElementById('currentDate');
      if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

      // Reveal on scroll
      const reveals = document.querySelectorAll('.vs-reveal');
      if (reduce) { reveals.forEach(el => el.classList.add('in')); }
      else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        reveals.forEach(el => io.observe(el));
      }

      // Vulnerability bars
      setTimeout(() => { document.querySelectorAll('.vuln-fill').forEach(b => b.style.width = (b.dataset.w || 0) + '%'); }, 300);

      Chart.defaults.font.family = "'Inter', sans-serif";
      Chart.defaults.color = 'rgba(180, 182, 204, 0.8)';

      const personalityScores = {
        Openness: <%= (personalityScores && personalityScores.openness) || 0 %>,
        Conscientiousness: <%= (personalityScores && personalityScores.conscientiousness) || 0 %>,
        Extroversion: <%= (personalityScores && personalityScores.extroversion) || 0 %>,
        Agreeableness: <%= (personalityScores && personalityScores.agreeableness) || 0 %>,
        Neuroticism: <%= (personalityScores && personalityScores.neuroticism) || 0 %>
      };

      // Trait bars
      const traitBars = document.getElementById('traitBars');
      if (traitBars) {
        const colors = { Openness: '#9d7bff', Conscientiousness: '#7c6cff', Extroversion: '#34e3ff', Agreeableness: '#2dd4a8', Neuroticism: '#f6b24a' };
        Object.entries(personalityScores).forEach(([trait, score], i) => {
          const el = document.createElement('div');
          el.className = 'trait-item';
          el.innerHTML = `<div class="trait-head"><span class="trait-name">${trait}</span><span class="trait-value">${score}%</span></div><div class="trait-bar"><div class="trait-fill" style="width:0%; background:${colors[trait]}"></div></div>`;
          traitBars.appendChild(el);
          setTimeout(() => { el.querySelector('.trait-fill').style.width = score + '%'; }, reduce ? 0 : 120 + i * 130);
        });
      }

      // Word chart
      const words = <%- JSON.stringify(mostCommonWords || []) %>;
      if (words.length > 0) {
        const ctx = document.getElementById('wordCountChart');
        if (ctx) {
          const grad = ctx.getContext('2d').createLinearGradient(0, 0, 0, 300);
          grad.addColorStop(0, 'rgba(157,123,255,.9)');
          grad.addColorStop(0.55, 'rgba(124,108,255,.7)');
          grad.addColorStop(1, 'rgba(52,227,255,.45)');
          new Chart(ctx, {
            type: 'bar',
            data: { labels: words.slice(0, 8).map(w => w.word.charAt(0).toUpperCase() + w.word.slice(1)),
              datasets: [{ data: words.slice(0, 8).map(w => w.count), backgroundColor: grad, borderColor: 'rgba(124,108,255,1)', borderWidth: 0, borderRadius: 7, maxBarThickness: 46 }] },
            options: { responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false }, tooltip: { backgroundColor: 'rgba(16,16,27,.95)', padding: 12, cornerRadius: 8, titleFont: { family: 'JetBrains Mono' }, callbacks: { label: c => `Uses: ${c.parsed.y}` } } },
              scales: { y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,.05)' }, ticks: { font: { family: 'JetBrains Mono' } } }, x: { grid: { display: false } } } }
          });
        }
      }

      // Sentiment doughnut
      const sentimentScore = <%= (sentiment && sentiment.score) || 50 %>;
      const sentCtx = document.getElementById('sentimentChart');
      if (sentCtx) {
        const isPos = sentimentScore >= 50;
        new Chart(sentCtx, {
          type: 'doughnut',
          data: { labels: ['Positive', 'Negative'], datasets: [{ data: [sentimentScore, 100 - sentimentScore], backgroundColor: ['rgba(45,212,168,.85)', 'rgba(255,93,108,.8)'], borderWidth: 0, hoverOffset: 8 }] },
          options: { responsive: true, maintainAspectRatio: false, cutout: '76%', plugins: { legend: { position: 'bottom', labels: { padding: 18, usePointStyle: true } } } },
          plugins: [{ id: 'centerText', beforeDraw: function(chart) { const { width, height, ctx } = chart; ctx.restore(); ctx.font = '700 2.3rem "Space Grotesk"'; ctx.textBaseline = 'middle'; ctx.textAlign = 'center'; ctx.fillStyle = isPos ? '#2dd4a8' : '#ff5d6c'; ctx.fillText(sentimentScore + '%', width / 2, height / 2 - 12); ctx.font = '.82rem "JetBrains Mono"'; ctx.fillStyle = '#8a8aa6'; ctx.fillText(isPos ? 'POSITIVE' : 'NEGATIVE', width / 2, height / 2 + 22); ctx.save(); } }]
        });
      }

      // Personality radar
      const pCtx = document.getElementById('personalityChart');
      if (pCtx && Object.values(personalityScores).some(s => s > 0)) {
        new Chart(pCtx, {
          type: 'radar',
          data: { labels: Object.keys(personalityScores), datasets: [{ label: 'Your personality', data: Object.values(personalityScores), backgroundColor: 'rgba(124,108,255,.18)', borderColor: 'rgba(124,108,255,1)', borderWidth: 2, pointBackgroundColor: 'rgba(52,227,255,1)', pointBorderColor: '#fff', pointRadius: 4, pointHoverRadius: 6 }] },
          options: { responsive: true, maintainAspectRatio: false,
            scales: { r: { beginAtZero: true, max: 100, ticks: { stepSize: 20, backdropColor: 'transparent', font: { family: 'JetBrains Mono', size: 9 } }, grid: { color: 'rgba(255,255,255,.06)' }, angleLines: { color: 'rgba(255,255,255,.06)' }, pointLabels: { color: 'rgba(236,236,246,.9)', font: { size: 12, weight: '600', family: 'Space Grotesk' } } } },
            plugins: { legend: { display: false } } }
        });
      }

      // Back to top
      const btt = document.getElementById('backToTop');
      window.addEventListener('scroll', () => btt.classList.toggle('visible', window.scrollY > 400), { passive: true });
      btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // Handlers
      document.getElementById('refreshBtn')?.addEventListener('click', refreshAnalysis);
      document.getElementById('triggerSurveillanceBtn')?.addEventListener('click', triggerSurveillance);
      document.getElementById('refreshSurveillanceBtn')?.addEventListener('click', refreshSurveillance);
      document.getElementById('alertNotification')?.addEventListener('click', function() { this.classList.remove('show'); });

      // First-visit welcome
      if (!localStorage.getItem('hasVisitedDashboard')) {
        setTimeout(() => { showAlert('info', 'Welcome', 'Explore your personality insights and surveillance intelligence.'); localStorage.setItem('hasVisitedDashboard', 'true'); }, 1500);
      }
    });
  </script>

  <%- include('partials/footer') %>
</body>
</html>
