NODE_ENV=development
PORT=3001

# Facebook App Credentials — create an app at developers.facebook.com.
# Run in Development Mode with test users only, per Meta Platform Terms.
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
API_VERSION=v24.0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MongoDB
MONGODB_URI=mongodb://localhost:27017/visisocial

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-long-random-hex

# Admin bootstrap (createAdmin.js)
ADMIN_PASSWORD=change-me

# Callback URLs
PROD_CALLBACK_URL=https://your-domain.example/auth/facebook/callback
DEV_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Google Cloud Vision — path to your own service-account key (not committed)
GOOGLE_APPLICATION_CREDENTIALS=./cloudvision/service-account.json

# Optional OSINT keys (features are skipped if absent)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
HIBP_API_KEY=
SHODAN_API_KEY=
