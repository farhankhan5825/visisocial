<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <title><%= title || 'Platform Metrics | VisiSocial' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Live platform metrics for VisiSocial: users, analyses, and the data-economy value of what's being inferred.">
  <link href="/img/favicon.ico" rel="icon">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
  <link href="/stylesheets/bootstrap.min.css" rel="stylesheet">
  <link href="/stylesheets/visisocial.css" rel="stylesheet">
  <link href="/stylesheets/styles.css" rel="stylesheet">
  <style>
    .met { padding: 30px 0 40px; }
    .met-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 30px; }
    .met-title { font-size: clamp(1.7rem, 4vw, 2.5rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.05; margin: 8px 0 8px; }
    .met-sub { color: var(--vs-muted); max-width: 54ch; }
    .met-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
    .met-updated { font-family: var(--vs-mono); font-size: .76rem; color: var(--vs-faint); }

    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 18px; }
    @media (max-width: 900px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) { .kpi-grid { grid-template-columns: 1fr; } }

    .card-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 18px 0; }
    @media (max-width: 820px) { .card-grid { grid-template-columns: 1fr; } }

    .stat-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .stat-cell .sv { font-family: var(--vs-display); font-size: 1.6rem; font-weight: 700; letter-spacing: -.02em; }
    .stat-cell .sl { font-family: var(--vs-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--vs-muted); margin-top: 2px; }

    .chart-box { height: 320px; }
    .chart-box.sm { height: 280px; }
    .two-up { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 820px) { .two-up { grid-template-columns: 1fr; } }

    .back-to-top.visible { display: inline-flex; }
  </style>
</head>
<body>
  <div class="vs-field"></div>
  <div class="vs-grid-overlay"></div>

  <%- include('partials/navbar') %>

  <main class="met">
    <div class="vs-shell">

      <header class="met-head vs-reveal">
        <div>
          <span class="vs-eyebrow">Platform Telemetry</span>
          <h1 class="met-title">Platform <span class="vs-grad-text">metrics</span></h1>
          <p class="met-sub">A live read of the network: who's being analyzed, how much data is in motion, and what that footprint is worth to the watchers.</p>
        </div>
        <div class="met-meta">
          <span class="vs-pill vs-pill--ok vs-pill--live">Live</span>
          <span class="met-updated">Updated <%= new Date(lastUpdated || Date.now()).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
      </header>

      <!-- KPI bento -->
      <div class="kpi-grid vs-reveal">
        <div class="vs-metric vs-edge-violet">
          <div class="vs-metric__top"><div class="vs-metric__ic vs-tint-violet"><i class="fas fa-users"></i></div><span class="vs-metric__label">Total users</span></div>
          <div class="vs-metric__value vs-data"><%= stats.users.total.toLocaleString() %></div>
          <div class="vs-metric__sub up"><i class="fas fa-arrow-up"></i><%= stats.users.growthRate %>% weekly</div>
        </div>
        <div class="vs-metric vs-edge-cyan">
          <div class="vs-metric__top"><div class="vs-metric__ic vs-tint-cyan"><i class="fas fa-chart-bar"></i></div><span class="vs-metric__label">Profiles analyzed</span></div>
          <div class="vs-metric__value vs-data"><%= stats.analyses.total.toLocaleString() %></div>
          <div class="vs-metric__sub"><i class="fas fa-bullseye"></i><%= stats.analyses.avgConfidence %>% confidence</div>
        </div>
        <div class="vs-metric vs-edge-ok">
          <div class="vs-metric__top"><div class="vs-metric__ic vs-tint-ok"><i class="fas fa-database"></i></div><span class="vs-metric__label">Data points</span></div>
          <div class="vs-metric__value vs-data"><%= stats.analyses.dataPoints.toLocaleString() %></div>
          <div class="vs-metric__sub"><i class="fas fa-layer-group"></i><%= stats.users.total > 0 ? Math.round(stats.analyses.dataPoints / stats.users.total).toLocaleString() : 0 %> / user</div>
        </div>
        <div class="vs-metric vs-edge-warn">
          <div class="vs-metric__top"><div class="vs-metric__ic vs-tint-warn"><i class="fas fa-dollar-sign"></i></div><span class="vs-metric__label">Exposed value</span></div>
          <div class="vs-metric__value vs-data">$<%= Math.round(stats.platform.dataValue / 1000).toLocaleString() %>K</div>
          <div class="vs-metric__sub"><i class="fas fa-user-tag"></i>$<%= stats.users.total > 0 ? Math.round(stats.platform.dataValue / stats.users.total) : 0 %> / user</div>
        </div>
      </div>

      <!-- Detail cards -->
      <div class="card-grid vs-reveal">
        <div class="vs-card">
          <div class="vs-card-head"><h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-users"></i></span>User growth</h3></div>
          <div class="vs-card-body">
            <div class="stat-row">
              <div class="stat-cell"><div class="sv"><%= stats.users.newWeek.toLocaleString() %></div><div class="sl">New this week</div></div>
              <div class="stat-cell"><div class="sv"><%= stats.users.newMonth.toLocaleString() %></div><div class="sl">New this month</div></div>
              <div class="stat-cell"><div class="sv"><%= stats.users.activeWeek.toLocaleString() %></div><div class="sl">Active this week</div></div>
              <div class="stat-cell"><div class="sv" style="color: var(--vs-ok);"><%= stats.users.growthRate %>%</div><div class="sl">Weekly growth</div></div>
            </div>
          </div>
        </div>
        <div class="vs-card">
          <div class="vs-card-head"><h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-chart-bar"></i></span>Analysis metrics</h3></div>
          <div class="vs-card-body">
            <div class="stat-row">
              <div class="stat-cell"><div class="sv"><%= stats.analyses.total.toLocaleString() %></div><div class="sl">Profiles analyzed</div></div>
              <div class="stat-cell"><div class="sv"><%= stats.analyses.avgConfidence %>%</div><div class="sl">Avg confidence</div></div>
              <div class="stat-cell"><div class="sv"><%= stats.analyses.avgEngagement %>%</div><div class="sl">Avg engagement</div></div>
              <div class="stat-cell"><div class="sv"><%= stats.analyses.dataPoints.toLocaleString() %></div><div class="sl">Total data points</div></div>
            </div>
          </div>
        </div>
        <div class="vs-card">
          <div class="vs-card-head"><h3 class="vs-card-title"><span class="vs-ic" style="background: rgba(246,178,74,.13); color: var(--vs-warn);"><i class="fas fa-dollar-sign"></i></span>Data economy value</h3></div>
          <div class="vs-card-body">
            <div class="stat-row">
              <div class="stat-cell"><div class="sv">$<%= Math.round(stats.platform.dataValue / 1000).toLocaleString() %>K</div><div class="sl">Total exposed value</div></div>
              <div class="stat-cell"><div class="sv">$<%= stats.users.total > 0 ? Math.round(stats.platform.dataValue / stats.users.total) : 0 %></div><div class="sl">Per user value</div></div>
              <div class="stat-cell"><div class="sv">$0.00</div><div class="sl">User revenue (free)</div></div>
              <div class="stat-cell"><div class="sv"><%= stats.platform.analysesPerUser.toLocaleString() %></div><div class="sl">Data points / user</div></div>
            </div>
          </div>
        </div>
        <div class="vs-card">
          <div class="vs-card-head"><h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-globe"></i></span>Reach</h3></div>
          <div class="vs-card-body">
            <div class="stat-row">
              <div class="stat-cell"><div class="sv"><%= stats.platform.countries.toLocaleString() %></div><div class="sl">Countries</div></div>
              <div class="stat-cell"><div class="sv"><%= stats.users.activeWeek.toLocaleString() %></div><div class="sl">Weekly active</div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Growth chart -->
      <section class="vs-section vs-reveal" style="padding-bottom: 0;">
        <div class="vs-section-head"><h2 class="vs-section-title"><span class="vs-tick"></span>User growth, last 30 days</h2></div>
        <div class="vs-card vs-card--pad"><div class="chart-box"><canvas id="growthChart"></canvas></div></div>
      </section>

      <!-- Distributions -->
      <section class="vs-section vs-reveal">
        <div class="two-up">
          <div class="vs-card">
            <div class="vs-card-head"><h3 class="vs-card-title"><span class="vs-ic"><i class="fas fa-brain"></i></span>Personality distribution</h3></div>
            <div class="vs-card-body"><div class="chart-box sm"><canvas id="personalityChart"></canvas></div></div>
          </div>
          <div class="vs-card">
            <div class="vs-card-head"><h3 class="vs-card-title"><span class="vs-ic" style="background: rgba(246,178,74,.13); color: var(--vs-warn);"><i class="fas fa-fire"></i></span>Engagement levels</h3></div>
            <div class="vs-card-body"><div class="chart-box sm"><canvas id="engagementChart"></canvas></div></div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <button class="back-to-top vs-btn vs-btn--solid btn-lg-square" id="backToTop"><i class="fas fa-arrow-up"></i></button>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script nonce="<%= nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      Chart.defaults.font.family = "'Inter', sans-serif";
      Chart.defaults.color = 'rgba(138,138,166,.85)';
      const C = { violet: '#7c6cff', violetSoft: '#9d7bff', cyan: '#34e3ff', ok: '#2dd4a8', warn: '#f6b24a', alert: '#ff5d6c' };
      const tip = { backgroundColor: 'rgba(16,16,27,.95)', titleColor: '#ECECF6', bodyColor: '#b6b6cc', borderColor: 'rgba(124,108,255,.3)', borderWidth: 1, padding: 12, cornerRadius: 8, titleFont: { family: 'JetBrains Mono' } };
      const gridc = 'rgba(255,255,255,.05)', tickc = '#8a8aa6';

      // Growth
      const growthData = <%- JSON.stringify(stats.growth || []) %>;
      const gLabels = growthData.map(d => new Date(d._id).toLocaleDateString('en-GB', { month: 'short', day: 'numeric' }));
      const gVals = growthData.map(d => d.count);
      const gc = document.getElementById('growthChart');
      if (gc) {
        const grad = gc.getContext('2d').createLinearGradient(0, 0, 0, 320);
        grad.addColorStop(0, 'rgba(124,108,255,.32)'); grad.addColorStop(1, 'rgba(124,108,255,0)');
        new Chart(gc, { type: 'line',
          data: { labels: gLabels, datasets: [{ label: 'New users', data: gVals, borderColor: C.violet, backgroundColor: grad, borderWidth: 2.5, fill: true, tension: 0.4, pointRadius: 0, pointHoverRadius: 5, pointBackgroundColor: C.cyan }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { ...tip, displayColors: false } },
            scales: { y: { beginAtZero: true, grid: { color: gridc }, ticks: { color: tickc, font: { family: 'JetBrains Mono' } } }, x: { grid: { display: false }, ticks: { color: tickc, font: { family: 'JetBrains Mono', size: 10 } } } } } });
      }

      // Personality
      const pData = <%- JSON.stringify(stats.personality || []) %>;
      const pc = document.getElementById('personalityChart');
      if (pc) new Chart(pc, { type: 'doughnut',
        data: { labels: pData.map(d => d._id || 'Unknown'), datasets: [{ data: pData.map(d => d.count), backgroundColor: [C.violet, C.violetSoft, C.cyan, C.ok, C.warn], borderWidth: 0, hoverOffset: 8 }] },
        options: { responsive: true, maintainAspectRatio: false, cutout: '64%', plugins: { legend: { position: 'bottom', labels: { color: tickc, padding: 16, usePointStyle: true, font: { size: 11 } } }, tooltip: tip } } });

      // Engagement
      const eData = <%- JSON.stringify(stats.engagement || []) %>;
      const ec = document.getElementById('engagementChart');
      if (ec) new Chart(ec, { type: 'bar',
        data: { labels: eData.map(d => d._id === 'Other' ? 'Other' : `${d._id}-${d._id + 20}`), datasets: [{ label: 'Users', data: eData.map(d => d.count), backgroundColor: [C.alert, C.warn, C.cyan, C.ok, C.violet], borderRadius: 7, borderSkipped: false, maxBarThickness: 54 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: tip },
          scales: { y: { beginAtZero: true, grid: { color: gridc }, ticks: { color: tickc, font: { family: 'JetBrains Mono' } } }, x: { grid: { display: false }, ticks: { color: tickc, font: { family: 'JetBrains Mono', size: 10 } } } } } });

      // Back to top
      const btt = document.getElementById('backToTop');
      window.addEventListener('scroll', () => btt.classList.toggle('visible', window.scrollY > 300), { passive: true });
      btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    });
  </script>

  <%- include('partials/footer') %>
</body>
</html>
