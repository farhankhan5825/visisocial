<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error <%= err.status || 500 %> | VisiSocial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">    <style>
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --primary-dark: #5b4fe0;
            --secondary: #9d7bff;
            --danger: #ff5d6c;
            --danger-light: #fca5a5;
            --danger-dark: #dc2626;
            --warning: #f6b24a;
            --warning-light: #ffd089;
            --success: #2dd4a8;
            --info: #34e3ff;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
            --shadow-soft: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            min-height: 100vh;
            line-height: 1.6;
            overflow-x: hidden;
        }

        .error-container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 2rem;
            position: relative;
        }

        /* Animated Background */
        .error-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: 
                radial-gradient(circle at 20% 80%, rgba(99, 102, 241, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 80% 20%, rgba(139, 92, 246, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(239, 68, 68, 0.05) 0%, transparent 60%);
            animation: float 20s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            33% { transform: translate(30px, -20px) rotate(120deg); }
            66% { transform: translate(-20px, 30px) rotate(240deg); }
        }

        .error-content {
            max-width: 700px;
            width: 100%;
            text-align: center;
            position: relative;
        }

        /* Error Icon with Animation */
        .error-icon-container {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 2rem;
        }

        .error-icon-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--danger) 0%, var(--warning) 100%);
            border-radius: 50%;
            opacity: 0.2;
            animation: pulse 3s ease-in-out infinite;
        }

        .error-icon {
            position: relative;
            font-size: 3.5rem;
            color: var(--danger);
            animation: wobble 2s ease-in-out infinite;
            filter: drop-shadow(0 0 20px rgba(239, 68, 68, 0.4));
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.2; }
            50% { transform: scale(1.1); opacity: 0.3; }
        }

        @keyframes wobble {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            25% { transform: translateY(-10px) rotate(-5deg); }
            75% { transform: translateY(-5px) rotate(5deg); }
        }

        /* Error Header */
        .error-header {
            margin-bottom: 2rem;
        }

        .error-title {
            font-family: 'Poppins', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--danger-light) 0%, var(--warning-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 4px 20px rgba(239, 68, 68, 0.3);
        }

        .error-subtitle {
            font-size: 1.2rem;
            color: var(--muted);
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.8;
        }

        /* Error Card */
        .error-card {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 2.5rem;
            margin-bottom: 2.5rem;
            text-align: left;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: var(--shadow-soft);
        }

        .error-card:hover {
            background: var(--glass-hover);
            transform: translateY(-4px);
            box-shadow: var(--shadow-glow);
        }

        /* Error Message with Copy */
        .error-message-container {
            position: relative;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(245, 158, 11, 0.1) 100%);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            overflow: hidden;
        }

        .error-message-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(to bottom, var(--danger), var(--warning));
        }

        .error-message-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .error-message-header h3 {
            color: var(--danger-light);
            font-size: 1.2rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0;
        }

        .copy-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--light);
            padding: 0.5rem 1rem;
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .copy-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .copy-btn.copied {
            background: rgba(34, 197, 94, 0.2);
            border-color: rgba(34, 197, 94, 0.3);
            color: #86efac;
        }

        .copy-btn.copied i {
            animation: bounce 0.5s ease;
        }

        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }

        .error-message-content {
            position: relative;
        }

        .error-message {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--light);
            margin: 0;
            padding: 1rem;
            background: rgba(2, 6, 23, 0.5);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            font-family: 'Inter', monospace;
            line-height: 1.7;
            word-break: break-word;
        }

        /* Error Details Grid */
        .error-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .detail-card {
            background: rgba(2, 6, 23, 0.5);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 1.5rem;
            transition: all 0.3s ease;
        }

        .detail-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary-light);
        }

        .detail-label {
            display: block;
            font-size: 0.875rem;
            color: var(--muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 500;
        }

        .detail-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--light);
        }

        .status-badge {
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .status-badge:hover {
            transform: scale(1.05);
        }

        .status-5xx {
            background: linear-gradient(135deg, var(--danger) 0%, #dc2626 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        }

        .status-4xx {
            background: linear-gradient(135deg, var(--warning) 0%, #d97706 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        }

        .status-other {
            background: linear-gradient(135deg, var(--info) 0%, #1d4ed8 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
        }

        /* Stack Trace */
        .stack-container {
            margin-top: 2rem;
        }

        .stack-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            padding: 1rem 1.5rem;
            background: rgba(2, 6, 23, 0.5);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            color: var(--muted);
            font-weight: 500;
            user-select: none;
            transition: all 0.3s ease;
        }

        .stack-toggle:hover {
            background: rgba(2, 6, 23, 0.7);
            color: var(--light);
        }

        .stack-toggle i {
            transition: transform 0.3s ease;
        }

        .stack-toggle.active {
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;
            border-bottom: none;
        }

        .stack-toggle.active i {
            transform: rotate(180deg);
        }

        .stack-content {
            background: rgba(2, 6, 23, 0.5);
            border: 1px solid var(--glass-border);
            border-top: none;
            border-radius: 0 0 16px 16px;
            padding: 1.5rem;
            max-height: 300px;
            overflow-y: auto;
            display: none;
            animation: slideDown 0.3s ease;
        }

        .stack-content.active {
            display: block;
        }

        .error-stack {
            font-family: 'Courier New', monospace;
            font-size: 0.875rem;
            color: var(--muted);
            line-height: 1.6;
            white-space: pre-wrap;
            word-wrap: break-word;
            margin: 0;
        }

        .stack-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .stack-btn {
            padding: 0.5rem 1rem;
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            border: 1px solid var(--glass-border);
            background: rgba(255, 255, 255, 0.05);
            color: var(--light);
        }

        .stack-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        /* Suggestions */
        .suggestions {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(6, 182, 212, 0.05) 100%);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 16px;
            padding: 2rem;
            margin-top: 2rem;
        }

        .suggestions-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .suggestions-header h4 {
            color: #93c5fd;
            font-size: 1.1rem;
            font-weight: 600;
            margin: 0;
        }

        .suggestions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        .suggestion-item {
            background: rgba(2, 6, 23, 0.3);
            border: 1px solid rgba(59, 130, 246, 0.1);
            border-radius: 12px;
            padding: 1rem;
            transition: all 0.3s ease;
        }

        .suggestion-item:hover {
            transform: translateY(-2px);
            border-color: rgba(59, 130, 246, 0.3);
        }

        .suggestion-item i {
            color: #60a5fa;
            margin-right: 0.5rem;
        }

        .suggestion-item p {
            color: var(--muted);
            margin: 0;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* Action Buttons */
        .error-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 2.5rem;
        }

        .error-btn {
            padding: 1.25rem 2rem;
            border-radius: 16px;
            font-weight: 600;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            cursor: pointer;
            text-decoration: none;
            font-size: 1rem;
            position: relative;
            overflow: hidden;
        }

        .error-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.6s ease;
        }

        .error-btn:hover::before {
            left: 100%;
        }

        .error-btn:hover {
            transform: translateY(-4px);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
        }

        .btn-primary:hover {
            box-shadow: 0 12px 35px rgba(99, 102, 241, 0.4);
        }

        .btn-secondary {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            color: var(--light);
        }

        .btn-secondary:hover {
            background: var(--glass-hover);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .btn-danger {
            background: linear-gradient(135deg, var(--danger) 0%, #dc2626 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
        }

        .btn-danger:hover {
            box-shadow: 0 12px 35px rgba(239, 68, 68, 0.4);
        }

        .btn-support {
            background: linear-gradient(135deg, var(--success) 0%, #16a34a 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(34, 197, 94, 0.3);
        }

        .btn-support:hover {
            box-shadow: 0 12px 35px rgba(34, 197, 94, 0.4);
        }

        .btn-icon {
            font-size: 1.5rem;
        }

        .btn-text {
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* Footer */
        .error-footer {
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--glass-border);
            color: var(--muted);
            font-size: 0.875rem;
            text-align: center;
        }

        .footer-info {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .error-id-container {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 1.5rem;
            background: rgba(2, 6, 23, 0.5);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .error-id-container:hover {
            background: rgba(2, 6, 23, 0.7);
        }

        .error-id-label {
            color: var(--muted);
        }

        .error-id-value {
            color: var(--light);
            font-weight: 600;
            font-family: 'Courier New', monospace;
            letter-spacing: 1px;
        }

        .error-id-copy {
            color: var(--muted);
            font-size: 0.75rem;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .error-id-container:hover .error-id-copy {
            opacity: 1;
        }

        .footer-links {
            display: flex;
            gap: 2rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .footer-link {
            color: var(--muted);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .footer-link:hover {
            color: var(--light);
            transform: translateY(-2px);
        }

        /* Toast Notification */
        .toast {
            position: fixed;
            top: 2rem;
            right: 2rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 1rem;
            z-index: 1000;
            animation: slideInRight 0.3s ease, fadeOut 0.3s ease 2.7s forwards;
            max-width: 350px;
        }

        @keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes fadeOut {
            to {
                opacity: 0;
                transform: translateY(-20px);
            }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .error-container {
                padding: 1.5rem;
            }

            .error-title {
                font-size: 2.25rem;
            }

            .error-subtitle {
                font-size: 1.1rem;
            }

            .error-card {
                padding: 2rem;
            }

            .error-details {
                grid-template-columns: 1fr;
            }

            .error-actions {
                grid-template-columns: 1fr;
            }

            .suggestions-grid {
                grid-template-columns: 1fr;
            }

            .footer-links {
                flex-direction: column;
                gap: 1rem;
            }

            .toast {
                left: 1rem;
                right: 1rem;
                max-width: none;
            }
        }

        @media (max-width: 480px) {
            .error-title {
                font-size: 2rem;
            }

            .error-icon-container {
                width: 100px;
                height: 100px;
            }

            .error-icon {
                font-size: 2.75rem;
            }

            .error-card {
                padding: 1.5rem;
            }

            .stack-actions {
                flex-direction: column;
            }
        }

        /* Hide stack trace in production */
        <% if (process.env.NODE_ENV === 'production' && !showDetails) { %>
        .stack-container {
            display: none !important;
        }
        <% } %>

        /* Animation for page load */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .error-content {
            animation: fadeInUp 0.6s ease;
        }
    </style>
</head>
<body>
    <!-- Animated Background -->
    <div class="error-bg"></div>
        <%- include('partials/navbar') %>

    <div class="error-container">
        <div class="error-content">
            <!-- Error Icon -->
            <div class="error-icon-container">
                <div class="error-icon-bg"></div>
                <i class="fas fa-exclamation-triangle error-icon"></i>
            </div>

            <!-- Error Header -->
            <div class="error-header">
                <h1 class="error-title">Error <%= err.status || 500 %></h1>
                <p class="error-subtitle">
                    <%
                    const errorMessages = {
                        400: "Your request couldn't be processed. Please check your input.",
                        401: "You need to be logged in to access this page.",
                        403: "You don't have permission to access this resource.",
                        404: "The page you're looking for doesn't exist.",
                        429: "You're making too many requests. Please slow down.",
                        500: "Something went wrong on our end. We're working to fix it.",
                        503: "Our service is temporarily unavailable. Please try again later."
                    };
                    %>
                    <%= errorMessages[err.status] || "We encountered an unexpected error. Our team has been notified." %>
                </p>
            </div>

            <!-- Error Card -->
            <div class="error-card">
                <!-- Error Message with Copy -->
                <div class="error-message-container">
                    <div class="error-message-header">
                        <h3>
                            <i class="fas fa-bug"></i>
                            Error Message
                        </h3>
                        <button class="copy-btn" id="copyMessageBtn">
                            <i class="fas fa-copy"></i>
                            <span>Copy Error</span>
                        </button>
                    </div>
                    <div class="error-message-content">
                        <p class="error-message" id="errorMessage">
                            <%= err.message || 'An unexpected error occurred' %>
                        </p>
                    </div>
                </div>

                <!-- Error Details Grid -->
                <div class="error-details">
                    <div class="detail-card">
                        <span class="detail-label">Status Code</span>
                        <span class="detail-value">
                            <span class="status-badge <%= err.status >= 500 ? 'status-5xx' : err.status >= 400 ? 'status-4xx' : 'status-other' %>">
                                <%= err.status || 500 %>
                            </span>
                        </span>
                    </div>
                    
                    <% if (err.code) { %>
                    <div class="detail-card">
                        <span class="detail-label">Error Code</span>
                        <span class="detail-value"><%= err.code %></span>
                    </div>
                    <% } %>
                    
                    <div class="detail-card">
                        <span class="detail-label">Error ID</span>
                        <span class="detail-value" id="errorIdValue"><%= err.id || 'N/A' %></span>
                    </div>
                    
                    <div class="detail-card">
                        <span class="detail-label">Timestamp</span>
                        <span class="detail-value"><%= new Date().toLocaleString() %></span>
                    </div>
                </div>

                <!-- Stack Trace (Development Only) -->
                <% if (err.stack && (process.env.NODE_ENV !== 'production' || showDetails)) { %>
                <div class="stack-container">
                    <div class="stack-toggle" id="stackToggle">
                        <span>View Technical Details</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="stack-content" id="stackContent">
                        <pre class="error-stack" id="errorStack"><%= err.stack %></pre>
                        <div class="stack-actions">
                            <button class="stack-btn" id="copyStackBtn">
                                <i class="fas fa-copy"></i>
                                Copy Stack Trace
                            </button>
                            <button class="stack-btn" id="expandStackBtn">
                                <i class="fas fa-expand"></i>
                                Expand All
                            </button>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Suggestions -->
                <div class="suggestions">
                    <div class="suggestions-header">
                        <i class="fas fa-lightbulb"></i>
                        <h4>Try These Solutions</h4>
                    </div>
                    <div class="suggestions-grid">
                        <div class="suggestion-item">
                            <i class="fas fa-sync-alt"></i>
                            <p>Refresh the page and try again</p>
                        </div>
                        <div class="suggestion-item">
                            <i class="fas fa-trash-alt"></i>
                            <p>Clear browser cache and cookies</p>
                        </div>
                        <div class="suggestion-item">
                            <i class="fas fa-wifi"></i>
                            <p>Check your internet connection</p>
                        </div>
                        <div class="suggestion-item">
                            <i class="fas fa-clock"></i>
                            <p>Wait a few minutes and try again</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="error-actions">
                <a href="<%= redirectUrl || '/' %>" class="error-btn btn-primary">
                    <i class="fas fa-home btn-icon"></i>
                    <span class="btn-text">Go to Homepage</span>
                </a>
                
                <a href="javascript:history.back()" class="error-btn btn-secondary">
                    <i class="fas fa-arrow-left btn-icon"></i>
                    <span class="btn-text">Go Back</span>
                </a>
                
                <% if (err.status === 401 || err.status === 403) { %>
                <a href="/login?redirect=<%= encodeURIComponent(req.originalUrl) %>" class="error-btn btn-danger">
                    <i class="fas fa-sign-in-alt btn-icon"></i>
                    <span class="btn-text">Login Again</span>
                </a>
                <% } %>
                
                <a href="/support?errorId=<%= err.id %>" class="error-btn btn-support">
                    <i class="fas fa-headset btn-icon"></i>
                    <span class="btn-text">Contact Support</span>
                </a>
            </div>

            <!-- Footer -->
            <div class="error-footer">
                <div class="footer-info">
                    <div class="error-id-container" id="errorIdContainer">
                        <span class="error-id-label">Error ID:</span>
                        <span class="error-id-value" id="errorIdText"><%= err.id || 'N/A' %></span>
                        <span class="error-id-copy">Click to copy</span>
                    </div>
                    <small>Keep this ID handy when contacting support</small>
                </div>
                
                <div class="footer-links">
                    <a href="/status" class="footer-link">
                        <i class="fas fa-server"></i>
                        <span>System Status</span>
                    </a>
                    <a href="/docs" class="footer-link">
                        <i class="fas fa-book"></i>
                        <span>Error Documentation</span>
                    </a>
                    <a href="mailto:support@visionsocial.com?subject=Error%20<%= err.id %>" class="footer-link">
                        <i class="fas fa-envelope"></i>
                        <span>Email Support</span>
                    </a>
                    <a href="#" target="_blank" class="footer-link">
                        <i class="fab fa-github"></i>
                        <span>Report Issue</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer"></div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elements
            const copyMessageBtn = document.getElementById('copyMessageBtn');
            const copyStackBtn = document.getElementById('copyStackBtn');
            const expandStackBtn = document.getElementById('expandStackBtn');
            const errorIdContainer = document.getElementById('errorIdContainer');
            const errorIdText = document.getElementById('errorIdText');
            const errorMessage = document.getElementById('errorMessage');
            const errorStack = document.getElementById('errorStack');
            const stackToggle = document.getElementById('stackToggle');
            const stackContent = document.getElementById('stackContent');

            // Toast system
            function showToast(message, type = 'success') {
                const icon = type === 'success' ? 'check-circle' : 'info-circle';
                const toast = document.createElement('div');
                toast.className = 'toast';
                toast.innerHTML = `
                    <i class="fas fa-${icon}"></i>
                    <span>${message}</span>
                `;
                document.getElementById('toastContainer').appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }

            // Copy error message
            if (copyMessageBtn) {
                copyMessageBtn.addEventListener('click', async function() {
                    const textToCopy = `Error ID: ${errorIdText.textContent}\n` +
                                     `Status: ${<%= err.status || 500 %>}\n` +
                                     `Message: ${errorMessage.textContent}\n` +
                                     `Timestamp: ${new Date().toISOString()}\n` +
                                     `URL: ${window.location.href}`;

                    try {
                        await navigator.clipboard.writeText(textToCopy);
                        this.classList.add('copied');
                        this.innerHTML = '<i class="fas fa-check"></i><span>Copied!</span>';
                        showToast('Error details copied to clipboard', 'success');
                        
                        setTimeout(() => {
                            this.classList.remove('copied');
                            this.innerHTML = '<i class="fas fa-copy"></i><span>Copy Error</span>';
                        }, 2000);
                    } catch (err) {
                        showToast('Failed to copy to clipboard', 'error');
                    }
                });
            }

            // Copy stack trace
            if (copyStackBtn) {
                copyStackBtn.addEventListener('click', async function() {
                    try {
                        await navigator.clipboard.writeText(errorStack.textContent);
                        this.innerHTML = '<i class="fas fa-check"></i> Copied!';
                        showToast('Stack trace copied to clipboard', 'success');
                        
                        setTimeout(() => {
                            this.innerHTML = '<i class="fas fa-copy"></i> Copy Stack Trace';
                        }, 2000);
                    } catch (err) {
                        showToast('Failed to copy stack trace', 'error');
                    }
                });
            }

            // Expand stack trace
            if (expandStackBtn) {
                expandStackBtn.addEventListener('click', function() {
                    if (errorStack.style.maxHeight) {
                        errorStack.style.maxHeight = null;
                        this.innerHTML = '<i class="fas fa-expand"></i> Expand All';
                    } else {
                        errorStack.style.maxHeight = 'none';
                        this.innerHTML = '<i class="fas fa-compress"></i> Collapse';
                    }
                });
            }

            // Toggle stack trace visibility
            if (stackToggle && stackContent) {
                stackToggle.addEventListener('click', function() {
                    stackContent.classList.toggle('active');
                    this.classList.toggle('active');
                    this.querySelector('span').textContent = 
                        stackContent.classList.contains('active') ? 
                        'Hide Technical Details' : 'View Technical Details';
                });
            }

            // Copy error ID
            if (errorIdContainer) {
                errorIdContainer.addEventListener('click', async function() {
                    const errorId = errorIdText.textContent;
                    if (errorId !== 'N/A') {
                        try {
                            await navigator.clipboard.writeText(errorId);
                            const originalText = errorIdContainer.querySelector('.error-id-copy').textContent;
                            errorIdContainer.querySelector('.error-id-copy').textContent = 'Copied!';
                            showToast('Error ID copied to clipboard', 'success');
                            
                            setTimeout(() => {
                                errorIdContainer.querySelector('.error-id-copy').textContent = originalText;
                            }, 2000);
                        } catch (err) {
                            showToast('Failed to copy Error ID', 'error');
                        }
                    }
                });
            }

            // Auto actions based on error type
            const errorStatus = <%= err.status || 500 %>;
            
            // Auto-refresh suggestion for 5xx errors
            if (errorStatus >= 500 && errorStatus < 600) {
                setTimeout(() => {
                    const suggestionsGrid = document.querySelector('.suggestions-grid');
                    const refreshSuggestion = document.createElement('div');
                    refreshSuggestion.className = 'suggestion-item';
                    refreshSuggestion.innerHTML = `
                        <i class="fas fa-redo-alt"></i>
                        <p>The issue might be resolved. Try refreshing the page.</p>
                    `;
                    suggestionsGrid.appendChild(refreshSuggestion);
                    
                    // Add auto-refresh button
                    setTimeout(() => {
                        const refreshBtn = document.createElement('button');
                        refreshBtn.className = 'error-btn btn-secondary';
                        refreshBtn.style.marginTop = '1rem';
                        refreshBtn.innerHTML = `
                            <i class="fas fa-sync-alt btn-icon"></i>
                            <span class="btn-text">Try Again</span>
                        `;
                        refreshBtn.onclick = () => location.reload();
                        document.querySelector('.error-actions').appendChild(refreshBtn);
                    }, 5000);
                }, 10000);
            }

            // Auto-redirect for 401/403 errors after delay
            if (errorStatus === 401 || errorStatus === 403) {
                setTimeout(() => {
                    showToast('Redirecting to login page...', 'info');
                    setTimeout(() => {
                        window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                    }, 2000);
                }, 15000);
            }

            // Add keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Ctrl+C / Cmd+C to copy error
                if ((e.ctrlKey || e.metaKey) && e.key === 'c') {
                    e.preventDefault();
                    if (copyMessageBtn) copyMessageBtn.click();
                }
                
                // Escape to go back
                if (e.key === 'Escape') {
                    history.back();
                }
                
                // F5 to refresh
                if (e.key === 'F5') {
                    location.reload();
                }
            });

            // Add visual feedback for interactive elements
            document.querySelectorAll('.copy-btn, .stack-btn, .error-btn, .footer-link').forEach(element => {
                element.addEventListener('mousedown', function() {
                    this.style.transform = 'translateY(0)';
                });
                element.addEventListener('mouseup', function() {
                    this.style.transform = '';
                });
            });

            // Log error to console for debugging
            console.group('Error Details');
            console.error('Error ID:', errorIdText.textContent);
            console.error('Status:', errorStatus);
            console.error('Message:', errorMessage.textContent);
            console.error('URL:', window.location.href);
            console.error('Timestamp:', new Date().toISOString());
            if (errorStack) {
                console.error('Stack Trace:', errorStack.textContent);
            }
            console.groupEnd();
        });
    </script>
    <%- include('partials/footer') %>
</body>
</html>