/**
 * Analyze user interests
 */
function analyzeInterests(likesArray, favoriteTeamsArray, favoriteAthletesArray) {
  const combinedArray = [
    ...(Array.isArray(likesArray) ? likesArray : []), 
    ...(Array.isArray(favoriteTeamsArray) ? favoriteTeamsArray : []), 
    ...(Array.isArray(favoriteAthletesArray) ? favoriteAthletesArray : [])
  ];

  if (combinedArray.length === 0) {
    return { topInterest: 'Not enough data', interestCategories: {}, diversity: 0, count: 0 };
  }

  const frequencyMap = {};
  combinedArray.forEach((item) => {
    if (!item) return;
    const category = (item.category || item.name || "Other").trim();
    if (category) frequencyMap[category] = (frequencyMap[category] || 0) + 1;
  });

  const sortedCategories = Object.entries(frequencyMap).sort((a, b) => b[1] - a[1]);
  const totalInterests = combinedArray.length;
  const uniqueCategories = Object.keys(frequencyMap).length;
  
  const diversityIndex = sortedCategories.reduce((entropy, [_, count]) => {
    const probability = count / totalInterests;
    return entropy - (probability * Math.log(probability));
  }, 0);
  
  const maxPossibleEntropy = Math.log(uniqueCategories || 1);
  const normalizedDiversity = Math.round((diversityIndex / (maxPossibleEntropy || 1)) * 100);
  
  return {
    topInterest: sortedCategories.length > 0 ? sortedCategories[0][0] : 'No specific interest',
    interestCategories: Object.fromEntries(sortedCategories),
    diversity: normalizedDiversity,
    count: totalInterests
  };
}

