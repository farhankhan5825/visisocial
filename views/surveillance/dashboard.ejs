<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | VisiSocial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <link href="/stylesheets/visisocial.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chart.js/dist/chart.min.css">
    <style>
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --danger: #ff5d6c;
            --warning: #f6b24a;
            --success: #2dd4a8;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            min-height: 100vh;
        }

        .dashboard-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: 
                radial-gradient(circle at 10% 10%, rgba(99, 102, 241, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            padding: 2rem;
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
        }

        .header-left h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--primary-light) 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-left .subtitle {
            color: var(--muted);
            font-size: 1.1rem;
        }

        .refresh-btn {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem 2rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .refresh-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-glow);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2rem;
            transition: all 0.4s ease;
        }

        .stat-card:hover {
            background: var(--glass-hover);
            box-shadow: var(--shadow-glow);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }

        .stat-value {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            font-family: 'Space Grotesk', sans-serif;
        }

        .stat-label {
            color: var(--muted);
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        .stat-trend {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(34, 197, 94, 0.1);
            border-radius: 50px;
            color: var(--success);
            font-size: 0.9rem;
        }

        .stat-trend.down {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .module-card {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2rem;
            transition: all 0.4s ease;
            cursor: pointer;
        }

        .module-card:hover {
            background: var(--glass-hover);
            box-shadow: var(--shadow-glow);
            transform: translateY(-5px);
        }

        .module-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .module-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--light);
        }

        .module-badge {
            padding: 0.5rem 1rem;
            background: rgba(239, 68, 68, 0.1);
            border-radius: 50px;
            color: var(--danger);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .module-badge.high {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .module-badge.medium {
            background: rgba(59, 130, 246, 0.1);
            color: #60a5fa;
        }

        .module-badge.low {
            background: rgba(34, 197, 94, 0.1);
            color: var(--success);
        }

        .module-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .module-stat {
            text-align: center;
        }

        .module-stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--light);
        }

        .module-stat-label {
            font-size: 0.9rem;
            color: var(--muted);
        }

        .chart-container {
            height: 200px;
            margin-top: 1rem;
        }

        .risk-meter {
            width: 100%;
            height: 10px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 5px;
            margin: 1rem 0;
            overflow: hidden;
        }

        .risk-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--success), var(--warning), var(--danger));
            border-radius: 5px;
            transition: width 0.5s ease;
        }

        .module-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--glass-border);
        }

        .module-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--primary-light);
            text-decoration: none;
            font-weight: 600;
        }

        .module-link:hover {
            text-decoration: underline;
        }

        .quick-actions {
            display: flex;
            gap: 1rem;
            margin-bottom: 3rem;
        }

        .action-btn {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            color: var(--light);
            text-decoration: none;
            transition: all 0.4s ease;
        }

        .action-btn:hover {
            background: var(--glass-hover);
            box-shadow: var(--shadow-glow);
            transform: translateY(-3px);
        }

        .action-icon {
            width: 70px;
            height: 70px;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
        }

        .action-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .action-desc {
            color: var(--muted);
            text-align: center;
            font-size: 0.9rem;
        }

        .alert-banner {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(239, 68, 68, 0.05) 100%);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 3rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .alert-icon {
            font-size: 1.5rem;
            color: #fcd34d;
        }

        .alert-content h3 {
            color: #fcd34d;
            margin-bottom: 0.5rem;
        }

        .alert-content p {
            color: var(--muted);
        }

        @media (max-width: 768px) {
            .container { padding: 1rem; }
            .dashboard-header { flex-direction: column; gap: 1.5rem; text-align: center; }
            .modules-grid { grid-template-columns: 1fr; }
            .quick-actions { flex-direction: column; }
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="dashboard-bg"></div>

    <div class="container">
        <div class="dashboard-header">
            <div class="header-left">
                <h1>Surveillance Intelligence Dashboard</h1>
                <p class="subtitle">Real-time analysis of behavioral patterns, psychographics, and exploitation risks</p>
                <div class="last-updated">
                    <i class="fas fa-clock"></i>
                    Last analysis: <%= surveillance.metadata?.lastFullAnalysis ? new Date(surveillance.metadata.lastFullAnalysis).toLocaleDateString() : 'Never' %>
                </div>
            </div>
            <button class="refresh-btn" id="refreshAnalysis">
                <i class="fas fa-sync-alt"></i>
                Refresh Analysis
            </button>
        </div>

        <% if (!surveillance.metadata?.lastFullAnalysis) { %>
        <div class="alert-banner">
            <i class="fas fa-exclamation-triangle alert-icon"></i>
            <div class="alert-content">
                <h3>Initial Analysis Required</h3>
                <p>Run your first surveillance analysis to populate the dashboard with intelligence data.</p>
            </div>
        </div>
        <% } %>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-database"></i>
                </div>
                <div class="stat-value"><%= surveillance.metadata?.totalDataPoints || 0 %></div>
                <div class="stat-label">Total Data Points</div>
                <div class="stat-trend">
                    <i class="fas fa-arrow-up"></i>
                    +12.5% from last week
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-brain"></i>
                </div>
                <div class="stat-value"><%= surveillance.metadata?.inferenceConfidence || 0 %>%</div>
                <div class="stat-label">Inference Confidence</div>
                <div class="stat-trend">
                    <i class="fas fa-arrow-up"></i>
                    High accuracy
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div class="stat-value">
                    <% if (surveillance.vulnerability) { 
                        const overallRisk = Math.round(Object.values(surveillance.vulnerability).reduce((a, b) => a + b, 0) / 6);
                    %>
                    <%= overallRisk %>%
                    <% } else { %>
                    --
                    <% } %>
                </div>
                <div class="stat-label">Exploitation Risk</div>
                <div class="stat-trend down">
                    <i class="fas fa-arrow-down"></i>
                    Monitor closely
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-project-diagram"></i>
                </div>
                <div class="stat-value"><%= surveillance.metadata?.crossModalCorrelations || 0 %></div>
                <div class="stat-label">Cross-Modal Correlations</div>
                <div class="stat-trend">
                    <i class="fas fa-arrow-up"></i>
                    +8 detected
                </div>
            </div>
        </div>

        <div class="modules-grid">
            <!-- Behavioral Patterns Module -->
            <div class="module-card" onclick="window.location.href='/surveillance/profile-depth'">
                <div class="module-header">
                    <h3 class="module-title">Behavioral Patterns</h3>
                    <span class="module-badge high">HIGH INSIGHT</span>
                </div>
                <div class="module-stats">
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.behavioral?.postingCycle) { %>
                                <%= surveillance.behavioral.postingCycle.regularity || 0 %>%
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Regularity</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.behavioral?.peakActivity) { %>
                                <%= surveillance.behavioral.peakActivity.length || 0 %>
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Peak Hours</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.behavioral?.responseTime) { %>
                                <%= surveillance.behavioral.responseTime.avgMinutes || 0 %>m
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Response Time</div>
                    </div>
                </div>
                <div class="chart-container">
                    <!-- Chart will be rendered here -->
                    <canvas id="behavioralChart"></canvas>
                </div>
                <div class="module-footer">
                    <a href="/surveillance/profile-depth" class="module-link">
                        <span>Explore Depth</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <span class="module-stat-label">Pattern detection: <%= surveillance.behavioral?.patternConfidence || 0 %>%</span>
                </div>
            </div>

            <!-- Psychographics Module -->
            <div class="module-card" onclick="window.location.href='/surveillance/profile-depth'">
                <div class="module-header">
                    <h3 class="module-title">Psychographic Profile</h3>
                    <span class="module-badge medium">MEDIUM SENSITIVITY</span>
                </div>
                <div class="module-stats">
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.psychographic?.primaryTraits) { %>
                                <%= surveillance.psychographic.primaryTraits.length || 0 %>
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Traits Identified</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.psychographic?.values) { %>
                                <%= surveillance.psychographic.values.length || 0 %>
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Core Values</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.psychographic?.motivations) { %>
                                <%= surveillance.psychographic.motivations.length || 0 %>
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Motivations</div>
                    </div>
                </div>
                <div class="risk-meter">
                    <div class="risk-fill" style="width: <%= surveillance.psychographic?.sensitivityScore || 0 %>%"></div>
                </div>
                <div class="module-footer">
                    <a href="/surveillance/profile-depth" class="module-link">
                        <span>View Profile</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <span class="module-stat-label">Confidence: <%= surveillance.psychographic?.confidence || 0 %>%</span>
                </div>
            </div>

            <!-- Vulnerability Profile Module -->
            <div class="module-card" onclick="window.location.href='/surveillance/exploitation-risk'">
                <div class="module-header">
                    <h3 class="module-title">Vulnerability Analysis</h3>
                    <span class="module-badge"><%= surveillance.vulnerability?.overallRisk > 70 ? 'CRITICAL' : surveillance.vulnerability?.overallRisk > 50 ? 'HIGH' : 'MODERATE' %></span>
                </div>
                <div class="module-stats">
                    <div class="module-stat">
                        <div class="module-stat-value"><%= surveillance.vulnerability?.manipulationSusceptibility || 0 %>%</div>
                        <div class="module-stat-label">Manipulation</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value"><%= surveillance.vulnerability?.reidentificationRisk || 0 %>%</div>
                        <div class="module-stat-label">Re-ID Risk</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value"><%= surveillance.vulnerability?.dataExposureLevel || 0 %>%</div>
                        <div class="module-stat-label">Exposure</div>
                    </div>
                </div>
                <div class="chart-container">
                    <!-- Chart will be rendered here -->
                    <canvas id="vulnerabilityChart"></canvas>
                </div>
                <div class="module-footer">
                    <a href="/surveillance/exploitation-risk" class="module-link">
                        <span>Risk Details</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <span class="module-stat-label"><%= surveillance.vulnerability?.scenarios?.length || 0 %> attack vectors</span>
                </div>
            </div>

            <!-- Social Graph Module -->
            <div class="module-card" onclick="window.location.href='/surveillance/cross-modal'">
                <div class="module-header">
                    <h3 class="module-title">Social Intelligence</h3>
                    <span class="module-badge low">LOW RISK</span>
                </div>
                <div class="module-stats">
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.social?.connections) { %>
                                <%= surveillance.social.connections.total || 0 %>
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Connections</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.social?.influenceScore) { %>
                                <%= surveillance.social.influenceScore || 0 %>
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Influence</div>
                    </div>
                    <div class="module-stat">
                        <div class="module-stat-value">
                            <% if (surveillance.social?.clusters) { %>
                                <%= surveillance.social.clusters.length || 0 %>
                            <% } else { %>--<% } %>
                        </div>
                        <div class="module-stat-label">Clusters</div>
                    </div>
                </div>
                <div class="module-footer">
                    <a href="/surveillance/cross-modal" class="module-link">
                        <span>View Correlations</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <span class="module-stat-label">Network density: <%= surveillance.social?.networkDensity || 0 %>%</span>
                </div>
            </div>
        </div>

        <div class="quick-actions">
            <a href="/surveillance/profile-depth" class="action-btn">
                <div class="action-icon">
                    <i class="fas fa-user-secret"></i>
                </div>
                <h4 class="action-title">Profile Depth</h4>
                <p class="action-desc">See what platforms know about you</p>
            </a>

            <a href="/surveillance/exploitation-risk" class="action-btn">
                <div class="action-icon">
                    <i class="fas fa-shield-virus"></i>
                </div>
                <h4 class="action-title">Risk Analysis</h4>
                <p class="action-desc">Identify vulnerabilities and attack vectors</p>
            </a>

            <a href="/surveillance/cross-modal" class="action-btn">
                <div class="action-icon">
                    <i class="fas fa-project-diagram"></i>
                </div>
                <h4 class="action-title">Cross-Modal Intel</h4>
                <p class="action-desc">Discover hidden correlations in your data</p>
            </a>

            <a href="/surveillance/compare-models" class="action-btn">
                <div class="action-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <h4 class="action-title">Multi-Entity Views</h4>
                <p class="action-desc">See how different entities view you</p>
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js/dist/chart.min.js"></script>
    <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
        document.addEventListener('DOMContentLoaded', function() {
            // Refresh analysis button
            document.getElementById('refreshAnalysis').addEventListener('click', function() {
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyzing...';
                this.disabled = true;
                
                fetch('/surveillance/analyze', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = data.redirect;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    this.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh Analysis';
                    this.disabled = false;
                });
            });

            // Initialize charts
            <% if (surveillance.behavioral) { %>
            const behavioralCtx = document.getElementById('behavioralChart')?.getContext('2d');
            if (behavioralCtx) {
                new Chart(behavioralCtx, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Activity Level',
                            data: [65, 59, 80, 81, 56, 55, 40],
                            borderColor: '#6366f1',
                            backgroundColor: 'rgba(99, 102, 241, 0.1)',
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(255, 255, 255, 0.1)' },
                                ticks: { color: '#94a3b8' }
                            },
                            x: {
                                grid: { color: 'rgba(255, 255, 255, 0.1)' },
                                ticks: { color: '#94a3b8' }
                            }
                        }
                    }
                });
            }
            <% } %>

            <% if (surveillance.vulnerability) { %>
            const vulnerabilityCtx = document.getElementById('vulnerabilityChart')?.getContext('2d');
            if (vulnerabilityCtx) {
                new Chart(vulnerabilityCtx, {
                    type: 'radar',
                    data: {
                        labels: ['Manipulation', 'Re-ID Risk', 'Exposure', 'Predictability', 'Pattern Risk', 'Data Richness'],
                        datasets: [{
                            label: 'Risk Score',
                            data: [
                                <%= surveillance.vulnerability.manipulationSusceptibility || 0 %>,
                                <%= surveillance.vulnerability.reidentificationRisk || 0 %>,
                                <%= surveillance.vulnerability.dataExposureLevel || 0 %>,
                                <%= surveillance.vulnerability.predictabilityScore || 0 %>,
                                <%= surveillance.vulnerability.patternRisk || 0 %>,
                                <%= surveillance.vulnerability.dataRichness || 0 %>
                            ],
                            backgroundColor: 'rgba(239, 68, 68, 0.2)',
                            borderColor: '#ef4444',
