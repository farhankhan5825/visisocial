<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | VisiSocial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <link href="/stylesheets/visisocial.css" rel="stylesheet">
    <style>
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --danger: #ff5d6c;
            --warning: #f6b24a;
            --success: #2dd4a8;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            min-height: 100vh;
        }

        .correlation-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: 
                radial-gradient(circle at 30% 20%, rgba(99, 102, 241, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 70% 80%, rgba(6, 182, 212, 0.05) 0%, transparent 40%);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--primary-light) 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            color: var(--muted);
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }

        .correlation-count {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem 2rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
            font-size: 1.1rem;
        }

        .correlation-count i {
            color: var(--primary-light);
        }

        .stats-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            background: var(--glass-hover);
            transform: translateY(-2px);
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            font-family: 'Space Grotesk', sans-serif;
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value.critical { color: var(--danger); }
        .stat-value.high { color: var(--warning); }
        .stat-value.medium { color: #60a5fa; }
        .stat-value.low { color: var(--success); }

        .correlation-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .correlation-section {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2rem;
            transition: all 0.4s ease;
        }

        .correlation-section:hover {
            background: var(--glass-hover);
            box-shadow: var(--shadow-glow);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--glass-border);
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--light);
        }

        .section-count {
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .section-count.critical { 
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .section-count.high { 
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .section-count.medium { 
            background: rgba(59, 130, 246, 0.1);
            color: #60a5fa;
        }

        .section-count.low { 
            background: rgba(34, 197, 94, 0.1);
            color: var(--success);
        }

        .correlation-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .correlation-item {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1.5rem;
            transition: all 0.3s ease;
        }

        .correlation-item:hover {
            border-color: var(--primary-light);
            transform: translateX(5px);
        }

        .correlation-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .correlation-strength {
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .strength-high { 
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .strength-medium { 
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .strength-low { 
            background: rgba(59, 130, 246, 0.1);
            color: #60a5fa;
        }

        .correlation-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--light);
            margin-bottom: 0.5rem;
        }

        .correlation-desc {
            font-size: 0.9rem;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .correlation-sources {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .source-badge {
            padding: 0.25rem 0.75rem;
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 50px;
            font-size: 0.8rem;
            color: var(--primary-light);
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--muted);
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            padding: 1rem 1.5rem;
            background: var(--glass);
            border-radius: 12px;
        }

        .breadcrumb a {
            color: var(--muted);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .breadcrumb a:hover {
            color: var(--primary-light);
        }

        .breadcrumb .separator {
            color: var(--muted);
        }

        .breadcrumb .current {
            color: var(--accent);
            font-weight: 600;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--light);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: var(--glass-hover);
            border-color: var(--primary-light);
        }

        .info-box {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(99, 102, 241, 0.05) 100%);
            border: 1px solid rgba(6, 182, 212, 0.2);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .info-box-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .info-box-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--accent);
        }

        .info-box-content {
            color: var(--muted);
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .container { padding: 1rem; }
            h1 { font-size: 2rem; }
            .correlation-grid { grid-template-columns: 1fr; }
            .stats-summary { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="correlation-bg"></div>

    <div class="container">
        <div class="breadcrumb">
            <a href="/surveillance/dashboard">Surveillance</a>
            <span class="separator">/</span>
            <span class="current">Cross-Modal Intelligence</span>
        </div>

        <div class="page-header">
            <h1>Cross-Modal Intelligence</h1>
            <p class="subtitle">Discover hidden correlations and intelligence insights across different data modalities</p>
            <div class="correlation-count">
                <i class="fas fa-project-diagram"></i>
                <span><%= totalCorrelations %> correlations detected across all sensitivity levels</span>
            </div>
        </div>

        <div class="info-box">
            <div class="info-box-header">
                <i class="fas fa-info-circle"></i>
                <h3 class="info-box-title">Understanding Cross-Modal Correlations</h3>
            </div>
            <div class="info-box-content">
                Cross-modal correlations reveal how different types of data (behavioral, psychographic, social, etc.) 
                intersect to create comprehensive profiles. These insights show how platforms can infer sensitive information 
                by connecting seemingly unrelated data points.
            </div>
        </div>

        <div class="stats-summary">
            <div class="stat-card">
                <div class="stat-value critical"><%= correlations.critical?.length || 0 %></div>
                <div class="stat-label">Critical Correlations</div>
            </div>
            <div class="stat-card">
                <div class="stat-value high"><%= correlations.high?.length || 0 %></div>
                <div class="stat-label">High Sensitivity</div>
            </div>
            <div class="stat-card">
                <div class="stat-value medium"><%= correlations.medium?.length || 0 %></div>
                <div class="stat-label">Medium Sensitivity</div>
            </div>
            <div class="stat-card">
                <div class="stat-value low"><%= correlations.low?.length || 0 %></div>
                <div class="stat-label">Low Sensitivity</div>
            </div>
        </div>

        <div class="correlation-grid">
            <!-- Critical Correlations -->
            <div class="correlation-section">
                <div class="section-header">
                    <h2 class="section-title">Critical Correlations</h2>
                    <span class="section-count critical"><%= correlations.critical?.length || 0 %> detected</span>
                </div>
                
                <% if (correlations.critical && correlations.critical.length > 0) { %>
                <div class="correlation-list">
                    <% correlations.critical.forEach((correlation, index) => { %>
                    <div class="correlation-item">
                        <div class="correlation-meta">
                            <span class="correlation-strength strength-high">CRITICAL</span>
                            <span style="color: var(--muted); font-size: 0.85rem;">
                                Confidence: <%= correlation.confidence || 95 %>%
                            </span>
                        </div>
                        <h3 class="correlation-title"><%= correlation.description || correlation.type %></h3>
                        <p class="correlation-desc">
                            <%= correlation.insight || 'High-risk correlation detected across multiple data sources.' %>
                        </p>
                        <div class="correlation-sources">
                            <% if (correlation.sources) { 
                                correlation.sources.forEach(source => { %>
                            <span class="source-badge"><%= source %></span>
                            <% }); } else { %>
                            <span class="source-badge">Behavioral</span>
                            <span class="source-badge">Location</span>
                            <span class="source-badge">Social</span>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-shield-check"></i>
                    <h3>No Critical Correlations</h3>
                    <p>No critical cross-modal correlations detected at this time.</p>
                </div>
                <% } %>
            </div>

            <!-- High Sensitivity Correlations -->
            <div class="correlation-section">
                <div class="section-header">
                    <h2 class="section-title">High Sensitivity</h2>
                    <span class="section-count high"><%= correlations.high?.length || 0 %> detected</span>
                </div>
                
                <% if (correlations.high && correlations.high.length > 0) { %>
                <div class="correlation-list">
                    <% correlations.high.forEach((correlation, index) => { %>
                    <div class="correlation-item">
                        <div class="correlation-meta">
                            <span class="correlation-strength strength-medium">HIGH</span>
                            <span style="color: var(--muted); font-size: 0.85rem;">
                                Confidence: <%= correlation.confidence || 85 %>%
                            </span>
                        </div>
                        <h3 class="correlation-title"><%= correlation.description || correlation.type %></h3>
                        <p class="correlation-desc">
                            <%= correlation.insight || 'Significant correlation with potential privacy implications.' %>
                        </p>
                        <div class="correlation-sources">
                            <% if (correlation.sources) { 
                                correlation.sources.forEach(source => { %>
                            <span class="source-badge"><%= source %></span>
                            <% }); } else { %>
                            <span class="source-badge">Psychographic</span>
                            <span class="source-badge">Behavioral</span>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-chart-line"></i>
                    <h3>No High Sensitivity</h3>
                    <p>No high sensitivity correlations detected at this time.</p>
                </div>
                <% } %>
            </div>

            <!-- Medium Sensitivity Correlations -->
            <div class="correlation-section">
                <div class="section-header">
                    <h2 class="section-title">Medium Sensitivity</h2>
                    <span class="section-count medium"><%= correlations.medium?.length || 0 %> detected</span>
                </div>
                
                <% if (correlations.medium && correlations.medium.length > 0) { %>
                <div class="correlation-list">
                    <% correlations.medium.slice(0, 3).forEach((correlation, index) => { %>
                    <div class="correlation-item">
                        <div class="correlation-meta">
                            <span class="correlation-strength strength-low">MEDIUM</span>
                            <span style="color: var(--muted); font-size: 0.85rem;">
                                Confidence: <%= correlation.confidence || 75 %>%
                            </span>
                        </div>
                        <h3 class="correlation-title"><%= correlation.description || correlation.type %></h3>
                        <p class="correlation-desc">
                            <%= correlation.insight || 'Moderate correlation with some intelligence value.' %>
                        </p>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-chart-bar"></i>
                    <h3>No Medium Sensitivity</h3>
                    <p>No medium sensitivity correlations detected at this time.</p>
                </div>
                <% } %>
            </div>

            <!-- Low Sensitivity Correlations -->
            <div class="correlation-section">
                <div class="section-header">
                    <h2 class="section-title">Low Sensitivity</h2>
                    <span class="section-count low"><%= correlations.low?.length || 0 %> detected</span>
                </div>
                
                <% if (correlations.low && correlations.low.length > 0) { %>
                <div class="correlation-list">
                    <% correlations.low.slice(0, 3).forEach((correlation, index) => { %>
                    <div class="correlation-item">
                        <div class="correlation-meta">
                            <span class="correlation-strength">LOW</span>
                            <span style="color: var(--muted); font-size: 0.85rem;">
                                Confidence: <%= correlation.confidence || 65 %>%
                            </span>
                        </div>
                        <h3 class="correlation-title"><%= correlation.description || correlation.type %></h3>
                        <p class="correlation-desc">
                            <%= correlation.insight || 'Basic correlation with limited intelligence value.' %>
                        </p>
                    </div>
                    <% }); %>
                    <% if (correlations.low.length > 3) { %>
                    <div style="text-align: center; padding: 1rem; color: var(--muted);">
                        + <%= correlations.low.length - 3 %> more low sensitivity correlations
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-chart-pie"></i>
                    <h3>No Low Sensitivity</h3>
                    <p>No low sensitivity correlations detected at this time.</p>
                </div>
                <% } %>
            </div>
        </div>

        <a href="/surveillance/dashboard" class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>