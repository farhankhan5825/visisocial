router.get('/metrics', wrapAsync(async (req, res) => {
  const now = new Date();
  const weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
  const monthAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
  const yearAgo = new Date(Date.now() - 365 * 24 * 60 * 60 * 1000);

  // Core user statistics
  const [totalUsers, newUsersWeek, newUsersMonth, activeUsersWeek] = await Promise.all([
    User.countDocuments(),
    User.countDocuments({ createdAt: { $gte: weekAgo } }),
    User.countDocuments({ createdAt: { $gte: monthAgo } }),
    User.countDocuments({ lastUpdated: { $gte: weekAgo } })
  ]);

  // Analysis statistics
  const analysisStats = await User.aggregate([
    {
      $group: {
        _id: null,
        totalPosts: { $sum: { $size: { $ifNull: ["$feedData", []] } } },
        totalLikes: { $sum: { $size: { $ifNull: ["$likes", []] } } },
        totalAlbums: { $sum: { $size: { $ifNull: ["$albumsData", []] } } },
        totalPhotos: { $sum: { $size: { $ifNull: ["$photosData", []] } } }
      }
    }
  ]);

  const totalDataPoints = analysisStats[0] ? 
    analysisStats[0].totalPosts + 
    analysisStats[0].totalLikes + 
    analysisStats[0].totalAlbums + 
    analysisStats[0].totalPhotos : 0;

  // Countries served
  const countries = await User.distinct('location.name');
  const uniqueCountries = new Set(
    countries
      .filter(Boolean)
      .map(loc => loc.split(',').pop().trim())
  );

  // Average confidence score
  const avgConfidenceResult = await User.aggregate([
    { $match: { 'personalityScores.confidence': { $exists: true, $ne: null } } },
    { $group: { _id: null, avg: { $avg: '$personalityScores.confidence' } } }
  ]);
  const avgConfidence = avgConfidenceResult[0]?.avg || 0;

  // Average engagement score
  const avgEngagementResult = await User.aggregate([
    { $match: { engagementScore: { $exists: true, $ne: null } } },
    { $group: { _id: null, avg: { $avg: '$engagementScore' } } }
  ]);
  const avgEngagement = avgEngagementResult[0]?.avg || 0;

  // Growth rate calculation
  const weeklyGrowthRate = totalUsers > 0 ? 
    Math.round((newUsersWeek / totalUsers) * 100) : 0;

  // User growth over last 30 days
  const userGrowth = await User.aggregate([
    { $match: { createdAt: { $gte: monthAgo } } },
    {
      $group: {
        _id: { $dateToString: { format: '%Y-%m-%d', date: '$createdAt' } },
        count: { $sum: 1 }
      }
    },
    { $sort: { _id: 1 } }
  ]);

  // Personality distribution
  const personalityDistribution = await User.aggregate([
    { $match: { personalityScores: { $exists: true } } },
    {
      $project: {
        dominantTrait: {
          $arrayElemAt: [
            ['Openness', 'Conscientiousness', 'Extroversion', 'Agreeableness', 'Neuroticism'],
            {
              $indexOfArray: [
                [
                  '$personalityScores.openness',
                  '$personalityScores.conscientiousness',
                  '$personalityScores.extroversion',
                  '$personalityScores.agreeableness',
                  '$personalityScores.neuroticism'
                ],
                { $max: [
                  '$personalityScores.openness',
                  '$personalityScores.conscientiousness',
                  '$personalityScores.extroversion',
                  '$personalityScores.agreeableness',
                  '$personalityScores.neuroticism'
                ]}
              ]
            }
          ]
        }
      }
    },
    { $group: { _id: '$dominantTrait', count: { $sum: 1 } } },
    { $sort: { count: -1 } }
  ]);

  // Engagement distribution
  const engagementDistribution = await User.aggregate([
    { $match: { engagementScore: { $exists: true } } },
    {
      $bucket: {
        groupBy: '$engagementScore',
        boundaries: [0, 20, 40, 60, 80, 100],
        default: 'Other',
        output: { count: { $sum: 1 } }
      }
    }
  ]);

  // Calculate estimated data economy value
  const dataEconomyValue = Math.round((totalDataPoints * 0.0005) + (totalUsers * 200));

  const stats = {
    users: {
      total: totalUsers || 0,
      newWeek: newUsersWeek || 0,
      newMonth: newUsersMonth || 0,
      activeWeek: activeUsersWeek || 0,
      growthRate: weeklyGrowthRate
    },
    analyses: {
      total: analysisStats[0]?.totalPosts || 0,
      dataPoints: totalDataPoints,
      avgConfidence: Math.round(avgConfidence),
      avgEngagement: Math.round(avgEngagement)
    },
    platform: {
      countries: uniqueCountries.size,
      dataValue: dataEconomyValue,
      analysesPerUser: totalUsers > 0 ? Math.round(totalDataPoints / totalUsers) : 0
    },
    growth: userGrowth,
    personality: personalityDistribution,
    engagement: engagementDistribution
  };

  res.render('metrics', {
    title: 'Platform Metrics | VisiSocial',
    stats,
    lastUpdated: new Date(),
    nonce: res.locals.nonce
  });
}));


