<!-- views/loading.ejs -->
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analyzing Your Profile | VisiSocial</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">    
    <style>
        :root {
            --primary: #7c6cff;
            --primary-dark: #5b4fe0;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --gradient-primary: linear-gradient(118deg, #9d7bff 0%, #7c6cff 45%, #34e3ff 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            min-height: 100vh;
            overflow: hidden;
            position: relative;
            padding-top: 0;
        }

        /* Animated Background */
        .bg-animated {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.4;
            animation: float 25s ease-in-out infinite;
        }

        .orb-1 {
            width: 600px;
            height: 600px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            top: -200px;
            right: -200px;
            animation-delay: 0s;
        }

        .orb-2 {
            width: 500px;
            height: 500px;
            background: linear-gradient(135deg, var(--secondary) 0%, var(--accent) 100%);
            bottom: -150px;
            left: -150px;
            animation-delay: -10s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 100%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: -5s;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); }
            25% { transform: translate(60px, -60px) scale(1.1) rotate(90deg); }
            50% { transform: translate(-40px, 40px) scale(0.9) rotate(180deg); }
            75% { transform: translate(-60px, -40px) scale(1.05) rotate(270deg); }
        }

        /* Loading Container */
        .loading-container {
            width: 90%;
            max-width: 700px;
            padding: 60px 40px;
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 32px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
            text-align: center;
            position: relative;
            overflow: hidden;
            margin: 40px auto;
        }

        .loading-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--gradient-primary);
        }

        /* Brand */
        .brand {
            font-family: 'Poppins', sans-serif;
            font-size: 2rem;
            font-weight: 900;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 16px;
        }

        .loading-title {
            font-family: 'Poppins', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--light);
        }

        .loading-subtitle {
            font-size: 1.05rem;
            color: var(--muted);
            margin-bottom: 48px;
            line-height: 1.6;
        }

        /* Spinner */
        .spinner-container {
            position: relative;
            width: 140px;
            height: 140px;
            margin: 0 auto 48px;
        }

        .spinner {
            width: 140px;
            height: 140px;
            border: 4px solid rgba(255, 255, 255, 0.05);
            border-top: 4px solid var(--primary);
            border-right: 4px solid var(--secondary);
            border-radius: 50%;
            animation: spin 1.5s linear infinite;
            position: absolute;
            top: 0;
            left: 0;
        }

        .spinner-inner {
            width: 100px;
            height: 100px;
            border: 3px solid rgba(255, 255, 255, 0.03);
            border-top: 3px solid var(--accent);
            border-radius: 50%;
            animation: spin 2s linear infinite reverse;
            position: absolute;
            top: 20px;
            left: 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .spinner-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 3rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
            50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
        }

        /* Progress Bar */
        .progress-container {
            width: 100%;
            height: 8px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50px;
            overflow: hidden;
            margin-bottom: 24px;
            position: relative;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: var(--gradient-primary);
            border-radius: 50px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .progress-text {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            font-size: 0.95rem;
        }

        .progress-percentage {
            font-weight: 700;
            color: var(--primary-light);
            font-size: 1.1rem;
        }

        /* Status Message */
        .status-message {
            font-size: 1.15rem;
            color: var(--light);
            margin-bottom: 16px;
            font-weight: 600;
            min-height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .status-message i {
            color: var(--accent);
        }

        .status-detail {
            font-size: 0.95rem;
            color: var(--muted);
            line-height: 1.6;
            min-height: 24px;
        }

        /* Steps */
        .steps-container {
            margin-top: 48px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .step-item {
            padding: 16px 12px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            transition: all 0.4s ease;
            position: relative;
        }

        .step-item.active {
            background: rgba(99, 102, 241, 0.1);
            border-color: var(--primary);
            transform: translateY(-4px);
        }

        .step-item.completed {
            background: rgba(16, 185, 129, 0.08);
            border-color: var(--success);
        }

        .step-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 12px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            background: rgba(255, 255, 255, 0.05);
            color: var(--muted);
            transition: all 0.3s ease;
        }

        .step-item.active .step-icon {
            background: var(--gradient-primary);
            color: white;
            animation: pulse 2s ease-in-out infinite;
        }

        .step-item.completed .step-icon {
            background: var(--success);
            color: white;
        }

        .step-label {
            font-size: 0.85rem;
            color: var(--muted);
            font-weight: 500;
        }

        .step-item.active .step-label,
        .step-item.completed .step-label {
            color: var(--light);
        }

        /* Error State */
        .error-container {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 16px;
            padding: 24px;
            margin-top: 32px;
            display: none;
        }

        .error-container.show {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .error-title {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--danger);
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 12px;
        }

        .error-message {
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .btn {
            background: var(--gradient-primary);
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
        }

        .btn-warning {
            background: linear-gradient(135deg, var(--warning) 0%, #f97316 100%);
        }

        .btn-warning:hover {
            box-shadow: 0 10px 30px rgba(245, 158, 11, 0.3);
        }

        .btn-success {
            background: linear-gradient(135deg, var(--success) 0%, #059669 100%);
        }

        .btn-success:hover {
            box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
        }

        /* Success animation */
        .success-checkmark {
            width: 100px;
            height: 100px;
            margin: 0 auto 24px;
            border-radius: 50%;
            display: none;
            stroke-width: 3;
            stroke: #10b981;
            stroke-miterlimit: 10;
            animation: scaleIn 0.5s ease;
        }

        .success-checkmark.show {
            display: block;
        }

        @keyframes scaleIn {
            from { transform: scale(0); }
            to { transform: scale(1); }
        }

        .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        }

        .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.4s forwards;
        }

        @keyframes stroke {
            100% { stroke-dashoffset: 0; }
        }

        /* Timeout Warning */
        .timeout-warning {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 16px;
            padding: 20px;
            margin-top: 20px;
            animation: fadeIn 0.5s ease;
            display: none;
        }

        .timeout-warning.show {
            display: block;
        }

        .timeout-warning h4 {
            color: var(--warning);
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        /* Redirect Overlay */
        .redirect-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(2, 6, 23, 0.95);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .redirect-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .redirect-content {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 32px;
            padding: 60px 40px;
            text-align: center;
            max-width: 500px;
            width: 90%;
        }

        .redirect-spinner {
            width: 80px;
            height: 80px;
            border: 4px solid rgba(255, 255, 255, 0.1);
            border-top: 4px solid var(--success);
            border-radius: 50%;
            margin: 0 auto 30px;
            animation: spin 1.5s linear infinite;
        }

        /* Simple Navbar */
        .simple-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(2, 6, 23, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 1rem 2rem;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .simple-navbar-brand {
            font-family: 'Poppins', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
        }

        .logout-btn {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            transform: translateY(-2px);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .loading-container {
                padding: 40px 24px;
                margin: 20px auto;
            }

            .brand {
                font-size: 1.6rem;
            }

            .loading-title {
                font-size: 1.4rem;
            }

            .steps-container {
                grid-template-columns: repeat(2, 1fr);
            }

            .spinner-container {
                width: 100px;
                height: 100px;
            }

            .spinner {
                width: 100px;
                height: 100px;
            }

            .spinner-inner {
                width: 70px;
                height: 70px;
                top: 15px;
                left: 15px;
            }

            .spinner-icon {
                font-size: 2rem;
            }

            .simple-navbar {
                padding: 1rem;
            }

            .simple-navbar-brand {
                font-size: 1.2rem;
            }

            .logout-btn {
                padding: 6px 16px;
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <!-- Simple Navbar with Logout Only -->
    <nav class="simple-navbar">
        <a href="/" class="simple-navbar-brand">VisiSocial</a>
        <a href="/auth/logout" class="logout-btn">
            <i class="fas fa-sign-out-alt"></i>
            <span>Logout</span>
        </a>
    </nav>

    <!-- Animated Background -->
    <div class="bg-animated">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <!-- Loading Container -->
    <div class="loading-container">
        <div class="brand">VisiSocial</div>
        <h1 class="loading-title">Analyzing Your Profile</h1>
        <p class="loading-subtitle">We're processing your Facebook data to generate your personality insights</p>

        <!-- Spinner -->
        <div class="spinner-container">
            <div class="spinner"></div>
            <div class="spinner-inner"></div>
            <i class="fas fa-brain spinner-icon"></i>
        </div>

        <!-- Success Checkmark (hidden initially) -->
        <svg class="success-checkmark" id="successCheckmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
            <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none"/>
            <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
        </svg>

        <!-- Progress Bar -->
        <div class="progress-container">
            <div class="progress-bar" id="progressBar"></div>
        </div>

        <!-- Progress Text -->
        <div class="progress-text">
            <span id="taskMessage">Initializing...</span>
            <span class="progress-percentage" id="progressPercentage">0%</span>
        </div>

        <!-- Status Message -->
        <div class="status-message" id="statusMessage">
            <i class="fas fa-sync-alt fa-spin"></i>
            <span>Starting analysis...</span>
        </div>
        <div class="status-detail" id="statusDetail">
            Please wait while we securely fetch and analyze your data
        </div>

        <!-- Steps -->
        <div class="steps-container">
            <div class="step-item" id="step1">
                <div class="step-icon">
                    <i class="fas fa-database"></i>
                </div>
                <div class="step-label">Fetch Data</div>
            </div>
            <div class="step-item" id="step2">
                <div class="step-icon">
                    <i class="fas fa-comments"></i>
                </div>
                <div class="step-label">Process Posts</div>
            </div>
            <div class="step-item" id="step3">
                <div class="step-icon">
                    <i class="fas fa-brain"></i>
                </div>
                <div class="step-label">AI Analysis</div>
            </div>
            <div class="step-item" id="step4">
                <div class="step-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="step-label">Complete</div>
            </div>
        </div>

        <!-- Timeout Warning -->
        <div class="timeout-warning" id="timeoutWarning">
            <h4>
                <i class="fas fa-clock"></i>
                <span>Taking longer than expected?</span>
            </h4>
            <p style="color: var(--muted); margin-bottom: 20px; line-height: 1.6;">
                The analysis is taking longer than usual. You can continue to your dashboard now, and your data will continue processing in the background.
            </p>
            <button class="btn btn-warning" id="continueBtn">
                <i class="fas fa-forward"></i>
                <span>Continue to Dashboard</span>
            </button>
        </div>

        <!-- Error Container -->
        <div class="error-container" id="errorContainer">
            <div class="error-title">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Analysis Failed</span>
            </div>
            <div class="error-message" id="errorMessage">
                We encountered an error while processing your data. This might be temporary.
            </div>
            <button class="btn" id="retryBtn">
                <i class="fas fa-redo"></i>
                <span>Retry Analysis</span>
            </button>
        </div>
    </div>

    <!-- Redirect Overlay -->
    <div class="redirect-overlay" id="redirectOverlay">
        <div class="redirect-content">
            <div class="redirect-spinner"></div>
            <h2 style="color: var(--light); margin-bottom: 16px; font-family: 'Poppins', sans-serif;">
                Please wait...
            </h2>
            <p style="color: var(--muted); line-height: 1.6; margin-bottom: 30px;">
                You are now being redirected to your dashboard.
            </p>
            <div class="progress-container" style="width: 200px; margin: 0 auto;">
                <div class="progress-bar" id="redirectProgress" style="width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    let retries = 0;
    const MAX_RETRIES = 30;
    let lastProgress = 0;
    let pollInterval;
    let startTime = Date.now();
    const TIMEOUT_MS = 60000; // 1 minute timeout
    let timeoutId;
    let isRedirecting = false;

    // DOM Elements
    const progressBar = document.getElementById('progressBar');
    const progressPercentage = document.getElementById('progressPercentage');
    const taskMessage = document.getElementById('taskMessage');
    const statusMessage = document.getElementById('statusMessage');
    const statusDetail = document.getElementById('statusDetail');
    const errorContainer = document.getElementById('errorContainer');
    const errorMessage = document.getElementById('errorMessage');
    const spinnerContainer = document.querySelector('.spinner-container');
    const successCheckmark = document.getElementById('successCheckmark');
    const timeoutWarning = document.getElementById('timeoutWarning');
    const continueBtn = document.getElementById('continueBtn');
    const retryBtn = document.getElementById('retryBtn');
    const redirectOverlay = document.getElementById('redirectOverlay');
    const redirectProgress = document.getElementById('redirectProgress');

    // Task mapping for different status messages
    const TASK_MAP = {
        'Initializing...': { icon: 'fa-hourglass-start', detail: 'Starting analysis...' },
        'Connecting...': { icon: 'fa-plug', detail: 'Establishing connection...' },
        'Fetching Facebook data...': { icon: 'fa-database', detail: 'Retrieving profile information' },
        'Fetching likes...': { icon: 'fa-thumbs-up', detail: 'Analyzing your interests' },
        'Fetching posts...': { icon: 'fa-comments', detail: 'Processing your posts' },
        'Fetching albums...': { icon: 'fa-images', detail: 'Loading your photos' },
        'Saving user data...': { icon: 'fa-save', detail: 'Storing data securely' },
        'Calculating personality scores...': { icon: 'fa-brain', detail: 'Analyzing personality traits' },
        'Generating descriptions...': { icon: 'fa-file-alt', detail: 'Creating personalized insights' },
        'Analyzing text data...': { icon: 'fa-chart-bar', detail: 'Finalizing analysis' },
        'Analysis complete!': { icon: 'fa-check-circle', detail: 'Redirecting to dashboard...' },
        'Processing...': { icon: 'fa-sync-alt fa-spin', detail: 'Processing your data...' }
    };

    // Start timeout check
    function startTimeout() {
        timeoutId = setTimeout(() => {
            console.log('Loading timeout reached, showing continue button');
            timeoutWarning.classList.add('show');
        }, TIMEOUT_MS);
    }

    // Update UI based on backend response
    function updateUI(response) {
        console.log('Update UI with response:', response);
        
        // Extract data from response
        const taskText = response.task || response.message || 'Processing...';
        const progress = response.progress || 0;
        const step = response.step || response.currentStep || 1;
        
        // Calculate progress percentage
        const effectiveProgress = Math.min(100, Math.max(0, progress));
        lastProgress = effectiveProgress;
        
        // Update progress bar
        progressBar.style.width = `${effectiveProgress}%`;
        progressPercentage.textContent = `${effectiveProgress}%`;
        taskMessage.textContent = taskText;
        
        // Update status message
        const taskInfo = TASK_MAP[taskText] || { icon: 'fa-sync-alt fa-spin', detail: 'Processing your data...' };
        const statusIcon = statusMessage.querySelector('i');
        const statusText = statusMessage.querySelector('span');
        
        if (statusIcon) statusIcon.className = `fas ${taskInfo.icon}`;
        if (statusText) statusText.textContent = taskText;
        statusDetail.textContent = taskInfo.detail;
        
        // Update steps
        for (let i = 1; i <= 4; i++) {
            const el = document.getElementById(`step${i}`);
            if (el) {
                el.className = 'step-item';
                if (i < step) {
                    el.classList.add('completed');
                } else if (i === step) {
                    el.classList.add('active');
                }
            }
        }
        
        // Handle completion
        const isComplete = response.completed === true || 
                          response.redirectTo || 
                          (response.isProcessing === false && effectiveProgress >= 100) ||
                          taskText.toLowerCase().includes('complete') ||
                          effectiveProgress >= 100;
        
        if (isComplete && !isRedirecting) {
            console.log('Analysis complete detected');
            showSuccess();
            
            // Clear timeout and intervals
            clearTimeout(timeoutId);
            clearInterval(pollInterval);
            timeoutWarning.classList.remove('show');
            
            // Redirect after delay
            const redirectUrl = response.redirectTo || '/';
            setTimeout(() => {
                redirectToDashboard(redirectUrl);
            }, 1500);
        }
    }

    // Show success state
    function showSuccess() {
        spinnerContainer.style.display = 'none';
        successCheckmark.classList.add('show');
        timeoutWarning.classList.remove('show');
        
        progressBar.style.width = '100%';
        progressPercentage.textContent = '100%';
        taskMessage.textContent = 'Analysis Complete!';
        
        const statusIcon = statusMessage.querySelector('i');
        const statusText = statusMessage.querySelector('span');
        
        if (statusIcon) {
            statusIcon.className = 'fas fa-check-circle';
            statusIcon.style.color = 'var(--success)';
        }
        if (statusText) {
            statusText.textContent = 'Analysis Complete!';
            statusText.style.color = 'var(--success)';
        }
        statusDetail.textContent = 'Redirecting to your dashboard...';
        
        // Mark all steps as completed
        for (let i = 1; i <= 4; i++) {
            const el = document.getElementById(`step${i}`);
            if (el) {
                el.className = 'step-item completed';
            }
        }
    }

    // Show error state
    function showError(message) {
        clearTimeout(timeoutId);
        clearInterval(pollInterval);
        
        errorMessage.textContent = message || 'An unexpected error occurred.';
        errorContainer.classList.add('show');
        timeoutWarning.classList.remove('show');
        
        const statusIcon = statusMessage.querySelector('i');
        const statusText = statusMessage.querySelector('span');
        
        if (statusIcon) {
            statusIcon.className = 'fas fa-exclamation-triangle';
            statusIcon.style.color = 'var(--danger)';
        }
        if (statusText) {
            statusText.textContent = 'Analysis Failed';
            statusText.style.color = 'var(--danger)';
        }
        statusDetail.textContent = 'Please try refreshing or continue to dashboard';
        
        spinnerContainer.style.display = 'none';
    }

    // Show redirect overlay
    function showRedirectOverlay() {
        isRedirecting = true;
        redirectOverlay.classList.add('active');
        redirectProgress.style.width = '0%';
        
        // Animate progress bar
        let progress = 0;
        const interval = setInterval(() => {
            progress += 100 / 50; // 2% per interval
            redirectProgress.style.width = `${progress}%`;
            if (progress >= 100) {
                clearInterval(interval);
            }
        }, 30);
    }

    // Redirect to dashboard
    function redirectToDashboard(url = '/') {
        if (isRedirecting) return;
        
        showRedirectOverlay();
        console.log('Redirecting to:', url);
        
        // Wait for animation to complete
        setTimeout(() => {
            window.location.href = url;
        }, 2000);
    }

    // Poll backend for status
    async function poll() {
        try {
            const timestamp = Date.now();
            const url = `/task-status?_=${timestamp}`;
            
            console.log('Polling:', url);
            const res = await fetch(url, {
                credentials: 'include',
                cache: 'no-store',
                headers: { 'Accept': 'application/json' }
            });
            
            if (!res.ok) {
                if (res.status === 401 || res.status === 403) {
                    showError('Session expired. Please login again.');
                    setTimeout(() => window.location.href = '/login', 2000);
                    return;
                }
                throw new Error(`HTTP ${res.status}`);
            }

            const response = await res.json();
            console.log('Response:', response);

            if (response.error) {
                showError(response.error);
                return;
            }

            updateUI(response);
            retries = 0; // Reset retry counter on success

        } catch (err) {
            retries++;
            console.error(`Poll attempt ${retries} failed:`, err.message);
            
            if (retries < MAX_RETRIES) {
                statusDetail.textContent = `Reconnecting… (${retries}/${MAX_RETRIES})`;
                
                // Exponential backoff
                const delay = Math.min(1000 * Math.pow(1.5, retries), 10000);
                
                setTimeout(() => poll(), delay);
            } else {
                showError('Unable to contact server. Please check your connection.');
            }
        }
    }

    // Event Listeners
    continueBtn.addEventListener('click', () => {
        console.log('User chose to continue to dashboard');
        timeoutWarning.classList.remove('show');
        redirectToDashboard();
    });

    retryBtn.addEventListener('click', () => {
        console.log('Retry analysis requested');
        location.reload();
    });

    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', () => {
        console.log('Loading page initialized');
        
        // Start timeout check
        startTimeout();
        
        // Initial UI state
        updateUI({
            task: 'Connecting...',
            progress: 0,
            step: 1
        });
        
        // Start polling immediately
        poll();
        
        // Then poll every 2 seconds
        pollInterval = setInterval(poll, 2000);
    });

    // Clean up on page unload
    window.addEventListener('beforeunload', () => {
        clearTimeout(timeoutId);
        clearInterval(pollInterval);
    });

    // Handle visibility changes
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            if (pollInterval) {
                clearInterval(pollInterval);
                pollInterval = null;
            }
        } else {
            if (!pollInterval) {
                poll(); // Immediate poll
                pollInterval = setInterval(poll, 2000);
            }
        }
    });
    </script>

</body>
</html>