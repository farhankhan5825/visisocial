    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const backToTop = document.getElementById('backToTop');
            const uptimeChart = document.getElementById('uptimeChart');
            const subscribeForm = document.getElementById('subscribeForm');

            // Back to top functionality
            window.addEventListener('scroll', function() {
                if (window.pageYOffset > 300) {
                    backToTop.classList.add('visible');
                } else {
                    backToTop.classList.remove('visible');
                }
            });

            backToTop.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // Generate uptime chart
            function generateUptimeChart() {
                const days = 90;
                for (let i = 0; i < days; i++) {
                    const bar = document.createElement('div');
                    
                    // Simulate mostly operational status with occasional issues
                    const random = Math.random();
                    if (random > 0.98) {
                        bar.className = 'uptime-bar down';
                    } else if (random > 0.95) {
                        bar.className = 'uptime-bar degraded';
                    } else {
                        bar.className = 'uptime-bar';
                    }
                    
                    // Add tooltip
                    const date = new Date();
                    date.setDate(date.getDate() - (days - i));
                    bar.title = `${date.toLocaleDateString()}: ${
                        bar.classList.contains('down') ? 'Downtime' :
                        bar.classList.contains('degraded') ? 'Degraded' :
                        'Operational'
                    }`;
                    
                    uptimeChart.appendChild(bar);
                }
            }

            generateUptimeChart();

            // Subscribe form
            subscribeForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const email = this.querySelector('input[type="email"]').value;
                
                // Here you would send the subscription request to your server
                console.log('Subscribing:', email);
                
                alert('Thank you for subscribing! You\'ll receive status updates at ' + email);
                this.reset();
            });

            // Auto-refresh status every 30 seconds
            setInterval(function() {
                console.log('Refreshing status...');
                // In production, this would fetch real status data from your API
            }, 30000);
        });
    </script>
    <%- include('partials/footer') %>
</body>
</html>
