<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | VisiSocial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <link href="/stylesheets/visisocial.css" rel="stylesheet">
    <style>
        :root {
            --primary: #7c6cff;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --danger: #ff5d6c;
            --warning: #f6b24a;
            --success: #2dd4a8;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-glow: 0 0 60px rgba(124,108,255,0.32);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            min-height: 100vh;
        }

        .profile-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: 
                radial-gradient(circle at 20% 30%, rgba(99, 102, 241, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--primary-light) 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            color: var(--muted);
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }

        .data-points {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem 2rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
            font-size: 1.1rem;
        }

        .data-points i {
            color: var(--primary-light);
        }

        .profile-section {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 2rem;
            transition: all 0.4s ease;
        }

        .profile-section:hover {
            background: var(--glass-hover);
            box-shadow: var(--shadow-glow);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--glass-border);
        }

        .section-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }

        .section-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--light);
        }

        .section-subtitle {
            color: var(--muted);
            font-size: 1rem;
        }

        .data-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .data-item {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 1.5rem;
            transition: all 0.3s ease;
        }

        .data-item:hover {
            border-color: var(--primary-light);
            transform: translateY(-2px);
        }

        .data-label {
            font-size: 0.9rem;
            color: var(--muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .data-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--light);
            margin-bottom: 1rem;
        }

        .data-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--glass-border);
        }

        .data-source {
            font-size: 0.85rem;
            color: var(--muted);
        }

        .sensitivity-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .sensitivity-critical {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .sensitivity-high {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .sensitivity-medium {
            background: rgba(59, 130, 246, 0.1);
            color: #60a5fa;
        }

        .sensitivity-low {
            background: rgba(34, 197, 94, 0.1);
            color: var(--success);
        }

        .transformation-list {
            margin-top: 2rem;
        }

        .transformation-item {
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

        .transformation-item:hover {
            border-color: var(--primary-light);
            transform: translateX(5px);
        }

        .transformation-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .transformation-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--light);
        }

        .transformation-flow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            margin: 1.5rem 0;
        }

        .flow-step {
            flex: 1;
            text-align: center;
            padding: 1rem;
        }

        .flow-step-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 1rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--primary-light);
        }

        .flow-step-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--light);
        }

        .flow-step-desc {
            font-size: 0.85rem;
            color: var(--muted);
        }

        .flow-arrow {
            color: var(--primary-light);
            font-size: 1.5rem;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            padding: 1rem 1.5rem;
            background: var(--glass);
            border-radius: 12px;
        }

        .breadcrumb a {
            color: var(--muted);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .breadcrumb a:hover {
            color: var(--primary-light);
        }

        .breadcrumb .separator {
            color: var(--muted);
        }

        .breadcrumb .current {
            color: var(--primary-light);
            font-weight: 600;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--light);
            text-decoration: none;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: var(--glass-hover);
            border-color: var(--primary-light);
        }

        @media (max-width: 768px) {
            .container { padding: 1rem; }
            h1 { font-size: 2rem; }
            .profile-section { padding: 2rem; }
            .transformation-flow {
                flex-direction: column;
                gap: 1rem;
            }
            .flow-arrow {
                transform: rotate(90deg);
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="profile-bg"></div>

    <div class="container">
        <div class="breadcrumb">
            <a href="/surveillance/dashboard">Surveillance</a>
            <span class="separator">/</span>
            <span class="current">Profile Depth</span>
        </div>

        <div class="page-header">
            <h1>Profile Depth Analysis</h1>
            <p class="subtitle">See what platforms know about you and how raw data transforms into insights</p>
            <div class="data-points">
                <i class="fas fa-database"></i>
                <span><%= dataPoints %> total data points analyzed</span>
            </div>
        </div>

        <!-- Explicit Data Section -->
        <div class="profile-section">
            <div class="section-header">
                <div class="section-icon">
                    <i class="fas fa-id-card"></i>
                </div>
                <div>
                    <h2 class="section-title">Explicit Data Profile</h2>
                    <p class="section-subtitle">Information you directly provided to platforms</p>
                </div>
            </div>

            <div class="data-grid">
                <% if (profile.explicit.name) { %>
                <div class="data-item">
                    <div class="data-label">Full Name</div>
                    <div class="data-value"><%= profile.explicit.name %></div>
                    <div class="data-meta">
                        <span class="data-source">Facebook Profile</span>
                        <span class="sensitivity-badge sensitivity-low">Low Sensitivity</span>
                    </div>
                </div>
                <% } %>

                <% if (profile.explicit.email) { %>
                <div class="data-item">
                    <div class="data-label">Email Address</div>
                    <div class="data-value"><%= profile.explicit.email %></div>
                    <div class="data-meta">
                        <span class="data-source">Account Registration</span>
                        <span class="sensitivity-badge sensitivity-high">High Sensitivity</span>
                    </div>
                </div>
                <% } %>

                <% if (profile.explicit.location) { %>
                <div class="data-item">
                    <div class="data-label">Location</div>
                    <div class="data-value"><%= profile.explicit.location %></div>
                    <div class="data-meta">
                        <span class="data-source">Profile Information</span>
                        <span class="sensitivity-badge sensitivity-critical">Critical</span>
                    </div>
                </div>
                <% } %>

                <% if (profile.explicit.birthday) { %>
                <div class="data-item">
                    <div class="data-label">Birthday</div>
                    <div class="data-value"><%= profile.explicit.birthday %></div>
                    <div class="data-meta">
                        <span class="data-source">Profile Information</span>
                        <span class="sensitivity-badge sensitivity-critical">Critical</span>
                    </div>
                </div>
                <% } %>

                <% if (profile.explicit.gender) { %>
                <div class="data-item">
                    <div class="data-label">Gender</div>
                    <div class="data-value"><%= profile.explicit.gender %></div>
                    <div class="data-meta">
                        <span class="data-source">Profile Information</span>
                        <span class="sensitivity-badge sensitivity-medium">Medium Sensitivity</span>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Derived Insights Section -->
        <div class="profile-section">
            <div class="section-header">
                <div class="section-icon">
                    <i class="fas fa-brain"></i>
                </div>
                <div>
                    <h2 class="section-title">Derived Insights</h2>
                    <p class="section-subtitle">Inferences made from your behavior and interactions</p>
                </div>
            </div>

            <div class="data-grid">
                <% if (profile.derived && Object.keys(profile.derived).length > 0) { 
                    for (const [key, value] of Object.entries(profile.derived)) { 
                        if (typeof value === 'object') continue; %>
                <div class="data-item">
                    <div class="data-label"><%= key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %></div>
                    <div class="data-value"><%= value %></div>
                    <div class="data-meta">
                        <span class="data-source">AI Inference</span>
                        <span class="sensitivity-badge sensitivity-high">High Sensitivity</span>
                    </div>
                </div>
                <% } } %>
            </div>
        </div>

        <!-- Data Transformation Section -->
        <div class="profile-section">
            <div class="section-header">
                <div class="section-icon">
                    <i class="fas fa-random"></i>
                </div>
                <div>
                    <h2 class="section-title">Data Transformation Pipeline</h2>
                    <p class="section-subtitle">How raw data becomes actionable intelligence</p>
                </div>
            </div>

            <% if (transformations && transformations.length > 0) { %>
            <div class="transformation-list">
                <% transformations.forEach((transformation, index) => { %>
                <div class="transformation-item">
                    <div class="transformation-header">
                        <h3 class="transformation-title">Transformation #<%= index + 1 %></h3>
                        <span class="sensitivity-badge sensitivity-<%= transformation.sensitivity.toLowerCase() %>">
                            <%= transformation.sensitivity %> SENSITIVITY
                        </span>
                    </div>

                    <div class="transformation-flow">
                        <div class="flow-step">
                            <div class="flow-step-icon">
                                <i class="fas fa-upload"></i>
                            </div>
                            <h4 class="flow-step-title">Input Data</h4>
                            <p class="flow-step-desc"><%= transformation.input %></p>
                        </div>

                        <div class="flow-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                        <div class="flow-step">
                            <div class="flow-step-icon">
                                <i class="fas fa-cogs"></i>
                            </div>
                            <h4 class="flow-step-title">Processing</h4>
                            <p class="flow-step-desc"><%= transformation.process %></p>
                        </div>

                        <div class="flow-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                        <div class="flow-step">
                            <div class="flow-step-icon">
                                <i class="fas fa-chart-bar"></i>
                            </div>
                            <h4 class="flow-step-title">Output</h4>
                            <p class="flow-step-desc">Insights & Intelligence</p>
                        </div>
                    </div>

                    <% if (transformation.output && typeof transformation.output === 'object') { %>
                    <div style="margin-top: 1rem; padding: 1rem; background: rgba(2, 6, 23, 0.6); border-radius: 8px;">
                        <div class="data-label">Generated Insights:</div>
                        <pre style="color: var(--muted); font-size: 0.9rem; margin-top: 0.5rem; overflow-x: auto;"><%= JSON.stringify(transformation.output, null, 2) %></pre>
                    </div>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div style="text-align: center; padding: 3rem; color: var(--muted);">
                <i class="fas fa-microscope" style="font-size: 3rem; margin-bottom: 1rem;"></i>
                <h3>No Transformations Available</h3>
                <p>Run a surveillance analysis to see data transformation insights</p>
            </div>
            <% } %>
        </div>

        <a href="/surveillance/dashboard" class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>