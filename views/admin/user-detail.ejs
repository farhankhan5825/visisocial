<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'nonce-<%= nonce %>' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - VisiSocial</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
    <style nonce="<%= nonce %>">
        :root {
            --primary: #7c6cff;
            --primary-dark: #5b4fe0;
            --primary-light: #9d7bff;
            --secondary: #9d7bff;
            --accent: #34e3ff;
            --success: #2dd4a8;
            --warning: #f6b24a;
            --danger: #ff5d6c;
            --dark: #0a0a16;
            --darker: #06060e;
            --light: #ECECF6;
            --muted: #9a9ab6;
            --gradient-primary: linear-gradient(118deg, #9d7bff 0%, #7c6cff 45%, #34e3ff 100%);
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255,255,255,0.09);
            --shadow-lg: 0 25px 80px -20px rgba(99, 102, 241, 0.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--darker);
            color: var(--light);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        /* Animated Background */
        .bg-animated {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
            background: var(--darker);
        }

        .bg-animated .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.15;
            animation: float 25s ease-in-out infinite;
        }

        .bg-animated .orb-1 {
            width: 700px;
            height: 700px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            top: -250px;
            right: -250px;
        }

        .bg-animated .orb-2 {
            width: 500px;
            height: 500px;
            background: linear-gradient(135deg, var(--secondary) 0%, var(--accent) 100%);
            bottom: -150px;
            left: -150px;
            animation-delay: -7s;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(60px, -60px) scale(1.1); }
            50% { transform: translate(-40px, 40px) scale(0.9); }
            75% { transform: translate(-60px, -40px) scale(1.05); }
        }

        /* Header */
        header {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.3);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .logo {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-back {
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: var(--primary-light);
            padding: 10px 20px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back:hover {
            background: rgba(99, 102, 241, 0.2);
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--danger);
            transform: translateY(-2px);
        }

        /* Container */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 32px;
        }

        /* Glass Card */
        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            position: relative;
            overflow: hidden;
        }

        .glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        }

        /* User Profile Header */
        .user-profile-header {
            padding: 40px;
            display: flex;
            gap: 32px;
            align-items: center;
            border-bottom: 1px solid var(--glass-border);
        }

        .user-avatar {
            width: 120px;
            height: 120px;
            border-radius: 24px;
            border: 4px solid rgba(99, 102, 241, 0.3);
            overflow: hidden;
        }

        .user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-info {
            flex: 1;
        }

        .user-name {
            font-size: 2rem;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .user-email {
            color: var(--muted);
            font-size: 1.1rem;
            margin-bottom: 16px;
        }

        .user-badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .badge {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-admin {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .badge-active {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .badge-inactive {
            background: rgba(148, 163, 184, 0.1);
            color: var(--muted);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            padding: 32px;
            border-bottom: 1px solid var(--glass-border);
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--primary-light);
            margin-bottom: 8px;
        }

        .stat-label {
            color: var(--muted);
            font-size: 0.9rem;
        }

        /* Content Grid */
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            padding: 32px;
        }

        .content-section {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 24px;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            color: var(--accent);
        }

        /* Personality Bars */
        .personality-trait {
            margin-bottom: 20px;
        }

        .trait-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .trait-name {
            font-weight: 600;
            color: var(--light);
        }

        .trait-value {
            color: var(--primary-light);
            font-weight: 700;
        }

        .trait-bar {
            height: 12px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            overflow: hidden;
        }

        .trait-fill {
            height: 100%;
            background: var(--gradient-primary);
            border-radius: 6px;
            transition: width 0.5s ease;
        }

        /* Info List */
        .info-list {
            list-style: none;
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-label {
            color: var(--muted);
            font-weight: 500;
        }

        .info-value {
            color: var(--light);
            font-weight: 600;
        }

        /* Timeline */
        .timeline {
            position: relative;
            padding-left: 40px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--glass-border);
        }

        .timeline-item {
            position: relative;
            padding-bottom: 24px;
        }

        .timeline-dot {
            position: absolute;
            left: -33px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--primary);
            border: 3px solid var(--darker);
        }

        .timeline-content {
            background: rgba(255, 255, 255, 0.03);
            padding: 16px;
            border-radius: 12px;
        }

        .timeline-time {
            color: var(--muted);
            font-size: 0.85rem;
            margin-bottom: 4px;
        }

        .timeline-text {
            color: var(--light);
            font-weight: 500;
        }

        .timeline-details {
            color: var(--muted);
            font-size: 0.85rem;
            margin-top: 4px;
        }

        /* Sessions Table */
        .sessions-table {
            width: 100%;
            border-collapse: collapse;
        }

        .sessions-table th,
        .sessions-table td {
            padding: 12px;
            text-align: left;
        }

        .sessions-table th {
            background: rgba(255, 255, 255, 0.03);
            color: var(--muted);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .sessions-table tbody tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sessions-table tbody tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 16px;
            }

            .container {
                padding: 24px 16px;
            }

            .user-profile-header {
                flex-direction: column;
                text-align: center;
                padding: 24px;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                padding: 24px;
            }

            .content-grid {
                padding: 24px;
            }

            .user-name {
                font-size: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <!-- Animated Background -->
    <div class="bg-animated">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <!-- Header -->
    <header>
        <div class="header-content">
            <div class="header-left">
                <a href="/admin" class="logo">VisiSocial</a>
                <div class="admin-badge">
                    <i class="fas fa-user"></i>
                    <span>User Details</span>
                </div>
            </div>

            <div class="header-right">
                <a href="/admin/users" class="btn-back">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back to Users</span>
                </a>
                <button class="btn-danger" onclick="confirmDelete()">
                    <i class="fas fa-trash"></i>
                    <span>Delete User</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <div class="container">
        
        <!-- User Profile Card -->
        <div class="glass-card" style="margin-bottom: 24px;">
            <!-- User Header -->
            <div class="user-profile-header">
                <div class="user-avatar">
                    <img src="<%= user.picture || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) %>" 
                         alt="<%= user.name %>">
                </div>

                <div class="user-info">
                    <h1 class="user-name"><%= user.name %></h1>
                    <div class="user-email"><%= user.email %></div>
                    
                    <div class="user-badges">
                        <% if (user.isAdmin) { %>
                        <span class="badge badge-admin">
                            <i class="fas fa-shield-alt"></i>
                            Admin
                        </span>
                        <% } %>
                        
                        <span class="badge <%= user.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
                            <i class="fas <%= user.status === 'active' ? 'fa-check-circle' : 'fa-ban' %>"></i>
                            <%= user.status || 'Active' %>
                        </span>

                        <span class="badge" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-light);">
                            <i class="fas fa-id-card"></i>
                            <%= user.id.substring(0, 8) %>...
                        </span>
                    </div>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-value"><%= metrics.totalPosts %></div>
                    <div class="stat-label">Total Posts</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value"><%= metrics.totalLikes %></div>
                    <div class="stat-label">Total Likes</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value"><%= metrics.accountAge %></div>
                    <div class="stat-label">Days Active</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value"><%= metrics.activeSessions %></div>
                    <div class="stat-label">Active Sessions</div>
                </div>
            </div>

            <!-- Content Grid -->
            <div class="content-grid">
                <!-- Personality Scores -->
                <div class="content-section" style="grid-column: span 2;">
                    <h3 class="section-title">
                        <i class="fas fa-brain"></i>
                        Personality Profile
                    </h3>

                    <div class="personality-trait">
                        <div class="trait-header">
                            <span class="trait-name">Openness</span>
                            <span class="trait-value"><%= user.personalityScores?.openness || 50 %>%</span>
                        </div>
                        <div class="trait-bar">
                            <div class="trait-fill" style="width: <%= user.personalityScores?.openness || 50 %>%"></div>
                        </div>
                    </div>

                    <div class="personality-trait">
                        <div class="trait-header">
                            <span class="trait-name">Conscientiousness</span>
                            <span class="trait-value"><%= user.personalityScores?.conscientiousness || 50 %>%</span>
                        </div>
                        <div class="trait-bar">
                            <div class="trait-fill" style="width: <%= user.personalityScores?.conscientiousness || 50 %>%"></div>
                        </div>
                    </div>

                    <div class="personality-trait">
                        <div class="trait-header">
                            <span class="trait-name">Extroversion</span>
                            <span class="trait-value"><%= user.personalityScores?.extroversion || 50 %>%</span>
                        </div>
                        <div class="trait-bar">
                            <div class="trait-fill" style="width: <%= user.personalityScores?.extroversion || 50 %>%"></div>
                        </div>
                    </div>

                    <div class="personality-trait">
                        <div class="trait-header">
                            <span class="trait-name">Agreeableness</span>
                            <span class="trait-value"><%= user.personalityScores?.agreeableness || 50 %>%</span>
                        </div>
                        <div class="trait-bar">
                            <div class="trait-fill" style="width: <%= user.personalityScores?.agreeableness || 50 %>%"></div>
                        </div>
                    </div>

                    <div class="personality-trait">
                        <div class="trait-header">
                            <span class="trait-name">Neuroticism</span>
                            <span class="trait-value"><%= user.personalityScores?.neuroticism || 50 %>%</span>
                        </div>
                        <div class="trait-bar">
                            <div class="trait-fill" style="width: <%= user.personalityScores?.neuroticism || 50 %>%"></div>
                        </div>
                    </div>
                </div>

                <!-- User Information -->
                <div class="content-section">
                    <h3 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        User Information
                    </h3>

                    <ul class="info-list">
                        <li class="info-item">
                            <span class="info-label">Gender</span>
                            <span class="info-value"><%= user.gender || 'Not specified' %></span>
                        </li>
                        <li class="info-item">
                            <span class="info-label">Birthday</span>
                            <span class="info-value"><%= user.birthday || 'Not specified' %></span>
                        </li>
                        <li class="info-item">
                            <span class="info-label">Location</span>
                            <span class="info-value"><%= user.location?.name || 'Not specified' %></span>
                        </li>
                        <li class="info-item">
                            <span class="info-label">Hometown</span>
                            <span class="info-value"><%= user.hometown?.name || 'Not specified' %></span>
                        </li>
                        <li class="info-item">
                            <span class="info-label">Engagement Score</span>
                            <span class="info-value"><%= user.engagementScore || 0 %></span>
                        </li>
                        <li class="info-item">
                            <span class="info-label">Primary Interest</span>
                            <span class="info-value"><%= user.areaOfInterest || 'General' %></span>
                        </li>
                    </ul>
                </div>

                <!-- Activity Timeline -->
                <div class="content-section">
                    <h3 class="section-title">
                        <i class="fas fa-history"></i>
                        Recent Activity
                    </h3>

                    <div class="timeline">
                        <% activityTimeline.slice(0, 5).forEach(activity => { %>
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <div class="timeline-time">
                                    <%= new Date(activity.date).toLocaleString() %>
                                </div>
                                <div class="timeline-text"><%= activity.description %></div>
                                <% if (activity.details) { %>
                                <div class="timeline-details"><%= activity.details %></div>
                                <% } %>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sessions Card -->
        <div class="glass-card" style="padding: 32px;">
            <h3 class="section-title">
                <i class="fas fa-laptop"></i>
                Active Sessions
            </h3>

            <% if (sessions && sessions.length > 0) { %>
            <table class="sessions-table">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>Last Used</th>
                        <th>IP Address</th>
                        <th>User Agent</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% sessions.forEach(session => { 
                        const isValid = session.isValid && new Date(session.expiresAt) > new Date();
                    %>
                    <tr>
                        <td><%= new Date(session.createdAt).toLocaleDateString() %></td>
                        <td><%= session.lastUsed ? new Date(session.lastUsed).toLocaleDateString() : 'Never' %></td>
                        <td><%= session.ipAddress || 'Unknown' %></td>
                        <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <%= session.userAgent || 'Unknown' %>
                        </td>
                        <td>
                            <span class="badge <%= isValid ? 'badge-active' : 'badge-inactive' %>">
                                <%= isValid ? 'Active' : 'Expired' %>
                            </span>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <p style="text-align: center; color: var(--muted); padding: 40px;">
                No active sessions found
            </p>
            <% } %>
        </div>

    </div>

    <script nonce="<%= nonce %>">
        function confirmDelete() {
            if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                fetch('/admin/users/<%= user.id %>', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = '/admin/users?success=User+deleted+successfully';
                    } else {
                        alert('Error deleting user: ' + data.error);
                    }
                })
                .catch(err => {
                    alert('Error deleting user');
                    console.error(err);
                });
            }
        }
    </script>
</body>
</html>