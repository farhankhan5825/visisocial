<!-- VisiSocial footer — design system v3 · include before </body> -->
<style>
    /* global polish — applies wherever the footer is included (all pages) */
    html { scroll-behavior: smooth; }
    ::selection { background: rgba(124,108,255,.32); color: #fff; }
    *::-webkit-scrollbar { width: 10px; height: 10px; }
    *::-webkit-scrollbar-track { background: #07070e; }
    *::-webkit-scrollbar-thumb { background: rgba(124,108,255,.4); border-radius: 10px; border: 3px solid #07070e; }
    *::-webkit-scrollbar-thumb:hover { background: rgba(124,108,255,.7); }

    .site-footer { position: relative; margin-top: 90px; padding: 72px 0 34px; overflow: hidden;
        background: linear-gradient(180deg, transparent, rgba(124,108,255,.04) 34%, rgba(8,8,18,.55));
        border-top: 1px solid var(--vs-line, rgba(255,255,255,.08)); }
    .site-footer::before { content: ""; position: absolute; top: -1px; left: 0; right: 0; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(124,108,255,.8), rgba(52,227,255,.7), transparent); }
    .site-footer::after { content: ""; position: absolute; bottom: -42%; left: 50%; transform: translateX(-50%);
        width: 70vw; height: 60vw; max-width: 880px; max-height: 880px; border-radius: 50%; pointer-events: none;
        background: radial-gradient(circle, rgba(124,108,255,.1), transparent 62%); filter: blur(44px); }
    .ft-wrap { position: relative; z-index: 1; max-width: 1320px; margin: 0 auto; padding: 0 clamp(18px,4vw,40px); }
    .ft-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 52px; }
    .ft-brand { display: flex; align-items: center; gap: 11px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.5rem; margin-bottom: 16px; letter-spacing: -.02em; }
    .ft-brand__icon { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: #0a0a16; font-size: .9rem;
        background: linear-gradient(118deg, #9d7bff, #7c6cff 45%, #34e3ff); }
    .ft-brand__text { background: linear-gradient(120deg, #cfc7ff, #7c6cff 55%, #34e3ff); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .ft-desc { color: var(--vs-muted, #8a8aa6); line-height: 1.7; max-width: 42ch; margin-bottom: 24px; font-size: .94rem; }
    .ft-social { display: flex; gap: 11px; flex-wrap: wrap; }
    .ft-social a { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; color: var(--vs-muted, #8a8aa6);
        background: rgba(255,255,255,.04); border: 1px solid var(--vs-line-2, rgba(255,255,255,.12)); transition: .3s cubic-bezier(.22,.7,.2,1); }
    .ft-social a:hover { color: #fff; border-color: #7c6cff; background: rgba(124,108,255,.14); transform: translateY(-3px); }
    .ft-col h4 { font-family: 'JetBrains Mono', monospace; font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--vs-faint, #5a5a74); margin-bottom: 18px; }
    /* harden against page-level li styles bleeding into the footer */
    .site-footer ul, .site-footer li { margin: 0; padding: 0; list-style: none; background: none; border: 0; border-radius: 0; }
    .site-footer li::before, .site-footer li::after { content: none !important; }
    .ft-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .ft-links a { display: inline-flex; align-items: center; gap: 9px; color: var(--vs-muted, #8a8aa6); font-size: .92rem; transition: color .3s, transform .3s; }
    .ft-links a i { font-size: .78rem; color: var(--vs-faint, #5a5a74); transition: color .3s; width: 14px; text-align: center; }
    .ft-links a:hover { color: #fff; transform: translateX(4px); }
    .ft-links a:hover i { color: #34e3ff; }
    .ft-bottom { display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;
        padding-top: 26px; border-top: 1px solid var(--vs-line, rgba(255,255,255,.08)); }
    .ft-bottom p { margin: 0; color: var(--vs-faint, #5a5a74); font-size: .84rem; font-family: 'JetBrains Mono', monospace; }
    .ft-note { color: var(--vs-muted, #8a8aa6); }
    .ft-badge { display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: .68rem;
        letter-spacing: .12em; text-transform: uppercase; color: #34e3ff; padding: 6px 12px; border-radius: 999px;
        border: 1px solid rgba(52,227,255,.28); background: rgba(52,227,255,.05); }
    @media (max-width: 860px) { .ft-grid { grid-template-columns: 1fr 1fr; gap: 36px; } .ft-brand-col { grid-column: 1 / -1; } }
    @media (max-width: 520px) { .ft-grid { grid-template-columns: 1fr; } .ft-bottom { flex-direction: column; align-items: flex-start; } }
</style>

<footer class="site-footer">
    <div class="ft-wrap">
        <div class="ft-grid">
            <div class="ft-brand-col">
                <div class="ft-brand">
                    <span class="ft-brand__icon"><i class="fas fa-brain"></i></span>
                    <span class="ft-brand__text">VisiSocial</span>
                </div>
                <p class="ft-desc">Surveillance intelligence that hands the dossier back to the watched. We reconstruct what the data economy infers about you, so you can finally read it.</p>
                <div class="ft-social">
                    <a href="#" aria-label="GitHub"><i class="fab fa-github"></i></a>
                    <a href="#" aria-label="X"><i class="fab fa-x-twitter"></i></a>
                    <a href="/privacy" aria-label="Privacy"><i class="fas fa-user-shield"></i></a>
                    <a href="/docs" aria-label="Docs"><i class="fas fa-file-lines"></i></a>
                </div>
            </div>
            <div class="ft-col">
                <h4>Intelligence</h4>
                <ul class="ft-links">
                    <li><a href="/"><i class="fas fa-chart-line"></i> Dashboard</a></li>
                    <li><a href="/surveillance/dashboard"><i class="fas fa-eye"></i> Surveillance</a></li>
                    <li><a href="/about"><i class="fas fa-circle-info"></i> About</a></li>
                </ul>
            </div>
            <div class="ft-col">
                <h4>Protection</h4>
                <ul class="ft-links">
                    <li><a href="/settings"><i class="fas fa-sliders"></i> Privacy settings</a></li>
                    <li><a href="/data"><i class="fas fa-trash-can"></i> Data deletion</a></li>
                    <li><a href="/support"><i class="fas fa-shield-halved"></i> Security guide</a></li>
                </ul>
            </div>
            <div class="ft-col">
                <h4>Legal</h4>
                <ul class="ft-links">
                    <li><a href="/privacy"><i class="fas fa-user-shield"></i> Privacy policy</a></li>
                    <li><a href="/terms"><i class="fas fa-file-contract"></i> Terms</a></li>
                    <li><a href="/cookies"><i class="fas fa-cookie-bite"></i> Cookies</a></li>
                    <li><a href="mailto:support@visionsocial.com"><i class="fas fa-envelope"></i> Contact</a></li>
                </ul>
            </div>
        </div>
        <div class="ft-bottom">
            <p>&copy; <%= new Date().getFullYear() %> VisiSocial Intelligence <span class="ft-note">· built for educational surveillance analysis</span></p>
            <span class="ft-badge">Your data is never resold</span>
        </div>
    </div>
</footer>

<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
(function(){
    // Site-wide reveal-on-scroll for any element marked .vs-reveal
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.vs-reveal:not(.in)');
    if (!els.length) return;
    if (reduce || !('IntersectionObserver' in window)) { els.forEach(function(e){ e.classList.add('in'); }); return; }
    var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.1 });
    els.forEach(function(e){ io.observe(e); });
})();
</script>
