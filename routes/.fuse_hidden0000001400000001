/**
 * Authenticate user based on access token
 */
const authenticateToken = wrapAsync(async (req, res, next) => {
  const token = req.cookies.access_token;
  
  logger.debug('Auth check', { hasAccessToken: !!token });
  
  if (!token) {
    res.clearCookie('access_token');
    return res.redirect('/login?error=Authentication%20required');
  }

  try {
    const userToken = await UserToken.findOne({ accessToken: token });
    if (!userToken) {
      res.clearCookie('access_token');
      return res.redirect('/login?error=Invalid%20session');
    }

    const now = Date.now();
    if (now > new Date(userToken.expiresAt).getTime()) {
      res.clearCookie('access_token');
      logger.info(`Token expired for user ${userToken.userId}`);
      return res.redirect('/login?error=Session%20expired');
    }

    req.user = {
      id: userToken.userId,
      accessToken: userToken.accessToken
    };

    metrics.increment('auth.session_active');
    logger.debug(`User ${userToken.userId} authenticated`);
    
    next();
  } catch (error) {
    logger.error(`Authentication error: ${error.message}`);
    metrics.increment('auth.errors');
    res.clearCookie('access_token');
    return res.redirect('/login?error=Authentication%20error');
  }
});

