router.get('/loading', authenticateToken, wrapAsync(async (req, res) => {
  const userId = req.user.id;
  const user = await User.findOne({ id: userId });
  
  if (!user) return res.redirect('/login');
  if (user.analysisComplete || user.status === 'complete') return res.redirect('/');
  
  const userTasks = taskStatus.getUserTasks(userId);
  const latestTask = userTasks.length > 0 ? userTasks[userTasks.length - 1] : null;
  const hasActiveTask = latestTask && (latestTask.state === 'running' || latestTask.state === 'pending');
  
  if (!hasActiveTask) {
    if (user.status === 'processing') {
      const lastUpdated = user.lastUpdated || new Date();
      const timeSinceUpdate = Date.now() - lastUpdated.getTime();
      
      if (timeSinceUpdate > 10 * 60 * 1000) {
        user.status = 'pending';
        user.analysisComplete = false;
        await user.save();
        taskStatus.clearUserTasks(userId);
        
        setImmediate(() => {
          processUserDataInBackground(userId, req.user.accessToken)
            .catch(err => console.error('Restart error:', err));
        });
      }
    } else if (user.status === 'pending' || !user.status) {
      const task = taskStatus.create(userId, 'initial_processing', { triggeredBy: 'loading_page' });
      taskStatus.start(task.id, 9, 'Preparing to analyze your data...');
      
      setImmediate(() => {
        processUserDataInBackground(userId, req.user.accessToken)
          .catch(err => console.error('Processing error:', err));
      });
    }
  }
  
  res.render('loading', {
    title: 'Loading Your Data',
    userId: userId,
    taskId: latestTask?.id,
    nonce: res.locals.nonce
  });
}));

/**
 * Task Status API Route
 */
router.get('/task-status', authenticateToken, wrapAsync(async (req, res) => {
  const userId = req.user.id;
  
  try {
    const user = await User.findOne({ id: userId });
    
    if (!user) {
      return res.json({
        task: 'User not found',
        progress: 0,
        completed: false,
        error: true
      });
    }
    
    if (user.analysisComplete || user.status === 'complete') {
      return res.json({
        task: 'Analysis complete!',
        step: 9,
        progress: 100,
        totalSteps: 9,
        isProcessing: false,
        completed: true,
        redirectTo: '/',
        timestamp: Date.now()
      });
    }
    
    const userTasks = taskStatus.getUserTasks(userId, { limit: 5 });
    const activeTask = userTasks.find(t => t.state === 'running' || t.state === 'pending');
    const latestTask = userTasks.length > 0 ? userTasks[userTasks.length - 1] : null;
    const task = activeTask || latestTask;
    
    if (task) {
      if (task.state === 'completed') {
        user.status = 'complete';
        user.analysisComplete = true;
        user.lastUpdated = new Date();
        await user.save();
        
        return res.json({
          task: 'Analysis complete!',
          step: 9,
          progress: 100,
          totalSteps: 9,
          isProcessing: false,
          completed: true,
          redirectTo: '/',
          timestamp: Date.now()
        });
      }
      
      return res.json({
        task: task.message || 'Processing...',
        step: task.currentStep || 0,
        progress: task.progress || 0,
        totalSteps: task.totalSteps || 9,
        isProcessing: task.state === 'running',
        completed: task.state === 'completed',
        timestamp: Date.now()
      });
    }
    
    res.json({
      task: 'Starting analysis...',
      step: 0,
      progress: 0,
      totalSteps: 9,
      isProcessing: true,
      completed: false,
      timestamp: Date.now()
    });
  } catch (error) {
    console.error('Task status error:', error);
    res.json({
      task: 'Error checking status',
      progress: 0,
      completed: false,
      error: true
    });
  }
}));

